PROMPT =============================================================================
PROMPT 25. ORPHAN ORACLE PRODUCTION CANDIDATES
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Identify Oracle production lots whose PRECAST_LOT_ID has no matching
PROMPT   Web header. These are candidates only; investigate before correction.
PROMPT
PROMPT EXPECTATION:
PROMPT   Normal imported Web lots should have PRECAST_LOT_ID matching HEADER_ID.
PROMPT =============================================================================

WITH filtered_lots AS
(
    SELECT l.*
    FROM reco.reco_lot_numbers l
    JOIN reco.reco_pcf_v v
      ON v.pcf_id = l.pcf_id
    WHERE ('&&P_PROJECT_NUMBER' IS NULL OR v.project_num = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR v.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR l.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_LOT_ID' IS NULL OR l.lot_id = TO_NUMBER('&&P_LOT_ID'))
      AND ('&&P_LOT_NUMBER' IS NULL OR l.lot_number = '&&P_LOT_NUMBER')
)
SELECT
    l.lot_id,
    l.pcf_id,
    l.precast_lot_id,
    l.lot_number,
    l.lot_type,
    l.lot_date,
    l.billed_flag,
    p.production_id,
    p.pc_id,
    p.quantity_produced
FROM filtered_lots l
JOIN reco.reco_production p
  ON p.lot_id = l.lot_id
WHERE l.precast_lot_id IS NOT NULL
  AND NOT EXISTS
      (
          SELECT 1
          FROM prec_trans_header@RECOWEBPROD h
          WHERE h.header_id = l.precast_lot_id
      )
ORDER BY l.lot_date, l.lot_id, p.production_id;


