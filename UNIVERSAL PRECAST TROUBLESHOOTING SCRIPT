PROMPT =============================================================================
PROMPT 13. ORACLE LOT TRACE - STRICTLY FILTERED
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Confirm Oracle received the Web header/lot.
PROMPT
PROMPT EXPECTATION:
PROMPT   PRECAST_LOT_ID should trace to the Web HEADER_ID.
PROMPT
PROMPT BILLED_FLAG:
PROMPT   N = not yet billed
PROMPT   Y = billed
PROMPT   X = historical/special state; investigate before changing
PROMPT =============================================================================

WITH filtered_pcf AS
(
    SELECT DISTINCT v.pcf_id
    FROM reco.reco_pcf_v v
    JOIN reco.reco_pcf_current c
      ON c.pcf_id = v.pcf_id
    LEFT JOIN prec_pcf@RECOWEBPROD w
      ON w.pcf_id = v.pcf_id
     AND w.revision_number = c.revision_number
    WHERE v.revision_number = c.revision_number
      AND ('&&P_PROJECT_NUMBER' IS NULL OR v.project_num = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR v.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR v.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR w.product_code = '&&P_PRODUCT_CODE')
)
SELECT
    l.lot_id,
    l.precast_lot_id,
    l.pcf_id,
    l.lot_number,
    l.lot_type,
    l.lot_date,
    l.billed_flag,
    l.billed_date,
    l.waco_lot_id,
    l.creation_date,
    l.last_update_date
FROM filtered_pcf fp
JOIN reco.reco_lot_numbers l
  ON l.pcf_id = fp.pcf_id
WHERE ('&&P_HEADER_ID' IS NULL OR l.precast_lot_id = TO_NUMBER('&&P_HEADER_ID'))
  AND ('&&P_LOT_NUMBER' IS NULL OR l.lot_number = '&&P_LOT_NUMBER')
  AND ('&&P_LOT_ID' IS NULL OR l.lot_id = TO_NUMBER('&&P_LOT_ID'))
ORDER BY l.lot_date, l.lot_id;

