PROMPT
PROMPT =============================================================================
PROMPT 6. REQUIRED VS ORACLE PRODUCTION - OVERAGE / SHORT ANALYSIS
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Explain cases where physical production is above/below requirements.
PROMPT
PROMPT EXPECTATION:
PROMPT   OVERAGE = produced above requirement for that mark.
PROMPT   SHORT   = required quantity not yet produced.
PROMPT
PROMPT IMPORTANT:
PROMPT   A Production > Job Cost difference can be legitimate overage.
PROMPT =============================================================================

WITH filtered_pcf AS
(
    SELECT DISTINCT
        v.pcf_id,
        c.revision_number,
        w.product_code
    FROM reco.reco_pcf_v v
    JOIN reco.reco_pcf_current c
      ON c.pcf_id = v.pcf_id
    LEFT JOIN prec_pcf@RECOWEBPROD w
      ON w.pcf_id = v.pcf_id
     AND w.revision_number = c.revision_number
    WHERE v.revision_number = c.revision_number
      AND ('&&P_PROJECT_NUMBER' IS NULL OR v.project_num = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR v.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR v.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR w.product_code = '&&P_PRODUCT_CODE')
),
req AS
(
    SELECT
        fp.pcf_id,
        fp.product_code,
        pp.mark_number,
        pp.quantity_required,
        pp.width,
        pp.area_per_piece,
        CASE
            WHEN fp.product_code IN ('COP','HFC','PAR','TRB')
                THEN NVL(pp.quantity_required,0) * NVL(pp.width,0)
            ELSE NVL(pp.quantity_required,0) * NVL(pp.area_per_piece,0)
        END AS required_area
    FROM filtered_pcf fp
    JOIN prec_pcf_panels@RECOWEBPROD pp
      ON pp.pcf_id = fp.pcf_id
),
prd AS
(
    SELECT
        pv.pcf_id,
        pv.mark_number,
        SUM(pv.quantity_produced) AS produced_qty,
        MAX(pv.area_per_piece) AS area_per_piece,
        SUM(NVL(pv.area_total,
                NVL(pv.quantity_produced,0) * NVL(pv.area_per_piece,0))) AS produced_area
    FROM filtered_pcf fp
    JOIN reco.reco_production_v pv
      ON pv.pcf_id = fp.pcf_id
    GROUP BY pv.pcf_id, pv.mark_number
)
SELECT
    r.pcf_id,
    r.mark_number,
    r.quantity_required,
    NVL(p.produced_qty,0) AS produced_qty,
    NVL(p.produced_qty,0) - r.quantity_required AS qty_variance,
    ROUND(r.required_area,2) AS required_area,
    ROUND(NVL(p.produced_area,0),2) AS produced_area,
    ROUND(
        GREATEST(NVL(p.produced_area,0) - r.required_area,0)
    ,2) AS overage_area,
    ROUND(
        GREATEST(r.required_area - NVL(p.produced_area,0),0)
    ,2) AS short_area,
    CASE
        WHEN NVL(p.produced_area,0) > r.required_area THEN 'OVERAGE'
        WHEN NVL(p.produced_area,0) < r.required_area THEN 'SHORT'
        ELSE 'MATCH'
    END AS mark_status
FROM req r
LEFT JOIN prd p
  ON p.pcf_id = r.pcf_id
 AND p.mark_number = r.mark_number
WHERE ('&&P_MARK_NUMBER' IS NULL OR r.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
ORDER BY r.pcf_id, r.mark_number;


