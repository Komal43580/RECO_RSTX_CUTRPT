PROMPT =============================================================================
PROMPT 12. OUTBOUND TRACE
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Determine whether the batch created outbound records for Oracle.
PROMPT
PROMPT EXPECTATION:
PROMPT   Batch exists but outbound lot missing
PROMPT       -> export/outbound problem.
PROMPT
PROMPT   Outbound lot exists but Oracle lot missing
PROMPT       -> Oracle import problem.
PROMPT =============================================================================

WITH filtered_pcf AS
(
    SELECT DISTINCT p.pcf_id
    FROM prec_pcf@RECOWEBPROD p
    WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.project_number = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR p.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR p.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR p.product_code = '&&P_PRODUCT_CODE')
)
SELECT
    l.batch_id,
    l.precast_lot_id,
    l.pcf_id,
    l.revision_number,
    l.lot_number,
    l.lot_date,
    l.lot_type,
    l.lot_status,
    l.date_status,
    l.status_desc
FROM filtered_pcf fp
JOIN web_re_outbound_lots@RECOWEBPROD l
  ON l.pcf_id = fp.pcf_id
WHERE ('&&P_BATCH_ID' IS NULL OR l.batch_id = TO_NUMBER('&&P_BATCH_ID'))
  AND ('&&P_HEADER_ID' IS NULL OR l.precast_lot_id = TO_NUMBER('&&P_HEADER_ID'))
  AND ('&&P_LOT_NUMBER' IS NULL OR l.lot_number = '&&P_LOT_NUMBER')
ORDER BY l.batch_id, l.precast_lot_id;

no row
PROMPT
PROMPT Outbound Production
PROMPT -------------------

WITH outbound_lots AS
(
    SELECT l.precast_lot_id
    FROM web_re_outbound_lots@RECOWEBPROD l
    JOIN prec_pcf@RECOWEBPROD p
      ON p.pcf_id = l.pcf_id
    WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.project_number = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR p.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR l.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR p.product_code = '&&P_PRODUCT_CODE')
      AND ('&&P_BATCH_ID' IS NULL OR l.batch_id = TO_NUMBER('&&P_BATCH_ID'))
      AND ('&&P_HEADER_ID' IS NULL OR l.precast_lot_id = TO_NUMBER('&&P_HEADER_ID'))
      AND ('&&P_LOT_NUMBER' IS NULL OR l.lot_number = '&&P_LOT_NUMBER')
)
SELECT
    op.precast_lot_id,
    op.pc_id,
    op.quantity_produced,
    op.project_id
FROM outbound_lots ol
JOIN web_re_outbound_prod@RECOWEBPROD op
  ON op.precast_lot_id = ol.precast_lot_id
ORDER BY op.precast_lot_id, op.pc_id;

