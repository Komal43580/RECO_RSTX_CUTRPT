PROMPT 14. ORACLE PRODUCTION TRACE BY LOT / MARK
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Confirm the exact physical production imported for each Oracle lot.
PROMPT
PROMPT EXPECTATION:
PROMPT   If Oracle lot exists but production is wrong/missing, investigate
PROMPT   RECO_PRODUCTION / PC_ID mapping.
PROMPT =============================================================================

WITH filtered_pcf AS
(
    SELECT DISTINCT v.pcf_id
    FROM reco.reco_pcf_v v
    JOIN reco.reco_pcf_current c
      ON c.pcf_id = v.pcf_id
    WHERE v.revision_number = c.revision_number
      AND ('&&P_PROJECT_NUMBER' IS NULL OR v.project_num = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR v.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR v.pcf_id = TO_NUMBER('&&P_PCF_ID'))
)
SELECT
    pv.pcf_id,
    pv.lot_id,
    pv.lot_number,
    pv.lot_date,
    pv.lot_type,
    pv.billed_flag,
    pv.billed_date,
    pv.mark_number,
    pv.production_id,
    pv.pc_id,
    pv.quantity_produced,
    pv.area_per_piece,
    pv.area_total,
    pv.quantity_required,
    pv.req_total,
    pv.quantity_billed
FROM filtered_pcf fp
JOIN reco.reco_production_v pv
  ON pv.pcf_id = fp.pcf_id
WHERE ('&&P_MARK_NUMBER' IS NULL OR pv.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
  AND ('&&P_LOT_NUMBER' IS NULL OR pv.lot_number = '&&P_LOT_NUMBER')
  AND ('&&P_LOT_ID' IS NULL OR pv.lot_id = TO_NUMBER('&&P_LOT_ID'))
ORDER BY pv.lot_date, pv.lot_id, pv.mark_number, pv.production_id;


