PROMPT
PROMPT =============================================================================
PROMPT 11. LIVE WEB TRANSACTION VS EXPORTED BATCH
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Prove batch corruption.
PROMPT
PROMPT EXPECTATION:
PROMPT   WEB_QTY = BATCH_QTY and classification fields should normally agree.
PROMPT
PROMPT IF DIFFERENT:
PROMPT   The live transaction may be correct while batch generation is wrong.
PROMPT   Do NOT modify the live Web transaction until this is understood.
PROMPT =============================================================================

SELECT
    bh.batch_id,
    bh.header_id,
    bh.pcf_id,
    bh.revision_number,
    bh.lot_number,
    bh.transaction_type,
    bt.transaction_id,
    bt.mark_number,
    t.quantity AS web_qty,
    bt.quantity AS batch_qty,
    NVL(bt.quantity,0)-NVL(t.quantity,0) AS qty_difference,
    t.qty_standard AS web_standard,
    bt.qty_standard AS batch_standard,
    NVL(bt.qty_standard,0)-NVL(t.qty_standard,0) AS std_difference,
    t.qty_overage AS web_overage,
    bt.qty_overage AS batch_overage,
    NVL(bt.qty_overage,0)-NVL(t.qty_overage,0) AS overage_difference,
    t.qty_paid_over AS web_paid_over,
    bt.qty_paid_over AS batch_paid_over,
    NVL(bt.qty_paid_over,0)-NVL(t.qty_paid_over,0) AS paid_over_difference
FROM prec_batch_headers@RECOWEBPROD bh
JOIN prec_batch_transactions@RECOWEBPROD bt
  ON bt.batch_id = bh.batch_id
 AND bt.header_id = bh.header_id
JOIN prec_transactions@RECOWEBPROD t
  ON t.transaction_id = bt.transaction_id
JOIN prec_pcf@RECOWEBPROD p
  ON p.pcf_id = t.pcf_id
WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.project_number = '&&P_PROJECT_NUMBER')
  AND ('&&P_TASK_NUMBER' IS NULL OR p.task_number = '&&P_TASK_NUMBER')
  AND ('&&P_PCF_ID' IS NULL OR t.pcf_id = TO_NUMBER('&&P_PCF_ID'))
  AND ('&&P_PRODUCT_CODE' IS NULL OR p.product_code = '&&P_PRODUCT_CODE')
  AND ('&&P_MARK_NUMBER' IS NULL OR t.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
  AND ('&&P_HEADER_ID' IS NULL OR bh.header_id = TO_NUMBER('&&P_HEADER_ID'))
  AND ('&&P_TRANSACTION_ID' IS NULL OR bt.transaction_id = TO_NUMBER('&&P_TRANSACTION_ID'))
  AND ('&&P_BATCH_ID' IS NULL OR bh.batch_id = TO_NUMBER('&&P_BATCH_ID'))
  AND ('&&P_LOT_NUMBER' IS NULL OR bh.lot_number = '&&P_LOT_NUMBER')
ORDER BY bh.batch_id, bt.transaction_id;



