PROMPT
PROMPT =============================================================================
PROMPT 20. JOB COST / PA TOTAL BY PCF
PROMPT =============================================================================

SELECT
    v.project_num,
    pe.task_number,
    pe.pcf_id,
    ROUND(SUM(NVL(pe.quantity,0)),2) AS pa_quantity,
    ROUND(SUM(NVL(pe.denom_raw_cost,0)),2) AS pa_raw_cost
FROM reco.reco_precast_expenditures pe
JOIN reco.reco_pcf_v v
  ON v.project_id = pe.project_id
 AND v.task_id = pe.task_id
 AND TO_CHAR(v.pcf_id) = pe.pcf_id
WHERE ('&&P_PROJECT_NUMBER' IS NULL OR v.project_num = '&&P_PROJECT_NUMBER')
  AND ('&&P_TASK_NUMBER' IS NULL OR pe.task_number = '&&P_TASK_NUMBER')
  AND ('&&P_PCF_ID' IS NULL OR pe.pcf_id = '&&P_PCF_ID')
GROUP BY v.project_num, pe.task_number, pe.pcf_id
ORDER BY v.project_num, pe.task_number, pe.pcf_id;

