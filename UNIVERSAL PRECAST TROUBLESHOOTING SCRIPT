PROMPT =============================================================================
PROMPT 10. WEB HEADER -> BATCH TRACE
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Determine whether the Web transaction generated an OP batch.
PROMPT
PROMPT EXPECTATION:
PROMPT   Header/detail exists but NO batch header/detail:
PROMPT       -> stopped before/during export.
PROMPT
PROMPT   Batch exists:
PROMPT       -> compare batch values to live transaction in Section 11.
PROMPT =============================================================================

WITH valid_headers AS
(
    SELECT DISTINCT t.header_id
    FROM prec_transactions@RECOWEBPROD t
    JOIN prec_pcf@RECOWEBPROD p
      ON p.pcf_id = t.pcf_id
    WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.project_number = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR p.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR t.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR p.product_code = '&&P_PRODUCT_CODE')
      AND ('&&P_MARK_NUMBER' IS NULL OR t.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
      AND ('&&P_HEADER_ID' IS NULL OR t.header_id = TO_NUMBER('&&P_HEADER_ID'))
      AND ('&&P_TRANSACTION_ID' IS NULL OR t.transaction_id = TO_NUMBER('&&P_TRANSACTION_ID'))
)
SELECT
    b.batch_id,
    b.creation_date AS batch_creation_date,
    b.batch_type,
    b.batch_status,
    b.status_date AS batch_status_date,
    DBMS_LOB.SUBSTR(b.batch_err_msg,1000,1) AS batch_error,
    bh.header_id,
    bh.pcf_id,
    bh.revision_number,
    bh.lot_number,
    bh.lot_date,
    bh.transaction_type
FROM valid_headers vh
JOIN prec_batch_headers@RECOWEBPROD bh
  ON bh.header_id = vh.header_id
LEFT JOIN prec_batches@RECOWEBPROD b
  ON b.batch_id = bh.batch_id
WHERE ('&&P_BATCH_ID' IS NULL OR bh.batch_id = TO_NUMBER('&&P_BATCH_ID'))
  AND ('&&P_LOT_NUMBER' IS NULL OR bh.lot_number = '&&P_LOT_NUMBER')
ORDER BY bh.batch_id, bh.header_id;

