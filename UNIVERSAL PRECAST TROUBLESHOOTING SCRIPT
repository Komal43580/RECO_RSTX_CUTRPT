PROMPT =============================================================================
PROMPT 26. WEB HEADER TIMING / MISSING-BATCH DIAGNOSTIC
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Detect cases where a header/detail exists but no batch exists, and show
PROMPT   header/detail creation timing.
PROMPT
PROMPT EXPECTATION:
PROMPT   If transaction detail was created after the original header submission,
PROMPT   timing may explain why export had no detail.
PROMPT
PROMPT CAUTION:
PROMPT   Do not infer root cause from TRANSACTION_DATE alone.
PROMPT =============================================================================

SELECT
    h.header_id,
    t.transaction_id,
    t.pcf_id,
    t.mark_number,
    t.quantity,
    h.transaction_type,
    h.transaction_status,
    h.ebs_status,
    h.lot_number,
    h.transaction_date,
    h.creation_date AS header_created,
    h.status_date,
    h.posted_date,
    h.last_update_date AS header_updated,
    t.creation_date AS transaction_created,
    t.last_update_date AS transaction_updated,
    CASE
        WHEN EXISTS
             (
                 SELECT 1
                 FROM prec_batch_headers@RECOWEBPROD bh
                 WHERE bh.header_id = h.header_id
             )
        THEN 'BATCH EXISTS'
        ELSE 'NO BATCH'
    END AS batch_status
FROM prec_transactions@RECOWEBPROD t
JOIN prec_trans_header@RECOWEBPROD h
  ON h.header_id = t.header_id
JOIN prec_pcf@RECOWEBPROD p
  ON p.pcf_id = t.pcf_id
WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.project_number = '&&P_PROJECT_NUMBER')
  AND ('&&P_TASK_NUMBER' IS NULL OR p.task_number = '&&P_TASK_NUMBER')
  AND ('&&P_PCF_ID' IS NULL OR t.pcf_id = TO_NUMBER('&&P_PCF_ID'))
  AND ('&&P_MARK_NUMBER' IS NULL OR t.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
  AND ('&&P_HEADER_ID' IS NULL OR h.header_id = TO_NUMBER('&&P_HEADER_ID'))
  AND ('&&P_TRANSACTION_ID' IS NULL OR t.transaction_id = TO_NUMBER('&&P_TRANSACTION_ID'))
ORDER BY h.transaction_date, h.header_id, t.transaction_id;


