PROMPT =============================================================================
PROMPT 22. PA INTERFACE - PENDING / REJECTED PRODUCTION
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Find production transactions that have not yet imported to PA.
PROMPT
PROMPT EXPECTATION:
PROMPT   TRANSACTION_STATUS_CODE = P usually means pending.
PROMPT   Rejection code populated means import problem.
PROMPT =============================================================================

SELECT
    i.transaction_source,
    i.batch_name,
    i.project_number,
    i.task_number,
    i.expenditure_type,
    i.expenditure_item_date,
    i.quantity,
    i.raw_cost,
    i.transaction_status_code,
    i.transaction_rejection_code,
    i.orig_transaction_reference,
    i.attribute2 AS production_tnum,
    i.attribute3 AS pcf_id,
    i.attribute4 AS revision_number,
    i.attribute5 AS vendor,
    i.attribute6 AS period_classification,
    i.unmatched_negative_txn_flag,
    i.expenditure_item_id,
    i.project_id,
    i.task_id,
    i.txn_interface_id,
    i.creation_date,
    i.last_update_date
FROM apps.pa_transaction_interface_all i
WHERE ('&&P_PROJECT_NUMBER' IS NULL OR i.project_number = '&&P_PROJECT_NUMBER')
  AND ('&&P_TASK_NUMBER' IS NULL OR i.task_number = '&&P_TASK_NUMBER')
  AND ('&&P_PCF_ID' IS NULL OR i.attribute3 = '&&P_PCF_ID')
  AND ('&&P_REVISION' IS NULL OR i.attribute4 = '&&P_REVISION')
  AND ('&&P_TNUM' IS NULL OR i.attribute2 = '&&P_TNUM'
                                  OR i.orig_transaction_reference = '&&P_TNUM')
  AND i.expenditure_type LIKE 'PRECAST%'
ORDER BY i.creation_date, i.txn_interface_id;


