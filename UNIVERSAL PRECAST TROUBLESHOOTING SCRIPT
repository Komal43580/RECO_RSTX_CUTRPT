WITH filtered_pcf AS
(
    SELECT DISTINCT
        p.pcf_id
    FROM prec_pcf@RECOWEBPROD p
    WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.project_number = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR p.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR p.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR p.product_code = '&&P_PRODUCT_CODE')
      AND ('&&P_REVISION' IS NULL OR p.revision_number = TO_NUMBER('&&P_REVISION'))
)
SELECT
    h.header_id,
    t.transaction_id,
    t.pcf_id,
    t.mark_number,
    t.related_transaction_id,
    t.quantity,
    t.qty_standard,
    t.qty_overage,
    t.qty_paid_over,
    t.qty_shipped,
    h.transaction_date,
    h.transaction_type,
    h.transaction_status,
    h.ebs_status,
    h.lot_number,
    h.reco_lot_id,
    h.old_lot_id,
    h.related_header_id,
    h.primary_pcf_id,
    h.from_revision,
    h.to_revision,
    t.creation_date AS trans_creation_date,
    t.last_update_date AS trans_last_update,
    t.created_by AS trans_created_by,
    t.last_updated_by AS trans_last_updated_by,
    h.creation_date AS header_creation_date,
    h.last_update_date AS header_last_update,
    h.status_date,
    h.posted_date,
    h.created_by AS header_created_by,
    h.last_updated_by AS header_last_updated_by
FROM filtered_pcf fp
JOIN prec_transactions@RECOWEBPROD t
  ON t.pcf_id = fp.pcf_id
JOIN prec_trans_header@RECOWEBPROD h
  ON h.header_id = t.header_id
WHERE ('&&P_MARK_NUMBER' IS NULL OR t.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
  AND ('&&P_HEADER_ID' IS NULL OR h.header_id = TO_NUMBER('&&P_HEADER_ID'))
  AND ('&&P_TRANSACTION_ID' IS NULL OR t.transaction_id = TO_NUMBER('&&P_TRANSACTION_ID'))
  AND ('&&P_LOT_NUMBER' IS NULL OR h.lot_number = '&&P_LOT_NUMBER')
ORDER BY h.transaction_date, h.header_id, t.transaction_id;


