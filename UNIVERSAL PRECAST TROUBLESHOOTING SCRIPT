PROMPT
PROMPT =============================================================================
PROMPT 15. TRANSFER PAIR CHECK
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   For transaction type T, identify BOTH sides of the transfer.
PROMPT
PROMPT EXPECTATION:
PROMPT   Related transactions should normally offset each other.
PROMPT
PROMPT IMPORTANT:
PROMPT   A transfer can cross PCFs and even projects.
PROMPT =============================================================================

SELECT
    t1.transaction_id AS transaction_id_1,
    t1.header_id AS header_id_1,
    p1.project_number AS project_1,
    p1.task_number AS task_1,
    t1.pcf_id AS pcf_1,
    t1.mark_number AS mark_1,
    t1.quantity AS qty_1,
    h1.lot_number AS lot_1,
    h1.transaction_date AS date_1,
    t1.related_transaction_id,
    t2.transaction_id AS transaction_id_2,
    t2.header_id AS header_id_2,
    p2.project_number AS project_2,
    p2.task_number AS task_2,
    t2.pcf_id AS pcf_2,
    t2.mark_number AS mark_2,
    t2.quantity AS qty_2,
    h2.lot_number AS lot_2,
    h2.transaction_date AS date_2,
    NVL(t1.quantity,0)+NVL(t2.quantity,0) AS pair_net_qty
FROM prec_transactions@RECOWEBPROD t1
JOIN prec_trans_header@RECOWEBPROD h1
  ON h1.header_id = t1.header_id
JOIN prec_pcf@RECOWEBPROD p1
  ON p1.pcf_id = t1.pcf_id
LEFT JOIN prec_transactions@RECOWEBPROD t2
  ON t2.transaction_id = t1.related_transaction_id
LEFT JOIN prec_trans_header@RECOWEBPROD h2
  ON h2.header_id = t2.header_id
LEFT JOIN prec_pcf@RECOWEBPROD p2
  ON p2.pcf_id = t2.pcf_id
WHERE h1.transaction_type = 'T'
  AND ('&&P_PROJECT_NUMBER' IS NULL OR p1.project_number = '&&P_PROJECT_NUMBER'
                                  OR p2.project_number = '&&P_PROJECT_NUMBER')
  AND ('&&P_TASK_NUMBER' IS NULL OR p1.task_number = '&&P_TASK_NUMBER'
                                  OR p2.task_number = '&&P_TASK_NUMBER')
  AND ('&&P_PCF_ID' IS NULL OR t1.pcf_id = TO_NUMBER('&&P_PCF_ID')
                                  OR t2.pcf_id = TO_NUMBER('&&P_PCF_ID'))
  AND ('&&P_MARK_NUMBER' IS NULL OR t1.mark_number = TO_NUMBER('&&P_MARK_NUMBER')
                                  OR t2.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
  AND ('&&P_TRANSACTION_ID' IS NULL OR t1.transaction_id = TO_NUMBER('&&P_TRANSACTION_ID')
                                  OR t2.transaction_id = TO_NUMBER('&&P_TRANSACTION_ID'))
  AND ('&&P_HEADER_ID' IS NULL OR t1.header_id = TO_NUMBER('&&P_HEADER_ID')
                                  OR t2.header_id = TO_NUMBER('&&P_HEADER_ID'))
ORDER BY h1.transaction_date, t1.transaction_id;

