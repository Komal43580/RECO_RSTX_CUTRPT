PROMPT =============================================================================
PROMPT 3. MASTER THREE-WAY RECONCILIATION
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Establish the 3 critical totals in one place:
PROMPT       Web Physical Production
PROMPT       Oracle Physical Production
PROMPT       Job Cost / PA Production
PROMPT
PROMPT EXPECTATION / DECISION:
PROMPT   Web = Oracle = Job Cost
PROMPT       -> no system quantity variance.
PROMPT
PROMPT   Web != Oracle, but Oracle = Job Cost
PROMPT       -> investigate Web -> batch -> outbound -> Oracle import.
PROMPT
PROMPT   Web = Oracle, but Job Cost differs
PROMPT       -> investigate billing / PA / Cost Distribution.
PROMPT
PROMPT   Oracle > Job Cost
PROMPT       -> could be overage; run Section 6 before changing anything.
PROMPT =============================================================================

WITH filtered_pcf AS
(
    SELECT DISTINCT
        v.project_num,
        v.project_id,
        v.task_number,
        v.task_id,
        v.pcf_id,
        c.revision_number AS current_revision,
        w.product_code,
        w.unit_of_measure,
        v.expenditure_type,
        v.unit_price
    FROM reco.reco_pcf_v v
    JOIN reco.reco_pcf_current c
      ON c.pcf_id = v.pcf_id
    LEFT JOIN prec_pcf@RECOWEBPROD w
      ON w.pcf_id = v.pcf_id
     AND w.revision_number = c.revision_number
    WHERE v.revision_number = c.revision_number
      AND ('&&P_PROJECT_NUMBER' IS NULL OR v.project_num = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR v.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR v.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR w.product_code = '&&P_PRODUCT_CODE')
),
web_totals AS
(
    SELECT
        t.pcf_id,
        ROUND(SUM(
            CASE
                WHEN fp.product_code IN ('COP','HFC','PAR','TRB')
                    THEN NVL(t.quantity,0) * NVL(pp.width,0)
                ELSE NVL(t.quantity,0) * NVL(pp.area_per_piece,0)
            END
        ),2) AS web_physical
    FROM filtered_pcf fp
    JOIN prec_transactions@RECOWEBPROD t
      ON t.pcf_id = fp.pcf_id
    JOIN prec_trans_header@RECOWEBPROD h
      ON h.header_id = t.header_id
    JOIN prec_pcf_panels@RECOWEBPROD pp
      ON pp.pcf_id = t.pcf_id
     AND pp.mark_number = t.mark_number
    GROUP BY t.pcf_id
),
oracle_totals AS
(
    SELECT
        pv.pcf_id,
        ROUND(SUM(NVL(pv.area_total,
                      NVL(pv.quantity_produced,0) * NVL(pv.area_per_piece,0))),2) AS oracle_physical
    FROM filtered_pcf fp
    JOIN reco.reco_production_v pv
      ON pv.pcf_id = fp.pcf_id
    GROUP BY pv.pcf_id
),
jobcost_totals AS
(
    SELECT
        TO_NUMBER(pe.pcf_id) AS pcf_id,
        ROUND(SUM(NVL(pe.quantity,0)),2) AS jobcost_qty,
        ROUND(SUM(NVL(pe.denom_raw_cost,0)),2) AS jobcost_raw_cost
    FROM filtered_pcf fp
    JOIN reco.reco_precast_expenditures pe
      ON pe.project_id = fp.project_id
     AND pe.task_id = fp.task_id
     AND pe.pcf_id = TO_CHAR(fp.pcf_id)
    WHERE pe.expenditure_type = fp.expenditure_type
    GROUP BY TO_NUMBER(pe.pcf_id)
)
SELECT
    fp.project_num,
    fp.task_number,
    fp.pcf_id,
    fp.current_revision,
    fp.product_code,
    fp.unit_of_measure,
    fp.expenditure_type,
    NVL(w.web_physical,0) AS web_physical,
    NVL(o.oracle_physical,0) AS oracle_physical,
    NVL(j.jobcost_qty,0) AS jobcost_qty,
    ROUND(NVL(w.web_physical,0) - NVL(o.oracle_physical,0),2) AS web_minus_oracle,
    ROUND(NVL(o.oracle_physical,0) - NVL(j.jobcost_qty,0),2) AS oracle_minus_jobcost,
    j.jobcost_raw_cost
FROM filtered_pcf fp
LEFT JOIN web_totals w
  ON w.pcf_id = fp.pcf_id
LEFT JOIN oracle_totals o
  ON o.pcf_id = fp.pcf_id
LEFT JOIN jobcost_totals j
  ON j.pcf_id = fp.pcf_id
ORDER BY fp.task_number, fp.pcf_id;


