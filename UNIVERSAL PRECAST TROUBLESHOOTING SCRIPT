PROMPT =============================================================================
PROMPT 24. DUPLICATE LOT NUMBER CHECK
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Detect the historical pattern where a second Web header cannot import
PROMPT   because Oracle already has the same lot number.
PROMPT
PROMPT EXPECTATION:
PROMPT   One business lot should normally map cleanly to one intended header.
PROMPT =============================================================================

WITH selected_lots AS
(
    SELECT DISTINCT
        t.pcf_id,
        h.lot_number
    FROM prec_transactions@RECOWEBPROD t
    JOIN prec_trans_header@RECOWEBPROD h
      ON h.header_id = t.header_id
    JOIN prec_pcf@RECOWEBPROD p
      ON p.pcf_id = t.pcf_id
    WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.project_number = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER'    IS NULL OR p.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID'         IS NULL OR t.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE'   IS NULL OR p.product_code = '&&P_PRODUCT_CODE')
      AND ('&&P_LOT_NUMBER'     IS NULL OR h.lot_number = '&&P_LOT_NUMBER')
      AND h.lot_number IS NOT NULL
)
SELECT
    sl.pcf_id,
    sl.lot_number,
    COUNT(DISTINCT h.header_id) AS web_header_count,
    COUNT(DISTINCT l.lot_id) AS oracle_lot_count
FROM selected_lots sl
LEFT JOIN prec_transactions@RECOWEBPROD t
  ON t.pcf_id = sl.pcf_id
LEFT JOIN prec_trans_header@RECOWEBPROD h
  ON h.header_id = t.header_id
 AND h.lot_number = sl.lot_number
LEFT JOIN reco.reco_lot_numbers l
  ON l.pcf_id = sl.pcf_id
 AND l.lot_number = sl.lot_number
GROUP BY sl.pcf_id, sl.lot_number
HAVING COUNT(DISTINCT h.header_id) > 1
    OR COUNT(DISTINCT l.lot_id) > 1
ORDER BY sl.pcf_id, sl.lot_number;


