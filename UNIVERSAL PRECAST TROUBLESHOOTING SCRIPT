PROMPT =============================================================================
PROMPT 7. OVERAGE / SHORT SUMMARY BY PCF
PROMPT =============================================================================
PROMPT EXPECTATION:
PROMPT   STANDARD BILLABLE APPROXIMATION =
PROMPT       REQUIRED AREA - SHORT REQUIRED AREA
PROMPT
PROMPT   PHYSICAL PRODUCTION APPROXIMATION =
PROMPT       STANDARD BILLABLE + OVERAGE
PROMPT
PROMPT This was the pattern proven on PCF 175829.
PROMPT =============================================================================

WITH filtered_pcf AS
(
    SELECT DISTINCT
        v.pcf_id,
        w.product_code
    FROM reco.reco_pcf_v v
    JOIN reco.reco_pcf_current c
      ON c.pcf_id = v.pcf_id
    LEFT JOIN prec_pcf@RECOWEBPROD w
      ON w.pcf_id = v.pcf_id
     AND w.revision_number = c.revision_number
    WHERE v.revision_number = c.revision_number
      AND ('&&P_PROJECT_NUMBER' IS NULL OR v.project_num = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR v.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR v.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR w.product_code = '&&P_PRODUCT_CODE')
),
req AS
(
    SELECT
        fp.pcf_id,
        pp.mark_number,
        CASE
            WHEN fp.product_code IN ('COP','HFC','PAR','TRB')
                THEN NVL(pp.quantity_required,0) * NVL(pp.width,0)
            ELSE NVL(pp.quantity_required,0) * NVL(pp.area_per_piece,0)
        END AS required_area
    FROM filtered_pcf fp
    JOIN prec_pcf_panels@RECOWEBPROD pp
      ON pp.pcf_id = fp.pcf_id
),
prd AS
(
    SELECT
        pv.pcf_id,
        pv.mark_number,
        SUM(NVL(pv.area_total,
                NVL(pv.quantity_produced,0) * NVL(pv.area_per_piece,0))) AS produced_area
    FROM filtered_pcf fp
    JOIN reco.reco_production_v pv
      ON pv.pcf_id = fp.pcf_id
    GROUP BY pv.pcf_id, pv.mark_number
),
x AS
(
    SELECT
        r.pcf_id,
        r.mark_number,
        r.required_area,
        NVL(p.produced_area,0) AS produced_area,
        GREATEST(NVL(p.produced_area,0)-r.required_area,0) AS overage_area,
        GREATEST(r.required_area-NVL(p.produced_area,0),0) AS short_area
    FROM req r
    LEFT JOIN prd p
      ON p.pcf_id = r.pcf_id
     AND p.mark_number = r.mark_number
)
SELECT
    pcf_id,
    ROUND(SUM(required_area),2) AS required_area,
    ROUND(SUM(short_area),2) AS short_required_area,
    ROUND(SUM(required_area)-SUM(short_area),2) AS standard_billable_estimate,
    ROUND(SUM(overage_area),2) AS overage_area,
    ROUND(SUM(produced_area),2) AS physical_production
FROM x
GROUP BY pcf_id
ORDER BY pcf_id;


