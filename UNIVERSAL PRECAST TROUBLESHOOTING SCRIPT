  AND ('&&P_LOT_ID' IS NULL OR b.lot_id = TO_NUMBER('&&P_LOT_ID'))
  AND ('&&P_TNUM' IS NULL OR b.tnum = '&&P_TNUM')
ORDER BY b.lot_date, b.lot_id, b.tnum;


