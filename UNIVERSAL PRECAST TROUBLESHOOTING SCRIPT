WITH valid_headers AS
(
    SELECT DISTINCT t.header_id
    FROM prec_transactions@RECOWEBPROD t
    JOIN prec_pcf@RECOWEBPROD p
      ON p.pcf_id = t.pcf_id
    WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.project_number = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR p.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR t.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR p.product_code = '&&P_PRODUCT_CODE')
      AND ('&&P_MARK_NUMBER' IS NULL OR t.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
      AND ('&&P_HEADER_ID' IS NULL OR t.header_id = TO_NUMBER('&&P_HEADER_ID'))
      AND ('&&P_TRANSACTION_ID' IS NULL OR t.transaction_id = TO_NUMBER('&&P_TRANSACTION_ID'))
)
SELECT
    bt.batch_id,
    bt.header_id,
    bt.transaction_id,
    bt.mark_number,
    bt.quantity,
    bt.qty_standard,
    bt.qty_overage,
    bt.qty_paid_over,
    bt.qty_shipped
FROM valid_headers vh
JOIN prec_batch_transactions@RECOWEBPROD bt
  ON bt.header_id = vh.header_id
WHERE ('&&P_BATCH_ID' IS NULL OR bt.batch_id = TO_NUMBER('&&P_BATCH_ID'))
  AND ('&&P_TRANSACTION_ID' IS NULL OR bt.transaction_id = TO_NUMBER('&&P_TRANSACTION_ID'))
  AND ('&&P_MARK_NUMBER' IS NULL OR bt.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
ORDER BY bt.batch_id, bt.header_id, bt.transaction_id;

