PROMPT =============================================================================
PROMPT 2. IDENTIFY THE EXACT PCF(S)
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Confirm project/task/PCF/revision/product before investigating totals.
PROMPT
PROMPT EXPECTATION:
PROMPT   - PCF should belong to the project/task the user reported.
PROMPT   - Current revision comes from RECO_PCF_CURRENT.
PROMPT   - PRODUCT_CODE comes from Precast Web.
PROMPT
PROMPT IF WRONG:
PROMPT   Stop. Do not troubleshoot the wrong PCF.
PROMPT =============================================================================

WITH ebs_pcf AS
(
    SELECT
        v.project_num,
        v.project_id,
        v.project_name,
        v.task_number,
        v.task_id,
        v.task_name,
        v.pcf_id,
        v.revision_number,
        v.description,
        v.expenditure_type,
        v.unit_price,
        v.vendor_id,
        v.vendor_site_id,
        v.vendor_name,
        v.vendor_site_code,
        v.pcf_type,
        v.project_status,
        v.distribution_rule
    FROM reco.reco_pcf_v v
    WHERE ('&&P_PROJECT_NUMBER' IS NULL OR v.project_num = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR v.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR v.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_REVISION' IS NULL OR v.revision_number = TO_NUMBER('&&P_REVISION'))
),
web_pcf AS
(
    SELECT
        p.pcf_id,
        p.revision_number,
        p.project_number,
        p.task_number,
        p.product_code,
        p.unit_of_measure,
        p.expenditure_type,
        p.unit_price,
        p.description,
        p.pcf_type,
        p.job_status,
        p.close_date
    FROM prec_pcf@RECOWEBPROD p
    WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.project_number = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR p.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR p.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR p.product_code = '&&P_PRODUCT_CODE')
      AND ('&&P_REVISION' IS NULL OR p.revision_number = TO_NUMBER('&&P_REVISION'))
)
SELECT
    e.project_num,
    e.project_id,
    e.project_name,
    e.task_number,
    e.task_id,
    e.pcf_id,
    e.revision_number AS ebs_revision,
    c.revision_number AS current_revision,
    w.revision_number AS web_revision,
    w.product_code,
    w.unit_of_measure,
    e.expenditure_type,
    e.unit_price AS ebs_unit_price,
    w.unit_price AS web_unit_price,
    e.description,
    e.pcf_type,
    e.project_status,
    e.distribution_rule
FROM ebs_pcf e
LEFT JOIN reco.reco_pcf_current c
  ON c.pcf_id = e.pcf_id
LEFT JOIN web_pcf w
  ON w.pcf_id = e.pcf_id
 AND w.revision_number = e.revision_number
ORDER BY e.task_number, e.pcf_id, e.revision_number;

