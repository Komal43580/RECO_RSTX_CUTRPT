PROMPT =============================================================================
PROMPT 23. TASK BILLABILITY / READY-TO-BILL CHECK
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Useful when PA items exist but revenue/job-cost downstream behavior is
PROMPT   unexpected.
PROMPT
PROMPT EXPECTATION:
PROMPT   Review child and parent chain.
PROMPT   READY_TO_BILL_FLAG / READY_TO_DISTRIBUTE_FLAG / BILLABLE_FLAG matter.
PROMPT =============================================================================

SELECT
    p.segment1 AS project_number,
    pt.task_id,
    pt.task_number,
    pt.task_name,
    pt.wbs_level,
    pt.parent_task_id,
    pt.top_task_id,
    pt.ready_to_bill_flag,
    pt.ready_to_distribute_flag,
    pt.billable_flag,
    pt.chargeable_flag,
    pt.start_date,
    pt.completion_date
FROM apps.pa_projects_all p
JOIN apps.pa_tasks pt
  ON pt.project_id = p.project_id
WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.segment1 = '&&P_PROJECT_NUMBER')
  AND (
        '&&P_TASK_NUMBER' IS NULL
        OR pt.task_number = '&&P_TASK_NUMBER'
        OR pt.task_id IN
           (
               SELECT x.parent_task_id
               FROM apps.pa_tasks x
               WHERE x.project_id = p.project_id
                 AND x.task_number = '&&P_TASK_NUMBER'
           )
        OR pt.task_id IN
           (
               SELECT x.top_task_id
               FROM apps.pa_tasks x
               WHERE x.project_id = p.project_id
                 AND x.task_number = '&&P_TASK_NUMBER'
           )
      )
ORDER BY pt.wbs_level, pt.task_number;

