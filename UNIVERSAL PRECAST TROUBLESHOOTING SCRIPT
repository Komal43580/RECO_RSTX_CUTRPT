      AND ('&&P_PCF_ID' IS NULL OR l.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_LOT_ID' IS NULL OR l.lot_id = TO_NUMBER('&&P_LOT_ID'))
      AND ('&&P_LOT_NUMBER' IS NULL OR l.lot_number = '&&P_LOT_NUMBER')
)
SELECT
