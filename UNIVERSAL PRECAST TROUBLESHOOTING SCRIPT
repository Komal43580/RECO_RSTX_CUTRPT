PROMPT =============================================================================
PROMPT 9. WEB VS ORACLE BY MARK
PROMPT =============================================================================
PROMPT PURPOSE:
PROMPT   Highest-value isolation query for Web -> Oracle differences.
PROMPT
PROMPT EXPECTATION:
PROMPT   Only marks with a difference are displayed.
PROMPT   Once a mark is shown, put that mark into P_MARK_NUMBER and rerun Sections
PROMPT   8-14 to isolate the exact transaction / lot.
PROMPT =============================================================================

WITH filtered_pcf AS
(
    SELECT DISTINCT
        p.pcf_id,
        p.product_code
    FROM prec_pcf@RECOWEBPROD p
    WHERE ('&&P_PROJECT_NUMBER' IS NULL OR p.project_number = '&&P_PROJECT_NUMBER')
      AND ('&&P_TASK_NUMBER' IS NULL OR p.task_number = '&&P_TASK_NUMBER')
      AND ('&&P_PCF_ID' IS NULL OR p.pcf_id = TO_NUMBER('&&P_PCF_ID'))
      AND ('&&P_PRODUCT_CODE' IS NULL OR p.product_code = '&&P_PRODUCT_CODE')
),
web_prod AS
(
    SELECT
        fp.pcf_id,
        t.mark_number,
        SUM(t.quantity) AS web_qty,
        SUM(
            CASE
                WHEN fp.product_code IN ('COP','HFC','PAR','TRB')
                    THEN NVL(t.quantity,0) * NVL(pp.width,0)
                ELSE NVL(t.quantity,0) * NVL(pp.area_per_piece,0)
            END
        ) AS web_area
    FROM filtered_pcf fp
    JOIN prec_transactions@RECOWEBPROD t
      ON t.pcf_id = fp.pcf_id
    JOIN prec_trans_header@RECOWEBPROD h
      ON h.header_id = t.header_id
    JOIN prec_pcf_panels@RECOWEBPROD pp
      ON pp.pcf_id = t.pcf_id
     AND pp.mark_number = t.mark_number
    WHERE ('&&P_MARK_NUMBER' IS NULL OR t.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
    GROUP BY fp.pcf_id, t.mark_number
),
oracle_prod AS
(
    SELECT
        pv.pcf_id,
        pv.mark_number,
        SUM(pv.quantity_produced) AS oracle_qty,
        SUM(NVL(pv.area_total,
                NVL(pv.quantity_produced,0)*NVL(pv.area_per_piece,0))) AS oracle_area
    FROM filtered_pcf fp
    JOIN reco.reco_production_v pv
      ON pv.pcf_id = fp.pcf_id
    WHERE ('&&P_MARK_NUMBER' IS NULL OR pv.mark_number = TO_NUMBER('&&P_MARK_NUMBER'))
    GROUP BY pv.pcf_id, pv.mark_number
)
SELECT
    NVL(w.pcf_id,o.pcf_id) AS pcf_id,
    NVL(w.mark_number,o.mark_number) AS mark_number,
    NVL(w.web_qty,0) AS web_qty,
    NVL(o.oracle_qty,0) AS oracle_qty,
    NVL(w.web_qty,0)-NVL(o.oracle_qty,0) AS qty_difference,
    ROUND(NVL(w.web_area,0),2) AS web_area,
    ROUND(NVL(o.oracle_area,0),2) AS oracle_area,
    ROUND(NVL(w.web_area,0)-NVL(o.oracle_area,0),2) AS area_difference
FROM web_prod w
FULL OUTER JOIN oracle_prod o
  ON o.pcf_id = w.pcf_id
 AND o.mark_number = w.mark_number
WHERE ABS(NVL(w.web_qty,0)-NVL(o.oracle_qty,0)) > 0.00001
   OR ABS(NVL(w.web_area,0)-NVL(o.oracle_area,0)) > 0.005
ORDER BY NVL(w.pcf_id,o.pcf_id), NVL(w.mark_number,o.mark_number);


