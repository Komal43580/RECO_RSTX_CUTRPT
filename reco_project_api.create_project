    FUNCTION getTemplateId(pProjectId IN NUMBER, pRetStatus OUT VARCHAR2) RETURN NUMBER IS
        CURSOR cTemplate IS
        SELECT created_from_project_id
        FROM pa_projects
        WHERE project_id = pProjectId;
        
        lTemplateId     NUMBER;
    BEGIN
        OPEN cTemplate;
        FETCH cTemplate INTO lTemplateId;
        CLOSE cTemplate;
        
        IF NVL(lTemplateId , -1) NOT IN (G_UP_TEMPLATE_ID, G_LS_TEMPLATE_ID) THEN
            SELECT DECODE(project_type, 'CONTRACT - UNIT PRIC', G_UP_TEMPLATE_ID, 'CONTRACT - LUMP SUM',  G_LS_TEMPLATE_ID)
            INTO lTemplateId
            FROM pa_projects 
            WHERE project_id = pProjectId;
        END IF;
        
        RETURN lTemplateId;
    EXCEPTION 
        WHEN others THEN
            pRetStatus := 'E';
            RETURN NULL;
    END getTemplateId;
