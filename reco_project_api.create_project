    FUNCTION getExpType(pTopTask IN VARCHAR2, pTaskNum IN VARCHAR2, pWallNum IN VARCHAR2,  pUOM IN VARCHAR2) RETURN VARCHAR2 IS
        lExpType    VARCHAR2(250);
    BEGIN
        lExpType := NULL;
        
        SELECT expenditure_type
        INTO lExpType
        FROM pa_expenditure_types
        WHERE REPLACE(REPLACE(DECODE(G_Org_id, 0, attribute2, 293, attribute4), '<TASKNUM>', pTopTask), '<WALLNUM>', pWallNum) = pTaskNum
        --REPLACE(REPLACE(attribute2, '<TASKNUM>', pTopTask), '<WALLNUM>', pWallNum) = pTaskNum
        AND (unit_of_measure = pUOM OR (unit_of_measure IN ('HOURS', 'HOUR', 'HR') AND pUOM= 'HOURS'));
        
        RETURN lExpType;
    EXCEPTION
        WHEN no_data_found THEN
            --write_log(G_log_type, 'Exp Type not found: '||pTopTask||','||pTaskNum||','||pWallNum||', '||pUOM);
            RETURN NULL;
        WHEN others THEN
            write_log(G_log_type, 'Err in getExpType: '||sqlerrm);
            write_log(G_log_type, 'Err in getExpType: '||pTopTask||','||pTaskNum||','||pWallNum||', '||pUOM);
            RETURN NULL;
    END getExpType;
