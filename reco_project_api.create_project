    PROCEDURE populate_bill_rate(
        errbuf              OUT VARCHAR2, 
        retcode             OUT NUMBER,
        pProjectId          IN  number
        ) IS   
          
        l_bill_rate_id      number;
        l_bill_rate         number;    
        l_bdgt_rate         number;
        l_bill_rate_round   number;  
        l_budget_version_id number;
        l_bill_type         varchar2(5);
        l_start_date        date;
        bill_rate_found     BOOLEAN;
        idx                 number;
        
        CURSOR budgetRate IS
        SELECT p.segment1, p.start_date proj_start_date, t.task_number, ra.expenditure_type, bl.txn_bill_rate_override bill_rate, 
                bl.quantity, bl.revenue, t.task_id, t.top_task_id, bv.project_id,bl.revenue/bl.txn_bill_rate_override, bv.baselined_date, version_name
        FROM apps.pa_budget_versions bv, apps.pa_budget_lines bl, apps.pa_resource_assignments ra, apps.pa_tasks T, pa_projects P
        WHERE bv.budget_version_id = bl.budget_version_id
        AND bl.resource_assignment_id = ra.resource_assignment_id
        AND t.task_id = ra.task_id
        AND p.project_id = bv.project_id
        AND bv.budget_version_id = l_budget_version_id 
        AND bl.revenue <> 0;       
        
        
        TYPE BILLRATE_REC_TYPE IS record(
            proj_num    varchar2(15),
            proj_date   date,
            task_num    VARCHAR2(25),
            bill_type   varchar2(5),
            exp_type    varchar2(50),
            bdgt_name   varchar2(50),
            bdgt_date   date,
            bdgt_qty    number,
            bdgt_rev    number,
            bdgt_rate   number,
            old_rate    number,
            new_rate    number,
            start_date  date,
            end_date    date,
            message     VARCHAR2(500)
        );  
              
        TYPE BILLRATE_TBL_TYPE IS TABLE OF BILLRATE_REC_TYPE INDEX BY BINARY_INTEGER;
        
        l_rate_tbl  BILLRATE_TBL_TYPE; 
        
        INVALID_PARAMETER   EXCEPTION;
        BUDGET_NOT_FOUND    EXCEPTION;   
               
    BEGIN
        G_log_type := 'LOG';
        write_log(G_log_type, 'Begin reco_project_api.populate_bill_rate; project-id: '||pProjectId);
        errbuf := G_CONC_PROG_SUCC_MSG;
        retcode := G_CONC_PROG_SUCC_CODE;
        initialize_global_vars;
                 
        IF pProjectId IS NULL THEN
            write_log(G_log_type, 'pProjectIs is null; exception: invalid_parameter');
            RAISE INVALID_PARAMETER;
        END IF;
                
        --get the current baselineversionid
        l_budget_version_id := NULL;
        BEGIN   
            SELECT budget_version_id 
            INTO l_budget_version_id 
            FROM pa_budget_versions
            WHERE project_id = pProjectId
            AND budget_status_code = 'B'
            AND current_flag = 'Y';             
        EXCEPTION
            WHEN no_data_found THEN
                RAISE BUDGET_NOT_FOUND;
        END;
        write_log(G_log_type, 'l_budget_version_id: '||l_budget_version_id);
        
        idx := 0;
        FOR cb IN budgetRate LOOP
        BEGIN
            write_log(G_log_type, 'bdgt-proj-num: '||cb.segment1);
            write_log(G_log_type, 'bdgt-task-num: '||cb.task_number);
            write_log(G_log_type, 'bdgt-exp-type: '||cb.expenditure_type);
            write_log(G_log_type, 'bdgt-bill-rate: '||cb.bill_rate);
            write_log(G_log_type, 'bdgt-baselined: '||cb.baselined_date);
        
            idx := idx +1;
            l_rate_tbl(idx).proj_num := cb.segment1;
            l_rate_tbl(idx).proj_date := cb.proj_start_date;
            l_rate_tbl(idx).task_num := cb.task_number;
            l_rate_tbl(idx).exp_type := cb.expenditure_type;
            l_rate_tbl(idx).bdgt_name := cb.version_name;
            l_rate_tbl(idx).bdgt_date := cb.baselined_date;
            l_rate_tbl(idx).bdgt_qty := cb.quantity;
            l_rate_tbl(idx).bdgt_rev := cb.revenue;
            l_rate_tbl(idx).bdgt_rate := cb.bill_rate;
            l_rate_tbl(idx).message := '';
            
            l_bill_rate_round := NULL;            

            SELECT DECODE(attribute1, 'Unit Price', 2, 'Lump Sum', 5, 3),
                DECODE(attribute1, 'Unit Price', 'UP', 'Lump Sum', 'LS', NULL)
            INTO l_bill_rate_round, l_bill_type
            FROM pa_tasks 
            WHERE task_id = cb.top_task_id;
            
            l_rate_tbl(idx).bill_type := l_bill_type;            
            l_bdgt_rate := ROUND(cb.bill_rate, l_bill_rate_round);
            
            -- check if active bill rate exists
            l_bill_rate_id := NULL;
            l_bill_rate := NULL;
            BEGIN
                SELECT nl_bill_rate_override_id, bill_rate --, LENGTH(bill_rate - FLOOR(bill_rate))-1
                INTO l_bill_rate_id, l_bill_rate --, l_bill_rate_round
                FROM APPS.pa_nl_bill_rate_overrides
                WHERE task_id = cb.task_id
                AND expenditure_type = cb.expenditure_type
                AND TRUNC(SYSDATE) BETWEEN TRUNC(start_date_active) AND TRUNC(NVL(end_date_active, SYSDATE))
                AND ROWNUM = 1
                ORDER BY start_date_active;
                
                bill_rate_found := TRUE;
            EXCEPTION
                WHEN no_data_found THEN
                    bill_rate_found := FALSE;                
            END;
    
            write_log(G_log_type,'l_bill_rate_id: '||l_bill_rate_id);
            write_log(G_log_type,'l_bill_rate: '||l_bill_rate);
            
            --if bill-rate does not exist, insert
            IF NOT bill_rate_found THEN
                write_log(G_log_type,'bill-rate not found; insert bill-rate');
                l_rate_tbl(idx).message := l_rate_tbl(idx).message||'bill-rate not found; insert bill-rate; ';
                
                BEGIN
                    SELECT GREATEST(NVL(MAX(end_date_active+1), cb.baselined_date), cb.baselined_date)
                    INTO l_start_date
                    FROM APPS.pa_nl_bill_rate_overrides
                    WHERE task_id = cb.task_id
                    AND expenditure_type = cb.expenditure_type; 
                EXCEPTION
                WHEN no_data_found THEN
                    l_start_date := cb.baselined_date ;           
                END;
                
                INSERT INTO apps.pa_nl_bill_rate_overrides (
                    nl_bill_rate_override_id,
                    expenditure_type,
                    task_id,
                    start_date_active,
                    bill_rate, --as per the table definition it is number(22, 5); rounds to 5 decimal places
                    rate_currency_code,
                    rate_disc_reason_code,
                    record_version_number,
                    creation_date,
                    created_by,
                    last_update_date,
                    last_updated_by,
                    last_update_login)
                VALUES(
                    apps.pa_nl_bill_rate_overrides_s.NEXTVAL,
                    cb.expenditure_type,
                    cb.task_id,
                    l_start_date, --cb.baselined_date,
                    l_bdgt_rate,
                    'USD',
                    'BUDGET',
                    1,
                    SYSDATE,
                    G_user_id,
                    SYSDATE,
                    G_user_id,
                    G_login_id);
                    
                l_rate_tbl(idx).old_rate := NULL;    
                l_rate_tbl(idx).new_rate := l_bdgt_rate;
                    
            ELSE
                -- bill rate found
                -- same rate then no updates
                -- different rate then end date existing one and insert new rate
                write_log(G_log_type,'bill-rate found; update-insert if different rate');
                
                IF (l_bill_rate = l_bdgt_rate) THEN
                    write_log(G_log_type,'same bill-rate; no action needed');
                    l_rate_tbl(idx).message := l_rate_tbl(idx).message||'same bill-rate; no action needed; ';                    
                    l_rate_tbl(idx).old_rate := l_bdgt_rate; --ROUND(cb.bill_rate, l_bill_rate_round); --cb.bill_rate;
                    l_rate_tbl(idx).new_rate := l_bill_rate;

                ELSE
                    write_log(G_log_type,'different bill-rate; update-insert');
                    l_rate_tbl(idx).message := l_rate_tbl(idx).message||'different bill-rate; end-date existing one; add new rate';
                    l_rate_tbl(idx).old_rate := l_bill_rate;
                    l_rate_tbl(idx).new_rate := l_bdgt_rate; --ROUND(cb.bill_rate, l_bill_rate_round); --cb.bill_rate;
                     
                    UPDATE apps.pa_nl_bill_rate_overrides
                    set end_date_active = GREATEST(start_date_active+1, cb.baselined_date-1),
                        last_updated_by = G_user_id,
                        last_update_date = SYSDATE,
                        last_update_login = G_login_id
                    WHERE nl_bill_rate_override_id = l_bill_rate_id;
                    
                    BEGIN
                        SELECT GREATEST(NVL(MAX(end_date_active+1), cb.baselined_date), cb.baselined_date)
                        INTO l_start_date
                        FROM APPS.pa_nl_bill_rate_overrides
                        WHERE task_id = cb.task_id
                        AND expenditure_type = cb.expenditure_type; 
                    EXCEPTION
                        WHEN no_data_found THEN
                            l_start_date := cb.baselined_date ;           
                        END;
                    
                    INSERT INTO apps.pa_nl_bill_rate_overrides (
                        nl_bill_rate_override_id,
                        expenditure_type,
                        task_id,
                        start_date_active,
                        bill_rate,
                        rate_currency_code,
                        rate_disc_reason_code,
                        record_version_number,
                        creation_date,
                        created_by,
                        last_update_date,
                        last_updated_by,
                        last_update_login)
                    VALUES(
                        apps.pa_nl_bill_rate_overrides_s.NEXTVAL,
                        cb.expenditure_type,
                        cb.task_id,
                        l_start_date, --cb.baselined_date,
                        l_bdgt_rate,
                        --ROUND(cb.bill_rate, l_bill_rate_round),                        
                        'USD',
                        'BUDGET',
                        1,
                        SYSDATE,
                        G_user_id,
                        SYSDATE,
                        G_user_id,
                        G_login_id);
                    
                END IF; 
            END IF;
            write_log(G_log_type,'----------------------');
        EXCEPTION
            WHEN others THEN
                l_rate_tbl(idx).message := 'Error: '||sqlerrm||': '||l_rate_tbl(idx).message; 
                write_log(G_log_type, 'Error: '||sqlerrm);
                retcode := G_CONC_PROG_WARN_CODE;  
                errbuf := G_CONC_PROG_WARN_MSG;  
        END;
        END LOOP;
        
        -- write output
        BEGIN 
            IF idx > 0 THEN
                write_log(G_log_type, 'Write the Output file');
                write_log('OUT', 'Project: '||l_rate_tbl(1).proj_num);
                write_log('OUT', 'Proj Start Date: '||l_rate_tbl(1).proj_date);
                write_log('OUT', 'Budget Version: '||l_rate_tbl(1).bdgt_name);
                write_log('OUT', 'Baselined Date: '||l_rate_tbl(1).bdgt_date);
                write_log('OUT', ' ');
                write_log('OUT', ' ');
                
                write_log('OUT', RPAD('-', 15, '-')||
                                 RPAD('-', 10, '-')||
                                 RPAD('-', 25, '-')||
                                 RPAD('-', 15, '-')||
                                 RPAD('-', 15, '-')||
                                 RPAD('-', 25, '-')||
                                 RPAD('-', 15, '-')||
                                 RPAD('-', 15, '-')||
                                 RPAD('-', 75, '-')); 
                     
                
                write_log('OUT', RPAD('Task', 15, ' ')||
                                 RPAD('Billing', 10, ' ')||
                                 RPAD('Exp Type', 25, ' ')||
                                 RPAD('Quantity', 15, ' ')||
                                 RPAD('Revenue', 15, ' ')||
                                 RPAD('Bdgt Rate', 25, ' ')||
                                 RPAD('Old Rate', 15, ' ')||
                                 RPAD('New Rate', 15, ' ')||
                                 RPAD('Message', 75, ' '));
                                 
                write_log('OUT', RPAD('-', 15, '-')||
                                 RPAD('-', 10, '-')||
                                 RPAD('-', 25, '-')||
                                 RPAD('-', 15, '-')||
                                 RPAD('-', 15, '-')||
                                 RPAD('-', 25, '-')||
                                 RPAD('-', 15, '-')||
                                 RPAD('-', 15, '-')||
                                 RPAD('-', 75, '-'));    
                                             
                FOR idx IN l_rate_tbl.first.. l_rate_tbl.last LOOP         
                    write_log('OUT', RPAD(l_rate_tbl(idx).task_num, 15, ' ')||
                                     RPAD(l_rate_tbl(idx).bill_type, 10, ' ')||
                                     RPAD(l_rate_tbl(idx).exp_type, 25, ' ')||
                                     RPAD(l_rate_tbl(idx).bdgt_qty, 15, ' ')||
                                     RPAD(l_rate_tbl(idx).bdgt_rev, 15, ' ')||
                                     RPAD(ROUND(l_rate_tbl(idx).bdgt_rate, 10), 25, ' ')||
                                     RPAD(NVL(l_rate_tbl(idx).old_rate, 0), 15, ' ')||
                                     RPAD(l_rate_tbl(idx).new_rate, 15, ' ')||
                                     RPAD(l_rate_tbl(idx).message, 150, ' ')
                    );
                END LOOP;
            ELSE
                write_log(G_log_type, 'No Output to display');
            END IF;
            
        EXCEPTION 
            WHEN others THEN
                write_log(G_log_type, 'Error in writing output: '||sqlerrm);
                retcode := G_CONC_PROG_WARN_CODE;  
                errbuf := G_CONC_PROG_WARN_MSG;   
        END;
        
        write_log(G_log_type, 'End reco_project_api.populate_bill_rate');
        fnd_file.CLOSE;
    EXCEPTION
        WHEN INVALID_PARAMETER THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;  
            write_log(G_log_type, 'Invalid parameter project-id: '||pProjectId);
            fnd_file.CLOSE;
            
        WHEN BUDGET_NOT_FOUND THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;  
            write_log(G_log_type, 'Unable to find Current Baselined budget for project-id: '||pProjectId);
            fnd_file.CLOSE;
            
        WHEN others THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;  
            write_log(G_log_type, 'Populate Bill Rate Error: '||sqlerrm);
            fnd_file.CLOSE;
    END populate_bill_rate;
