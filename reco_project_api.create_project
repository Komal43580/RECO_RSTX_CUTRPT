    FUNCTION getStructureId(pProductId IN NUMBER, pStructName IN VARCHAR2) RETURN NUMBER IS
        CURSOR takeOffStruct IS
        SELECT toff_struct_id
        FROM reco_toff_structs ts, reco_toff_jobs tj
        WHERE tj.product_id = pProductId
        AND tj.toff_job_id = ts.toff_job_id
        AND structure_name = pStructName;
        
