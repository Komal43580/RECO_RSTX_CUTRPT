    FUNCTION getContractAddrId(pRecoProjectId IN NUMBER, 
                               pAddrType IN VARCHAR2, 
                               pRetStatus OUT VARCHAR2) RETURN NUMBER IS
        lAddrId NUMBER;
        lAddrStatus CHAR(1);
    BEGIN
        write_log(G_log_type, 'In getContractAddrId; pRecoProjectId: '||pRecoProjectId||'; pAddrType: '||pAddrType);
        pRetStatus := 'S';
        
        SELECT address_id
        INTO lAddrId 
        FROM reco_contract_addresses 
        WHERE reco_project_id = pRecoProjectId
        AND address_type = pAddrType;
        
        write_log(G_log_type, 'getContractAddrId returns addrid: '||lAddrId);
        
        IF lAddrId < 0 THEN
            write_log(G_log_type, 'getContractAddrId address not synched ('||pAddrType||'): '||lAddrId);
            pRetStatus := 'E';
            RETURN -1; 
        END IF;
        
        SELECT status
        INTO lAddrStatus 
        FROM apps.hz_cust_acct_sites 
        WHERE cust_acct_site_id = lAddrId;
        
        IF lAddrStatus <> 'A' THEN
            write_log(G_log_type, 'getContractAddrId Inactive address ('||pAddrType||'): '||lAddrId);
            pRetStatus := 'E';
            RETURN -1; 
        END IF;       

        RETURN lAddrId;

    EXCEPTION
        WHEN others THEN
            write_log(G_log_type, 'Exception in getContractAddrId: '||sqlerrm);
            pRetStatus := 'E';
            RETURN -1;
    END getContractAddrId;
