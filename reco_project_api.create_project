    FUNCTION getProjectTemplateId(
            pRecoProjId     IN  VARCHAR2, 
            pProjType       OUT VARCHAR2, 
            pProjBilling    OUT VARCHAR2, 
            pRetStatus      OUT VARCHAR2) 
        RETURN NUMBER IS
        
        lContractAmt    NUMBER;
        lProjTemplateId NUMBER;
        
        CURSOR cProjTempl IS
        SELECT NVL(rct.contract_amount, 0) AS contract_amount, 
                DECODE(rct.project_type, 'U', G_UP_TEMPLATE_ID, G_LS_TEMPLATE_ID) AS project_template,
                DECODE(rct.project_type, 'U', 'UNIT PRICE', 'LUMP SUM') AS project_type,                
                CASE WHEN rct.invoice_on_prod = 'Y' AND rct.invoice_on_del = 'N' THEN 'ON PRODUCTION' 
                    WHEN rct.invoice_on_prod = 'Y' AND rct.invoice_on_del = 'Y' THEN 'ON PROD + FREIGHT'
                    WHEN rct.invoice_on_prod = 'N' AND rct.invoice_on_del = 'Y' THEN 'ON DELIVERY'
                    ELSE NULL
                END AS proj_billing
        FROM reco_contract_tasks rct
        WHERE reco_project_id = pRecoProjId
        --AND crm_status_code = 'Won'
        ORDER BY 1 DESC; 
    BEGIN
    
        write_log(G_log_type, 'In getProjectTemplateId; pRecoProjId: '||pRecoProjId);
        pRetStatus := 'S';
        
        OPEN cProjTempl; 
        FETCH cProjTempl INTO lContractAmt, lProjTemplateId, pProjType, pProjBilling;
        CLOSE cProjTempl; 
        
        write_log(G_log_type, 'getProjectTemplateId: project type: '||pProjType);
        write_log(G_log_type, 'getProjectTemplateId: project billing: '||pProjBilling);
        write_log(G_log_type, 'getProjectTemplateId: template id: '||lProjTemplateId);
        
        RETURN lProjTemplateId;
    EXCEPTION
        WHEN others THEN
            write_log(G_log_type, 'Exception in getProjectTemplateId: '||sqlerrm);
            pRetStatus := 'E';
            RETURN -1;
    END getProjectTemplateId;
