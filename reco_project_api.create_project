    PROCEDURE create_agreement(
        errbuf OUT VARCHAR2, 
        retcode OUT NUMBER,
        pProjNum IN VARCHAR2 
        --pAgreementId OUT NUMBER
        ) IS
        
        l_api_version_number        NUMBER :=1.0;
        l_commit                    VARCHAR2(1):= 'F';
        l_return_status             VARCHAR2(1);
        l_init_msg_list             VARCHAR2(1) := 'F';
        l_msg_count                 NUMBER;
        l_msg_data                  VARCHAR2(2000);
        l_data                      VARCHAR2(2000);
        l_msg_index                 NUMBER;
        l_msg_index_out             NUMBER;

        l_pm_funding_reference      VARCHAR2(25);
        
        l_agreement_in_rec          apps.pa_agreement_pub.agreement_rec_in_type;
        l_agreement_out_rec         apps.pa_agreement_pub.agreement_rec_out_type;
        l_funding_in_rec            apps.pa_agreement_pub.funding_rec_in_type;
        l_funding_in                apps.pa_agreement_pub.funding_in_tbl_type;
        l_funding_out_rec           apps.pa_agreement_pub.funding_rec_out_type;
        l_funding_out               apps.pa_agreement_pub.funding_out_tbl_type;
        
        l_project_id                NUMBER;
        l_agreement_reference       VARCHAR2(25);
        l_agreement_amount          NUMBER;
        l_description               VARCHAR2(240);
        l_agreement_type            VARCHAR2(30);
        l_customer_id               NUMBER;
        l_admin_id                  NUMBER;
        l_customer_num              VARCHAR2(30);
        indx                        NUMBER;
        l_agreement_num 			VARCHAR2(50);
        l_user_id                   NUMBER;
        l_responsibility_id         NUMBER;
         
        contractRec                 reco_contracts%ROWTYPE;
        
        INVALID_PARAMETER           EXCEPTION;
        API_ERROR                   EXCEPTION;
        RECO_PROJ_API_ERROR         EXCEPTION;
        INVALID_CONTRACT            EXCEPTION;
        INVALID_AGREEMENT           EXCEPTION;
        
        CURSOR contractInfo(pProjNum VARCHAR2) IS
        SELECT * FROM reco_contracts
        WHERE project_number = pProjNum
        AND org_id = G_org_id; --APK CA changes
        
        
        CURSOR contractTasks (pRecoProjId NUMBER) IS
        SELECT t.task_number, t.task_id AS top_task_id, ct.contract_amount 
        FROM reco_contract_tasks ct, reco_contracts rc,pa_projects P, pa_tasks T
        WHERE ct.reco_project_id = pRecoProjId
        AND ct.reco_project_id = rc.reco_project_id
        AND rc.project_number = p.segment1
        AND p.project_id = t.project_id
        AND ct.task_number = t.task_number
        AND ct.crm_status_code = 'Won'
        ORDER BY t.task_number;
        /*
        SELECT rtt.task_number, rtt.top_task_id, ct.contract_amount 
        FROM reco_contract_tasks ct, reco_top_tasks rtt
        WHERE ct.reco_project_id = pRecoProjId
        AND ct.reco_project_id = rtt.reco_project_id
        AND ct.product_id = rtt.product_id
        ORDER BY rtt.task_number; 
        */
        
    BEGIN
        G_log_type := 'LOG';
        write_log(G_log_type, 'Begin reco_project_api.create_agreement; pProjNum: '||pProjNum);
        errbuf := G_CONC_PROG_SUCC_MSG;
        retcode := G_CONC_PROG_SUCC_CODE;
        initialize_global_vars;
        
        write_log(G_log_type, 'Validate parameter');
        IF NOT validProject(pProjNum, l_project_id) THEN
            RAISE invalid_parameter;
        END IF;
        
        write_log(G_log_type, 'Get contract info');
        OPEN contractInfo(pProjNum);
        FETCH contractInfo INTO contractRec;
        CLOSE contractInfo;

        IF contractRec.contract_type IS NULL OR contractRec.po_number IS NULL THEN
            RAISE INVALID_AGREEMENT;
        END IF;  

        IF contractRec.contract_type IN ('P', 'R') THEN
            l_agreement_type := 'PURCHASE ORDER';
        ELSIF contractRec.contract_type = 'Q' THEN
            l_agreement_type := 'RECO QUOTATION CONTRACT';
        END IF;
        write_log(G_log_type, 'Agreement Type: '||l_agreement_type);
             
        l_agreement_reference   := SUBSTR(ltrim(rtrim(contractRec.po_number)), 1, 25);
        write_log(G_log_type, 'Agreement Ref: '||l_agreement_reference);
        
        l_agreement_num         := ltrim(rtrim(contractRec.po_number)); --||' DD '||TO_CHAR(contractRec.po_date, 'MM/DD/YYYY');
        write_log(G_log_type, 'Agreement Num: '||l_agreement_num);
        
        l_agreement_amount      := contractRec.contract_amount;
        l_description           := ltrim(rtrim(contractRec.project_number ||' - '||getAgreementDesc(contractRec.reco_project_id, l_return_status))); 
        write_log(G_log_type, 'Agreement Desc: '||l_description);
        IF l_return_status <> 'S' THEN
            RAISE RECO_PROJ_API_ERROR;
        END IF;
                
        l_customer_id := getProjCustomer(l_project_id, l_customer_num, l_return_status);
        IF l_return_status <> 'S' THEN
            RAISE RECO_PROJ_API_ERROR;
        END IF;
        write_log(G_log_type, 'Got the customer');
        
        l_admin_id  := getProjJCAdmin(l_project_id, l_return_status);
        IF l_return_status <> 'S' THEN
            RAISE RECO_PROJ_API_ERROR;
        END IF;
        write_log(G_log_type, 'Got the admin');
        
        l_agreement_in_rec.pm_agreement_reference       := l_agreement_reference;
        l_agreement_in_rec.customer_id                  := l_customer_id;
        l_agreement_in_rec.customer_num                 := l_customer_num;
        l_agreement_in_rec.agreement_num                := l_agreement_num;
        l_agreement_in_rec.agreement_type               := l_agreement_type;
        l_agreement_in_rec.amount                       := l_agreement_amount;
        l_agreement_in_rec.term_id                      := 1000;    --NET 30
        l_agreement_in_rec.owned_by_person_id           := l_admin_id;
        l_agreement_in_rec.revenue_limit_flag           := 'Y';
        l_agreement_in_rec.invoice_limit_flag           := 'Y';
        l_agreement_in_rec.start_date                   := NVL(getProjectStartDate(l_project_id), SYSDATE);
        l_agreement_in_rec.template_flag                := NULL;
        l_agreement_in_rec.owning_organization_id       := G_org_id; -- APK CA changes 0; --RECo
        l_agreement_in_rec.description                  := l_description;
        
        indx := 0;
        write_log(G_log_type, 'Populate funding record');
        FOR conTaskRec IN contractTasks(contractRec.reco_project_id) LOOP
            indx := indx +1;
            
            l_funding_in_rec.pm_funding_reference   := contractRec.project_number||'-'||conTaskRec.task_number;
            l_funding_in_rec.project_id             := l_project_id;
            l_funding_in_rec.task_id                := conTaskRec.top_task_id;
            l_funding_in_rec.date_allocated         := SYSDATE;
            l_funding_in_rec.allocated_amount       := conTaskRec.contract_amount;
            l_funding_in_rec.funding_category       := 'ORIGINAL';
            
            l_funding_in(indx) := l_funding_in_rec;
        END LOOP;
        write_log(G_log_type, 'Populated '||indx||' funding records');
        
        FOR idx IN l_funding_in.first.. l_funding_in.last LOOP        
            write_log(G_log_type,
                idx||'. '||l_funding_in(idx).pm_funding_reference||'; '||l_funding_in(idx).funding_category||': '||l_funding_in(idx).allocated_amount
                );
        END LOOP;

        write_log(G_log_type, 'call create agreement');
        apps.pa_agreement_pub.create_agreement(
            p_api_version_number    => l_api_version_number,
            p_commit                => l_commit,
            p_init_msg_list         => l_init_msg_list,
            p_msg_count             => l_msg_count,
            p_msg_data              => l_msg_data,
            p_return_status         => l_return_status,
            p_pm_product_code       => G_PM_PRODUCT_CODE,
            p_agreement_in_rec      => l_agreement_in_rec,
            p_agreement_out_rec     => l_agreement_out_rec,
            p_funding_in_tbl        => l_funding_in,
            p_funding_out_tbl       => l_funding_out);
            
        IF l_return_status != 'S' THEN
            RAISE API_ERROR;
        END IF;
        
        write_log(G_log_type, 'Successfully created agreement '||l_agreement_out_rec.agreement_id);
        
        --pAgreementId := l_agreement_out_rec.agreement_id;
        BEGIN 
            write_log(G_log_type, 'Write the Output file');
            write_log('OUT', 'Project: '||pProjNum);
            write_log('OUT',  RPAD('Agreement #', 50, ' ')||RPAD('Amount', 15, ' '));
            write_log('OUT', RPAD(l_agreement_in_rec.agreement_num, 50, ' ')||
                             RPAD(l_agreement_in_rec.amount, 15, ' '));
                             
            write_log('OUT', ' ');
            write_log('OUT', ' ');
            
            write_log('OUT', RPAD('Proj-Task', 15, ' ')||RPAD('Amount', 15, ' '));
            FOR idx IN l_funding_in.first.. l_funding_in.last LOOP         
                write_log('OUT',
                    RPAD(l_funding_in(idx).pm_funding_reference, 15, ' ')||
                    RPAD(l_funding_in(idx).allocated_amount, 15, ' ')
                );
            END LOOP;
        EXCEPTION 
            WHEN others THEN
                write_log(G_log_type, 'Error in writing output: '||sqlerrm);
        END;

        write_log(G_log_type, 'End reco_project_api.create_agreement');
        
        
    EXCEPTION
        WHEN INVALID_PARAMETER THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;
            write_log(G_log_type, 'Invalid parameter: '||pProjNum);
            fnd_file.CLOSE;
            
        WHEN INVALID_CONTRACT THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;
            write_log(G_log_type, 'Invalid contract for: '||pProjNum);
            fnd_file.CLOSE;
            
        WHEN INVALID_AGREEMENT THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;
            write_log(G_log_type, 'Invalid agreement for: '||pProjNum);
            fnd_file.CLOSE;
            
        WHEN RECO_PROJ_API_ERROR THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;
            write_log(G_log_type, 'RECO AGREEMENT API Error');
            fnd_file.CLOSE;
            
        WHEN API_ERROR THEN
            ROLLBACK;
            write_log(G_log_type, 'Agreement API Error');
            
            IF l_msg_count >= 1 THEN
                FOR I IN 1..l_msg_count LOOP
                    apps.pa_interface_utils_pub.get_messages(
                        p_msg_data      => l_msg_data,
                        p_encoded       => 'F',
                        p_data          => l_data,
                        p_msg_count     => l_msg_count,
                        p_msg_index     => l_msg_count,   
                        p_msg_index_out => l_msg_index_out);
                    
                    write_log(G_log_type, 'API Error Msg: '||l_data);
                END LOOP;
            END IF;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;
            fnd_file.CLOSE;
            
        WHEN OTHERS THEN
            ROLLBACK;
            write_log(G_log_type, 'Agreement API Other exception: '||sqlerrm);
            
            IF l_msg_count >= 1 THEN
                FOR I IN 1..l_msg_count LOOP
                    apps.pa_interface_utils_pub.get_messages(
                        p_msg_count     => l_msg_count,
                        p_encoded       => 'F',
                        p_msg_data      => l_msg_data,
                        p_data          => l_data,
                        p_msg_index     => l_msg_count,    
                        p_msg_index_out => l_msg_index_out);
                    
                    write_log(G_log_type, 'Other Exception Msg: '||l_data);
                END LOOP;
            END IF; 
            
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;
            fnd_file.CLOSE;  
    END create_agreement;
    ---------------------------------------------------------------------------- 
    
    PROCEDURE create_budget(
        errbuf OUT VARCHAR2, 
        retcode OUT NUMBER,
        pProjNum IN VARCHAR2 
        --pBudgetVerId OUT NUMBER
        ) IS
        
        l_api_version_number        NUMBER :=1.0;
        l_commit                    VARCHAR2(1):= 'F';
        l_return_status             VARCHAR2(1);
        l_init_msg_list             VARCHAR2(1);
        l_msg_count                 NUMBER;
        l_msg_data                  VARCHAR2(2000);
        l_data                      VARCHAR2(2000);
        l_msg_index                 NUMBER;
        l_msg_index_out             NUMBER;
        l_responsibility_id	        NUMBER;
        l_user_id		            NUMBER;
        
        indx                        NUMBER;
        errIndx                     NUMBER;
        l_project_id                NUMBER;
        l_task_id                   NUMBER;
        l_top_task_id               NUMBER;
        l_qty                       NUMBER;
        l_cost_amt                  NUMBER;
        l_rev_amt                   NUMBER;
        
        l_budget_version_name       VARCHAR2(250);
        l_description               VARCHAR2(500);
        l_top_task_num              VARCHAR2(25);
        l_billing                   VARCHAR2(50);
        l_task_num                  VARCHAR2(25);
        l_wall_num                  VARCHAR2(15);
        l_cost_uom                  VARCHAR2(25);
        l_rev_uom                   VARCHAR2(25);
        l_uom                       VARCHAR2(25);
        l_exp_type                  VARCHAR2(150);
        l_pre_exp_type              VARCHAR2(150);
        l_rev_exp_type              VARCHAR2(150);
        l_responsibility_name       VARCHAR2(150);

        l_attribute_category        VARCHAR2(30);
        l_attribute1                VARCHAR2(150);
        l_version_type              apps.pa_budget_versions.version_type%TYPE ;
        
        addBudgetLine               BOOLEAN;
        sameUOM                     BOOLEAN;
        
        l_budget_lines_in_rec       apps.pa_budget_pub.budget_line_in_rec_type;
        l_budget_lines_in           apps.pa_budget_pub.budget_line_in_tbl_type;
        l_budget_lines_out          apps.pa_budget_pub.budget_line_out_tbl_type;

        INVALID_PARAMETER           EXCEPTION;
        INVALID_ACCESS              EXCEPTION;
        INVALID_PRODUCT             EXCEPTION;
        INVALID_BILLING             EXCEPTION;
        INVALID_TASK                EXCEPTION;
        EXP_NOT_FOUND               EXCEPTION;
        API_ERROR                   EXCEPTION;
        RECO_PROJ_API_ERROR         EXCEPTION;
        
        l_budget_err_tbl            ERR_TBL_TYPE;
        
        
        CURSOR conProj IS
        SELECT rc.project_number, rc.reco_project_id
        FROM reco_contracts rc
        WHERE rc.project_number = pProjNum
        AND org_id = G_org_id;
        
        CURSOR conProd(pRecoProjId NUMBER) IS
        SELECT rct.task_number AS top_task_number, 
               rct.invoice_on_prod, rct.invoice_on_del, rct.bill_split_freight, rct.bill_condition, 
               rct.product_id,
               CASE WHEN rct.invoice_on_prod = 'Y' AND rct.invoice_on_del = 'N' THEN 'ON PRODUCTION' 
                    WHEN rct.invoice_on_prod = 'Y' AND rct.invoice_on_del = 'Y' THEN 'ON PROD + FREIGHT'
                    WHEN rct.invoice_on_prod = 'N' AND rct.invoice_on_del = 'Y' THEN 'ON DELIVERY'
                    ELSE NULL
                END AS billing
        FROM reco_contract_tasks rct
        WHERE rct.reco_project_id = pRecoProjId
        AND crm_status_code = 'Won'
        ORDER BY rct.task_number;
        
        CURSOR conBudget(pProductId  NUMBER) IS
        SELECT *
        FROM reco_budget_lines rbl
        WHERE product_id = pProductId
        AND (cost_qty IS NOT NULL OR COST IS NOT NULL OR revenue_qty IS NOT NULL OR revenue IS NOT NULL)
        ORDER BY task_number;
        
        
        FUNCTION getTaskNumber(pTaskId IN NUMBER) RETURN VARCHAR2 IS
            lTaskNum    VARCHAR2(30);
        BEGIN
            SELECT task_number 
            INTO lTaskNum 
            FROM pa_tasks 
            WHERE task_id = pTaskId;
            
            RETURN lTaskNum;
        EXCEPTION
            WHEN others THEN
                RETURN 'X';
        END getTaskNumber;
        ------------------------------------------------------------------------
        
        FUNCTION getResourceExpType(pResourceListMemId IN NUMBER) RETURN VARCHAR2 IS
            lResourceExp    VARCHAR2(250);
        BEGIN
            SELECT lm.expenditure_type
            INTO lResourceExp
            FROM apps.pa_resource_list_members lm
            WHERE lm.resource_list_id = G_RESOURCE_LIST_ID
            AND lm.resource_list_member_id = pResourceListMemId;
            
            RETURN lResourceExp;
        EXCEPTION
            WHEN others THEN
                RETURN 'X';
        END getResourceExpType;
        ------------------------------------------------------------------------
        
    BEGIN
        G_log_type := 'LOG';
        write_log(G_log_type, 'Begin reco_project_api.create_budget; pProjNum: '||pProjNum);
        errbuf := G_CONC_PROG_SUCC_MSG;
        retcode := G_CONC_PROG_SUCC_CODE;
        initialize_global_vars;
        
        write_log(G_log_type, 'Refresh Resource List Id');
        refreshResourceListId(l_return_status);
        IF l_return_status <> 'S' THEN
            RAISE RECO_PROJ_API_ERROR;
        END IF;
        write_log(G_log_type, 'ResourceListId: '||G_RESOURCE_LIST_ID);
        
        SELECT DECODE(G_org_id, 0, 'Project Super User', 293, 'Project Super User - Canada', 'X')
        INTO l_responsibility_name
        FROM dual;
        
        BEGIN
            SELECT user_id, responsibility_id
            INTO  l_user_id, l_responsibility_id
            FROM apps.pa_user_resp_v
            WHERE user_id = G_user_id	
            AND responsibility_name = l_responsibility_name; --'Project Super User';
        EXCEPTION
            WHEN no_data_found THEN
                write_log(G_log_type, 'No data found in user-resp view');
                RAISE INVALID_ACCESS;
        END;	
        
        -- SET GLOBAL VALUES
        apps.pa_interface_utils_pub.set_global_info(
            p_api_version_number    => 1.0,
            p_responsibility_id     => l_responsibility_id,
            p_user_id        	    => l_user_id,  
            p_msg_count             => l_msg_count,
            p_msg_data              => l_msg_data,
            p_return_status         => l_return_status);
        
        IF l_return_status <> 'S' THEN
            RAISE INVALID_ACCESS;
        END IF;
        
        
        IF NOT validProject(pProjNum, l_project_id) THEN
            RAISE INVALID_PARAMETER;
        END IF;
        write_log(G_log_type, 'Project #: '||pProjNum||', ProjectId: '||l_project_id);

        l_budget_version_name  := pProjNum ||' CONTRACT DD '||TO_CHAR(SYSDATE, 'MM/DD/YYYY');
        l_attribute_category := G_BUDGET_CATEGORY; 
        l_attribute1 := G_BUDGET_TYPE; 
        l_version_type := G_VERSION_TYPE; 
        
        write_log(G_log_type, 'Budget version: '||l_budget_version_name);  
              
        FOR proj IN conProj LOOP

            l_description := pProjNum ||' CONTRACT DD '||TO_CHAR(SYSDATE, 'MM/DD/YYYY')||' - '||getAgreementDesc(proj.reco_project_id, l_return_status); 
            IF l_return_status <> 'S' THEN
                write_log(G_log_type, 'getAgreementDesc returns error');
                RAISE RECO_PROJ_API_ERROR;
            END IF;
              
            indx := 0; 
            errIndx := 0;
                         
            FOR tsk IN conProd(proj.reco_project_id) LOOP 
            BEGIN
                l_top_task_num := tsk.top_task_number;
                IF NOT validTask(l_project_id, l_top_task_num, l_top_task_id) THEN
                    RAISE INVALID_PRODUCT;
                END IF;
            
                l_billing := tsk.billing;
                IF NVL(l_billing, 'X') NOT IN ('ON DELIVERY', 'ON PROD + FREIGHT', 'ON PRODUCTION') THEN
                    RAISE INVALID_BILLING;
                END IF;
                
                write_log(G_log_type,RPAD('-', 80, '-'));
                write_log(G_log_type,'Top Task: '||l_top_task_num||', Billing: '||l_billing||', Top Task Id: '||l_top_task_id||', ProductId: '||tsk.product_id);
                write_log(G_log_type,RPAD('-', 80, '-'));

                FOR bdgt IN conBudget(tsk.product_id) LOOP
                BEGIN
                    addBudgetLine := TRUE;
                    l_task_num := bdgt.task_number;
                    IF NOT validTask(l_project_id, l_task_num, l_task_id) THEN
                        RAISE INVALID_TASK;
                    END IF;
                    
                    l_wall_num := NULL;
                    IF LENGTH(l_task_num)>=12 THEN
                        SELECT  REGEXP_SUBSTR(l_task_num, '[^.]*$') INTO l_wall_num FROM dual;
                    END IF;

                    write_log(G_log_type,'Task Num: '||l_task_num||', Wall Num: '||l_wall_num||', Task Id: '||l_task_id);
                    
                    IF bdgt.cost_uom = bdgt.revenue_uom THEN
                        sameUOM := TRUE;
                        write_log(G_log_type,'Same UOM: Cost UOM-'||bdgt.cost_uom||', Rev UOM-'||bdgt.revenue_uom);
                    ELSE
                        sameUOM := FALSE;
                        write_log(G_log_type,'Different UOM: Cost UOM-'||bdgt.cost_uom||', Rev UOM-'||bdgt.revenue_uom);
                    END IF;
                                            
                    SELECT DECODE(bdgt.cost_uom, '$', 'DOLLARS', 'SF', 'SQUARE FEET', 'RL', 'ROLLS', 'HR', 'HOURS', bdgt.cost_uom),
                           DECODE(bdgt.revenue_uom, '$', 'DOLLARS', 'SF', 'SQUARE FEET', 'RL', 'ROLLS', 'HR', 'HOURS', bdgt.revenue_uom)
                    INTO l_cost_uom, l_rev_uom
                    FROM dual; 
                    
                    l_uom := l_cost_uom;
                    l_qty := bdgt.cost_qty;
                    l_cost_amt := bdgt.cost;
                    l_rev_amt := bdgt.revenue;
                    
                    write_log(G_log_type,'UOM:'||l_uom||', Qty:'||l_qty||', Cost:'||l_cost_amt||', Rev:'||l_rev_amt);

                    l_budget_lines_in_rec.pa_task_id := l_task_id;
                    l_budget_lines_in_rec.budget_start_date := TRUNC(SYSDATE);
                    l_budget_lines_in_rec.budget_end_date := ADD_MONTHS(TRUNC(SYSDATE), 12*10);
                    
                    IF l_task_num LIKE l_top_task_num||'.01.01%' THEN
                        write_log(G_log_type,'Precast Production budget line');
                        
                        l_uom := NVL(l_cost_uom, l_rev_uom);
                        l_qty := NVL(bdgt.cost_qty, bdgt.revenue_qty);
                        l_exp_type := getExpType(l_top_task_num, l_task_num, l_wall_num, l_uom);
                        IF l_exp_type IS NOT NULL THEN
                            l_budget_lines_in_rec.resource_list_member_id := getResourceId(l_exp_type);                                
                            
                            IF l_billing IN ('ON PROD + FREIGHT', 'ON PRODUCTION') THEN
                                write_log(G_log_type, l_billing);
                                l_budget_lines_in_rec.quantity := l_qty;
                                l_budget_lines_in_rec.raw_cost := NVL(l_cost_amt, 0);
                                l_budget_lines_in_rec.revenue := NVL(l_rev_amt, 0);

                            ELSIF l_billing = 'ON DELIVERY' THEN
                                write_log(G_log_type, l_billing);
                                l_budget_lines_in_rec.quantity := l_qty;
                                l_budget_lines_in_rec.raw_cost := NVL(l_cost_amt, 0);
                                l_budget_lines_in_rec.revenue := 0; --NULL;
                                
                            END IF;
                            write_log(G_log_type,'Precast Exp:'||l_exp_type||', Qty:'||l_budget_lines_in_rec.quantity||', Cost:'||l_budget_lines_in_rec.raw_cost||', Rev:'||l_budget_lines_in_rec.revenue);
                        ELSE
                            addBudgetLine := FALSE;
                            write_log(G_log_type, 'Expenditure Type Not Identified for '||l_task_num||' UOM '||l_uom);
                            RAISE EXP_NOT_FOUND;
                        END IF;
                        
                    ELSIF l_task_num LIKE l_top_task_num||'.01.02%' THEN
                        write_log(G_log_type,'Precast Delivery budget line');
                        l_uom := NVL(l_cost_uom, l_rev_uom);
                        l_qty := NVL(bdgt.cost_qty, bdgt.revenue_qty);
                        
                        IF l_billing = 'ON DELIVERY' THEN
                            l_pre_exp_type := getExpType(l_top_task_num, l_top_task_num||'.01.01.'||l_wall_num, l_wall_num, l_uom);
                            write_log(G_log_type, '01.02 ON DELIVERY Precast Expenditure Type '|| l_pre_exp_type);
                            
                            IF l_pre_exp_type IS NOT NULL  THEN
                                l_budget_lines_in_rec.resource_list_member_id := getResourceId(l_pre_exp_type); 
                                
                                l_budget_lines_in_rec.quantity := l_qty;
                                l_budget_lines_in_rec.raw_cost := NVL(l_cost_amt, 0);
                                l_budget_lines_in_rec.revenue := NVL(l_rev_amt, 0);
                                
                                write_log(G_log_type,'Prec-Del '||l_billing||' Exp:'||l_pre_exp_type||', Qty:'||l_budget_lines_in_rec.quantity||', Cost:'||l_budget_lines_in_rec.raw_cost||', Rev:'||l_budget_lines_in_rec.revenue);
                            ELSE
                                addBudgetLine := FALSE;
                                write_log(G_log_type, 'Expenditure Type (Precast) Not Identified for '||l_task_num||' UOM '||l_uom);
                                RAISE EXP_NOT_FOUND;
                            END IF;
                        END IF;
                        
                        IF l_billing IN ( 'ON PRODUCTION', 'ON PROD + FREIGHT') THEN
                            l_exp_type := getExpType(l_top_task_num, l_task_num, l_wall_num, l_uom);
                            write_log(G_log_type, '01.02 '||l_billing||' Freight Expenditure Type '||l_exp_type);
                            
                            IF l_exp_type IS NOT NULL THEN
                                l_budget_lines_in_rec.resource_list_member_id := getResourceId(l_exp_type);
                                
                                IF l_billing = 'ON PRODUCTION' THEN
                                    l_budget_lines_in_rec.quantity := l_qty;
                                    l_budget_lines_in_rec.raw_cost := NVL(l_cost_amt, 0);
                                    l_budget_lines_in_rec.revenue := 0; --NULL;
                                ELSIF l_billing = 'ON PROD + FREIGHT' THEN
                                    l_budget_lines_in_rec.quantity := l_qty;
                                    l_budget_lines_in_rec.raw_cost := NVL(l_cost_amt, 0);
                                    l_budget_lines_in_rec.revenue := NVL(l_rev_amt, 0);
                                END IF;  
                                
                                write_log(G_log_type,'Prec-Del '||l_billing||' Exp:'||l_exp_type||', Qty:'||l_budget_lines_in_rec.quantity||', Cost:'||l_budget_lines_in_rec.raw_cost||', Rev:'||l_budget_lines_in_rec.revenue);                  
                            ELSE
                                addBudgetLine := FALSE;
                                write_log(G_log_type, 'Expenditure Type Not Identified for '||l_task_num||' UOM '||l_uom);
                                RAISE EXP_NOT_FOUND;
                            END IF;
                        END IF;
                        
                    ELSE
                        write_log(G_log_type,'Other Budget Line');
                        
                        l_exp_type := getExpType(l_top_task_num, l_task_num, l_wall_num, l_cost_uom);
                        write_log(G_log_type,'Cost Exp Type:'||l_exp_type);  
                                       
                        IF NOT sameUOM THEN
                            l_rev_exp_type := getExpType(l_top_task_num, l_task_num, l_wall_num, l_rev_uom);
                            write_log(G_log_type,'Rev Exp Type:'||l_rev_exp_type); 
                        END IF; 
                        
                        IF sameUOM THEN
                            IF l_exp_type IS NOT NULL THEN 
                                l_budget_lines_in_rec.resource_list_member_id := getResourceId(l_exp_type);
                                l_budget_lines_in_rec.quantity := NVL(bdgt.cost_qty, bdgt.revenue_qty);
                                l_budget_lines_in_rec.raw_cost := NVL(l_cost_amt, 0);
                                l_budget_lines_in_rec.revenue := NVL(l_rev_amt, 0);
                                write_log(G_log_type,'Same UOM Exp:'||l_exp_type||', Qty:'||l_budget_lines_in_rec.quantity||', Cost:'||l_budget_lines_in_rec.raw_cost||', Rev:'||l_budget_lines_in_rec.revenue);
                            ELSE
                                addBudgetLine := FALSE;
                                write_log(G_log_type, 'Expenditure Type Not Identified for '||l_task_num||' UOM '||l_uom);
                                RAISE EXP_NOT_FOUND;
                            END IF;   
                        ELSE
                            IF l_cost_uom IS NOT NULL AND NVL(l_cost_amt, 0)<> 0 THEN
                                IF l_exp_type IS NOT NULL THEN
                                    l_budget_lines_in_rec.resource_list_member_id := getResourceId(l_exp_type);
                                    
                                    l_budget_lines_in_rec.quantity := l_qty;
                                    l_budget_lines_in_rec.raw_cost := NVL(l_cost_amt, 0);
                                    l_budget_lines_in_rec.revenue := 0; --NULL;
                                    write_log(G_log_type,'Diff UOM Cost Exp:'||l_exp_type||', Qty:'||l_budget_lines_in_rec.quantity||', Cost:'||l_budget_lines_in_rec.raw_cost||', Rev:'||l_budget_lines_in_rec.revenue);
                                    indx := indx + 1;
                                    write_log(G_log_type, indx||'. Add COST budget line for '||l_task_num);
                                    l_budget_lines_in(indx) := l_budget_lines_in_rec;
                                    addBudgetLine := FALSE;
                                ELSE
                                    --addBudgetLine := FALSE;
                                    write_log(G_log_type, 'Expenditure Type Not Identified for '||l_task_num||' Cost UOM '||l_uom);
                                    RAISE EXP_NOT_FOUND;
                                END IF;
                            END IF;
                            
                            IF l_rev_uom IS NOT NULL AND NVL(bdgt.revenue, 0) <> 0 THEN
                                IF l_rev_exp_type IS NOT NULL THEN  
                                    l_budget_lines_in_rec.resource_list_member_id := getResourceId(l_rev_exp_type);
                                    
                                    l_budget_lines_in_rec.quantity := bdgt.revenue_qty;
                                    l_budget_lines_in_rec.raw_cost := 0; --NULL;
                                    l_budget_lines_in_rec.revenue := NVL(bdgt.revenue, 0);
                                    write_log(G_log_type,'Diff UOM Rev Exp:'||l_rev_exp_type||', Qty:'||l_budget_lines_in_rec.quantity||', Cost:'||l_budget_lines_in_rec.raw_cost||', Rev:'||l_budget_lines_in_rec.revenue);
                                    addBudgetLine := TRUE;
                                ELSE
                                    addBudgetLine := FALSE;
                                    write_log(G_log_type, 'Expenditure Type Not Identified for '||l_task_num||' Rev UOM '||l_rev_uom);
                                    RAISE EXP_NOT_FOUND;
                                END IF;
                            END IF;
                            
                        END IF;
                    END IF;                        
                    write_log(G_log_type,RPAD('~', 80, '~'));
                    IF addBudgetLine THEN
                        IF NVL(l_budget_lines_in_rec.quantity, 0) <> 0 OR NVL(l_budget_lines_in_rec.raw_cost , 0)<> 0 OR NVL(l_budget_lines_in_rec.revenue , 0) <> 0 THEN 
                            indx := indx + 1;
                            --write_log(G_log_type, indx||'. Add budget line for '||l_task_num);
                            l_budget_lines_in(indx) := l_budget_lines_in_rec;
                        END IF;
                    END IF;    
                EXCEPTION
                    WHEN INVALID_TASK THEN
                        write_log(G_log_type, l_task_num||' not set up for project '||pProjNum);
                        
                        errIndx := errIndx +1;
                        l_budget_err_tbl(errIndx).task_num := l_task_num;
                        l_budget_err_tbl(errIndx).message := 'TASK NOT SET UP FOR THE PROJECT';
                        
                    WHEN EXP_NOT_FOUND THEN
                        write_log(G_log_type, 'Expenditure Type Not Found for '||l_task_num||' UOM '||l_uom);
                        
                        errIndx := errIndx +1;
                        l_budget_err_tbl(errIndx).task_num := l_task_num;
                        l_budget_err_tbl(errIndx).message := 'EXPENDITURE TYPE NOT FOUND FOR UOM '||l_uom;
                END;
                END LOOP; --Bdgt
            EXCEPTION
                WHEN INVALID_PRODUCT THEN
                    write_log(G_log_type, l_top_task_num||' not set up for project '||pProjNum);
                    
                    errIndx := errIndx +1;
                    l_budget_err_tbl(errIndx).task_num := l_top_task_num;
                    l_budget_err_tbl(errIndx).message := 'TOP TASK NOT SET UP FOR THE PROJECT';
                WHEN INVALID_BILLING THEN
                    write_log(G_log_type, l_top_task_num||' has invalid bill condition');
                    
                    errIndx := errIndx +1;
                    l_budget_err_tbl(errIndx).task_num := l_top_task_num;
                    l_budget_err_tbl(errIndx).message := 'TOP TASK HAS INVALID BILL CONDITION';
            END;
            END LOOP;   --Prod
        END LOOP; -- Proj 
        
        write_log(G_log_type, 'Populated Budget Lines');
        FOR idx IN l_budget_lines_in.first.. l_budget_lines_in.last LOOP        
            write_log(G_log_type,
                idx||'. '||getTaskNumber(l_budget_lines_in(idx).pa_task_id)||' - '||
                getResourceExpType(l_budget_lines_in(idx).resource_list_member_id)||': '||
                l_budget_lines_in(idx).quantity||', '||
                l_budget_lines_in(idx).raw_cost||', '||
                l_budget_lines_in(idx).revenue
            );
        END LOOP;
        
        IF errIndx > 0 THEN
            write_log(G_log_type,RPAD('~', 80, '~'));
            write_log(G_log_type, 'Warnings');
            FOR idx IN l_budget_err_tbl.first.. l_budget_err_tbl.last LOOP        
                write_log(G_log_type,
                l_budget_err_tbl(idx).task_num||' - '||
                l_budget_err_tbl(idx).message
                );
            END LOOP;
        END IF;
        
        write_log(G_log_type,RPAD('-', 80, '-'));
        write_log(G_log_type, 'Call API to create budget');
        apps.pa_budget_pub.init_budget;
        
        apps.pa_budget_pub.create_draft_budget(
            p_api_version_number    => l_api_version_number,
            p_commit                =>  l_commit,
            p_msg_count             => l_msg_count,
            p_msg_data              => l_msg_data,
            p_return_status         => l_return_status,
            p_pm_product_code       => G_PM_PRODUCT_CODE,
            p_pa_project_id         => l_project_id,
            p_budget_version_name   => l_budget_version_name,
            p_description           => l_description,
            p_resource_list_id      => G_RESOURCE_LIST_ID,
            p_attribute_category    => G_BUDGET_CATEGORY,
            p_attribute1            => G_BUDGET_TYPE,                   
            p_budget_lines_in       => l_budget_lines_in,
            p_budget_lines_out      => l_budget_lines_out,
            p_fin_plan_type_id      => G_FIN_PLAN_TYPE_ID,
            p_version_type          => G_VERSION_TYPE,
            p_raw_cost_flag         => 'Y',
            p_revenue_flag          => 'Y',
            p_all_qty_flag          => 'Y'         		
        );
        
        IF l_return_status != 'S' THEN
            RAISE API_ERROR;
        END IF;
        
        write_log(G_log_type, 'Successfully created budget version: '||l_budget_version_name);
        
        BEGIN 
            write_log(G_log_type, 'Write the Output file');
            write_log('OUT', 'Project: '||pProjNum);
            write_log('OUT', 'CONTRACT Budget Version Name: '||l_budget_version_name);
            write_log('OUT',' ');
            write_log('OUT',' ');
            
            write_log('OUT', RPAD('Task', 15, ' ')||RPAD('Exp. Type', 30, ' ')||RPAD('Qty.', 15, ' ')||RPAD('Cost', 15, ' ')||RPAD('Revenue', 15, ' '));
            FOR idx IN l_budget_lines_in.first.. l_budget_lines_in.last LOOP        
                write_log('OUT',
                    RPAD(getTaskNumber(l_budget_lines_in(idx).pa_task_id), 15, ' ')||
                    RPAD(getResourceExpType(l_budget_lines_in(idx).resource_list_member_id), 30, ' ')||
                    RPAD(NVL(TO_CHAR(l_budget_lines_in(idx).quantity), '-'), 15, ' ')||
                    RPAD(NVL(TO_CHAR(l_budget_lines_in(idx).raw_cost), '-'), 15, ' ')||
                    RPAD(NVL(TO_CHAR(l_budget_lines_in(idx).revenue), '-'), 15, ' ')
                );
            END LOOP;
            
            IF errIndx > 0 THEN
                write_log('OUT',' ');
                write_log('OUT',' ');
                write_log('OUT', RPAD('Warnings', 8, ' '));
                write_log('OUT',RPAD('-', 8, '-'));
                
                write_log('OUT',
                    RPAD('Task Number', 25, ' ')||
                    RPAD('Error Message', 250, ' ')
                );
                FOR idx IN l_budget_err_tbl.first.. l_budget_err_tbl.last LOOP        
                    write_log('OUT',
                    RPAD(l_budget_err_tbl(idx).task_num, 25, ' ')||
                    RPAD(l_budget_err_tbl(idx).message, 250, ' ')
                    );
                END LOOP;
            END IF;

        EXCEPTION 
            WHEN others THEN
                write_log(G_log_type, 'Error in writing output: '||sqlerrm);
        END;
        
        IF errIndx > 0 THEN
            retcode := G_CONC_PROG_WARN_CODE;
            errbuf  := G_CONC_PROG_WARN_MSG;
        END IF;

        write_log(G_log_type, 'End reco_project_api.create_budget');       
        
        
    EXCEPTION
        WHEN INVALID_ACCESS THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;  
            write_log(G_log_type, 'User '||G_user_id|| ' is not authorized to execute this process');
            fnd_file.CLOSE;
            
        WHEN INVALID_PARAMETER THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;  
            write_log(G_log_type, 'Invalid parameter/Project not setup in job cost: '||pProjNum);
            fnd_file.CLOSE;
            
        WHEN RECO_PROJ_API_ERROR THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;  
            write_log(G_log_type, 'RECO BUDGET API Error');
            fnd_file.CLOSE;
            
        WHEN API_ERROR THEN
            ROLLBACK;
            write_log(G_log_type, 'Budget API Error');
            
            IF l_msg_count >= 1 THEN
                FOR I IN 1..l_msg_count LOOP
                    apps.pa_interface_utils_pub.get_messages(
                        p_msg_data      => l_msg_data,
                        p_encoded       => 'F',
                        p_data          => l_data,
                        p_msg_count     => l_msg_count,
                        p_msg_index     => l_msg_count,   
                        p_msg_index_out => l_msg_index_out);
                    
                    write_log(G_log_type, 'API Error Msg: '||l_data);
                END LOOP;
            END IF;
            
            retcode := G_CONC_PROG_ERR_CODE;   
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
        WHEN OTHERS THEN
            ROLLBACK;
            write_log(G_log_type, 'Budget API Other exception: '||sqlerrm);
            
            IF l_msg_count >= 1 THEN
                FOR I IN 1..l_msg_count LOOP
                    apps.pa_interface_utils_pub.get_messages(
                        p_msg_count     => l_msg_count,
                        p_encoded       => 'F',
                        p_msg_data      => l_msg_data,
                        p_data          => l_data,
                        p_msg_index     => l_msg_count,    
                        p_msg_index_out => l_msg_index_out);
                    
                    write_log(G_log_type, 'Other Exception Msg: '||l_data);
                END LOOP;
            END IF;
            
            retcode := G_CONC_PROG_ERR_CODE;   
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;   
    END create_budget;
