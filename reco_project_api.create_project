    FUNCTION getAgreementDesc(pRecoProjId IN NUMBER, pRetStatus OUT VARCHAR2) RETURN VARCHAR2 IS
        CURSOR contTasks IS 
        SELECT * FROM reco_contract_tasks
        WHERE reco_project_id = pRecoProjId
        ORDER BY task_name;
        
        lDesc   VARCHAR2(250);
    BEGIN
        write_log(G_log_type, 'In getAgreementDesc; pRecoProjId: '||pRecoProjId);
        pRetStatus := 'S';
        
        lDesc := NULL;
        FOR con IN contTasks LOOP
            IF lDesc IS NOT NULL THEN
                lDesc := lDesc||'; ';
            END IF;
            lDesc := lDesc ||con.task_name||'('||con.project_type||')';
        END LOOP;
        
        RETURN lDesc;
    EXCEPTION
        WHEN others THEN
            write_log(G_log_type, 'Exception in getAgreementDesc: '||sqlerrm);
            pRetStatus := 'E';
            RETURN 'ERROR';
    END getAgreementDesc; 
