    PROCEDURE add_product(
        errbuf OUT VARCHAR2, 
        retcode OUT NUMBER,
        pProjNum IN VARCHAR2, 
        pTaskNum IN VARCHAR2, 
        pByWall IN VARCHAR2, 
        pNoOfWalls IN NUMBER, 
        pDesignBuild IN VARCHAR2
    ) IS
    
        CURSOR projectInfo IS
        SELECT  * FROM reco_projects
        WHERE project_number = pProjNum
        AND org_id = G_org_id;
        
        CURSOR taskInfo(pRecoProjectId NUMBER) IS
        SELECT * FROM reco_top_tasks
        WHERE reco_project_id = pRecoProjectId
        AND task_number = pTaskNum
        AND osc_status_code = 'Won'
        ORDER BY task_number;
        
        CURSOR wallInfo(pTaskName VARCHAR2, pWalls NUMBER) IS     
        SELECT pTaskName ||' WALL '||LEVEL AS wall_name, LEVEL AS wall_order
        FROM DUAL
        WHERE pByWall = 'Y'        
        CONNECT BY LEVEL <= pWalls
        UNION
        SELECT pTaskName ||' WALL', 1 
        FROM dual
        WHERE pByWall = 'N'
        UNION
        SELECT pTaskName||' POOL TASK', 1000000
        FROM dual
        WHERE pDesignBuild = 'Y'
        ORDER BY 2;
        
        CURSOR templateTaskInfo(pTemplateId NUMBER, POverHead CHAR) IS
        SELECT project_id,            
                task_id,
                task_number,
                task_name,           
                (SELECT task_number
                FROM pa_tasks
                WHERE task_id = a.parent_task_id) parent_task_number,
                wbs_level,
                parent_task_id,
                billable_flag,
                chargeable_flag
        FROM pa_tasks A
        WHERE project_id = pTemplateId
        AND task_number LIKE DECODE(pOverHead, 'Y', '001%<TASKNUM>', '<TASKNUM>%')
        ORDER BY task_number, wbs_level;
        
        idx                     NUMBER;
        l_project_id            NUMBER;
        l_template_id           NUMBER;
        l_top_task_id           NUMBER;
        l_no_of_walls           NUMBER;
        l_wall_num              NUMBER;
        
        l_task_number           VARCHAR2(25);
        l_task_name             VARCHAR2(250);
        l_wall_task_number      VARCHAR2(25);
        l_wall_task_name        VARCHAR2(250);
        l_parent_task_number    VARCHAR2(25);        
        l_task_billing_type     VARCHAR2(25);
        fmt                     VARCHAR2(10);
        
        poolTask                BOOLEAN;
        
        l_api_version_number    NUMBER := 1;
        l_commit            	VARCHAR2(1) := 'F';
        l_return_status         VARCHAR2(1);
        l_init_msg_list         VARCHAR2(1) := 'F';
        l_msg_count             NUMBER;
        l_msg_index_out         NUMBER;
        l_msg_data              VARCHAR2(2000);
        l_data            	    VARCHAR2(2000);
        l_workflow_started      VARCHAR2(10);
        
        INVALID_PARAMETER       EXCEPTION;
        INVALID_PROJECT         EXCEPTION;
        INVALID_TASK            EXCEPTION;
        INVALID_PROD            EXCEPTION;
        INVALID_RECO_PROJECT    EXCEPTION;
        INVALID_ACCESS          EXCEPTION;
        API_ERROR               EXCEPTION;
        
        l_project_in            apps.PA_PROJECT_PUB.PROJECT_IN_REC_TYPE;
        l_project_out           apps.PA_PROJECT_PUB.PROJECT_OUT_REC_TYPE;
        l_tasks_out_rec         apps.PA_PROJECT_PUB.TASK_OUT_REC_TYPE;
        l_tasks_out             apps.PA_PROJECT_PUB.TASK_OUT_TBL_TYPE;
        l_task_rec              apps.PA_PROJECT_PUB.TASK_IN_REC_TYPE;
        l_tasks                 apps.PA_PROJECT_PUB.TASK_IN_TBL_TYPE;
        
        projectRec              reco_projects%ROWTYPE;
        taskRec                 reco_top_tasks%ROWTYPE;
        l_start                 date; -- bug 34700329  patch 34858347
    BEGIN
        G_log_type := 'LOG';
        
        write_log(G_log_type, 'Parameters');
        write_log(G_log_type, RPAD('-', 10, '-'));
        write_log(G_log_type, 'pProjNum: '||pProjNum);
        write_log(G_log_type, 'pTaskNum: '||pTaskNum);
        write_log(G_log_type, 'pByWall: '||pByWall);
        write_log(G_log_type, 'pNoOfWalls: '||pNoOfWalls);
        write_log(G_log_type, 'pDesignBuild: '||pDesignBuild);
        write_log(G_log_type, RPAD('-', 15, '-'));
        
        write_log(G_log_type, 'Begin reco_project_api.add_product; pProjNum: '||pProjNum);
        write_log(G_log_type, 'Initializing return status to SUCCESS');
        errbuf := G_CONC_PROG_SUCC_MSG;
        retcode := G_CONC_PROG_SUCC_CODE;
        
        initialize_global_vars;
        
        write_log(G_log_type, 'Validate Parameters');
        IF pProjNum IS NULL OR pTaskNum IS NULL THEN
            RAISE INVALID_PARAMETER;
        END IF;
        
        OPEN projectInfo;
        FETCH projectInfo INTO projectRec;
        IF projectInfo%NOTFOUND THEN
            CLOSE projectInfo;
            RAISE INVALID_RECO_PROJECT;
        END IF;
        CLOSE projectInfo;
        
        OPEN taskInfo(projectRec.reco_project_id);
        FETCH taskInfo INTO taskRec;
        IF taskInfo%notfound THEN
            CLOSE taskInfo;
            RAISE INVALID_PROD;
        END IF;
        CLOSE taskInfo;

        
        l_project_id        := NULL;
        l_template_id       := NULL;
        l_top_task_id       := NULL;
        
        write_log(G_log_type, 'Validate project exists and get project_id and template_id');
        BEGIN
            SELECT project_id, created_from_project_id, start_date
            INTO l_project_id, l_template_id, l_start
            FROM pa_projects
            WHERE segment1 = projectRec.project_number;
        EXCEPTION
            WHEN no_data_found THEN
                RAISE INVALID_PROJECT;
        END;
        
        l_project_in.pa_project_id := l_project_id;
        l_project_in.start_date := l_start;
        
        write_log(G_log_type,'validate task does not exist for the project');
        BEGIN
            SELECT task_id
            INTO l_top_task_id
            FROM pa_tasks
            WHERE project_id = l_project_id
            AND task_number = pTaskNum;
        EXCEPTION
            WHEN no_data_found THEN
                NULL;
        END;
        IF l_top_task_id IS NOT NULL THEN
            RAISE INVALID_TASK;
        END IF;
        
        l_no_of_walls := 1;
         
        IF pByWall = 'Y' THEN
            l_no_of_walls := NVL(pNoOfWalls, NVL(taskRec.pg_walls, 1));
        END IF;
        

        idx := 0;
        
        FOR templateTask IN templateTaskInfo(l_template_id, 'Y') LOOP
            l_task_number           := REPLACE(templateTask.task_number, '<TASKNUM>', taskRec.task_number);
            l_task_name             := REPLACE(templateTask.task_name, '<TASK>', taskRec.task_name);
            
            l_task_rec.task_name                := l_task_name;
            l_task_rec.long_task_name           := l_task_name;          
            l_task_rec.task_description         := l_task_name;
            l_task_rec.pa_task_number           := l_task_number;                    
            l_task_rec.pm_task_reference        := l_task_number;
            l_task_rec.pm_parent_task_reference := templateTask.parent_task_number;
            l_task_rec.billable_flag            := templateTask.billable_flag;
            l_task_rec.chargeable_flag          := templateTask.chargeable_flag;
            
            idx := idx + 1;
            l_tasks(idx) := l_task_rec;
        END LOOP;
        
        FOR templateTask IN templateTaskInfo(l_template_id, 'N') LOOP
        
            l_task_number           := REPLACE(templateTask.task_number, '<TASKNUM>', taskRec.task_number);
            l_task_name             := REPLACE(templateTask.task_name, '<TASK>', taskRec.task_name);
            l_parent_task_number    := REPLACE(templateTask.parent_task_number, '<TASKNUM>', taskRec.task_number);
            
            l_task_rec.tasks_dff               := 'N';
            l_task_rec.attribute_category      := NULL;
            l_task_rec.attribute1              := NULL;
            l_task_rec.attribute2              := NULL;
            l_task_rec.attribute6              := NULL;
            l_task_rec.task_start_date         := NULL;
            l_task_rec.task_completion_date    := NULL;
            
            IF templateTask.parent_task_number IS NULL AND templateTask.wbs_level = 1 THEN
                l_task_rec.tasks_dff := 'Y';
                l_task_rec.attribute_category   := 'Billing Information';
                
                IF taskRec.award_contract_type = 'U' THEN
                    l_task_billing_type     := 'Unit Price';
                ELSIF taskRec.award_contract_type = 'L' THEN
                    l_task_billing_type     := 'Lump Sum';
                END IF;
                l_task_rec.attribute1           := l_task_billing_type;
                
                IF pByWall = 'Y' THEN
                    l_task_rec.attribute2           := 'BY WALL';
                END IF;
            END IF;
                
            IF INSTR(l_task_number, 'WALL') > 0 THEN
                l_wall_num := 0;
                
                FOR wallRec IN wallInfo(taskRec.task_name, l_no_of_walls) LOOP
                
                    IF wallRec.wall_order = 1000000 AND wallRec.wall_name LIKE '%POOL TASK%' THEN
                        l_wall_num := 0; --99;
                        poolTask := TRUE;
                    ELSE
                        l_wall_num := l_wall_num + 1;
                        poolTask := FALSE;
                    END IF;
                    
                    SELECT DECODE(LENGTH(l_wall_num), 1, 'FM09', 'FM99999') INTO fmt FROM dual;
                    
                    l_wall_task_number           := REPLACE(l_task_number, '<WALLNUM>', TO_CHAR(l_wall_num, fmt));
                    l_wall_task_name             := REPLACE(l_task_name, '<WALL>', wallRec.wall_name);
                    
                    l_task_rec.task_name                := l_wall_task_name;
                    l_task_rec.long_task_name           := l_wall_task_name;          
                    l_task_rec.task_description         := l_wall_task_name;
                    l_task_rec.pa_task_number           := l_wall_task_number;                    
                    l_task_rec.pm_task_reference        := l_wall_task_number;
                    l_task_rec.pm_parent_task_reference := l_parent_task_number;
                    
                    IF poolTask THEN
                        l_task_rec.billable_flag        := 'N';
                        l_task_rec.chargeable_flag      := 'N';
                    ELSE
                        l_task_rec.billable_flag        := templateTask.billable_flag;
                        l_task_rec.chargeable_flag      := templateTask.chargeable_flag;                                
                    END IF;

                    idx := idx + 1;
                    l_tasks(idx) := l_task_rec;
                END LOOP;
            ELSE 
                l_task_rec.task_name                := l_task_name;
                l_task_rec.long_task_name           := l_task_name;          
                l_task_rec.task_description         := l_task_name;
                l_task_rec.pa_task_number           := l_task_number;                    
                l_task_rec.pm_task_reference        := l_task_number;
                l_task_rec.pm_parent_task_reference := l_parent_task_number;
                l_task_rec.billable_flag            := templateTask.billable_flag;
                l_task_rec.chargeable_flag          := templateTask.chargeable_flag;

                idx := idx + 1;
                l_tasks(idx) := l_task_rec;
                
            END IF;                        
        END LOOP;
        
        FOR tsk IN l_tasks.first.. l_tasks.last LOOP
            write_log(G_log_type, LPAD(tsk, 3, ' ')||') '||RPAD(l_tasks(tsk).pa_task_number, 20, ' ')||RPAD(l_tasks(tsk).task_name, 30, ' ')||RPAD(l_tasks(tsk).pm_parent_task_reference, 20, ' '));
        END LOOP;
        
        
        apps.pa_project_pub.UPDATE_project(
            p_api_version_number    => l_api_version_number,
            p_commit                => l_commit,
            p_init_msg_list         => l_init_msg_list,
            p_msg_count             => l_msg_count,
            p_msg_data              => l_msg_data,
            p_return_status         => l_return_status,
            p_workflow_started      => l_workflow_started,
            p_pm_product_code       => G_PM_PRODUCT_CODE,
            p_project_in            => l_project_in,
            p_project_out           => l_project_out,
            p_tasks_in              => l_tasks,
            p_tasks_out             => l_tasks_out);
            --p_update_mode           => 'PA_UPD_WBS_ATTR');
            
        IF l_return_status != 'S' THEN
            RAISE API_ERROR;
        END IF;
        
        FOR tsk IN l_tasks.first.. l_tasks.last LOOP
            write_log('OUT', LPAD(tsk, 3, ' ')||') '||RPAD(l_tasks(tsk).pa_task_number, 20, ' ')||RPAD(l_tasks(tsk).task_name, 30, ' ')||RPAD(l_tasks(tsk).pm_parent_task_reference, 20, ' '));
        END LOOP;
        
        write_log(G_log_type, 'Sucessfully updated the project');
    EXCEPTION     
        WHEN INVALID_PARAMETER THEN
            ROLLBACK;
            write_log(G_log_type, 'Invalid input parameters');
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
            
        WHEN INVALID_PROJECT THEN
            ROLLBACK;
            write_log(G_log_type, 'Invalid PROJECT. Project should exist in JC');
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
            
        WHEN INVALID_TASK THEN
            ROLLBACK;
            write_log(G_log_type, 'Invalid TASK. Task should not exist for the project in JC');
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
        
        WHEN INVALID_RECO_PROJECT THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            write_log(G_log_type, 'Invalid RECO-PROJECT. Project should exist in RECO-PROJECTS table');
               
        WHEN INVALID_PROD THEN
            ROLLBACK;
            write_log(G_log_type, 'Invalid RECO-TOP-TASK. Product should exist in RECO-TOP-TASKS table');
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
        
        WHEN INVALID_ACCESS THEN
            ROLLBACK;
            write_log(G_log_type, 'User is not authorized to execute this process');
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
        
        WHEN API_ERROR THEN
            ROLLBACK;
            write_log(G_log_type, 'Project API Error');
            
            IF l_msg_count >= 1 THEN
                FOR I IN 1..l_msg_count LOOP
                    apps.pa_interface_utils_pub.get_messages(
                        p_msg_data      => l_msg_data,
                        p_encoded       => 'F',
                        p_data          => l_data,
                        p_msg_count     => l_msg_count,
                        p_msg_index     => l_msg_count,   
                        p_msg_index_out => l_msg_index_out);
                    
                    write_log(G_log_type, 'API Error Msg: '||l_data);
                END LOOP;
            END IF; 
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;   
    END add_product;
    
