   G_resp_appl_id  := NULL;   
   G_conc_req_id   := NULL;
   G_conc_prog_id  := NULL;
   G_login_id      := NULL;
   G_log_type      := 'DBMS';
   
   --PA_FP_NO_PLAN_AMT_CHECKED
