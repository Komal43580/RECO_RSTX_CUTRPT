    FUNCTION validEmployee(pPersonId IN NUMBER) RETURN BOOLEAN IS
        lValid VARCHAR2(1);
    BEGIN
        lValid := 'N';
        
        SELECT 'Y' 
        INTO lValid
        FROM per_people_f P,per_person_types pt
        WHERE p.person_id = pPersonId
        AND p.person_type_id = pt.person_type_id  
        AND pt.system_person_type = 'EMP' --Employee
        AND pt.business_group_id = G_Business_Group_Id
        AND SYSDATE BETWEEN p.effective_start_date AND p.effective_end_date;
        
        IF lValid = 'Y' THEN
            RETURN TRUE;
        ELSE
            RETURN FALSE;
        END IF;
    EXCEPTION
        WHEN no_data_found THEN
            write_log(G_log_type, 'Invalid Employee; personId: '||pPersonId);
            RETURN FALSE;
    END;
