    PROCEDURE warningMsg(pMsg1 IN VARCHAR2, pMsg2 IN VARCHAR2) IS
    BEGIN
        errIndx := errIndx + 1;
        l_err_tbl(errIndx).task_num := pMsg1;
        l_err_tbl(errIndx).message := pMsg2;
    END warningMsg;
    ----------------------------------------------------------------------------
    
    BEGIN
        G_log_type := 'LOG';
        write_log(G_log_type, 'Begin reco_project_api.create_project; pProjNum: '||pProjNum);
        write_log(G_log_type, 'Initializing return status to SUCCESS');
        errbuf := G_CONC_PROG_SUCC_MSG;
        retcode := G_CONC_PROG_SUCC_CODE;
        
        initialize_global_vars;
        errIndx := 0;
        
        write_log(G_log_type, 'Refresh template ids');
        refreshTemplateIds(l_return_status);
        IF l_return_status <> 'S' THEN
            RAISE RECO_PROJ_API_ERROR;
        END IF;
        write_log(G_log_type, 'UP templateId: '||G_UP_TEMPLATE_ID);
        write_log(G_log_type, 'LS templateId: '||G_LS_TEMPLATE_ID);
        
        --validate parameter
        write_log(G_log_type, 'Validate parameter');
        IF pProjNum IS NULL THEN
            RAISE INVALID_PARAMETER;
        END IF;        
        
        write_log(G_log_type, 'Check if contract exists');
        IF NOT contractExists(pProjNum) THEN
            RAISE INVALID_CONTRACT;
        END IF;        
        
        FOR contractRec IN contractInfo LOOP
            write_log(G_log_type, 'Populate project rec');
            
            l_template_id := getProjectTemplateId(contractRec.reco_project_id, l_project_type, l_project_billing, l_return_status);
            IF l_return_status <> 'S' THEN
                RAISE RECO_PROJ_API_ERROR;
            END IF;
            
            write_log(G_log_type, 'Project Type: '||l_project_type);
            write_log(G_log_type, 'Project Billing: '||l_project_billing);
            write_log(G_log_type, 'Template Id: '||l_template_id);
            
            l_inv_format_id := NULL;
            l_inv_format_desc := NULL;
            
            OPEN cInvFormat(l_project_type, l_project_billing);
            FETCH cInvFormat INTO l_inv_format_id, l_inv_format_desc;
            CLOSE cInvFormat; 
            
            write_log(G_log_type, 'Invoice Format Id: '||l_inv_format_id);
            write_log(G_log_type, 'Invoice Format Desc: '||l_inv_format_desc);
            
            IF l_inv_format_id IS NULL THEN
                warningMsg('INAVLID INV FMT', 'Unable to get invoice format for project type '||l_project_type||' and billing condt. '||l_project_billing);                
            END IF;
            
            l_inv_comment := contractRec.po_number||' dd '||contractRec.po_date||CHR(10)||
                             contractRec.owner_cont_no||CHR(10)||
                             contractRec.owner_proj_no||CHR(10)||
                             UPPER(contractRec.county);
            write_log(G_log_type, 'Invoice Comment: '||l_inv_comment);
            
            l_project_in.pa_project_number          := contractRec.project_number;
            l_project_in.project_name               := UPPER(SUBSTR(contractRec.project_name, 1,26)||', '||contractRec.state);
            l_project_in.long_name                  := UPPER(contractRec.project_name ||', '||contractRec.city||', '||contractRec.county||', '||contractRec.state);
            l_project_in.pm_project_reference       := contractRec.project_number;
            --l_project_in.description                := contractRec.project_desc;
            l_project_in.project_status_code        := 'UNAPPROVED';
            l_project_in.start_date                 := TRUNC(SYSDATE, 'MONTH'); --NVL(contractRec.est_start_date, SYSDATE); 
            --l_project_in.completion_date            := contractRec.est_completion_date;
            l_project_in.attribute_category         := 'Billing Information';
            l_project_in.attribute1                 := contractRec.billing_date;
            l_project_in.attribute4                 := contractRec.ebilling_type;
            SELECT DECODE(contractRec.notify_pm_ebilling, 'Y', 'YES', NULL)
            INTO l_project_in.attribute5
            FROM dual;
            l_project_in.attribute10                := contractRec.five_cubits;
            l_project_in.created_from_project_id    := l_template_id;
            
            -- Added by Komal 17-AUG-2026
            -- Default Job Cost Steel Freeze Date from Contract Package.
            -- Job Cost may override this value later if required.
            IF contractRec.steel_freeze_date IS NOT NULL THEN
               l_project_in.attribute7 :=
                   TO_CHAR(contractRec.steel_freeze_date, 'YYYY/MM/DD');
            END IF;
            
            --populate key members
            write_log(G_log_type, 'Populate key members');
            
            l_pm_person_id := getProjectMgrId(contractRec.project_manager, l_return_status);            
            IF l_return_status <> 'S' THEN
                RAISE RECO_PROJ_API_ERROR;
            END IF;            
            IF validEmployee(l_pm_person_id) THEN
                indx := 1;
                l_key_members(indx).person_id := l_pm_person_id;
                l_key_members(indx).project_role_type := G_PROJ_MGR_ROLE; 
                write_log(G_log_type, 'PM person_id: '||l_pm_person_id);
            ELSE
                write_log(G_log_type, 'Invalid PM person_id: '||l_person_id);
                warningMsg('INVALID EMPLOYEE', 'Invalid employee in HR '||contractRec.project_manager);
            END IF;
            
            
            l_person_id := getProjMemId(contractRec.region, 'DM', l_pm_person_id, l_mem_user_name, l_return_status);
            IF l_return_status <> 'S' THEN
                RAISE RECO_PROJ_API_ERROR;
            END IF;
            IF validEmployee(l_person_id) THEN
                indx := indx + 1;
                l_key_members(indx).person_id := l_person_id;
                l_key_members(indx).project_role_type := G_DIV_MGR_ROLE; 
                write_log(G_log_type, 'DM person_id: '||l_person_id);
            ELSE
                write_log(G_log_type, 'Invalid DM person_id: '||l_person_id);
                warningMsg('INVALID EMPLOYEE', 'Invalid employee in HR '||l_mem_user_name);
            END IF;
            
            
            l_person_id := getProjMemId(contractRec.region, 'RM', l_pm_person_id, l_mem_user_name, l_return_status);
            IF l_return_status <> 'S' THEN
                RAISE RECO_PROJ_API_ERROR;
            END IF;
            IF validEmployee(l_person_id) THEN
                indx := indx + 1;
                l_key_members(indx).person_id := l_person_id;
                l_key_members(indx).project_role_type := G_REG_MGR_ROLE; 
                write_log(G_log_type, 'RM person_id: '||l_person_id);
            ELSE
                write_log(G_log_type, 'Invalid RM person_id: '||l_person_id);
                warningMsg('INVALID EMPLOYEE', 'Invalid employee in HR '||l_mem_user_name);
            END IF;
            
            
            l_person_id := getProjMemId(contractRec.region, 'PA', l_pm_person_id, l_mem_user_name, l_return_status);
            IF l_return_status <> 'S' THEN
                RAISE RECO_PROJ_API_ERROR;
            END IF;
            IF validEmployee(l_person_id) THEN
                indx := indx + 1;
                l_key_members(indx).person_id := l_person_id; 
                l_key_members(indx).project_role_type := G_PROJ_ASST_ROLE; 
                write_log(G_log_type, 'PA person_id: '||l_person_id);
            ELSE
                write_log(G_log_type, 'Invalid PA person_id: '||l_person_id);
                warningMsg('INVALID EMPLOYEE', 'Invalid employee in HR '||l_mem_user_name);
            END IF;
            
            l_person_id := getProjMemId(contractRec.region, 'JC', l_pm_person_id, l_mem_user_name, l_return_status);
            IF l_return_status <> 'S' THEN
                RAISE RECO_PROJ_API_ERROR;
            END IF;
            IF validEmployee(l_person_id) THEN
                indx := indx + 1;
                l_key_members(indx).person_id := l_person_id;
                l_key_members(indx).project_role_type := G_JC_ADMIN_ROLE; 
                write_log(G_log_type, 'JC person_id: '||l_person_id);
            ELSE
                write_log(G_log_type, 'Invalid JC person_id: '||l_person_id);
                warningMsg('INVALID EMPLOYEE', 'Invalid employee in HR '||l_mem_user_name);
            END IF; 
            
            --Added by Rafi Syed on 05/28/2025.-- Assistant Project Manager 
--            IF contractRec.region IN ('CN','MA','MW','NE')THEN  
--            IF contractRec.region IN ('CN','MA','MW','NE','SE','FL','GTP')THEN   --updated on 03/10/2026 
            IF contractRec.region IN ('CN','MA','MW','NE','SE','FL','GTP','CE')THEN   --updated on 04/29/2026       
	            l_person_id := getProjMemId(contractRec.region, 'APM', l_pm_person_id, l_mem_user_name, l_return_status);
	            IF l_return_status <> 'S' THEN
	                RAISE RECO_PROJ_API_ERROR;
	            END IF;
	            IF validEmployee(l_person_id) THEN
	                indx := indx + 1;
	                l_key_members(indx).person_id := l_person_id;
	                l_key_members(indx).project_role_type := G_ASST_PRJ_MGR_ROLE; 
	                write_log(G_log_type, 'APM person_id: '||l_person_id);
	            ELSE
	                write_log(G_log_type, 'Invalid APM person_id: '||l_person_id);
	                warningMsg('INVALID EMPLOYEE', 'Invalid employee in HR '||l_mem_user_name);
	            END IF;
            END IF;
            
            --populate class categories    
            write_log(G_log_type, 'Populate class categories');        
            indx := 1;
            l_class_categories(indx).class_category := 'REGION';
            l_class_categories(indx).class_code := contractRec.region;
            write_log(G_log_type, 'Category REGION: '||contractRec.region);
                        
            indx := indx + 1;
            l_class_categories(indx).class_category := 'MARKET SEGMENT';
            l_class_categories(indx).class_code := UPPER(contractRec.market_segment);
            write_log(G_log_type, 'Category MARKET SEGMENT: '||contractRec.market_segment);
            
            --populate customer
            write_log(G_log_type, 'Populate customer');
            write_log(G_log_type, 'Customer Id: '||contractRec.customer_id);
            indx := 1;
            l_cust_rec.customer_id                      := contractRec.customer_id;
            l_cust_rec.project_relationship_code        := 'PRIMARY'; 
            l_cust_rec.bill_to_address_id               := getContractAddrId(contractRec.reco_project_id, 'BILLTO', l_return_status);
            IF l_return_status <> 'S' THEN
                RAISE RECO_PROJ_API_ERROR;
            END IF;
            l_cust_rec.ship_to_address_id               := getContractAddrId(contractRec.reco_project_id, 'SHIPTO', l_return_status);
            IF l_return_status <> 'S' THEN
                RAISE RECO_PROJ_API_ERROR;
            END IF;
            write_log(G_log_type, 'Got the address ids');
            l_cust_rec.customer_bill_split              := 100;
            
            l_contact_id := getContactId(contractRec.reco_project_id, l_cust_rec.bill_to_address_id, l_return_status);
            
            IF l_return_status = 'W' THEN
                warningMsg('INVALID CONTACT', 'Invalid Billing contact');
                l_cust_rec.contact_id                   := NULL; 
                l_cust_rec.project_contact_type_code    := NULL;
            ELSIF l_return_status = 'E' THEN
                RAISE RECO_PROJ_API_ERROR;
            ELSIF l_return_status = 'S' THEN
                write_log(G_log_type, 'Got the billing contact id');            
                l_cust_rec.contact_id                   := l_contact_id; 
                l_cust_rec.project_contact_type_code    := 'BILLING';
            END IF;
            
            write_log(G_log_type, 'Adding to cust table for cust rec indx '||indx);
            l_cust_tbl(indx) := l_cust_rec;
            
            
            --populate task hierachy from the template            
            write_log(G_log_type, 'Populate Overhead Task');
            indx := 0;

            FOR templateTask IN templateTaskInfo(l_template_id, 'Y') LOOP
            
                IF INSTR(templateTask.task_number, '<TASKNUM>') = 0 AND indx > 1 THEN
                    CONTINUE WHEN taskExists(templateTask.task_number, l_tasks_in);
                END IF;
                
                l_tasks_in_rec.task_start_date := NULL;
                l_tasks_in_rec.task_completion_date := NULL;
                
                IF INSTR(templateTask.task_number, '<TASKNUM>') > 0 THEN
                    FOR contractTaskRec IN contractTaskInfo(contractRec.reco_project_id) LOOP
                        l_task_number           := REPLACE(templateTask.task_number, '<TASKNUM>', contractTaskRec.task_number);
                        l_task_name             := REPLACE(templateTask.task_name, '<TASK>', contractTaskRec.task_name);
                        l_parent_task_number    := REPLACE(templateTask.parent_task_number, '<TASKNUM>', contractTaskRec.task_number);
                        
                        l_tasks_in_rec.task_name                := l_task_name;
                        l_tasks_in_rec.long_task_name           := l_task_name;          
                        l_tasks_in_rec.task_description         := l_task_name;
                        l_tasks_in_rec.pa_task_number           := l_task_number;                    
                        l_tasks_in_rec.pm_task_reference        := l_task_number;
                        l_tasks_in_rec.pm_parent_task_reference := l_parent_task_number;
                        l_tasks_in_rec.billable_flag            := templateTask.billable_flag;
                        l_tasks_in_rec.chargeable_flag          := templateTask.chargeable_flag;
                        
                        indx := indx + 1;
                        l_tasks_in(indx) := l_tasks_in_rec;
                    END LOOP;
                ELSE
                               
                    l_task_number           := templateTask.task_number;
                    l_task_name             := templateTask.task_name;
                    l_parent_task_number    := templateTask.parent_task_number;
                    
                    l_tasks_in_rec.task_name                := l_task_name;
                    l_tasks_in_rec.long_task_name           := l_task_name;          
                    l_tasks_in_rec.task_description         := l_task_name;
                    l_tasks_in_rec.pa_task_number           := l_task_number;                    
                    l_tasks_in_rec.pm_task_reference        := l_task_number;
                    l_tasks_in_rec.pm_parent_task_reference := l_parent_task_number;
                    l_tasks_in_rec.billable_flag            := templateTask.billable_flag;
                    l_tasks_in_rec.chargeable_flag          := templateTask.chargeable_flag;
                    
                    indx := indx + 1;                
                    l_tasks_in(indx) := l_tasks_in_rec;
                END IF;
            END LOOP;
            
            FOR contractTaskRec IN contractTaskInfo(contractRec.reco_project_id) LOOP
                write_log(G_log_type, RPAD('-', 15, '-'));
                write_log(G_log_type, 'Set up task for product ('||contractTaskRec.product_id||'): '||contractTaskRec.task_name||' ('||contractTaskRec.task_number||') ' ||' - Type: '||contractTaskRec.project_type||' - BY Wall: '|| contractTaskRec.invoice_by_wall||' - Design BUILD: '|| contractRec.design_build);

                /*byWall := 
                    CASE UPPER(contractTaskRec.invoice_by_wall) 
                        WHEN 'Y' THEN TRUE
                        ELSE FALSE
                    END;
                l_wall_count := 1;

                IF byWall THEN
                    l_wall_count := getWallCount(contractTaskRec.product_id);
                end if;
                */
                
                FOR templateTask IN templateTaskInfo(l_template_id, 'N') LOOP
                    --write_log(G_log_type, 'Template Task: '||templateTask.task_number);
                    IF INSTR(templateTask.task_number, '<TASKNUM>') = 0 AND indx > 1 THEN
                        CONTINUE WHEN taskExists(templateTask.task_number, l_tasks_in);
                    END IF;
            
                    --indx := indx + 1;
                    l_task_number           := REPLACE(templateTask.task_number, '<TASKNUM>', contractTaskRec.task_number);
                    l_task_name             := REPLACE(templateTask.task_name, '<TASK>', contractTaskRec.task_name);
                    l_parent_task_number    := REPLACE(templateTask.parent_task_number, '<TASKNUM>', contractTaskRec.task_number);
                    
                    l_tasks_in_rec.tasks_dff := 'N';
                    l_tasks_in_rec.attribute_category := NULL;
                    l_tasks_in_rec.attribute1 := NULL;
                    l_tasks_in_rec.attribute2 := NULL;
                    l_tasks_in_rec.attribute6 := NULL;
                    l_tasks_in_rec.task_start_date := NULL;
                    l_tasks_in_rec.task_completion_date := NULL;
                    
                    IF templateTask.parent_task_number IS NULL AND templateTask.wbs_level = 1 THEN
                        l_tasks_in_rec.tasks_dff := 'Y';
                        l_tasks_in_rec.attribute_category   := 'Billing Information';
                        
                        IF contractTaskRec.project_type = 'U' THEN
                            l_task_billing_type     := 'Unit Price';
                        ELSIF contractTaskRec.project_type = 'L' THEN
                            l_task_billing_type     := 'Lump Sum';
                        END IF;
                        l_tasks_in_rec.attribute1           := l_task_billing_type;
                        
                        IF contractTaskRec.invoice_by_wall = 'Y' THEN
                            l_tasks_in_rec.attribute2           := 'BY WALL';
                        END IF;
                    END IF;
                    
                    IF INSTR(l_task_number, 'WALL') > 0 THEN
                        l_wall_num := 0;
                        l_no_of_walls := 0;
                        
                        FOR wallRec IN contractWallInfo(contractTaskRec.product_id,  contractTaskRec.task_name, contractTaskRec.invoice_by_wall, contractRec.design_build) LOOP

                            --IF l_wall_num > 0 THEN
                            --    indx := indx + 1;
                            --END IF;
                            
                            IF wallRec.wall_order = 1000000 AND wallRec.wall_name LIKE '%POOL TASK%' THEN
                                l_wall_num := 0; --99;
                                poolTask := TRUE;
                            ELSE
                                l_wall_num := l_wall_num + 1;
                                poolTask := FALSE;
                            END IF;
                            l_no_of_walls := l_no_of_walls +1;
                            
                            SELECT DECODE(LENGTH(l_wall_num), 1, 'FM09', 'FM99999') INTO fmt FROM dual;
                            
                            l_wall_task_number           := REPLACE(l_task_number, '<WALLNUM>', TO_CHAR(l_wall_num, fmt));
                            l_wall_task_name             := REPLACE(l_task_name, '<WALL>', wallRec.wall_name);
                            
                            l_tasks_in_rec.task_name                := l_wall_task_name;
                            l_tasks_in_rec.long_task_name           := l_wall_task_name;          
                            l_tasks_in_rec.task_description         := l_wall_task_name;
                            l_tasks_in_rec.pa_task_number           := l_wall_task_number;                    
                            l_tasks_in_rec.pm_task_reference        := l_wall_task_number;
                            l_tasks_in_rec.pm_parent_task_reference := l_parent_task_number;
                            IF poolTask THEN
                                l_tasks_in_rec.billable_flag        := 'N';
                                l_tasks_in_rec.chargeable_flag      := 'N';
                            ELSE
                                l_tasks_in_rec.billable_flag        := templateTask.billable_flag;
                                l_tasks_in_rec.chargeable_flag      := templateTask.chargeable_flag;                                
                            END IF;

                            /*
                            l_structure_id := getStructureId(contractTaskRec.product_id, wallRec.wall_name);
                            
                            IF l_structure_id IS NOT NULL THEN
                                l_tasks_in_rec.tasks_dff := 'Y';
                                l_tasks_in_rec.attribute_category   := 'Structure Information';
                                l_tasks_in_rec.attribute6 := l_structure_id;
                            ELSE
                                l_tasks_in_rec.tasks_dff := 'N';
                                l_tasks_in_rec.attribute_category   := NULL;
                                l_tasks_in_rec.attribute6 := NULL;
                                write_log(G_log_type, 'Unable to get takeoff structure id for '||wallRec.wall_name);
                            END IF;
                            */
                            
                            --write_log(G_log_type, indx||') '||l_tasks_in_rec.pa_task_number );
                            indx := indx + 1;
                            l_tasks_in(indx) := l_tasks_in_rec;
                        END LOOP;
                        
                        IF l_no_of_walls = 0 THEN
                            write_log(G_log_type, 'No walls defined in contracts. Unable to create WALL tasks' );
                            warningMsg(contractTaskRec.task_number, 'No walls defined in contracts. Unable to create WALL task for TEMPLATE TASK '||templateTask.task_number);
                        END IF;
                    ELSE 
                        l_tasks_in_rec.task_name                := l_task_name;
                        l_tasks_in_rec.long_task_name           := l_task_name;          
                        l_tasks_in_rec.task_description         := l_task_name;
                        l_tasks_in_rec.pa_task_number           := l_task_number;                    
                        l_tasks_in_rec.pm_task_reference        := l_task_number;
                        l_tasks_in_rec.pm_parent_task_reference := l_parent_task_number;
                        l_tasks_in_rec.billable_flag            := templateTask.billable_flag;
                        l_tasks_in_rec.chargeable_flag          := templateTask.chargeable_flag;
                    
                        --write_log(G_log_type, indx||') '||l_tasks_in_rec.pa_task_number );
                        indx := indx + 1;
                        l_tasks_in(indx) := l_tasks_in_rec;
                    END IF;
                END LOOP; --templateTask
                write_log(G_log_type, 'Done setting up task for product: '||contractTaskRec.task_name);
                write_log(G_log_type, RPAD('-', 15, '-'));
            END LOOP; --contractTaskRec
            
            FOR idx IN l_tasks_in.first.. l_tasks_in.last LOOP
                write_log(G_log_type, idx||') '||l_tasks_in(idx).pa_task_number);
            END LOOP;

        
            --INIT_CREATE_PROJECT
            write_log(G_log_type, 'Initialize create project');
            apps.pa_project_pub.init_project;
            
            
            --CREATE_PROJECT
            write_log(G_log_type, 'Create project');
            apps.pa_project_pub.create_project(
                l_api_version_number,
                p_commit            => l_commit,
                p_init_msg_list     => l_init_msg_list,
                p_msg_count         => l_msg_count,
                p_msg_data          => l_msg_data,
                p_return_status     => l_return_status,
                p_workflow_started  => l_workflow_started,
                p_pm_product_code   => G_PM_PRODUCT_CODE,
                p_project_in        => l_project_in,
                p_project_out       => l_project_out,
                p_key_members       => l_key_members,
                p_class_categories  => l_class_categories,
                p_tasks_in          => l_tasks_in,
                p_tasks_out         => l_tasks_out,
                p_customers_in      => l_cust_tbl);
                
            -- Check for errors
            IF l_return_status != 'S' THEN
                RAISE API_ERROR;
            END IF;
            
            IF errIndx > 0 THEN
                write_log(G_log_type, 'Created project with Warning(s): '||pProjNum||', projectId: '||l_project_out.pa_project_id);
            ELSE
                write_log(G_log_type, 'Successfully created project: '||pProjNum||', projectId: '||l_project_out.pa_project_id);
            END IF;


            UPDATE pa_projects 
            SET NON_LABOR_INVOICE_FORMAT_ID = NVL(l_inv_format_id, NON_LABOR_INVOICE_FORMAT_ID),
                invoice_comment = l_inv_comment 
            WHERE project_id = l_project_out.pa_project_id;
                
            write_log(G_log_type, 'Updated project invoice-format-id to: '||l_inv_format_id);
            write_log(G_log_type, 'Updated project invoice-comment: '||l_inv_comment);
            
            --Added by Rafi Syed on 2/5/2025
			BEGIN
				SELECT count(*) INTO l_l_cnt
				FROM apps.pa_proj_fp_options
				WHERE project_id=l_project_out.pa_project_id
				AND fin_plan_option_level_code='PLAN_TYPE'
				AND all_layout_code='NPE_BUDGET';
			
			EXCEPTION WHEN OTHERS THEN
				l_l_cnt:=0;
			END;
            
            IF l_l_cnt!=0 THEN
				UPDATE apps.pa_proj_fp_options
				SET all_layout_code=l_b_layount
				WHERE project_id=l_project_out.pa_project_id
				AND fin_plan_option_level_code='PLAN_TYPE'
				AND all_layout_code='NPE_BUDGET';
	
				COMMIT;
	                
	            write_log(G_log_type, 'Updated plan type layout to: RECO Non-Periodic Budget Layout'); 
	   		ELSE
	   			write_log(G_log_type, 'NO update of plan type layout');
            END IF;
             
            write_log(G_log_type, 'Write the Output file');
            BEGIN
                write_log('OUT', 'Project '||pProjNum||' was created and set to UNAPPROVED status');
                write_log('OUT', 'Invoice Format: '||l_inv_format_desc);
                write_log('OUT', 'Invoice Comment: '||l_inv_comment);
                IF l_l_cnt!=0 THEN                 
                	write_log('OUT', 'Plan Type Layout: '||'RECO Non-Periodic Budget Layout');
		   		ELSE
		   			write_log('OUT', 'NO update of plan type layout');
	            END IF;
                write_log('OUT', '   ');
                write_log('OUT', '   ');
            EXCEPTION 
                WHEN others THEN
                    write_log(G_log_type, 'Error in writing project output: '||sqlerrm);
            END;
             
            BEGIN
                write_log('OUT', 'Customer');
                write_log('OUT', RPAD('Customer', 25, ' ')||RPAD(' ', 5, ' ')||RPAD('Bill-To Address', 50, ' ')||RPAD(' ', 5, ' ')||RPAD('Ship-To Address', 50, ' '));
                FOR idx IN l_cust_tbl.first.. l_cust_tbl.last LOOP         
                    write_log('OUT',
                        RPAD(SUBSTR(getCustomerName(l_cust_tbl(idx).customer_id), 1,25), 25, ' ')||RPAD(' ', 5, ' ')||
                        RPAD(SUBSTR(getAddress(l_cust_tbl(idx).bill_to_address_id), 1, 50), 50, ' ')||RPAD(' ', 5, ' ')||
                        RPAD(SUBSTR(getAddress(l_cust_tbl(idx).ship_to_address_id), 1, 50), 50, ' ')
                    );
                END LOOP;
                write_log('OUT', '   ');
                write_log('OUT', '   ');
            EXCEPTION 
                WHEN others THEN
                    write_log(G_log_type, 'Error in writing customer output: '||sqlerrm);
            END;
            
            BEGIN
                write_log('OUT', 'Key Members');
                write_log('OUT', RPAD('Person', 30, ' ')||RPAD(' ', 5, ' ')||RPAD('Role', 30, ' '));
                FOR idx IN l_key_members.first.. l_key_members.last LOOP         
                    write_log('OUT',
                        RPAD(getMemName(l_key_members(idx).person_id), 30, ' ')||RPAD(' ', 5, ' ')||
                        RPAD((CASE UPPER(l_key_members(idx).project_role_type) 
                                WHEN '1020' THEN 'DIVISION MANAGER'
                                WHEN '1060' THEN 'JOBCOST ADMINISTRATOR'
                                ELSE l_key_members(idx).project_role_type
                              END), 30, ' ')
                    );
                END LOOP;
                write_log('OUT', '   ');
                write_log('OUT', '   ');
            EXCEPTION 
                WHEN others THEN
                    write_log(G_log_type, 'Error in writing key members output: '||sqlerrm);
            END; 
            
            BEGIN             
                write_log('OUT', 'Class Categories');
                write_log('OUT', RPAD('Category', 25, ' ')||RPAD('Value', 30, ' '));
                FOR idx IN l_class_categories.first.. l_class_categories.last LOOP         
                    write_log('OUT',
                        RPAD(l_class_categories(idx).class_category, 25, ' ')||
                        RPAD(l_class_categories(idx).class_code, 30, ' ')
                    );
                END LOOP;
                write_log('OUT', '   ');
                write_log('OUT', '   ');
            EXCEPTION 
                WHEN others THEN
                    write_log(G_log_type, 'Error in writing class categories output: '||sqlerrm);
            END;
            
            BEGIN
                write_log('OUT', RPAD('Task', 25, ' ')||RPAD('Task Name', 30, ' '));
                FOR idx IN l_tasks_in.first.. l_tasks_in.last LOOP         
                    write_log('OUT',
                        RPAD(l_tasks_in(idx).pa_task_number, 25, ' ')||
                        RPAD(l_tasks_in(idx).task_name, 30, ' ')
                    );
                END LOOP;
            EXCEPTION 
                WHEN others THEN
                    write_log(G_log_type, 'Error in writing task output: '||sqlerrm);
            END;
            
            BEGIN
                IF errIndx > 0 THEN
                    write_log('OUT',' ');
                    write_log('OUT',' ');
                    write_log('OUT', RPAD('Warnings', 8, ' '));
                    write_log('OUT',RPAD('-', 8, '-'));
                    
                    write_log('OUT',
                        RPAD('Error Code/Task #', 25, ' ')||
                        RPAD('Error Message', 250, ' ')
                    );
                    FOR idx IN l_err_tbl.first.. l_err_tbl.last LOOP        
                        write_log('OUT',
                        RPAD(l_err_tbl(idx).task_num, 25, ' ')||
                        RPAD(l_err_tbl(idx).message, 250, ' ')
                        );
                    END LOOP;
                END IF;
            EXCEPTION 
                WHEN others THEN
                    write_log(G_log_type, 'Error in writing warnings: '||sqlerrm);
            END;
            
            --pProjId := l_project_out.pa_project_id;
            IF errIndx > 0 THEN
                write_log(G_log_type, 'errIndx > 0; setting the return status to WARNING');
                retcode  := G_CONC_PROG_WARN_CODE;
                errbuf  := G_CONC_PROG_WARN_MSG;
            END IF;
            
            write_log(G_log_type, 'End reco_project_api.create_project');
            
        END LOOP; --contractRec                    
        
    EXCEPTION
        WHEN INVALID_PARAMETER THEN
            ROLLBACK;
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;            
            write_log(G_log_type, 'Invalid parameter: '||pProjNum);
            fnd_file.CLOSE;
            
        WHEN INVALID_CONTRACT THEN
            ROLLBACK;
            write_log(G_log_type, 'Invalid contract for: '||pProjNum);
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
            
        WHEN RECO_PROJ_API_ERROR THEN
            ROLLBACK;
            write_log(G_log_type, 'RECO PROJECT API Error');
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
            
        WHEN API_ERROR THEN
            ROLLBACK;
            write_log(G_log_type, 'Project API Error');
            
            IF l_msg_count >= 1 THEN
                FOR I IN 1..l_msg_count LOOP
                    apps.pa_interface_utils_pub.get_messages(
                        p_msg_data      => l_msg_data,
                        p_encoded       => 'F',
                        p_data          => l_data,
                        p_msg_count     => l_msg_count,
                        p_msg_index     => l_msg_count,   
                        p_msg_index_out => l_msg_index_out);
                    
                    write_log(G_log_type, 'API Error Msg: '||l_data);
                END LOOP;
            END IF;
            
            retcode := G_CONC_PROG_ERR_CODE;   
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
        WHEN OTHERS THEN
            ROLLBACK;
            write_log(G_log_type, 'Project API Other exception: '||sqlerrm);
            
            IF l_msg_count >= 1 THEN
                FOR I IN 1..l_msg_count LOOP
                    apps.pa_interface_utils_pub.get_messages(
                        p_msg_count     => l_msg_count,
                        p_encoded       => 'F',
                        p_msg_data      => l_msg_data,
                        p_data          => l_data,
                        p_msg_index     => l_msg_count,    
                        p_msg_index_out => l_msg_index_out);
                    
                    write_log(G_log_type, 'Other Exception Msg: '||l_data);
                END LOOP;
            END IF;
            retcode := G_CONC_PROG_ERR_CODE;   
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
    END create_project;
