        --
        
        -- Predefined Composit data types
        l_project_in          apps.PA_PROJECT_PUB.PROJECT_IN_REC_TYPE;
        l_project_out         apps.PA_PROJECT_PUB.PROJECT_OUT_REC_TYPE;
        l_key_members         apps.PA_PROJECT_PUB.PROJECT_ROLE_TBL_TYPE;
        l_class_categories    apps.PA_PROJECT_PUB.CLASS_CATEGORY_TBL_TYPE;
        l_tasks_in_rec        apps.PA_PROJECT_PUB.TASK_IN_REC_TYPE;
        l_tasks_in            apps.PA_PROJECT_PUB.TASK_IN_TBL_TYPE;
        l_tasks_out_rec       apps.PA_PROJECT_PUB.TASK_OUT_REC_TYPE;
        l_tasks_out           apps.PA_PROJECT_PUB.TASK_OUT_TBL_TYPE;
