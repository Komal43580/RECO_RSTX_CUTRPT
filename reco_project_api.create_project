    PROCEDURE write_log(pLogType IN VARCHAR2, pLogMsg IN VARCHAR2) IS
    BEGIN
        IF pLogType = 'LOG' THEN
           fnd_file.put_line(fnd_file.LOG, pLogMsg); 
        ELSIF pLogType = 'OUT' THEN
            fnd_file.put_line(fnd_file.OUTPUT, pLogMsg);
        ELSIF pLogType = 'TABLE' THEN
            INSERT INTO reco_temp_messages(message) VALUES (pLogMsg);
        ELSE
            dbms_output.put_line(pLogMsg);
        END IF;
    END;
