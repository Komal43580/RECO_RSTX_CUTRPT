    PROCEDURE close_pc_projects(
        errbuf OUT VARCHAR2, 
        retcode OUT NUMBER,
        pCompletionDate IN VARCHAR2
        )IS
        
        CURSOR PCProjects IS
        SELECT p.segment1 project_num, p.name project_name, p.project_id 
        	  ,p.start_date --Added by Rafi Syed on 01/02/2025
        FROM pa_projects P
        WHERE p.project_status_code = 'PENDING_CLOSE'
        --AND p.segment1 = '17885'--'16972' 
        ORDER BY p.segment1;
        
        l_api_version_number    NUMBER := 1.0;
        l_commit            	VARCHAR2(1) := 'F';
        l_return_status         VARCHAR2(1);
        l_init_msg_list         VARCHAR2(1) := 'F';
        l_msg_count             NUMBER;
        l_msg_index_out         NUMBER;
        l_msg_data              VARCHAR2(2000);
        l_data            	    VARCHAR2(2000);
        l_workflow_started      VARCHAR2(1) := 'Y';
        l_completion_date       date;
        idx                     integer;
        
        l_project_in            apps.PA_PROJECT_PUB.PROJECT_IN_REC_TYPE;
        l_project_out           apps.PA_PROJECT_PUB.PROJECT_OUT_REC_TYPE;
        l_tasks_in              apps.PA_PROJECT_PUB.TASK_IN_TBL_TYPE;
        l_tasks_out             apps.PA_PROJECT_PUB.TASK_OUT_TBL_TYPE;       
        
        UPDATE_API_ERR          EXCEPTION;
        
        TYPE PROJ_REC_TYPE IS record(
            proj_num    varchar2(15),
            proj_date   date,
            status      varchar2(2),
            message     VARCHAR2(500)
        );  
              
        TYPE PROJ_TBL_TYPE IS TABLE OF PROJ_REC_TYPE INDEX BY BINARY_INTEGER;        
        l_proj_tbl  PROJ_TBL_TYPE; 
        
    BEGIN
        G_log_type := 'LOG';
        write_log(G_log_type, 'BEGIN reco_project_api.close_pc_projects: '||pCompletionDate);
        errbuf := G_CONC_PROG_SUCC_MSG;
        retcode := G_CONC_PROG_SUCC_CODE;
        initialize_global_vars;
        
        l_completion_date := FND_DATE.CANONICAL_TO_DATE(pCompletionDate);
        
        idx := 0;
        FOR pcp IN PCProjects LOOP
        BEGIN
            idx := idx + 1;
            
            l_project_in.pa_project_number          := pcp.project_num;  
            l_project_in.pa_project_id              := pcp.project_id;        
            l_project_in.project_status_code        := 'CLOSED';   
            l_project_in.completion_date            := l_completion_date;
            l_project_in.start_date                 := pcp.start_date; --Added by Rafi Syed on 01/02/2025
            
            write_log(G_log_type,l_project_in.pa_project_id||'-'||l_project_in.pa_project_number);
            
            apps.pa_project_pub.UPDATE_project(
                p_api_version_number    => l_api_version_number,
                p_commit                => l_commit,
                p_init_msg_list         => l_init_msg_list,
                p_msg_count             => l_msg_count,
                p_msg_data              => l_msg_data,
                p_return_status         => l_return_status,
                p_workflow_started      => l_workflow_started,
                p_pm_product_code       => G_PM_PRODUCT_CODE,
                p_project_in            => l_project_in,
                p_project_out           => l_project_out,
                p_tasks_in              => l_tasks_in,
                p_tasks_out             => l_tasks_out);
                
            --write_log(G_log_type,l_return_status||'-'||l_msg_data);
            
            l_proj_tbl(idx).proj_num := pcp.project_num;
            l_proj_tbl(idx).proj_date := l_completion_date;
            l_proj_tbl(idx).status := l_return_status;
            
            IF l_return_status != 'S' THEN
                RAISE UPDATE_API_ERR;
            END IF;
            
            l_proj_tbl(idx).message := NULL;
        EXCEPTION
            WHEN UPDATE_API_ERR THEN
            ROLLBACK;
            write_log(G_log_type,'Update Project API Error');
            
            IF l_msg_count >= 1 THEN
                FOR I IN 1..l_msg_count LOOP
                    apps.pa_interface_utils_pub.get_messages(
                        p_msg_data      => l_msg_data,
                        p_encoded       => 'F',
                        p_data          => l_data,
                        p_msg_count     => l_msg_count,
                        p_msg_index     => l_msg_count,   
                        p_msg_index_out => l_msg_index_out);
                    
                    write_log(G_log_type, 'Update Project API Error Msg: '||l_data);
                END LOOP;
            END IF;
            
            l_proj_tbl(idx).message := l_data;
            errbuf := G_CONC_PROG_WARN_MSG;
            retcode := G_CONC_PROG_WARN_CODE;        
        END;
        END LOOP; 
        
        BEGIN 
            IF idx > 0 THEN
                write_log(G_log_type, 'Write the Output file');
                
                write_log('OUT', RPAD('Project', 15, ' ')||
                                 RPAD('Completion Date', 25, ' ')||
                                 RPAD('Status', 15, ' ')||
                                 RPAD('Message', 150, ' '));
                                 
                write_log('OUT', RPAD('-', 15, '-')||
                                 RPAD('-', 25, '-')||
                                 RPAD('-', 15, '-')||
                                 RPAD('-', 150, '-'));    
                                             
                FOR idx IN l_proj_tbl.first.. l_proj_tbl.last LOOP         
                    write_log('OUT', RPAD(l_proj_tbl(idx).proj_num, 15, ' ')||
                                     RPAD(l_proj_tbl(idx).proj_date, 25, ' ')||
                                     RPAD(l_proj_tbl(idx).status, 15, ' ')||
                                     RPAD(l_proj_tbl(idx).message, 150, ' ')
                    );
                END LOOP;
            ELSE
                write_log(G_log_type, 'No Output to display');
            END IF;
        EXCEPTION 
            WHEN others THEN
                write_log(G_log_type, 'Error in writing output: '||sqlerrm);
                retcode := G_CONC_PROG_WARN_CODE;  
                errbuf := G_CONC_PROG_WARN_MSG;
        END;

        write_log(G_log_type, 'End reco_project_api.close_pc_projects');
        fnd_file.CLOSE;  
    EXCEPTION
        WHEN OTHERS THEN
            ROLLBACK;
            write_log(G_log_type, 'Update PC Projects API Other exception: '||sqlerrm);
            
            IF l_msg_count >= 1 THEN
                FOR I IN 1..l_msg_count LOOP
                    apps.pa_interface_utils_pub.get_messages(
                        p_msg_count     => l_msg_count,
                        p_encoded       => 'F',
                        p_msg_data      => l_msg_data,
                        p_data          => l_data,
                        p_msg_index     => l_msg_count,    
                        p_msg_index_out => l_msg_index_out);
                    
                    write_log(G_log_type, 'Other Exception Msg: '||l_data);
                END LOOP;
            END IF; 
            
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG;
            fnd_file.CLOSE;       
    END close_pc_projects;
