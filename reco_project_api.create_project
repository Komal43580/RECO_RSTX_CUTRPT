        l_cust_tbl            apps.PA_PROJECT_PUB.CUSTOMER_TBL_TYPE;
        l_err_tbl             ERR_TBL_TYPE;        
        
        INVALID_PARAMETER     EXCEPTION;
        INVALID_CONTRACT      EXCEPTION;
        API_ERROR             EXCEPTION;
        RECO_PROJ_API_ERROR   EXCEPTION;
       


        
        CURSOR contractInfo IS
        SELECT  * FROM reco_contracts
        WHERE project_number = pProjNum
        AND org_id = G_org_id;  --APK CA changes
        
        CURSOR contractTaskInfo(pRecoProjId NUMBER) IS
        SELECT * FROM reco_contract_tasks
        WHERE reco_project_id = pRecoProjId
        AND crm_status_code = 'Won'
        ORDER BY task_number;
        
        CURSOR templateTaskInfo(pTemplateId NUMBER, POverHead CHAR) IS
        SELECT project_id,            
                task_id,
                task_number,
                task_name,           
                (SELECT task_number
                FROM pa_tasks
                WHERE task_id = a.parent_task_id) parent_task_number,
                wbs_level,
                parent_task_id,
                billable_flag,
                chargeable_flag
        FROM pa_tasks A
        WHERE project_id = pTemplateId
        AND task_number LIKE DECODE(pOverHead, 'Y', '001%', '<TASKNUM>%')
        ORDER BY task_number, wbs_level;
        
        CURSOR contractWallInfo(pProductId NUMBER, pTaskName VARCHAR2, pByWall VARCHAR2, pDesignBuild VARCHAR2) IS
        SELECT product_id, wall_name, wall_order 
        FROM reco_task_walls 
        WHERE product_id = pProductId 
        AND pByWall = 'Y'
        UNION
        SELECT pProductId, pTaskName ||' WALL', 1 
        FROM dual
        WHERE pByWall = 'N'
        UNION
        SELECT pProductId, pTaskName||' POOL TASK', 1000000
        FROM dual
        WHERE pDesignBuild = 'Y'
        ORDER BY 3;   

        /*SELECT product_id, DECODE(pByWall, 'Y', wall_name, 'N', pTaskName) AS wall_name, wall_order FROM reco_task_walls 
        WHERE product_id = pProductId 
        AND DECODE(pByWall, 'N', 1, wall_order) = wall_order 
        UNION
        SELECT pProductId, pTaskName||' POOL TASK', 1000000
        FROM dual
        WHERE pDesignBuild = 'Y'
        AND pByWall = 'Y'
        ORDER BY wall_order; */

        CURSOR cInvFormat(pProjType VARCHAR2, pProjBilling VARCHAR2) IS
        SELECT master_value AS invoice_format_id, master_description AS invoice_format_desc 
        FROM RECO_INVOICE_BILLING_FORMAT 
        WHERE VALUE = pProjType 
        AND DESCRIPTION = pProjBilling;        
        
    FUNCTION taskExists(pTaskNum IN VARCHAR2, pTaskTbl IN apps.PA_PROJECT_PUB.TASK_IN_TBL_TYPE) RETURN BOOLEAN IS
    BEGIN
        FOR idx IN pTaskTbl.first.. pTaskTbl.last LOOP
            IF pTaskTbl(idx).pa_task_number = pTaskNum THEN
                write_log(G_log_type,'Task '||pTaskNum||' already added');
                RETURN TRUE;
            END IF;
        END LOOP;
        
        write_log(G_log_type, 'Task '||pTaskNum||' not added yet');
        RETURN FALSE;
    END taskExists;
    ----------------------------------------------------------------------------
    
    FUNCTION getMemName(pPersonId IN NUMBER) RETURN VARCHAR2 IS
        lName VARCHAR2(50);
    BEGIN
        SELECT full_name
        INTO lName 
        FROM per_people_f
        WHERE person_id = pPersonId
        AND ROWNUM = 1; 
        
        RETURN lName;
    EXCEPTION
        WHEN others THEN
            RETURN 'X';
    END getMemName;
    ----------------------------------------------------------------------------
    
    FUNCTION getCustomerName(pCustId IN NUMBER) RETURN VARCHAR2 IS
        lCustName VARCHAR2(50);
    BEGIN
        SELECT customer_name
        INTO lCustName
        FROM apps.ar_customers
        WHERE customer_id = pCustId;
        
        RETURN lCustName;
    EXCEPTION
        WHEN others THEN
            RETURN 'X';
    END getCustomerName;
    ----------------------------------------------------------------------------
    
    FUNCTION getAddress(pAddrId IN NUMBER) RETURN VARCHAR2 IS
        lAddr VARCHAR2(100);
    BEGIN
        SELECT SUBSTR(address1||' , '||city||' , '||NVL(STATE, province)||' '||postal_code||' , '||county, 1, 100) 
        INTO lAddr
        FROM apps.hz_cust_acct_sites cas, apps.hz_party_sites ps, apps.hz_locations loc
        WHERE cust_acct_site_id = pAddrId
        AND cas.party_site_id = ps.party_site_id
        AND ps.location_id = loc.location_id;
        
        RETURN lAddr;
    EXCEPTION
        WHEN others THEN
            RETURN 'X';
    END getAddress;
