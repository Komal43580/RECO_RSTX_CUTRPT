    FUNCTION getProjMemId(pRegion IN VARCHAR2, 
                          pRole IN VARCHAR2,
                          pPmId IN NUMBER,                          
                          pMemName OUT VARCHAR2,
                          pRetStatus OUT VARCHAR2) RETURN NUMBER IS
                          
        lMemberId   NUMBER;
        lQry        VARCHAR2(3000);
        --lUserName   VARCHAR2(25);
        lTable      VARCHAR2(30);
    BEGIN
        write_log(G_log_type, 'In getProjMemId; pRegion: '||pRegion||'; pRole: '||pRole);
        pRetStatus := 'S';
        
        lQry := 'SELECT DECODE(:1, 
                    ''DM'', ''RECO_DIV_MGR_REGION'',
                    ''RM'', ''RECO_REG_MGR_REGION'',
                    ''PA'', ''RECO_PROJ_ASST_REGION'',
                    ''JC'', ''RECO_JC_ADMIN_REGION'',
                    ''APM'', ''RECO_ASST_PROJ_REGION'')
                 FROM DUAL';
                 
        --write_log(G_log_type, 'getProjMemId: '||lQry);
        EXECUTE IMMEDIATE lQry INTO lTable USING pRole;
        write_log(G_log_type, 'getProjMemId: '||lTable);
        
        lQry := 'SELECT description FROM '||lTable||' WHERE VALUE = :1';        
        --write_log(G_log_type, 'getProjMemId: '||lQry);
        
        EXECUTE IMMEDIATE lQry INTO pMemName USING pRegion;

        IF pMemName = '<PM>' THEN
            lMemberId := pPmId;
        ELSE
            SELECT employee_id
            INTO lMemberId
            FROM fnd_user
            WHERE user_name = pMemName;
        END IF;

        write_log(G_log_type, 'getProjMemId returns member id: '||lMemberId);
        RETURN lMemberId;
    EXCEPTION
        WHEN others THEN
            write_log(G_log_type, 'Exception in getProjMemId: '||sqlerrm);
            pRetStatus := 'E';
            RETURN -1;
    END getProjMemId;
