    PROCEDURE add_wall_task(
            errbuf OUT VARCHAR2, 
            retcode OUT NUMBER,
            pProjNum IN VARCHAR2, 
            pTopTaskNum IN VARCHAR2, 
            pWallTaskName IN VARCHAR2) IS

        l_api_version_number    NUMBER := 1;
        l_commit            	VARCHAR2(1) := 'F';
        l_return_status         VARCHAR2(1);
        l_init_msg_list         VARCHAR2(1) := 'F';
        l_msg_count             NUMBER;
        l_msg_index_out         NUMBER;
        l_msg_data              VARCHAR2(2000);
        l_data            	    VARCHAR2(2000);

        l_project_id            NUMBER;
        l_top_task_id           NUMBER;
        l_template_id           NUMBER;
        l_parent_task_id        NUMBER;
        l_task_id               NUMBER;
        o_project_id            NUMBER;
        l_task_cnt              NUMBER;  
        l_responsibility_id	    NUMBER;
        l_user_id		        NUMBER;     
        o_proj_num              VARCHAR2(15);      
        l_task_number           VARCHAR2(25);
        l_task_name             VARCHAR2(250);
        l_responsibility_name       VARCHAR2(150);
        fmt                     VARCHAR2(10);
        
        INVALID_PROJECT     EXCEPTION;
        INVALID_PRODUCT     EXCEPTION;
        INVALID_ACCESS      EXCEPTION;
        INVALID_BILL_TYPE   EXCEPTION;
        TEMPLATE_ERROR      EXCEPTION;        
        API_ERROR           EXCEPTION;
    
        CURSOR wallTasks(pProjTemplateId NUMBER) IS
        SELECT REPLACE(t.task_number, '<TASKNUM>', pTopTaskNum) AS task_number, 
               t.task_name, t.billable_flag, t.chargeable_flag,
               REPLACE(pt.task_number, '<TASKNUM>', pTopTaskNum) AS parent_task_number
        FROM pa_tasks T, pa_tasks pt
        WHERE t.project_id = pProjTemplateId 
        AND t.task_number LIKE '%<WALLNUM>'
        AND t.parent_task_id = pt.task_id;
        
        FUNCTION billByWall(pTopTaskId IN NUMBER) RETURN BOOLEAN IS
            lByWall CHAR(1) := 'N';
        BEGIN                
            SELECT 'Y'
            INTO lByWall
            FROM pa_tasks 
            WHERE task_id = l_top_task_id
            AND attribute_category = 'Billing Information'
            AND attribute2 = 'BY WALL';
            IF lByWall = 'Y' THEN 
                RETURN TRUE;
            ELSE 
                RETURN FALSE;
            END IF;
        END billByWall;
        ------------------------------------------------------------------------
        
    BEGIN
        G_log_type := 'LOG';
        write_log(G_log_type, 'Parameters');
        write_log(G_log_type, RPAD('-', 10, '-'));
        write_log(G_log_type, 'pProjNum: '||pProjNum);
        write_log(G_log_type, 'pTopTaskNum: '||pTopTaskNum);
        write_log(G_log_type, RPAD('-', 15, '-'));
        
        write_log(G_log_type, 'Begin reco_project_api.add_wall_task; pProjNum: '||pProjNum);
        
        write_log(G_log_type, 'Initializing return status to SUCCESS');
        errbuf := G_CONC_PROG_SUCC_MSG;
        retcode := G_CONC_PROG_SUCC_CODE;
        
        initialize_global_vars;
        
        write_log(G_log_type, 'Validate Parameters');
        
        IF NOT validProject(pProjNum, l_project_id) THEN
            RAISE INVALID_PROJECT;
        END IF;
        
        write_log(G_log_type, 'ProjectId: '||l_project_id);
        IF (NOT validTask(l_project_id, pTopTaskNum, l_top_task_id) OR pTopTaskNum = '001') THEN
            RAISE INVALID_PRODUCT;
        END IF;
        
        IF NOT billByWall(l_top_task_id) THEN
            RAISE INVALID_BILL_TYPE;
        END IF;
        
        l_template_id := getTemplateId(l_project_id, l_return_status);
        IF l_return_status = 'E' THEN
            RAISE TEMPLATE_ERROR;
        END IF;
        
        SELECT DECODE(G_org_id, 0, 'Project Super User', 293, 'Project Super User - Canada', 'X')
        INTO l_responsibility_name
        FROM dual;
        write_log(G_log_type, 'Responsibility: '||l_responsibility_name);
        
        BEGIN
            SELECT user_id, responsibility_id
            INTO  l_user_id, l_responsibility_id
            FROM apps.pa_user_resp_v
            WHERE user_id = G_user_id	
            AND responsibility_name = l_responsibility_name; --'Project Super User';
        EXCEPTION
            WHEN no_data_found THEN
                write_log(G_log_type, 'No data found in user-resp view');
                RAISE INVALID_ACCESS;
        END;
        
        write_log(G_log_type, 'set global info: user_id = '||l_user_id||' responsibility_id: '||l_responsibility_id);
        -- SET GLOBAL VALUES
        apps.pa_interface_utils_pub.set_global_info(
            p_api_version_number    => 1.0,
            p_responsibility_id     => l_responsibility_id,
            p_user_id        	    => l_user_id,  
            p_msg_count             => l_msg_count,
            p_msg_data              => l_msg_data,
            p_return_status         => l_return_status);
        
        IF l_return_status <> 'S' THEN
            RAISE INVALID_ACCESS;
        END IF;
        
        write_log(G_log_type,'done with setting global info');
        
        FOR tmplt IN wallTasks(l_template_id) LOOP
            SELECT task_id
            INTO l_parent_task_id
            FROM pa_tasks
            WHERE project_id = l_project_id
            AND task_number = tmplt.parent_task_number;
            
            SELECT COUNT(*) INTO l_task_cnt
            FROM pa_tasks 
            WHERE parent_task_id = l_parent_task_id;
            l_task_cnt := l_task_cnt + 1;
            
            write_log(G_log_type, 'Task cnt: '||l_task_cnt);
            
            SELECT DECODE(LENGTH(l_task_cnt), 1, 'FM09', 'FM99999') INTO fmt FROM dual;
            l_task_number := REPLACE(tmplt.task_number, '<WALLNUM>', TO_CHAR(l_task_cnt, fmt));
            l_task_name   := REPLACE(tmplt.task_name, '<WALL>', pWallTaskName);
            
            write_log(G_log_type, 'Adding task '||l_task_number||' for parent task '||tmplt.parent_task_number);
            
            --CHECK_UNIQUE_TASK_NUMBER
            /*
            apps.pa_project_pub.check_unique_task_number(
                p_api_version_number    =>l_api_version_number,
                p_init_msg_list         => l_init_msg_list,
                p_return_status         => l_return_status,
                p_msg_count             => l_msg_count,
                p_msg_data              => l_msg_data,
                p_project_id            => l_project_id,
                p_task_number           => l_task_number,
                p_unique_task_number    => l_unique_task_num
                );
            */
        
            write_log(G_log_type,'call ps_project_pub.add_task');
            --PA_PROJECT_PUB.CHECK_ADD_SUBTASK_OK
            apps.PA_PROJECT_PUB.ADD_TASK(
                p_api_version_number    => l_api_version_number,
                p_commit                => l_commit,
                p_init_msg_list         => l_init_msg_list,
                p_msg_count             => l_msg_count,
                p_msg_data              => l_msg_data,
                p_return_status         => l_return_status,
                p_pm_product_code       => G_PM_PRODUCT_CODE,
                p_pa_project_id         => l_project_id,
                p_pm_task_reference     => l_task_number,
                p_pa_task_number        => l_task_number,
                p_task_name             => l_task_name,
                p_long_task_name        => l_task_name,
                p_task_description      => l_task_name,
                p_billable_flag         => tmplt.billable_flag,
                p_chargeable_flag       => tmplt.chargeable_flag,
                p_pa_parent_task_id     => l_parent_task_id,
                p_structure_type        => 'FINANCIAL',
                p_structure_updates_flag => 'N', 
                    -- Y runs Process Structure Updates; causes performance issue 
                    -- Pass N and once tasks are added run the process "PRC: Process Project Structure Updates" for the project.
                p_pa_project_id_out     => o_project_id,
                p_pa_project_number_out => o_proj_num,
                p_task_id               => l_task_id
            );
            
            write_log(G_log_type,'oProjectId: '||o_project_id);
            write_log(G_log_type,'oProjNum: '||o_proj_num);
            IF l_return_status != 'S' THEN
                RAISE API_ERROR;
            END IF;
            
            write_log(G_log_type,'oTaskId: '||l_task_id);
        END LOOP;
    EXCEPTION
        WHEN INVALID_PROJECT THEN
            ROLLBACK;
            write_log(G_log_type, 'Invalid parameter: '||pProjNum);
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
            
        WHEN INVALID_PRODUCT THEN
            ROLLBACK;
            write_log(G_log_type, 'Invalid product: '||pProjNum||' - '||pTopTaskNum);
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
        
        WHEN INVALID_BILL_TYPE THEN
            ROLLBACK;
            write_log(G_log_type, 'Cannot add wall task for bill BY PRODUCT task: '||pProjNum||' - '||pTopTaskNum);
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
            
        WHEN TEMPLATE_ERROR THEN
            ROLLBACK;
            write_log(G_log_type, 'Error in getting template-id for: '||pProjNum);
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
            
        WHEN INVALID_ACCESS THEN
            ROLLBACK;
            write_log(G_log_type, 'User is not authorized to execute this process');
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
            
        WHEN API_ERROR THEN
            ROLLBACK;
            write_log(G_log_type, 'Add Task API Error');
            
            IF l_msg_count >= 1 THEN
                FOR I IN 1..l_msg_count LOOP
                    apps.pa_interface_utils_pub.get_messages(
                        p_msg_data      => l_msg_data,
                        p_encoded       => 'F',
                        p_data          => l_data,
                        p_msg_count     => l_msg_count,
                        p_msg_index     => l_msg_count,   
                        p_msg_index_out => l_msg_index_out);
                    
                    write_log(G_log_type, 'API Error Msg: '||l_data);
                END LOOP;
            END IF;
                
            retcode := G_CONC_PROG_ERR_CODE;  
            errbuf := G_CONC_PROG_ERR_MSG; 
            fnd_file.CLOSE;
    END add_wall_task; 
