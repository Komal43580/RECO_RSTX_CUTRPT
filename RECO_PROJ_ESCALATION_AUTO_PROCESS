PROCEDURE PROCESS_REVENUE(P_PROJECT_NUM IN VARCHAR2 DEFAULT '%') IS
L_PROJECT_COUNT NUMBER := 0;
L_REQUEST_ID NUMBER;
L_REV_SUCCESS VARCHAR2(1);
L_USER_ID NUMBER;
L_RESPONSIBILITY_ID NUMBER;
CURSOR GETPROJECTS IS
SELECT DISTINCT a.project_id,a.segment1 project_number,b.reco_project_id,
(
SELECT user_id
FROM fnd_user f,
pa_project_players_v pp
WHERE pp.project_id = a.project_id
AND pp.role='Job Cost Administrator'
AND pp.end_date_active IS NULL
AND f.employee_id = pp.person_id
) jcadmin
FROM apps.pa_projects a,
reco_projects b
WHERE a.project_id = b.project_id
AND a.segment1 LIKE P_PROJECT_NUM
AND EXISTS
(
SELECT 1
FROM reco_contract_escalation_setup@contractstest c
WHERE c.project_id = b.reco_project_id
AND c.status IN ('COST_DISTRIBUTED','REV_ERROR')
); 

CURSOR C_TRACK(P_RECO_PROJECT_ID NUMBER) IS
SELECT bt.RECO_PROJECT_ID,bt.ESC_SETUP_ID,bt.TASK_NUMBER,bt.TRANSACTION_NUMBER
FROM RECO.RECO_ESC_BILLING_TRACK bt
WHERE bt.RECO_PROJECT_ID = P_RECO_PROJECT_ID
AND EXISTS
(
SELECT 1
FROM reco_contract_escalation_setup@contractstest c
WHERE c.esc_setup_id = bt.esc_setup_id
AND c.status IN ( 'COST_DISTRIBUTED','REV_ERROR')
); 

L_REV_COUNT NUMBER := 0; 
L_REV_ERROR_COUNT NUMBER := 0;
L_REV_FLAG VARCHAR2(1);

BEGIN
	LOG_MSG('====================================');
	LOG_MSG('PROCESS_REVENUE STARTED');
	LOG_MSG('====================================');
	
	FOR PROJROW IN GETPROJECTS LOOP
		L_PROJECT_COUNT := L_PROJECT_COUNT + 1;
		LOG_MSG('Project Number : '||PROJROW.PROJECT_NUMBER);
		LOG_MSG('Project Id : '||PROJROW.PROJECT_ID);
		L_USER_ID := PROJROW.JCADMIN;
		
		SELECT user_id,responsibility_id INTO L_USER_ID,L_RESPONSIBILITY_ID
		FROM apps.pa_user_resp_v
		WHERE user_id = L_USER_ID
		AND responsibility_name = 'Project Super User';   
		
		APPS.FND_GLOBAL.APPS_INITIALIZE(USER_ID => L_USER_ID,RESP_ID => L_RESPONSIBILITY_ID,RESP_APPL_ID => 275);
		
		L_REV_SUCCESS := 'N';  
		
		RUN_DRAFT_REVENUE(P_PROJECT_ID => PROJROW.PROJECT_ID,X_SUCCESS => L_REV_SUCCESS,X_REQUEST_ID => L_REQUEST_ID);
		
		LOG_MSG('Revenue Request Id : '||L_REQUEST_ID);
		LOG_MSG('Revenue Success : '||L_REV_SUCCESS); 
		
		IF L_REV_SUCCESS = 'Y' THEN
			FOR TRACK_REC IN C_TRACK(PROJROW.RECO_PROJECT_ID) LOOP
				BEGIN
					SELECT REVENUE_DISTRIBUTED_FLAG INTO L_REV_FLAG
					FROM PA_EXPENDITURE_ITEMS_ALL
					WHERE ORIG_TRANSACTION_REFERENCE =TRACK_REC.TRANSACTION_NUMBER;  
					
					LOG_MSG('--------------------------------');
					LOG_MSG('Transaction Number : '||TRACK_REC.TRANSACTION_NUMBER);
					LOG_MSG('Revenue Distributed Flag : '||NVL(L_REV_FLAG,'NULL'));   
					
					IF L_REV_FLAG = 'Y' THEN
						UPDATE_REVENUE_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'REVENUE_GENERATED');
						LOG_MSG('Revenue Verified');
						L_REV_COUNT := L_REV_COUNT + 1;
					ELSE
						UPDATE_REVENUE_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'REV_ERROR',P_ERROR_MESSAGE => 'Revenue Distributed Flag = N');
						LOG_MSG('Revenue NOT Verified');
						L_REV_ERROR_COUNT := L_REV_ERROR_COUNT + 1;
					END IF;  
					
				EXCEPTION WHEN NO_DATA_FOUND THEN
				UPDATE_REVENUE_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'REV_ERROR',P_ERROR_MESSAGE => 'Expenditure Item Not Found');
				LOG_MSG('Expenditure Item Not Found');
				L_REV_ERROR_COUNT :=L_REV_ERROR_COUNT + 1;
				END;
			END LOOP;
		ELSE
			FOR TRACK_REC IN C_TRACK(PROJROW.RECO_PROJECT_ID) LOOP
				UPDATE_REVENUE_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'REV_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
				L_REV_ERROR_COUNT :=L_REV_ERROR_COUNT + 1;
			END LOOP;
		END IF;
		
	END LOOP; 
	
	LOG_MSG('====================================');
	LOG_MSG('REVENUE SUMMARY');
	LOG_MSG('Projects Processed : '||L_PROJECT_COUNT);
	LOG_MSG('Revenue Generated : '||L_REV_COUNT);
	LOG_MSG('Revenue Errors : '||L_REV_ERROR_COUNT);
	LOG_MSG('Last Revenue Request Id : '||NVL(TO_CHAR(L_REQUEST_ID),'N/A'));
	LOG_MSG('===================================='); 
	
	LOG_MSG('PROCESS_REVENUE COMPLETED');
END PROCESS_REVENUE;

