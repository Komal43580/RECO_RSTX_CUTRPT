PROCEDURE ADD_ESC_TASKS(P_PROJECT_NUM IN VARCHAR2)IS 

l_api_version_number    NUMBER := 1;
l_commit            	VARCHAR2(1) := 'F';
l_return_status         VARCHAR2(1);
l_init_msg_list         VARCHAR2(1) := 'T';
l_msg_count             NUMBER;
l_msg_index_out         NUMBER;
l_msg_data              VARCHAR2(2000);
l_data            	    VARCHAR2(2000);

l_project_id            NUMBER;
l_top_task_id           NUMBER;
l_template_id           NUMBER; 
l_task_id               NUMBER;
o_project_id            NUMBER;
l_task_cnt              NUMBER;
l_responsibility_id	    NUMBER;
l_user_id		        NUMBER;
o_proj_num              VARCHAR2(15);
l_task_number           VARCHAR2(25);
l_task_name             VARCHAR2(250);
l_responsibility_name   VARCHAR2(150);
fmt                     VARCHAR2(10);
start_date   DATE;
end_date   DATE;   


-- Verify that the 
CURSOR getprojects IS
SELECT a.project_id, a.segment1, a.start_date, a.completion_date
	, (SELECT user_id FROM fnd_user f, pa_project_players_v pp
	   WHERE pp.project_id = a.project_id
	   AND pp.role='Job Cost Administrator'
	   AND pp.end_date_active is null
	   AND f.employee_id = pp.person_id ) jcadmin
	,b.reco_project_id
FROM apps.pa_projects a,reco_projects b
WHERE a.project_status_code = 'Signed' AND segment1 LIKE P_PROJECT_NUM
AND a.project_id=b.project_id
AND NOT EXISTS (SELECT * FROM reco_contract_escalation_setup@contractstest c where c.freeze_flag='Y' AND c.project_id=b.reco_project_id); 

--get new task details to be added
CURSOR gettasks (p_project_id NUMBER) IS
SELECT a.* ,
 CASE
    WHEN REGEXP_COUNT(task_number, '\.') >= 3
    THEN REGEXP_SUBSTR(task_number, '^[^.]+\.[^.]+\.[^.]+')
  END AS sub_sub_task,

  CASE
    WHEN REGEXP_COUNT(task_number, '\.') >= 2
    THEN REGEXP_SUBSTR(task_number, '^[^.]+\.[^.]+')
  END AS sub_task
FROM reco_contract_escalation_setup@contractstest a WHERE a.project_id=p_project_id and a.freeze_flag='N';

projrow getprojects%ROWTYPE;  
taskrow gettasks%ROWTYPE;
G_PM_PRODUCT_CODE   VARCHAR2(25) := 'RECO_CONTRACTS';  

l_c_t_cnt NUMBER;
l_ss_t_cnt NUMBER;
l_s_t_cnt NUMBER;
l_ss_task_id NUMBER;
l_parent_task_id NUMBER;

BEGIN 	
	get_reco_organization('0');
	
	FOR projrow IN getprojects LOOP
		
		l_user_id := projrow.jcadmin;  
		
		SELECT user_id, responsibility_id
		INTO  l_user_id, l_responsibility_id
		FROM apps.pa_user_resp_v
		WHERE user_id = l_user_id
		AND responsibility_name = 'Project Super User';
		
		apps.set_profile( l_user_id, l_responsibility_id, 275, null ); 

		-- Set global values
		apps.pa_interface_utils_pub.set_global_info(
													p_api_version_number    => 1.0,
													p_responsibility_id     => l_responsibility_id,
													p_user_id        	    => l_user_id,
													p_msg_count             => l_msg_count,
													p_msg_data              => l_msg_data,
													p_return_status         => l_return_status
													);

        IF l_return_status <> 'S' THEN
           DBMS_OUTPUT.PUT_LINE('Invalid access '||l_msg_data); 
           FND_FILE.PUT_LINE(FND_FILE.LOG,'Invalid access '||l_msg_data ) ;
           RAISE no_data_found;
        END IF;
        
		l_project_id := projrow.project_id;
		start_date := projrow.start_date;
		end_date := projrow.completion_date;
		DBMS_OUTPUT.PUT_LINE('Project:'||projrow.segment1||'-'||projrow.project_id ); 
		FND_FILE.PUT_LINE(FND_FILE.LOG,'Project:'||projrow.segment1||'-'||projrow.project_id) ;
		
		FOR taskrow IN gettasks(projrow.reco_project_id) LOOP 
		
			l_c_t_cnt :=0;
			l_ss_t_cnt :=0;
			l_s_t_cnt :=0;
			l_ss_task_id := NULL;
			l_parent_task_id := NULL;
								
			-- Task exists validation
			BEGIN 
				--Child Task Validation
				SELECT count(*) INTO l_c_t_cnt
				FROM pa_tasks
				WHERE project_id=projrow.project_id
				AND task_number=taskrow.task_number; 
				
				IF l_c_t_cnt = 0 THEN	
								
					DBMS_OUTPUT.PUT_LINE('Child Task Number:'||taskrow.task_number||' - NOT exists. Check for Sub Sub Task.' ); 
					FND_FILE.PUT_LINE(FND_FILE.LOG,'Child Task Number:'||taskrow.task_number||' - NOT exists. Check for Sub Sub Task.' ); 
                    l_c_t_cnt:=2;					
					
					--Sub Sub Task Validation
					SELECT count(*) INTO l_ss_t_cnt
					FROM pa_tasks
					WHERE project_id=projrow.project_id
					AND task_number=taskrow.sub_sub_task;   
				
						IF l_ss_t_cnt = 0 THEN					
							DBMS_OUTPUT.PUT_LINE('Sub Sub Task Number:'||taskrow.sub_sub_task||' - NOT exists. Check for Sub Task.' ); 
							FND_FILE.PUT_LINE(FND_FILE.LOG,'Sub Sub Task Number:'||taskrow.sub_sub_task||' - NOT exists. Check for Sub Task.' ); 
		                    l_ss_t_cnt:=2;						
						
						    --Sub Task Validation
							SELECT count(*) INTO l_s_t_cnt
							FROM pa_tasks
							WHERE project_id=projrow.project_id
							AND task_number=taskrow.sub_task;  
					
								IF l_s_t_cnt = 0 THEN					
									DBMS_OUTPUT.PUT_LINE('Sub Task Number:'||taskrow.sub_task||' - NOT exists. Error the record.' );  
								    FND_FILE.PUT_LINE(FND_FILE.LOG,'Sub Task Number:'||taskrow.sub_task||' - NOT exists. Error the record.' ); 
				                    l_s_t_cnt:=2;
								ELSE
								   DBMS_OUTPUT.PUT_LINE('Sub Task Number:'||taskrow.sub_task||' - already exists.' ); 
								    FND_FILE.PUT_LINE(FND_FILE.LOG,'Sub Task Number:'||taskrow.sub_task||' - already exists.' ); 
								END IF;
						ELSE
						   DBMS_OUTPUT.PUT_LINE('Sub Sub Task Number:'||taskrow.sub_sub_task||' - already exists.' ); 
						   FND_FILE.PUT_LINE(FND_FILE.LOG,'Sub Sub Task Number:'||taskrow.sub_sub_task||' - already exists.' ); 
						END IF;	 
					
				ELSE
					
					DBMS_OUTPUT.PUT_LINE('Child Task Number:'||taskrow.task_number||' - already exists.' ); 
					FND_FILE.PUT_LINE(FND_FILE.LOG,'Child Task Number:'||taskrow.task_number||' - already exists.') ;
				END IF; 
				
			EXCEPTION WHEN OTHERS THEN  
					
					DBMS_OUTPUT.PUT_LINE('EXCEPTION validating Task Number '||taskrow.task_number||' - '||SQLERRM ); 
					FND_FILE.PUT_LINE(FND_FILE.LOG,'EXCEPTION validating Task Number '||taskrow.task_number||' - '||SQLERRM) ;
			END;
			 	
			DBMS_OUTPUT.PUT_LINE('l_c_t_cnt: '||l_c_t_cnt||' - '||'l_ss_t_cnt: '||l_ss_t_cnt||' - '||'l_s_t_cnt: '||l_s_t_cnt); 
			FND_FILE.PUT_LINE(FND_FILE.LOG,'l_c_t_cnt: '||l_c_t_cnt||' - '||'l_ss_t_cnt: '||l_ss_t_cnt||' - '||'l_s_t_cnt: '||l_s_t_cnt);

			IF l_s_t_cnt=2 THEN    
			
				DBMS_OUTPUT.PUT_LINE('Main Sub task NOT Exists so error the record'); 
				FND_FILE.PUT_LINE(FND_FILE.LOG,'Main Sub task NOT Exists so error the record'); 
				UPDATE reco_contract_escalation_setup@contractstest a SET a.error_message='Main Sub Task NOT exists',a.freeze_flag='Y',a.status='ERROR'  WHERE a.project_id=projrow.reco_project_id and a.freeze_flag='N' and a.task_number=taskrow.task_number;
				COMMIT;
				CONTINUE;    
				
			ELSIF l_ss_t_cnt=2 THEN    
			
				DBMS_OUTPUT.PUT_LINE('create sub sub task - '||taskrow.sub_sub_task );
				FND_FILE.PUT_LINE(FND_FILE.LOG,'create sub sub task - '||taskrow.sub_sub_task);  
				
				--Creation Process
				--Get sub task id (Parent ID)
				SELECT task_id
				INTO l_parent_task_id
				FROM apps.pa_tasks
				WHERE project_id = projrow.project_id
				AND task_number = taskrow.sub_task; 
				
				DBMS_OUTPUT.PUT_LINE('l_parent_task_id - '||l_parent_task_id );
				FND_FILE.PUT_LINE(FND_FILE.LOG,'l_parent_task_id - '||l_parent_task_id);  


	            --PA_PROJECT_PUB.CHECK_ADD_SUBTASK_OK
	            apps.PA_PROJECT_PUB.ADD_TASK(
	                p_api_version_number    => l_api_version_number,
	                p_commit                => l_commit,
	                p_init_msg_list         => l_init_msg_list,
	                p_msg_count             => l_msg_count,
	                p_msg_data              => l_msg_data,
	                p_return_status         => l_return_status,
	                p_pm_product_code       => G_PM_PRODUCT_CODE,
	                p_pa_project_id         => l_project_id,
	                p_pm_task_reference     => taskrow.sub_sub_task,
	                p_pa_task_number        => taskrow.sub_sub_task,
	                p_task_name             => taskrow.task_name,
	                p_long_task_name        => taskrow.task_name,
	                p_task_description      => taskrow.task_name,
	               -- p_task_start_date       => t_date,
	               -- p_task_completion_date         => e_date,
	                p_billable_flag         => 'Y',
	                p_chargeable_flag       => 'Y',
	                p_pa_parent_task_id     => l_parent_task_id,
	                p_structure_type        => 'FINANCIAL',
	                p_structure_updates_flag => 'Y',
	                    -- Y runs Process Structure Updates; causes performance issue
	                    -- Pass N and once tasks are added run the process "PRC: Process Project Structure Updates" for the project.
	                p_pa_project_id_out     => o_project_id,
	                p_pa_project_number_out => o_proj_num,
	                p_task_id               => l_task_id
	            );
	
	            IF l_return_status != 'S' THEN
	                DBMS_OUTPUT.PUT_LINE( 'Proj:'||o_proj_num||' id:'||o_project_id ||' '||l_return_status||' '||l_data);  
				    FND_FILE.PUT_LINE(FND_FILE.LOG,'Proj:'||o_proj_num||' id:'||o_project_id ||' '||l_return_status||' '||l_data);  
	                RAISE no_data_found;
	            END IF;
	
	            DBMS_OUTPUT.PUT_LINE( 'Sub Sub oTaskId: '||l_task_id) ;
	            FND_FILE.PUT_LINE(FND_FILE.LOG,'Sub Sub oTaskId: '||l_task_id);    
	            
	            COMMIT;
	
	            DBMS_OUTPUT.PUT_LINE( 'Created Sub Sub Task: '||taskrow.sub_sub_task) ;
	            FND_FILE.PUT_LINE(FND_FILE.LOG,'Created Sub Sub Task: '||taskrow.sub_sub_task);   
				
				DBMS_OUTPUT.PUT_LINE('create child task - '||taskrow.task_number );
				FND_FILE.PUT_LINE(FND_FILE.LOG,'create child task - '||taskrow.task_number);   
				
				--Creation Process
				--Get sub sub task id (Parent ID)
				SELECT task_id
				INTO l_ss_task_id
				FROM apps.pa_tasks
				WHERE project_id = projrow.project_id
				AND task_number = taskrow.sub_sub_task; 
				
				DBMS_OUTPUT.PUT_LINE('l_ss_task_id - '||l_ss_task_id );
				FND_FILE.PUT_LINE(FND_FILE.LOG,'l_ss_task_id - '||l_ss_task_id);  


	            --PA_PROJECT_PUB.CHECK_ADD_SUBTASK_OK
	            apps.PA_PROJECT_PUB.ADD_TASK(
	                p_api_version_number    => l_api_version_number,
	                p_commit                => l_commit,
	                p_init_msg_list         => l_init_msg_list,
	                p_msg_count             => l_msg_count,
	                p_msg_data              => l_msg_data,
	                p_return_status         => l_return_status,
	                p_pm_product_code       => G_PM_PRODUCT_CODE,
	                p_pa_project_id         => l_project_id,
	                p_pm_task_reference     => taskrow.task_number,
	                p_pa_task_number        => taskrow.task_number,
	                p_task_name             => taskrow.task_name,
	                p_long_task_name        => taskrow.task_name,
	                p_task_description      => taskrow.task_name,
	               -- p_task_start_date       => t_date,
	               -- p_task_completion_date         => e_date,
	                p_billable_flag         => 'Y',
	                p_chargeable_flag       => 'Y',
	                p_pa_parent_task_id     => l_ss_task_id,
	                p_structure_type        => 'FINANCIAL',
	                p_structure_updates_flag => 'Y',
	                    -- Y runs Process Structure Updates; causes performance issue
	                    -- Pass N and once tasks are added run the process "PRC: Process Project Structure Updates" for the project.
	                p_pa_project_id_out     => o_project_id,
	                p_pa_project_number_out => o_proj_num,
	                p_task_id               => l_task_id
	            );
	
	            IF l_return_status != 'S' THEN
	                DBMS_OUTPUT.PUT_LINE( 'Proj:'||o_proj_num||' id:'||o_project_id ||' '||l_return_status||' '||l_data);  
				    FND_FILE.PUT_LINE(FND_FILE.LOG,'Proj:'||o_proj_num||' id:'||o_project_id ||' '||l_return_status||' '||l_data);  
	                RAISE no_data_found;
	            END IF;
	
	            DBMS_OUTPUT.PUT_LINE( 'oTaskId: '||l_task_id) ;
	            FND_FILE.PUT_LINE(FND_FILE.LOG,'oTaskId: '||l_task_id);
	            COMMIT;
	
	            DBMS_OUTPUT.PUT_LINE( 'Created Child Task: '||taskrow.task_number) ;
	            FND_FILE.PUT_LINE(FND_FILE.LOG,'Created Child Task: '||taskrow.task_number); 
				
			ELSIF l_c_t_cnt=2 THEN
				DBMS_OUTPUT.PUT_LINE('create child task - '||taskrow.task_number );
				FND_FILE.PUT_LINE(FND_FILE.LOG,'create child task - '||taskrow.task_number); 
				
				--Creation Process
				--Get sub sub task id (Parent ID)
				SELECT task_id
				INTO l_ss_task_id
				FROM apps.pa_tasks
				WHERE project_id = projrow.project_id
				AND task_number = taskrow.sub_sub_task; 
				
				DBMS_OUTPUT.PUT_LINE('l_ss_task_id - '||l_ss_task_id );
				FND_FILE.PUT_LINE(FND_FILE.LOG,'l_ss_task_id - '||l_ss_task_id);  


	            --PA_PROJECT_PUB.CHECK_ADD_SUBTASK_OK
	            apps.PA_PROJECT_PUB.ADD_TASK(
	                p_api_version_number    => l_api_version_number,
	                p_commit                => l_commit,
	                p_init_msg_list         => l_init_msg_list,
	                p_msg_count             => l_msg_count,
	                p_msg_data              => l_msg_data,
	                p_return_status         => l_return_status,
	                p_pm_product_code       => G_PM_PRODUCT_CODE,
	                p_pa_project_id         => l_project_id,
	                p_pm_task_reference     => taskrow.task_number,
	                p_pa_task_number        => taskrow.task_number,
	                p_task_name             => taskrow.task_name,
	                p_long_task_name        => taskrow.task_name,
	                p_task_description      => taskrow.task_name,
	               -- p_task_start_date       => t_date,
	               -- p_task_completion_date         => e_date,
	                p_billable_flag         => 'Y',
	                p_chargeable_flag       => 'Y',
	                p_pa_parent_task_id     => l_ss_task_id,
	                p_structure_type        => 'FINANCIAL',
	                p_structure_updates_flag => 'Y',
	                    -- Y runs Process Structure Updates; causes performance issue
	                    -- Pass N and once tasks are added run the process "PRC: Process Project Structure Updates" for the project.
	                p_pa_project_id_out     => o_project_id,
	                p_pa_project_number_out => o_proj_num,
	                p_task_id               => l_task_id
	            );
	
	            IF l_return_status != 'S' THEN
	                DBMS_OUTPUT.PUT_LINE( 'Proj:'||o_proj_num||' id:'||o_project_id ||' '||l_return_status||' '||l_data);  
				    FND_FILE.PUT_LINE(FND_FILE.LOG,'Proj:'||o_proj_num||' id:'||o_project_id ||' '||l_return_status||' '||l_data);  
	                RAISE no_data_found;
	            END IF;
	
	            DBMS_OUTPUT.PUT_LINE( 'oTaskId: '||l_task_id) ;
	            FND_FILE.PUT_LINE(FND_FILE.LOG,'oTaskId: '||l_task_id);
	            COMMIT;
	
	            DBMS_OUTPUT.PUT_LINE( 'Created Child Task: '||taskrow.task_number) ;
	            FND_FILE.PUT_LINE(FND_FILE.LOG,'Created Child Task: '||taskrow.task_number);
            
			END IF;
				
		END LOOP;	
		
	END LOOP;
	
EXCEPTION WHEN OTHERS THEN 
	DBMS_OUTPUT.PUT_LINE( 'Exception in Procedure ADD_ESC_TASKS: '||SQLERRM ) ;
	FND_FILE.PUT_LINE(FND_FILE.LOG,'Exception in Procedure ADD_ESC_TASKS: '||SQLERRM ) ;
END ADD_ESC_TASKS;     

