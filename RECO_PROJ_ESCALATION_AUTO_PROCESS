END UPDATE_BASELINE_STATUS;

PROCEDURE FREEZE_ESCALATION(P_RECO_PROJECT_ID NUMBER) IS
l_user_name VARCHAR2(100);
BEGIN 
	LOG_MSG('Calling UPDATE_ESC_PROCESSING_STATUS to freeze records');   
	SELECT USER_NAME INTO l_user_name FROM fnd_user where user_id=FND_GLOBAL.USER_ID;
	LOG_MSG('Applied By User : ' || l_user_name);
	UPDATE_ESC_PROCESSING_STATUS@contractstest(p_project_id => P_RECO_PROJECT_ID,p_freeze_flag => 'Y',p_applied_by => l_user_name,p_applied_date => SYSDATE,p_error_message => NULL);	
	LOG_MSG('Freeze completed successfully');
EXCEPTION WHEN OTHERS THEN
	ADD_ERROR('FREEZE_ESCALATION : ' || SQLERRM);
END FREEZE_ESCALATION;

PROCEDURE PROCESS_BASELINE(P_PROJECT_NUM IN VARCHAR2) IS 

L_BASELINE_SUCCESS VARCHAR2(1);
L_USER_ID NUMBER;
L_RESPONSIBILITY_ID NUMBER;
L_BUDGET_VERSION_ID NUMBER;
L_FIN_PLAN_TYPE_ID NUMBER;
L_VERSION_TYPE VARCHAR2(30);
L_VERSION_NUMBER NUMBER; 

CURSOR GETPROJECTS IS
SELECT a.project_id,a.segment1 project_number,b.reco_project_id,a.start_date,a.completion_date,
		(
		SELECT user_id
		FROM fnd_user f,
		pa_project_players_v pp
		WHERE pp.project_id = a.project_id
		AND pp.role='Job Cost Administrator'
		AND pp.end_date_active IS NULL
		AND f.employee_id = pp.person_id
		) jcadmin
FROM apps.pa_projects a,
reco_projects b
WHERE a.project_status_code='Signed'
AND a.project_id=b.project_id
AND a.segment1 LIKE P_PROJECT_NUM
AND EXISTS
(
SELECT 1
FROM reco_contract_escalation_setup@contractstest c
WHERE c.project_id = b.reco_project_id
AND c.freeze_flag = 'N'
AND c.current_escalation_flag = 'Y'
AND c.approval_status = 'APPROVED'
AND c.status IN ('FUNDED','BASELINE_ERROR')
); 

BEGIN
	LOG_MSG('PROCESS_BASELINE STARTED');  
	
	FOR PROJROW IN GETPROJECTS LOOP
	
		CLEAR_ERRORS;
		L_USER_ID := PROJROW.JCADMIN; 
		
		SELECT user_id,responsibility_id INTO L_USER_ID,L_RESPONSIBILITY_ID
		FROM apps.pa_user_resp_v
		WHERE user_id = L_USER_ID
		AND responsibility_name = 'Project Super User';   
		
		SET_PROJECT_CONTEXT(L_USER_ID,L_RESPONSIBILITY_ID);
		
--		IF PROCESS_ALREADY_COMPLETED(PROJROW.RECO_PROJECT_ID,NULL,'BASELINE','BASELINED') = 'Y' THEN
--			LOG_MSG('Project already baselined');
--			CONTINUE;
--		END IF;
		
		IF G_PROJECT_ERROR THEN  
			LOG_MSG('Context Initialization Failed');
			LOG_MSG(GET_ERROR_TEXT); 
			UPDATE_BASELINE_STATUS(PROJROW.RECO_PROJECT_ID,'BASELINE_ERROR',GET_ERROR_TEXT);
			CONTINUE;
		END IF; 
		
		GET_WORKING_BUDGET(P_PROJECT_ID => PROJROW.PROJECT_ID,X_BUDGET_VERSION_ID => L_BUDGET_VERSION_ID,X_FIN_PLAN_TYPE_ID => L_FIN_PLAN_TYPE_ID,X_VERSION_TYPE => L_VERSION_TYPE,X_VERSION_NUMBER => L_VERSION_NUMBER);
		
		IF G_PROJECT_ERROR THEN  
			LOG_MSG('GET_WORKING_BUDGET Failed');
			LOG_MSG(GET_ERROR_TEXT);
			UPDATE_BASELINE_STATUS(PROJROW.RECO_PROJECT_ID,'BASELINE_ERROR',GET_ERROR_TEXT);
			CONTINUE;
		END IF;
		
		PREPARE_BUDGET_FOR_BASELINE(P_BUDGET_VERSION_ID => L_BUDGET_VERSION_ID);  
		
		IF G_PROJECT_ERROR THEN
			LOG_MSG('PREPARE_BUDGET_FOR_BASELINE Failed');
			LOG_MSG(GET_ERROR_TEXT);
			UPDATE_BASELINE_STATUS(PROJROW.RECO_PROJECT_ID,'BASELINE_ERROR',GET_ERROR_TEXT);
			CONTINUE;
		END IF;
		
		BASELINE_PROJECT_BUDGET(P_PROJECT_ID => PROJROW.PROJECT_ID,P_FIN_PLAN_TYPE_ID => L_FIN_PLAN_TYPE_ID,X_SUCCESS => L_BASELINE_SUCCESS);
		
		IF L_BASELINE_SUCCESS = 'Y' THEN
			LOG_MSG('Baseline Completed Successfully');    
			UPDATE_BASELINE_STATUS(PROJROW.RECO_PROJECT_ID,'BASELINED');
			
			CLEAR_ERRORS;
			FREEZE_ESCALATION(PROJROW.RECO_PROJECT_ID); 
			
				IF G_ERROR_COUNT > 0 THEN 
					LOG_MSG('Freeze Escalation Failed');
					LOG_MSG(GET_ERROR_TEXT);
				END IF;
		ELSE
			LOG_MSG('Baseline API Failed');
			LOG_MSG('Baseline Error Details : ' || GET_ERROR_TEXT);
			UPDATE_BASELINE_STATUS(PROJROW.RECO_PROJECT_ID,'BASELINE_ERROR',GET_ERROR_TEXT); 
		END IF;
		
	END LOOP;
	LOG_MSG('PROCESS_BASELINE COMPLETED');
END PROCESS_BASELINE;  

PROCEDURE PROCESS_PROJECT_ESCALATION(P_PROJECT_NUM IN VARCHAR2) IS
BEGIN
	CLEAR_ERRORS;
	LOG_MSG('================================');
	LOG_MSG('ESCALATION PROCESS START');
	LOG_MSG('================================');
	
	PROCESS_TASKS(P_PROJECT_NUM);
	
	IF NOT G_PROJECT_ERROR THEN 
		CLEAR_ERRORS;
		PROCESS_BUDGET(P_PROJECT_NUM);
	END IF;
	
	IF NOT G_PROJECT_ERROR THEN 
		CLEAR_ERRORS;
		PROCESS_FUNDING(P_PROJECT_NUM);
	END IF;
	
	IF NOT G_PROJECT_ERROR THEN 
		CLEAR_ERRORS;
		PROCESS_BASELINE(P_PROJECT_NUM);
	END IF; 
	
	IF NOT G_PROJECT_ERROR THEN
		COMMIT;
	END IF;
	
	LOG_MSG('ESCALATION PROCESS COMPLETE');  
	
EXCEPTION WHEN OTHERS THEN
	ROLLBACK;
	ADD_ERROR('PROCESS_PROJECT_ESCALATION Error : '|| SQLERRM);  
END PROCESS_PROJECT_ESCALATION;

