PROCEDURE RUN_COST_DISTRIBUTION(P_PROJECT_ID IN NUMBER,X_SUCCESS OUT VARCHAR2,X_REQUEST_ID OUT NUMBER) IS 
L_WAIT_SUCCESS VARCHAR2(1);
L_LAST_DAY VARCHAR2(30);
BEGIN
	X_SUCCESS := 'N';
	LOG_MSG('================================');
	LOG_MSG('Submitting PRC: Distribute Usage and Miscellaneous Costs');
	LOG_MSG('Concurrent Program : PASDUC');
	LOG_MSG('Project ID : '||P_PROJECT_ID);
	LOG_MSG('================================');
	
	LOG_MSG('===== REQUEST CONTEXT =====');
    LOG_MSG('USER_ID='||FND_GLOBAL.USER_ID);
    LOG_MSG('RESP_ID='||FND_GLOBAL.RESP_ID);
    LOG_MSG('RESP_APPL_ID='||FND_GLOBAL.RESP_APPL_ID);
    LOG_MSG('LOGIN_ID='||FND_GLOBAL.LOGIN_ID);    
    LOG_MSG('ORG_ID='||NVL(TO_CHAR(FND_PROFILE.VALUE('ORG_ID')),'NULL'));
    LOG_MSG('MO: Operating Unit='||NVL(FND_PROFILE.VALUE('ORG_ID'),'NULL'));
    LOG_MSG('===========================');
    L_LAST_DAY := TO_CHAR(LAST_DAY(SYSDATE),'YYYY/MM/DD')|| ' 00:00:00';
	LOG_MSG('Cost Distribution Date : '||L_LAST_DAY);
	
	apps.RECO_SUBMIT_PASDUC
						(
						P_APPLICATION => 'PA',
						P_PROGRAM => 'PASDUC',
						P_ARG1 => NULL,
						P_ARG2 => TO_CHAR(P_PROJECT_ID),
						P_ARG3 => NULL,
						P_ARG4 => NULL,
						P_ARG5 => L_LAST_DAY,
						P_ARG6 => NULL,
						P_ARG7 => NULL,
						P_ARG8 => NULL,
						P_ARG9 => NULL,
						P_ARG10 => NULL,
						P_ARG11 => 'N',
						X_REQUEST_ID => X_REQUEST_ID
						);
	LOG_MSG('Request Id : '||X_REQUEST_ID);  
	
	IF X_REQUEST_ID > 0 THEN
		LOG_MSG('Concurrent Request Submitted Successfully');
	END IF;
		
	IF X_REQUEST_ID = 0 THEN
		LOG_MSG('SUBMIT_REQUEST FAILED');
		LOG_MSG('FND_MESSAGE=' || FND_MESSAGE.GET);
	END IF;
	
	IF X_REQUEST_ID > 0 THEN
		WAIT_FOR_REQUEST(P_REQUEST_ID => X_REQUEST_ID,P_PROGRAM_NAME => 'PRC: Distribute Usage and Miscellaneous Costs',X_SUCCESS => L_WAIT_SUCCESS);
		LOG_MSG('Cost Distribution Completion Status :'||L_WAIT_SUCCESS);
		X_SUCCESS := L_WAIT_SUCCESS;
	ELSE
		LOG_MSG('Unable to submit Cost Distribution');
	END IF;  
	    
EXCEPTION WHEN OTHERS THEN
	ADD_ERROR('RUN_COST_DISTRIBUTION : '||SQLERRM);
END RUN_COST_DISTRIBUTION; 

PROCEDURE PROCESS_COST_DISTRIBUTION(P_PROJECT_NUM IN VARCHAR2 DEFAULT '%') IS
L_PROJECT_COUNT NUMBER := 0;  
l_responsibility_id	    NUMBER;
l_user_id		        NUMBER;
L_COST_SUCCESS VARCHAR2(1);
L_REQUEST_ID NUMBER;
L_COST_COUNT NUMBER := 0;
L_COST_ERROR_COUNT NUMBER := 0;

CURSOR GETPROJECTS IS
SELECT DISTINCT
a.project_id,a.segment1 project_number,b.reco_project_id,
(
SELECT user_id
FROM fnd_user f,
pa_project_players_v pp
WHERE pp.project_id = a.project_id
AND pp.role = 'Job Cost Administrator'
AND pp.end_date_active IS NULL
AND f.employee_id = pp.person_id
) jcadmin
FROM apps.pa_projects a,
reco_projects b
WHERE a.project_id = b.project_id
AND a.segment1 LIKE P_PROJECT_NUM
AND EXISTS
(
SELECT 1
FROM reco_contract_escalation_setup@contractstest c
WHERE c.project_id = b.reco_project_id
AND c.status IN ( 'BILLING_IMPORTED','COST_DIST_ERROR')
);  

CURSOR C_TRACK(P_RECO_PROJECT_ID NUMBER) IS
SELECT bt.RECO_PROJECT_ID,bt.ESC_SETUP_ID,bt.TASK_NUMBER,bt.TRANSACTION_NUMBER
FROM RECO.RECO_ESC_BILLING_TRACK bt
WHERE bt.RECO_PROJECT_ID = P_RECO_PROJECT_ID
AND EXISTS
(
SELECT 1
FROM reco_contract_escalation_setup@contractstest c
WHERE c.esc_setup_id = bt.esc_setup_id
AND c.status IN ( 'BILLING_IMPORTED','COST_DIST_ERROR')
);

L_TRACK_COUNT NUMBER; 
L_EXP_ITEM_COUNT NUMBER;
BEGIN
	LOG_MSG('====================================');
	LOG_MSG('PROCESS_COST_DISTRIBUTION STARTED');
	LOG_MSG('====================================');
	
	FOR PROJROW IN GETPROJECTS LOOP
		L_PROJECT_COUNT := L_PROJECT_COUNT + 1;
		LOG_MSG('Project Number : '||PROJROW.PROJECT_NUMBER);
		LOG_MSG('Project Id : '||PROJROW.PROJECT_ID);
	
		l_user_id := projrow.jcadmin;  
		
		SELECT user_id, responsibility_id
		INTO  l_user_id, l_responsibility_id
		FROM apps.pa_user_resp_v
		WHERE user_id = l_user_id
		AND responsibility_name = 'Project Super User';    
		
		LOG_MSG('USER_ID=' || L_USER_ID);
		LOG_MSG('RESPONSIBILITY_ID=' || L_RESPONSIBILITY_ID); 
		
		LOG_MSG('================================');
		LOG_MSG('Before APPS_INITIALIZE');
		LOG_MSG('PROJECT=' || PROJROW.PROJECT_NUMBER);
		LOG_MSG('USER_ID=' || L_USER_ID);
		LOG_MSG('RESPONSIBILITY_ID=' || L_RESPONSIBILITY_ID);
		LOG_MSG('================================');
		APPS.FND_GLOBAL.APPS_INITIALIZE(USER_ID => L_USER_ID,RESP_ID => L_RESPONSIBILITY_ID,RESP_APPL_ID => 275);
		LOG_MSG('APPS_INITIALIZE COMPLETED');
		L_COST_SUCCESS := 'N';
		RUN_COST_DISTRIBUTION(P_PROJECT_ID => PROJROW.PROJECT_ID,X_SUCCESS => L_COST_SUCCESS,X_REQUEST_ID => L_REQUEST_ID);
		LOG_MSG('Cost Distribution Request Id : '||L_REQUEST_ID);
		LOG_MSG('Cost Distribution Success : '||L_COST_SUCCESS);     
		
		IF L_COST_SUCCESS <> 'Y' THEN
			LOG_MSG('Cost Distribution Failed');
			FOR TRACK_REC IN C_TRACK(PROJROW.RECO_PROJECT_ID) LOOP
				UPDATE_COST_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'COST_DIST_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
				L_COST_ERROR_COUNT := L_COST_ERROR_COUNT + 1;
			END LOOP;
			CONTINUE;
		END IF;
		
		IF L_COST_SUCCESS = 'Y' THEN
			LOG_MSG('================================');
			LOG_MSG('DISTRIBUTED TRANSACTION SUMMARY');
			LOG_MSG('================================');  
			
			SELECT COUNT(*) INTO L_TRACK_COUNT
			FROM RECO.RECO_ESC_BILLING_TRACK
			WHERE RECO_PROJECT_ID = PROJROW.RECO_PROJECT_ID;
			LOG_MSG('Tracked Transactions : '||L_TRACK_COUNT);
			
			FOR TRACK_REC IN C_TRACK(PROJROW.RECO_PROJECT_ID) LOOP
				LOG_MSG('Transaction Number : '||TRACK_REC.TRANSACTION_NUMBER);
				LOG_MSG('Task Number : '||TRACK_REC.TASK_NUMBER);
				BEGIN
					SELECT COUNT(*) INTO L_EXP_ITEM_COUNT
					FROM PA_EXPENDITURE_ITEMS_ALL
					WHERE ORIG_TRANSACTION_REFERENCE =TRACK_REC.TRANSACTION_NUMBER;
					LOG_MSG('Expenditure Item Count : '||L_EXP_ITEM_COUNT);
					
					IF L_EXP_ITEM_COUNT > 0 THEN
						LOG_MSG('EXPENDITURE ITEM VERIFIED');
						UPDATE_COST_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'COST_DISTRIBUTED');
						L_COST_COUNT := L_COST_COUNT + 1;
					ELSE
						LOG_MSG('NO EXPENDITURE ITEM FOUND');
						LOG_MSG('PASDUC completed but expenditure item was not created');
						LOG_MSG('Request Id : '||L_REQUEST_ID);
						UPDATE_COST_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'COST_DIST_ERROR',P_ERROR_MESSAGE => 'Expenditure Item Not Found. PASDUC Request='||L_REQUEST_ID);
						L_COST_ERROR_COUNT := L_COST_ERROR_COUNT + 1;
					END IF;
					
				EXCEPTION WHEN OTHERS THEN
					LOG_MSG('Expenditure Item Verification Error : '|| SQLERRM);
				END;
			END LOOP;
		END IF;
		
	END LOOP;
	IF L_PROJECT_COUNT = 0 THEN
		LOG_MSG('No projects found for Cost Distribution');
	END IF;                        
	
	LOG_MSG('====================================');
	LOG_MSG('COST DISTRIBUTION SUMMARY');
	LOG_MSG('Projects Processed : '||L_PROJECT_COUNT);
	LOG_MSG('Cost Distributed : '||L_COST_COUNT);
	LOG_MSG('Cost Errors : '||L_COST_ERROR_COUNT);
	LOG_MSG('Last PASDUC Request Id : '||NVL(TO_CHAR(L_REQUEST_ID),'N/A'));
	LOG_MSG('====================================');

	LOG_MSG('PROCESS_COST_DISTRIBUTION COMPLETED');
END PROCESS_COST_DISTRIBUTION;

