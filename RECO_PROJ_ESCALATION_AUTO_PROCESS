FUNCTION GET_DRAFT_INVOICE_NUM(P_TRANSACTION_NUMBER VARCHAR2) RETURN NUMBER IS
L_DRAFT_INVOICE_NUM NUMBER;
BEGIN
	SELECT MAX(CRDL.DRAFT_INVOICE_NUM) INTO L_DRAFT_INVOICE_NUM
	FROM apps.PA_CUST_REV_DIST_LINES_ALL CRDL,
	apps.PA_EXPENDITURE_ITEMS_ALL EI
	WHERE EI.EXPENDITURE_ITEM_ID =CRDL.EXPENDITURE_ITEM_ID
	AND EI.ORIG_TRANSACTION_REFERENCE =P_TRANSACTION_NUMBER;
		
	RETURN L_DRAFT_INVOICE_NUM;
EXCEPTION WHEN OTHERS THEN
	LOG_MSG('GET_DRAFT_INVOICE_NUM : '|| SQLERRM);
	RETURN NULL;
END GET_DRAFT_INVOICE_NUM;

PROCEDURE RUN_DRAFT_INVOICE(P_PROJECT_ID IN NUMBER,X_SUCCESS OUT VARCHAR2,X_REQUEST_ID OUT NUMBER) IS
L_WAIT_SUCCESS VARCHAR2(1);
L_DATE VARCHAR2(30);
BEGIN
	X_SUCCESS := 'N';
	LOG_MSG('================================');
	LOG_MSG('Submitting Draft Invoice');
	LOG_MSG('Concurrent Program : PRC: Generate Draft Invoices for Single Project');
	LOG_MSG('Project ID : '||P_PROJECT_ID);
	LOG_MSG('================================');
	L_DATE := TO_CHAR(LAST_DAY(SYSDATE),'YYYY/MM/DD')||' 00:00:00';
	APPS.RECO_SUBMIT_CONCURRENT_REQUEST
			(
			P_APPLICATION => 'PA',
			P_PROGRAM => 'PAIGEN_SINGLE',
			P_ARG1 => 'REGENERATE',
			P_ARG2 => TO_CHAR(P_PROJECT_ID),
			P_ARG3 => NULL,
			P_ARG4 => L_DATE,
			P_ARG12 => 'N',
			P_ARG14 => 'INCLUDE_RETN_INVOICES',
			P_ARG22 => 'N',
			P_ARG23 => 'N',
			P_ARG24 => 'N',
			P_ARG25 => 'NO',
			P_ARG26 => 'N',
			X_REQUEST_ID => X_REQUEST_ID
			); 
	LOG_MSG('Request Id : '||X_REQUEST_ID);
	IF X_REQUEST_ID > 0 THEN
		WAIT_FOR_REQUEST(P_REQUEST_ID => X_REQUEST_ID,P_PROGRAM_NAME => 'PRC: Generate Draft Invoices for Single Project',X_SUCCESS => L_WAIT_SUCCESS);
		X_SUCCESS := L_WAIT_SUCCESS;
	END IF;
EXCEPTION WHEN OTHERS THEN
ADD_ERROR('RUN_DRAFT_INVOICE : '||SQLERRM);
END RUN_DRAFT_INVOICE;

PROCEDURE CALCULATE_BILL_AMOUNT(P_TASK_ID NUMBER,P_QUANTITY NUMBER,P_BILL_RATE NUMBER,X_AMOUNT OUT NUMBER) IS
L_BILL_RATE NUMBER;
BEGIN
	L_BILL_RATE :=GET_ROUNDED_BILL_RATE(P_TASK_ID,P_BILL_RATE);
	X_AMOUNT :=ROUND(NVL(P_QUANTITY,0)*L_BILL_RATE,2);
END CALCULATE_BILL_AMOUNT; 

PROCEDURE PROCESS_INVOICE(P_PROJECT_NUM IN VARCHAR2 DEFAULT '%') IS
L_PROJECT_COUNT NUMBER := 0;
L_REQUEST_ID NUMBER;
L_INVOICE_SUCCESS VARCHAR2(1);
L_USER_ID NUMBER;
L_RESPONSIBILITY_ID NUMBER;
L_DRAFT_INVOICE_NUM NUMBER;
L_INVOICE_COUNT NUMBER := 0;
L_INVOICE_ERROR_COUNT NUMBER := 0;
CURSOR GETPROJECTS IS
SELECT DISTINCT A.PROJECT_ID,A.SEGMENT1 PROJECT_NUMBER,B.RECO_PROJECT_ID,
(
SELECT USER_ID
FROM FND_USER F,
PA_PROJECT_PLAYERS_V PP
WHERE PP.PROJECT_ID = A.PROJECT_ID
AND PP.ROLE='Job Cost Administrator'
AND PP.END_DATE_ACTIVE IS NULL
AND F.EMPLOYEE_ID = PP.PERSON_ID
) JCADMIN
FROM APPS.PA_PROJECTS A,
RECO_PROJECTS B
WHERE A.PROJECT_ID = B.PROJECT_ID
AND A.SEGMENT1 LIKE P_PROJECT_NUM
AND EXISTS
(
SELECT 1
FROM RECO_CONTRACT_ESCALATION_SETUP@CONTRACTSTEST C
WHERE C.PROJECT_ID = B.RECO_PROJECT_ID
AND C.STATUS IN('REVENUE_RELEASED','INV_ERROR'));

CURSOR C_TRACK(P_RECO_PROJECT_ID NUMBER) IS
SELECT BT.RECO_PROJECT_ID,BT.ESC_SETUP_ID,BT.TASK_NUMBER,BT.TRANSACTION_NUMBER
FROM RECO.RECO_ESC_BILLING_TRACK BT
WHERE BT.RECO_PROJECT_ID =P_RECO_PROJECT_ID
AND EXISTS
(
SELECT 1
FROM RECO_CONTRACT_ESCALATION_SETUP@CONTRACTSTEST C
WHERE C.ESC_SETUP_ID = BT.ESC_SETUP_ID
AND C.STATUS IN('REVENUE_RELEASED','INV_ERROR')
);
BEGIN
	LOG_MSG('====================================');
	LOG_MSG('PROCESS_INVOICE STARTED');
	LOG_MSG('====================================');  
	
	FOR PROJROW IN GETPROJECTS LOOP
	
		L_PROJECT_COUNT := L_PROJECT_COUNT + 1;
		L_USER_ID := PROJROW.JCADMIN;     
		
		SELECT USER_ID,RESPONSIBILITY_ID INTO L_USER_ID,L_RESPONSIBILITY_ID
		FROM APPS.PA_USER_RESP_V
		WHERE USER_ID = L_USER_ID
		AND RESPONSIBILITY_NAME ='Project Super User';     
		
		APPS.FND_GLOBAL.APPS_INITIALIZE(USER_ID => L_USER_ID,RESP_ID => L_RESPONSIBILITY_ID,RESP_APPL_ID => 275);
		
--		LOG_MSG('APPS_INITIALIZE COMPLETED');      
		
		L_INVOICE_SUCCESS := 'N';
		RUN_DRAFT_INVOICE(P_PROJECT_ID => PROJROW.PROJECT_ID,X_SUCCESS => L_INVOICE_SUCCESS,X_REQUEST_ID => L_REQUEST_ID);
		LOG_MSG('Invoice Request Id : '||L_REQUEST_ID);
		LOG_MSG('Invoice Success : '||L_INVOICE_SUCCESS);
		
		IF L_INVOICE_SUCCESS = 'Y' THEN
			FOR TRACK_REC IN C_TRACK(PROJROW.RECO_PROJECT_ID) LOOP
				L_DRAFT_INVOICE_NUM :=GET_DRAFT_INVOICE_NUM(TRACK_REC.TRANSACTION_NUMBER);
				LOG_MSG('Draft Invoice Num : ' ||NVL(TO_CHAR(L_DRAFT_INVOICE_NUM),'NULL'));   
				IF L_DRAFT_INVOICE_NUM IS NOT NULL THEN
					UPDATE_INVOICE_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'INVOICE_GENERATED');
					L_INVOICE_COUNT := L_INVOICE_COUNT + 1;
				ELSE
					UPDATE_INVOICE_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'INV_ERROR',P_ERROR_MESSAGE => 'Draft Invoice Not Found');
					L_INVOICE_ERROR_COUNT :=L_INVOICE_ERROR_COUNT + 1;
				END IF; 
			END LOOP; 
		ELSE
			FOR TRACK_REC IN C_TRACK(PROJROW.RECO_PROJECT_ID) LOOP
				UPDATE_INVOICE_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'INV_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
				L_INVOICE_ERROR_COUNT :=L_INVOICE_ERROR_COUNT + 1;
			END LOOP;
		END IF;
		
	END LOOP;  
	
	LOG_MSG('====================================');
	LOG_MSG('INVOICE SUMMARY');
	LOG_MSG('Projects Processed : '||L_PROJECT_COUNT);
	LOG_MSG('Invoices Generated : '||L_INVOICE_COUNT);
	LOG_MSG('Invoice Errors : '||L_INVOICE_ERROR_COUNT);
	LOG_MSG('Last Invoice Request Id : '||NVL(TO_CHAR(L_REQUEST_ID),'N/A'));
	LOG_MSG('====================================');
	LOG_MSG('PROCESS_INVOICE COMPLETED');

END PROCESS_INVOICE;  

PROCEDURE PROCESS_PROJECT_ESCALATION(P_PROJECT_NUM IN VARCHAR2) IS
BEGIN
	CLEAR_ERRORS;
	LOG_MSG('================================');
	LOG_MSG('ESCALATION PROCESS START');
	LOG_MSG('================================');
	
	PROCESS_TASKS(P_PROJECT_NUM);
	
	IF NOT G_PROJECT_ERROR THEN 
		CLEAR_ERRORS;
		PROCESS_BUDGET(P_PROJECT_NUM);
	END IF;
	
	IF NOT G_PROJECT_ERROR THEN 
		CLEAR_ERRORS;
		PROCESS_FUNDING(P_PROJECT_NUM);
	END IF;
	
	IF NOT G_PROJECT_ERROR THEN 
		CLEAR_ERRORS;
		PROCESS_BASELINE(P_PROJECT_NUM);
	END IF;   
	
	IF NOT G_PROJECT_ERROR THEN
		CLEAR_ERRORS;
		PROCESS_PROJECT_BILLING(P_PROJECT_NUM);
	END IF;   
	
	IF NOT G_PROJECT_ERROR THEN
		CLEAR_ERRORS;
		PROCESS_TRANSACTION_IMPORT(P_PROJECT_NUM);
	END IF;
	
	IF NOT G_PROJECT_ERROR THEN
		CLEAR_ERRORS;
		PROCESS_COST_DISTRIBUTION(P_PROJECT_NUM);
	END IF; 
	
	IF NOT G_PROJECT_ERROR THEN
		CLEAR_ERRORS;
		PROCESS_REVENUE(P_PROJECT_NUM);
	END IF;
	
	IF NOT G_PROJECT_ERROR THEN
		CLEAR_ERRORS;
		PROCESS_REVENUE_RELEASE(P_PROJECT_NUM);
	END IF; 
	
	IF NOT G_PROJECT_ERROR THEN
		CLEAR_ERRORS;
		PROCESS_INVOICE(P_PROJECT_NUM);
	END IF;
	
	IF NOT G_PROJECT_ERROR THEN
		COMMIT;
	END IF;
	
	LOG_MSG('ESCALATION PROCESS COMPLETE');  
	
EXCEPTION WHEN OTHERS THEN
	ROLLBACK;
	ADD_ERROR('PROCESS_PROJECT_ESCALATION Error : '|| SQLERRM);  
END PROCESS_PROJECT_ESCALATION;

