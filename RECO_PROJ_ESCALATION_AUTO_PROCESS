				L_RELEASE_COUNT := L_RELEASE_COUNT + 1;
				CONTINUE;
			END IF;

			
			IF L_DRAFT_REVENUE_NUM IS NULL THEN
				UPDATE_REV_RELEASE_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'REV_RELEASE_ERROR',P_ERROR_MESSAGE => 'Draft Revenue Not Found');
				L_RELEASE_ERROR_COUNT :=L_RELEASE_ERROR_COUNT + 1;
				CONTINUE;
			END IF;               
			
			L_RELEASE_SUCCESS := 'N';  
			
			BEGIN
				L_ALLOWED :=APPS.PA_DRAFT_REVENUES_PKG.ALLOW_RELEASE(X_PROJECT_ID => PROJROW.PROJECT_ID,X_DRAFT_REVENUE_NUM => L_DRAFT_REVENUE_NUM);
				IF L_ALLOWED THEN
					LOG_MSG('ALLOW_RELEASE = TRUE');
				ELSE
					LOG_MSG('ALLOW_RELEASE = FALSE');
					LOG_MSG('FND_MESSAGE = '||FND_MESSAGE.GET);
				END IF;
			END;     
			
			RELEASE_REVENUE(P_PROJECT_ID => PROJROW.PROJECT_ID,P_DRAFT_REVENUE_NUM => L_DRAFT_REVENUE_NUM,X_SUCCESS => L_RELEASE_SUCCESS); 
			
			LOG_MSG('L_RELEASE_SUCCESS='||L_RELEASE_SUCCESS);
			BEGIN
				SELECT RELEASED_DATE INTO L_RELEASE_DATE
				FROM PA_DRAFT_REVENUES_ALL
				WHERE PROJECT_ID = PROJROW.PROJECT_ID
				AND DRAFT_REVENUE_NUM = L_DRAFT_REVENUE_NUM;
				
				LOG_MSG('RELEASED_DATE='||NVL(TO_CHAR(L_RELEASE_DATE,'MM/DD/YYYY HH24:MI:SS'),'NULL'));
			EXCEPTION WHEN OTHERS THEN
				LOG_MSG('RELEASED_DATE QUERY ERROR : '||SQLERRM);
			END;
			
			SELECT COUNT(*) INTO L_RELEASED_CNT
			FROM PA_DRAFT_REVENUES_ALL
			WHERE PROJECT_ID = PROJROW.PROJECT_ID
			AND DRAFT_REVENUE_NUM = L_DRAFT_REVENUE_NUM
			AND RELEASED_DATE IS NOT NULL;
			
			LOG_MSG('L_RELEASED_CNT='||L_RELEASED_CNT);
			
			IF L_RELEASE_SUCCESS = 'Y' THEN
				UPDATE_REV_RELEASE_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'REVENUE_RELEASED');
				L_RELEASE_COUNT :=L_RELEASE_COUNT + 1;
			ELSE
				UPDATE_REV_RELEASE_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'REV_RELEASE_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
				L_RELEASE_ERROR_COUNT :=L_RELEASE_ERROR_COUNT + 1;
			END IF;
			
		END LOOP;
		
	END LOOP;
	
	LOG_MSG('====================================');
	LOG_MSG('REVENUE RELEASE SUMMARY');
	LOG_MSG('Projects Processed : '||L_PROJECT_COUNT);
	LOG_MSG('Revenue Released : '||L_RELEASE_COUNT);
	LOG_MSG('Revenue Release Errors : '||L_RELEASE_ERROR_COUNT);
	LOG_MSG('====================================');

	LOG_MSG('PROCESS_REVENUE_RELEASE COMPLETED');  
	
EXCEPTION WHEN OTHERS THEN
	ADD_ERROR('PROCESS_REVENUE_RELEASE : '|| SQLERRM);
END PROCESS_REVENUE_RELEASE;

