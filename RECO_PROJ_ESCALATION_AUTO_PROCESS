PROCEDURE INSERT_BILLING_TRANSACTION(P_PROJECT_NUMBER VARCHAR2,P_TASK_NUMBER VARCHAR2,P_COMPONENT VARCHAR2,P_QUANTITY NUMBER,P_BILL_RATE NUMBER,P_BATCH_NAME VARCHAR2,X_SUCCESS OUT VARCHAR2,X_TRANSACTION_NUMBER OUT VARCHAR2) IS
L_BILL_AMOUNT NUMBER;
expcomment   varchar2(240) := NULL;
isnegative  varchar2(1) := 'N';
adjusteddate date := NULL;
adjustedeow  date := NULL;  
tinum varchar2(100);
tvalue  number;
L_UOM VARCHAR2(30);
L_EXPENDITURE_TYPE VARCHAR2(100);
L_EMPLOYEE_NUMBER VARCHAR2(30);
L_TASK_ID NUMBER;

BEGIN
	X_SUCCESS := 'N';
	adjusteddate := sysdate;
	adjustedeow := TRUNC(adjusteddate+(8-TO_NUMBER(TO_CHAR(TRUNC(adjusteddate),'d'))));
	
	SELECT transentry_seq.NEXTVAL INTO tvalue FROM dual;

	tinum := 'ESC_'||TO_CHAR(tvalue);
	X_TRANSACTION_NUMBER := tinum;
	expcomment := 'Escalation Transaction_'||TO_CHAR(SYSDATE,'DD-MM-YYYY HH24:MI:SS');
	
	LOG_MSG('Transaction Number : '||tinum);
	LOG_MSG('Batch Name : '||P_BATCH_NAME);
	LOG_MSG('Comment : '||expcomment);
	LOG_MSG('EOW Date : '||TO_CHAR(adjustedeow,'DD-MON-YYYY'));  
	
	SELECT task_id INTO L_TASK_ID
	FROM pa_tasks WHERE task_number = P_TASK_NUMBER
	AND project_id =(SELECT project_id FROM pa_projects WHERE segment1 = P_PROJECT_NUMBER );
		
	CALCULATE_BILL_AMOUNT(L_TASK_ID,P_QUANTITY,P_BILL_RATE,L_BILL_AMOUNT);  
	
	LOG_MSG('INSERT_BILLING_TRANSACTION');
	LOG_MSG('Project Number : '||P_PROJECT_NUMBER);
	LOG_MSG('Task Number : '||P_TASK_NUMBER);   
	LOG_MSG('Task ID : '||L_TASK_ID);
	LOG_MSG('Bill Amount : '||L_BILL_AMOUNT); 
	
	BEGIN
		SELECT a.uom INTO L_UOM
		FROM reco.reco_contract_tasks a,reco_contracts b
		WHERE a.reco_project_id = b.reco_project_id
		AND a.task_number = SUBSTR(P_TASK_NUMBER,1,3)
		AND b.project_number = P_PROJECT_NUMBER;
		
		LOG_MSG('UOM : '||L_UOM);
	EXCEPTION WHEN NO_DATA_FOUND THEN
		ADD_ERROR('UOM not found for task '||P_TASK_NUMBER);
		RETURN;
	END;
	
	L_EXPENDITURE_TYPE :=GET_EXPENDITURE_TYPE(P_COMPONENT,L_UOM);
	LOG_MSG('EXPENDITURE TYPE : '||L_EXPENDITURE_TYPE); 
	
	IF L_EXPENDITURE_TYPE IS NULL THEN
		ADD_ERROR('Unable to derive expenditure type');
		RETURN;
	END IF;  
	
	L_EMPLOYEE_NUMBER := 
GET_EMPLOYEE_NUMBER(P_PROJECT_NUMBER); 
	LOG_MSG('Employee Number : '||L_EMPLOYEE_NUMBER);
	
	IF L_EMPLOYEE_NUMBER IS NULL THEN
		ADD_ERROR('Unable to derive employee number');
		RETURN;
	END IF;  
	
	 
	INSERT INTO apps.pa_transaction_interface_all
	(
	transaction_source,batch_name,expenditure_ending_date,expenditure_item_date,project_number,task_number,expenditure_type,employee_number
	,quantity, denom_raw_cost,transaction_status_code,orig_transaction_reference,unmatched_negative_txn_flag,expenditure_comment,org_id
	)
	VALUES
	(
	'RECO Billing Units',P_BATCH_NAME,adjustedeow,adjusteddate,P_PROJECT_NUMBER,P_TASK_NUMBER,L_EXPENDITURE_TYPE,L_EMPLOYEE_NUMBER
	,NVL(P_QUANTITY,0),0,'P',tinum,isnegative,expcomment,0
	);

	X_SUCCESS := 'Y';
EXCEPTION WHEN OTHERS THEN
	ADD_ERROR('INSERT_BILLING_TRANSACTION : '||SQLERRM);
END INSERT_BILLING_TRANSACTION;

PROCEDURE PROCESS_PROJECT_BILLING(P_PROJECT_NUM IN VARCHAR2) IS
	L_PROJECT_COUNT NUMBER := 0;
	CURSOR GETPROJECTS IS
	SELECT a.project_id,
	a.segment1 project_number,
	b.reco_project_id
	, (SELECT user_id FROM fnd_user f, pa_project_players_v pp
	   WHERE pp.project_id = a.project_id
	   AND pp.role='Job Cost Administrator'
	   AND pp.end_date_active is null
	   AND f.employee_id = pp.person_id ) jcadmin
	FROM apps.pa_projects a,
	reco_projects b
	WHERE a.project_id = b.project_id
	AND a.segment1 LIKE P_PROJECT_NUM
	AND EXISTS
	(
	SELECT 1
	FROM reco_contract_escalation_setup@contractstest c
	WHERE c.project_id = b.reco_project_id
	AND c.freeze_flag = 'Y'
	AND c.current_escalation_flag = 'Y'
	AND c.approval_status = 'APPROVED'
	AND c.status IN ('BASELINED','BILLING_ERROR')
	);
	
	CURSOR GETTASKS(P_RECO_PROJECT_ID NUMBER) IS
	SELECT *
	FROM reco_contract_escalation_setup@contractstest
	WHERE project_id = P_RECO_PROJECT_ID
	AND freeze_flag = 'Y'
	AND current_escalation_flag = 'Y'
	AND approval_status = 'APPROVED'
	AND status IN ('BASELINED','BILLING_ERROR');
	
	PROJROW GETPROJECTS%ROWTYPE;
	TASKROW GETTASKS%ROWTYPE; 
	L_BILLING_SUCCESS VARCHAR2(1);
	L_TRANSACTION_NUMBER VARCHAR2(100);
	L_TRANSACTION_LIST VARCHAR2(4000);    
	
	TYPE T_PROJECTS IS TABLE OF VARCHAR2(30) INDEX BY PLS_INTEGER;
	L_PROJECTS T_PROJECTS;
	L_PROJECT_INDEX NUMBER := 0;
	
	L_BATCH_NAME VARCHAR2(100);
	L_TXN_COUNT NUMBER := 0;
	L_REJECT_COUNT NUMBER := 0;
	
	CURSOR C_TRACK IS
	SELECT RECO_PROJECT_ID,ESC_SETUP_ID,TASK_NUMBER,TRANSACTION_NUMBER
	FROM RECO.RECO_ESC_BILLING_TRACK
	WHERE BATCH_NAME = L_BATCH_NAME;
	L_EXISTS1 NUMBER;
	l_responsibility_id	    NUMBER;
	l_user_id		        NUMBER;

BEGIN
	LOG_MSG('PROCESS_PROJECT_BILLING STARTED');  
	L_BATCH_NAME :='ESC_BATCH_' ||TO_CHAR(SYSDATE,'YYYYMMDDHH24MISS');
	LOG_MSG('Batch Name : ' || L_BATCH_NAME);
	
	FOR PROJROW IN GETPROJECTS LOOP     
	
		l_user_id := projrow.jcadmin;  
		
		SELECT user_id, responsibility_id
		INTO  l_user_id, l_responsibility_id
		FROM apps.pa_user_resp_v
		WHERE user_id = l_user_id
		AND responsibility_name = 'Project Super User';   
	
		L_PROJECT_COUNT := L_PROJECT_COUNT + 1;
		L_PROJECT_INDEX := L_PROJECT_INDEX + 1;
		L_PROJECTS(L_PROJECT_INDEX) := PROJROW.PROJECT_NUMBER;

		L_TRANSACTION_LIST := NULL;
		LOG_MSG('Project : '||PROJROW.PROJECT_NUMBER);   
		
		FOR TASKROW IN GETTASKS(PROJROW.RECO_PROJECT_ID) LOOP   
			CLEAR_ERRORS;
			L_BILLING_SUCCESS := 'N';    
			L_EXISTS1 := 0;
			 
			BEGIN
				SELECT COUNT(*) INTO L_EXISTS1 FROM RECO.RECO_ESC_BILLING_TRACK 
				WHERE RECO_PROJECT_ID = PROJROW.RECO_PROJECT_ID
				AND ESC_SETUP_ID = TASKROW.ESC_SETUP_ID;
			EXCEPTION WHEN OTHERS THEN
				L_EXISTS1 := 0;
			END;
			IF L_EXISTS1 > 0 THEN
				LOG_MSG('Billing Transaction already exists for ESC_SETUP_ID='||TASKROW.ESC_SETUP_ID||'. Skipping creation.');
				 
				CONTINUE;
			END IF;
			INSERT_BILLING_TRANSACTION(P_PROJECT_NUMBER => PROJROW.PROJECT_NUMBER,P_TASK_NUMBER => TASKROW.TASK_NUMBER,P_COMPONENT => TASKROW.COMPONENT,P_QUANTITY => TASKROW.QUANTITY,P_BILL_RATE => TASKROW.BILL_RATE,P_BATCH_NAME => L_BATCH_NAME,X_SUCCESS => L_BILLING_SUCCESS,X_TRANSACTION_NUMBER => L_TRANSACTION_NUMBER);
			
			
			LOG_MSG('Billing Success : '||L_BILLING_SUCCESS); 
			IF L_BILLING_SUCCESS = 'Y' THEN 
				L_TXN_COUNT := L_TXN_COUNT + 1;
				L_TRANSACTION_LIST :=L_TRANSACTION_LIST ||CHR(10) ||L_TRANSACTION_NUMBER ||' - ' ||TASKROW.TASK_NUMBER;     
				
				INSERT INTO RECO.RECO_ESC_BILLING_TRACK
				(RECO_PROJECT_ID,ESC_SETUP_ID,TASK_NUMBER,TRANSACTION_NUMBER,BATCH_NAME,CREATION_DATE)
				VALUES(PROJROW.RECO_PROJECT_ID,TASKROW.ESC_SETUP_ID,TASKROW.TASK_NUMBER,L_TRANSACTION_NUMBER,L_BATCH_NAME,SYSDATE);
				
				UPDATE_BILLING_STATUS(P_RECO_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_ESC_SETUP_ID => TASKROW.ESC_SETUP_ID,P_TASK_NUMBER => TASKROW.TASK_NUMBER,P_STATUS => 'BILLING_CREATED');
			ELSE
				L_REJECT_COUNT := L_REJECT_COUNT + 1;
				UPDATE_BILLING_STATUS(P_RECO_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_ESC_SETUP_ID => TASKROW.ESC_SETUP_ID,P_TASK_NUMBER => TASKROW.TASK_NUMBER,P_STATUS => 'BILLING_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
			END IF; 
		END LOOP;
		LOG_MSG('====================================');
		LOG_MSG('Billing Summary');
		LOG_MSG('Project : '||PROJROW.PROJECT_NUMBER);
		
		IF L_TRANSACTION_LIST IS NOT NULL THEN
			LOG_MSG('Transactions Inserted:');
			LOG_MSG(L_TRANSACTION_LIST);
		ELSE
			LOG_MSG('No Transactions Inserted');
		END IF;
		LOG_MSG('====================================');
	END LOOP;
	
	IF L_TXN_COUNT > 0 THEN
		LOG_MSG('====================================');
		LOG_MSG('INTERFACE RECORD CREATION COMPLETED');
		LOG_MSG('Batch Name : '||L_BATCH_NAME);
		LOG_MSG('Transactions Created : '||L_TXN_COUNT);
		LOG_MSG('Status Updated To BILLING_CREATED');
		LOG_MSG('Ready For Transaction Import');
		LOG_MSG('====================================');
	END IF; 

	IF L_PROJECT_COUNT = 0 THEN
	LOG_MSG('No eligible records found for processing. Records may have already been processed or are not in a valid status.');
	END IF;
	LOG_MSG('PROCESS_PROJECT_BILLING COMPLETED');
	
	LOG_MSG('====================================');
	LOG_MSG('Billing Interface Summary');
	LOG_MSG('Batch Name : ' || L_BATCH_NAME);
	LOG_MSG('Transactions Created : ' || L_TXN_COUNT);
	LOG_MSG('Errors : ' || L_REJECT_COUNT); 
	LOG_MSG('Transactions Waiting For Import : ' || L_TXN_COUNT);
	LOG_MSG('====================================');
	
EXCEPTION WHEN OTHERS THEN
	LOG_MSG('PROCESS_PROJECT_BILLING : '||SQLERRM);
END PROCESS_PROJECT_BILLING; 

PROCEDURE reco_sleep (p_seconds IN NUMBER) IS
	v_now DATE:=NULL;
BEGIN  
	SELECT SYSDATE INTO v_now FROM DUAL;
	LOOP
		EXIT WHEN v_now + (p_seconds * (1/86400)) <= SYSDATE;
	END LOOP;
END reco_sleep; 

PROCEDURE WAIT_FOR_REQUEST(P_REQUEST_ID NUMBER,P_PROGRAM_NAME VARCHAR2,X_SUCCESS OUT VARCHAR2) IS
L_PHASE_CODE VARCHAR2(1);
L_STATUS_CODE VARCHAR2(1);
L_START_TIME DATE := SYSDATE;
L_COMPLETION_TEXT VARCHAR2(2000);
L_TIMEOUT_HOURS NUMBER := 2; -- optional
BEGIN
	X_SUCCESS := 'N';  
	LOOP
	BEGIN
		SELECT phase_code,status_code,NVL(completion_text,'No Completion Text') INTO L_PHASE_CODE,L_STATUS_CODE,L_COMPLETION_TEXT
		FROM apps.fnd_concurrent_requests
		WHERE request_id = P_REQUEST_ID;   
		LOG_MSG('Waiting Request='||P_REQUEST_ID||', Phase='||L_PHASE_CODE||', Status='||L_STATUS_CODE);  
		
		IF L_PHASE_CODE = 'C' THEN
			EXIT;
		END IF; 
		
		IF SYSDATE > L_START_TIME + (L_TIMEOUT_HOURS/24) THEN
			LOG_MSG('REQUEST TIMEOUT');
			LOG_MSG('Request Id : '||P_REQUEST_ID);
			LOG_MSG('Program : '||P_PROGRAM_NAME);  
			ADD_ERROR('Concurrent Request Timed Out. Request Id='||P_REQUEST_ID||', Program='||P_PROGRAM_NAME);
			X_SUCCESS := 'N';
			RETURN;
		END IF;
		
	EXCEPTION WHEN NO_DATA_FOUND THEN
		NULL;
	END; 
	 reco_sleep(10);
	 END LOOP;
	LOG_MSG('--------------------------------');
	LOG_MSG(P_PROGRAM_NAME);
	LOG_MSG('Waiting Request Id : '||P_REQUEST_ID);
	LOG_MSG('Phase Code : '||L_PHASE_CODE);
	LOG_MSG('Status Code : '||L_STATUS_CODE);
	LOG_MSG('--------------------------------');
	IF L_PHASE_CODE = 'C' AND L_STATUS_CODE IN ('C','G') THEN
		X_SUCCESS := 'Y';
	ELSE                  
		ADD_ERROR(P_PROGRAM_NAME||' failed. Request Id='||P_REQUEST_ID||', Status='||L_STATUS_CODE||', Completion='||SUBSTR(L_COMPLETION_TEXT,1,1000));
		LOG_MSG('Concurrent Program Failed. Completion Text='||L_COMPLETION_TEXT);
		X_SUCCESS := 'N';
	END IF;

END WAIT_FOR_REQUEST;  

PROCEDURE RUN_TRANSACTION_IMPORT (P_BATCH_NAME IN VARCHAR2,X_SUCCESS OUT VARCHAR2,X_REQUEST_ID OUT NUMBER) IS
L_WAIT_SUCCESS VARCHAR2(1);
BEGIN
	X_SUCCESS := 'N';
	LOG_MSG('================================');
	LOG_MSG('Submitting PRC: Transaction Import');
	LOG_MSG('Batch Name : ' || P_BATCH_NAME);
	LOG_MSG('Transaction Source : RECO Billing Units');
	LOG_MSG('Concurrent Program : PAXTRTRX');
	LOG_MSG('================================'); 
	
	LOG_MSG('===== REQUEST CONTEXT =====');
	LOG_MSG('USER_ID='||FND_GLOBAL.USER_ID);
	LOG_MSG('RESP_ID='||FND_GLOBAL.RESP_ID);
	LOG_MSG('RESP_APPL_ID='||FND_GLOBAL.RESP_APPL_ID);
	LOG_MSG('LOGIN_ID='||FND_GLOBAL.LOGIN_ID);
	LOG_MSG('===========================');
	
	apps.RECO_SUBMIT_CONCURRENT_REQUEST
										(
										P_APPLICATION => 'PA',
										P_PROGRAM => 'PAXTRTRX',
										P_ARG1 => 'RECO Billing Units',
										P_ARG2 => P_BATCH_NAME,
										X_REQUEST_ID => X_REQUEST_ID
										); 
	LOG_MSG('Request Id : ' || X_REQUEST_ID);
	
	IF X_REQUEST_ID > 0 THEN
		LOG_MSG('Concurrent Request Submitted Successfully');
	END IF;
		
	IF X_REQUEST_ID = 0 THEN
		LOG_MSG('SUBMIT_REQUEST FAILED');
		LOG_MSG('FND_MESSAGE=' || FND_MESSAGE.GET);
	END IF;
	
	IF X_REQUEST_ID > 0 THEN
		WAIT_FOR_REQUEST(P_REQUEST_ID => X_REQUEST_ID,P_PROGRAM_NAME => 'PRC: Transaction Import',X_SUCCESS => L_WAIT_SUCCESS);
		LOG_MSG('Transaction Import Completion Status : '||L_WAIT_SUCCESS);
		X_SUCCESS := L_WAIT_SUCCESS;
	ELSE
		LOG_MSG('Unable to submit Transaction Import');
	END IF;  
	
EXCEPTION WHEN OTHERS THEN
	ADD_ERROR('RUN_TRANSACTION_IMPORT : ' || SQLERRM);
END RUN_TRANSACTION_IMPORT;

PROCEDURE PROCESS_TRANSACTION_IMPORT(P_PROJECT_NUM IN VARCHAR2 DEFAULT '%') IS
L_BATCH_NAME VARCHAR2(100);
L_IMPORT_SUCCESS VARCHAR2(1);
L_REQUEST_ID NUMBER;
L_EXISTS NUMBER;
L_ERROR_MSG VARCHAR2(2000);  
l_responsibility_id	    NUMBER;
l_user_id		        NUMBER;  
L_INTERFACE_COUNT NUMBER;

CURSOR GETPROJECTS IS
SELECT DISTINCT a.segment1 project_number,b.reco_project_id
	, (SELECT user_id FROM fnd_user f, pa_project_players_v pp
	   WHERE pp.project_id = a.project_id
	   AND pp.role='Job Cost Administrator'
	   AND pp.end_date_active is null
	   AND f.employee_id = pp.person_id ) jcadmin 
FROM apps.pa_projects a,reco_projects b
WHERE a.project_id = b.project_id
AND a.segment1 LIKE P_PROJECT_NUM
AND EXISTS(
SELECT 1
FROM reco_contract_escalation_setup@contractstest c
WHERE c.project_id = b.reco_project_id
AND c.status IN ('BILLING_CREATED','IMPORT_ERROR'));

CURSOR C_TRACK(P_RECO_PROJECT_ID NUMBER) IS
SELECT bt.RECO_PROJECT_ID,bt.ESC_SETUP_ID,bt.TASK_NUMBER,bt.TRANSACTION_NUMBER
FROM RECO.RECO_ESC_BILLING_TRACK bt
WHERE bt.RECO_PROJECT_ID = P_RECO_PROJECT_ID
AND EXISTS
(
SELECT 1
FROM reco_contract_escalation_setup@contractstest c
WHERE c.esc_setup_id = bt.esc_setup_id
AND c.status IN ('BILLING_CREATED','IMPORT_ERROR')
);
L_IMPORTED_COUNT NUMBER := 0;
L_IMPORT_ERROR_COUNT NUMBER := 0;

BEGIN
	LOG_MSG('================================================');
	LOG_MSG('PROCESS_TRANSACTION_IMPORT STARTED');  
	LOG_MSG('================================================');
	FOR PROJROW IN GETPROJECTS LOOP
	
		l_user_id := projrow.jcadmin;  
		
		SELECT user_id, responsibility_id
		INTO  l_user_id, l_responsibility_id
		FROM apps.pa_user_resp_v
		WHERE user_id = l_user_id
		AND responsibility_name = 'Project Super User'; 
		
		BEGIN
			SELECT MAX(BATCH_NAME) INTO L_BATCH_NAME
			FROM RECO.RECO_ESC_BILLING_TRACK
			WHERE RECO_PROJECT_ID = PROJROW.RECO_PROJECT_ID;
		EXCEPTION WHEN NO_DATA_FOUND THEN
			CONTINUE;
		END;   
		
		LOG_MSG('Project Number : '||PROJROW.PROJECT_NUMBER);
		LOG_MSG('Reco Project Id : '||PROJROW.RECO_PROJECT_ID);
		LOG_MSG('Batch Name : '||L_BATCH_NAME);
		
		BEGIN
			SELECT COUNT(*) INTO L_INTERFACE_COUNT
			FROM APPS.PA_TRANSACTION_INTERFACE_ALL
			WHERE BATCH_NAME = L_BATCH_NAME;
			
			LOG_MSG('INTERFACE RECORD COUNT : '||L_INTERFACE_COUNT);
		
		EXCEPTION WHEN OTHERS THEN
			LOG_MSG('INTERFACE COUNT ERROR : '||SQLERRM);
		END;
		
		L_IMPORT_SUCCESS := 'N';  
		LOG_MSG('================================');
		LOG_MSG('Before APPS_INITIALIZE');
		LOG_MSG('PROJECT=' || PROJROW.PROJECT_NUMBER);
		LOG_MSG('USER_ID=' || L_USER_ID);
		LOG_MSG('RESPONSIBILITY_ID=' || L_RESPONSIBILITY_ID);
		LOG_MSG('================================');                                                                     
		
		apps.FND_GLOBAL.APPS_INITIALIZE(USER_ID => L_USER_ID,RESP_ID => L_RESPONSIBILITY_ID,RESP_APPL_ID => 275); 
		
		LOG_MSG('APPS_INITIALIZE COMPLETED');  COMMIT;
		LOG_MSG('COMMIT COMPLETED BEFORE SUBMIT_REQUEST');
		
		RUN_TRANSACTION_IMPORT(P_BATCH_NAME => L_BATCH_NAME,X_SUCCESS => L_IMPORT_SUCCESS,X_REQUEST_ID => L_REQUEST_ID);
		IF L_IMPORT_SUCCESS = 'Y' THEN
			LOG_MSG('Reconciling Import Results');
			FOR TRACK_REC IN C_TRACK(PROJROW.RECO_PROJECT_ID) LOOP 
				BEGIN
					LOG_MSG('--------------------------------');
					LOG_MSG('Reconciling Transaction');
					LOG_MSG('Transaction Number : '||TRACK_REC.TRANSACTION_NUMBER);
					LOG_MSG('Task Number : '||TRACK_REC.TASK_NUMBER);
					LOG_MSG('Project Id : '||TRACK_REC.RECO_PROJECT_ID);
					LOG_MSG('--------------------------------');
					
					SELECT COUNT(*) INTO L_EXISTS
					FROM PA_TRANSACTION_INTERFACE_ALL
					WHERE ORIG_TRANSACTION_REFERENCE =TRACK_REC.TRANSACTION_NUMBER;
					
					LOG_MSG('Interface Record Count : '||L_EXISTS);
					
					IF L_EXISTS > 0 THEN
						BEGIN
							SELECT TRANSACTION_REJECTION_CODE INTO L_ERROR_MSG
							FROM PA_TRANSACTION_INTERFACE_ALL
							WHERE ORIG_TRANSACTION_REFERENCE = TRACK_REC.TRANSACTION_NUMBER
							AND ROWNUM = 1;						
						EXCEPTION WHEN OTHERS THEN
							L_ERROR_MSG := 'Transaction Import Error';
						END;  
											 
						LOG_MSG('Transaction Import Rejected');
						LOG_MSG('Transaction Number : '||TRACK_REC.TRANSACTION_NUMBER);
						LOG_MSG('Task Number : '||TRACK_REC.TASK_NUMBER);
						LOG_MSG('Rejection Code : '||L_ERROR_MSG);    
						
						UPDATE_BILLING_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'IMPORT_ERROR',P_ERROR_MESSAGE => L_ERROR_MSG);
						L_IMPORT_ERROR_COUNT := L_IMPORT_ERROR_COUNT + 1;
					ELSE
						LOG_MSG('Transaction Imported Successfully');
						LOG_MSG('Transaction Number : '||TRACK_REC.TRANSACTION_NUMBER);
						LOG_MSG('Task Number : '||TRACK_REC.TASK_NUMBER);
						
						UPDATE_BILLING_STATUS(P_RECO_PROJECT_ID => TRACK_REC.RECO_PROJECT_ID,P_ESC_SETUP_ID => TRACK_REC.ESC_SETUP_ID,P_TASK_NUMBER => TRACK_REC.TASK_NUMBER,P_STATUS => 'BILLING_IMPORTED');
						L_IMPORTED_COUNT := L_IMPORTED_COUNT + 1;
						
					END IF;
					
				EXCEPTION WHEN OTHERS THEN
					LOG_MSG('Import reconciliation error for '|| TRACK_REC.TRANSACTION_NUMBER|| ' : '|| SQLERRM);
				END;
			END LOOP;
			
		END IF;
		
	END LOOP;      
	LOG_MSG('====================================');
	LOG_MSG('TRANSACTION IMPORT SUMMARY');
	LOG_MSG('Batch Name : '||NVL(L_BATCH_NAME,'N/A'));
	LOG_MSG('Request Id : '||NVL(TO_CHAR(L_REQUEST_ID),'N/A'));
	LOG_MSG('Imported Transactions : '||L_IMPORTED_COUNT);
	LOG_MSG('Import Errors : '||L_IMPORT_ERROR_COUNT);
	LOG_MSG('Total Transactions Processed : '||(L_IMPORTED_COUNT + L_IMPORT_ERROR_COUNT));
	LOG_MSG('Import Success : '||NVL(L_IMPORT_SUCCESS,'N'));
	LOG_MSG('===================================='); 
	LOG_MSG('PROCESS_TRANSACTION_IMPORT COMPLETED'); 
	
END PROCESS_TRANSACTION_IMPORT;

PROCEDURE UPDATE_COST_STATUS(P_RECO_PROJECT_ID NUMBER,P_ESC_SETUP_ID NUMBER,P_TASK_NUMBER VARCHAR2,P_STATUS VARCHAR2,P_ERROR_MESSAGE VARCHAR2 DEFAULT NULL) IS
BEGIN
	LOG_MSG('Cost Status Update : '||'ESC_SETUP_ID='||P_ESC_SETUP_ID||', TASK='||P_TASK_NUMBER||', STATUS='||P_STATUS||', ERROR='||NVL(P_ERROR_MESSAGE,'NULL'));
	INSERT_PROCESS_LOG(P_PROJECT_ID => P_RECO_PROJECT_ID,P_TASK_NUMBER => P_TASK_NUMBER,P_STAGE => 'COST_DIST',P_STATUS => P_STATUS,P_ERROR_MESSAGE => P_ERROR_MESSAGE);
	UPDATE_ESC_PROCESSING_STATUS@contractstest(p_project_id => P_RECO_PROJECT_ID,p_esc_setup_id => P_ESC_SETUP_ID,p_status => P_STATUS,p_error_message => P_ERROR_MESSAGE);

EXCEPTION WHEN OTHERS THEN
	ADD_ERROR('UPDATE_COST_STATUS : '||SQLERRM);
