PROCEDURE PROCESS_FUNDING(P_PROJECT_NUM IN VARCHAR2) IS  
L_AGREEMENT_ID NUMBER;
L_CURRENT_AMOUNT NUMBER; 
L_TOP_TASK_ID NUMBER;
L_USER_ID NUMBER;
L_RESPONSIBILITY_ID NUMBER;
L_FUNDING_SUCCESS VARCHAR2(1);
L_PROJECT_COUNT NUMBER := 0;

CURSOR GETPROJECTS IS
SELECT a.project_id,a.segment1 project_number,b.reco_project_id,a.start_date,a.completion_date,
	(
	SELECT user_id
	FROM fnd_user f,
	pa_project_players_v pp
	WHERE pp.project_id = a.project_id
	AND pp.role='Job Cost Administrator'
	AND pp.end_date_active IS NULL
	AND f.employee_id = pp.person_id
	) jcadmin
FROM apps.pa_projects a,
reco_projects b
WHERE a.project_status_code='Signed'
AND a.project_id=b.project_id
AND a.segment1 LIKE P_PROJECT_NUM
AND EXISTS
(
SELECT 1
FROM reco_contract_escalation_setup@contractstest c
WHERE c.project_id = b.reco_project_id
AND c.freeze_flag = 'N'
AND c.current_escalation_flag = 'Y'
AND c.approval_status = 'APPROVED'
AND c.status IN ('BUDGET_CREATED','FUNDING_ERROR')
); 

CURSOR GET_FUNDING_TASKS(P_RECO_PROJECT_ID NUMBER,P_PROJECT_ID NUMBER) IS
SELECT SUBSTR(c.task_number,1,3) TOP_TASK,ROUND(SUM(NVL(c.quantity,0)*ROUND(NVL(c.bill_rate,0),DECODE(t.attribute1,'Unit Price',2,'Lump Sum',5,3))),2) ADDITIONAL_FUNDING
FROM reco_contract_escalation_setup@contractstest c,
pa_tasks pt,
pa_tasks t
WHERE c.project_id = P_RECO_PROJECT_ID
AND pt.project_id = P_PROJECT_ID
AND pt.task_number = c.task_number
AND t.task_id = pt.top_task_id
AND c.freeze_flag = 'N'
AND c.current_escalation_flag='Y'
AND c.approval_status='APPROVED'
AND c.status IN('BUDGET_CREATED','FUNDING_ERROR')
AND EXISTS
(
SELECT 1
FROM RECO.RECO_ESC_PROCESS_LOG l
WHERE l.project_id = c.project_id
AND l.task_number = c.task_number
AND l.process_stage = 'BUDGET'
AND l.process_status = 'BUDGET_CREATED'
)
GROUP BY SUBSTR(c.task_number,1,3);

CURSOR GET_TOP_TASK_ROWS(P_RECO_PROJECT_ID NUMBER,P_TOP_TASK VARCHAR2) IS
SELECT esc_setup_id,task_number
FROM reco_contract_escalation_setup@contractstest
WHERE project_id = P_RECO_PROJECT_ID
AND freeze_flag = 'N'
AND current_escalation_flag = 'Y'
AND approval_status = 'APPROVED'
AND STATUS IN ('BUDGET_CREATED','FUNDING_ERROR')
AND SUBSTR(task_number,1,3) = P_TOP_TASK;

FUNDROW GET_FUNDING_TASKS%ROWTYPE;
PROJROW GETPROJECTS%ROWTYPE; 

BEGIN
	LOG_MSG('PROCESS_FUNDING STARTED'); 
	
	FOR PROJROW IN GETPROJECTS LOOP
	    L_PROJECT_COUNT := L_PROJECT_COUNT + 1;
		CLEAR_ERRORS;
		
		L_USER_ID := PROJROW.JCADMIN; 
		
		SELECT user_id,responsibility_id INTO L_USER_ID,L_RESPONSIBILITY_ID
		FROM apps.pa_user_resp_v
		WHERE user_id = L_USER_ID
		AND responsibility_name = 'Project Super User';   
		
		SET_PROJECT_CONTEXT(L_USER_ID,L_RESPONSIBILITY_ID);
		
		IF G_PROJECT_ERROR THEN 
			CONTINUE;
		END IF;
		
		LOG_MSG('Project : '||PROJROW.PROJECT_NUMBER);  
		
		FOR FUNDROW IN GET_FUNDING_TASKS(PROJROW.RECO_PROJECT_ID,PROJROW.PROJECT_ID) LOOP
			CLEAR_ERRORS;
--			
--			IF PROCESS_ALREADY_COMPLETED(PROJROW.RECO_PROJECT_ID,FUNDROW.TOP_TASK,'FUNDING','FUNDED') = 'Y'	THEN
--				LOG_MSG('Funding already processed for Top Task '|| FUNDROW.TOP_TASK);
--				CONTINUE;
--			END IF;
			-- GET TOP TASK ID
			BEGIN
				SELECT task_id INTO L_TOP_TASK_ID
				FROM pa_tasks
				WHERE project_id = PROJROW.PROJECT_ID
				AND task_number = FUNDROW.TOP_TASK; 
			EXCEPTION WHEN NO_DATA_FOUND THEN
				FOR R IN GET_TOP_TASK_ROWS(PROJROW.RECO_PROJECT_ID,FUNDROW.TOP_TASK) LOOP 
--					UPDATE_ESC_PROCESSING_STATUS@contractstest(p_project_id => PROJROW.RECO_PROJECT_ID,p_esc_setup_id => R.ESC_SETUP_ID,p_status => 'FUNDING_ERROR',p_error_message => 'Top Task Not Found');
					UPDATE_FUNDING_STATUS(P_RECO_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_ESC_SETUP_ID => R.ESC_SETUP_ID,P_TASK_NUMBER => R.TASK_NUMBER,P_STATUS => 'FUNDING_ERROR',P_ERROR_MESSAGE => 'Top Task Not Found');
				END LOOP;
--				INSERT_PROCESS_LOG(P_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_TASK_NUMBER => FUNDROW.TOP_TASK,P_STAGE => 'FUNDING',P_STATUS => 'FUNDING_ERROR',P_ERROR_MESSAGE => 'Top Task Not Found');
				CONTINUE;
			END; 
			
			LOG_MSG('Top Task : '||FUNDROW.TOP_TASK);    
			
			LOG_MSG('Additional Funding : '|| FUNDROW.ADDITIONAL_FUNDING);  
			
			-- VALIDATE FUNDING
			VALIDATE_FUNDING(P_PROJECT_ID => PROJROW.PROJECT_ID,P_TOP_TASK_ID => L_TOP_TASK_ID,X_AGREEMENT_ID => L_AGREEMENT_ID,X_CURRENT_AMOUNT => L_CURRENT_AMOUNT);
			IF G_PROJECT_ERROR THEN 
				LOG_MSG('Funding Validation Failed');
				LOG_MSG(GET_ERROR_TEXT);
				FOR R IN GET_TOP_TASK_ROWS(PROJROW.RECO_PROJECT_ID,FUNDROW.TOP_TASK) LOOP 
--					UPDATE_ESC_PROCESSING_STATUS@contractstest(p_project_id => PROJROW.RECO_PROJECT_ID,p_esc_setup_id => R.ESC_SETUP_ID,p_status => 'FUNDING_ERROR',p_error_message => GET_ERROR_TEXT);
					UPDATE_FUNDING_STATUS(P_RECO_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_ESC_SETUP_ID => R.ESC_SETUP_ID,P_TASK_NUMBER => R.TASK_NUMBER,P_STATUS => 'FUNDING_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
				END LOOP; 
--				INSERT_PROCESS_LOG(P_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_TASK_NUMBER => FUNDROW.TOP_TASK,P_STAGE => 'FUNDING',P_STATUS => 'FUNDING_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
				CONTINUE;
			END IF;  
			
			-- AGREEMENT CALCULATION 
			SAVEPOINT FUNDING_SP;
			LOG_MSG('Funding Top Task : '|| FUNDROW.TOP_TASK|| ' Amount : '|| FUNDROW.ADDITIONAL_FUNDING);
			UPDATE_AGREEMENT_AMOUNT(P_AGREEMENT_ID => L_AGREEMENT_ID,P_CURRENT_AMOUNT => L_CURRENT_AMOUNT,P_ADDITIONAL_FUNDING => FUNDROW.ADDITIONAL_FUNDING);
			IF G_ERROR_COUNT > 0 THEN
				LOG_MSG('Agreement Update Failed for Top Task : '|| FUNDROW.TOP_TASK);
				LOG_MSG(GET_ERROR_TEXT); 
				FOR R IN GET_TOP_TASK_ROWS(PROJROW.RECO_PROJECT_ID,FUNDROW.TOP_TASK) LOOP	 
--					UPDATE_ESC_PROCESSING_STATUS@contractstest(p_project_id => PROJROW.RECO_PROJECT_ID,p_esc_setup_id => R.ESC_SETUP_ID,p_status => 'FUNDING_ERROR',p_error_message => GET_ERROR_TEXT);
					UPDATE_FUNDING_STATUS(P_RECO_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_ESC_SETUP_ID => R.ESC_SETUP_ID,P_TASK_NUMBER => R.TASK_NUMBER,P_STATUS => 'FUNDING_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
				END LOOP;  
--				INSERT_PROCESS_LOG(P_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_TASK_NUMBER => FUNDROW.TOP_TASK,P_STAGE => 'FUNDING',P_STATUS => 'FUNDING_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
				CONTINUE;
			END IF;
			
			L_CURRENT_AMOUNT := L_CURRENT_AMOUNT + FUNDROW.ADDITIONAL_FUNDING;
			
					
			L_FUNDING_SUCCESS := 'N';              
			LOG_MSG('Calling Funding API. '||'Project='||PROJROW.PROJECT_NUMBER||', Top Task='||FUNDROW.TOP_TASK||', Agreement='||L_AGREEMENT_ID||', Amount='||FUNDROW.ADDITIONAL_FUNDING);
			
			ADD_PROJECT_FUNDING(P_PROJECT_ID => PROJROW.PROJECT_ID,P_TOP_TASK_ID => L_TOP_TASK_ID,P_AGREEMENT_ID => L_AGREEMENT_ID,P_ADDITIONAL_FUNDING => FUNDROW.ADDITIONAL_FUNDING,X_SUCCESS => L_FUNDING_SUCCESS);
			
			IF L_FUNDING_SUCCESS = 'Y' THEN     
			LOG_MSG('Funding Success. Top Task='||FUNDROW.TOP_TASK||', Agreement='||L_AGREEMENT_ID);
				FOR R IN GET_TOP_TASK_ROWS(PROJROW.RECO_PROJECT_ID,FUNDROW.TOP_TASK) LOOP
--					UPDATE_ESC_PROCESSING_STATUS@contractstest(p_project_id => PROJROW.RECO_PROJECT_ID,p_esc_setup_id => R.ESC_SETUP_ID,p_status => 'FUNDED');
					UPDATE_FUNDING_STATUS(P_RECO_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_ESC_SETUP_ID => R.ESC_SETUP_ID,P_TASK_NUMBER => R.TASK_NUMBER,P_STATUS => 'FUNDED');
				END LOOP;
--				INSERT_PROCESS_LOG(P_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_TASK_NUMBER => FUNDROW.TOP_TASK,P_STAGE => 'FUNDING',P_STATUS => 'FUNDED');
			
			ELSE
				ROLLBACK TO FUNDING_SP;
				FOR R IN GET_TOP_TASK_ROWS(PROJROW.RECO_PROJECT_ID,FUNDROW.TOP_TASK) LOOP
--					UPDATE_ESC_PROCESSING_STATUS@contractstest(p_project_id => PROJROW.RECO_PROJECT_ID,p_esc_setup_id => R.ESC_SETUP_ID,p_status => 'FUNDING_ERROR',p_error_message => GET_ERROR_TEXT);
					UPDATE_FUNDING_STATUS(P_RECO_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_ESC_SETUP_ID => R.ESC_SETUP_ID,P_TASK_NUMBER => R.TASK_NUMBER,P_STATUS => 'FUNDING_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
				END LOOP;
--				INSERT_PROCESS_LOG(P_PROJECT_ID => PROJROW.RECO_PROJECT_ID,P_TASK_NUMBER => FUNDROW.TOP_TASK,P_STAGE => 'FUNDING',P_STATUS => 'FUNDING_ERROR',P_ERROR_MESSAGE => GET_ERROR_TEXT);
			END IF;
			
		END LOOP;
		
		IF G_ERROR_COUNT > 0 THEN
			LOG_MSG('PROJECT FUNDING ERROR SUMMARY');
			LOG_MSG(GET_ERROR_TEXT);
		END IF;
		IF G_ERROR_COUNT = 0 THEN
			LOG_MSG('PROJECT FUNDING PROCESS COMPLETED SUCCESSFULLY');
		END IF; 
		
	END LOOP;  
	
	IF L_PROJECT_COUNT = 0 THEN
		LOG_MSG('No eligible records found for processing. Records may have already been processed or are not in a valid status.');
	END IF;
	
	LOG_MSG('PROCESS_FUNDING COMPLETED'); 
	
END PROCESS_FUNDING;      

PROCEDURE GET_WORKING_BUDGET(P_PROJECT_ID IN NUMBER,X_BUDGET_VERSION_ID OUT NUMBER,X_FIN_PLAN_TYPE_ID OUT NUMBER,X_VERSION_TYPE OUT VARCHAR2,X_VERSION_NUMBER OUT NUMBER) IS  

BEGIN
	SELECT budget_version_id,fin_plan_type_id,version_type,version_number
	INTO X_BUDGET_VERSION_ID,X_FIN_PLAN_TYPE_ID,X_VERSION_TYPE,X_VERSION_NUMBER
	FROM pa_budget_versions
	WHERE project_id = P_PROJECT_ID
	AND budget_status_code = 'W'
	AND current_working_flag = 'Y'; 
	
EXCEPTION WHEN NO_DATA_FOUND THEN
	ADD_ERROR('Working Budget Not Found');
	G_PROJECT_ERROR := TRUE;
WHEN TOO_MANY_ROWS THEN
	ADD_ERROR('Multiple Working Budgets Found');
	G_PROJECT_ERROR := TRUE;
END GET_WORKING_BUDGET;    

PROCEDURE PREPARE_BUDGET_FOR_BASELINE(P_BUDGET_VERSION_ID IN NUMBER) IS  
L_NEW_VERSION_NAME VARCHAR2(100); 

BEGIN
	L_NEW_VERSION_NAME :='ESCALATION UPDATE - '|| TO_CHAR(SYSDATE,'MM/DD/YYYY HH24:MM:SS');
	UPDATE apps.pa_budget_versions
	SET version_name = L_NEW_VERSION_NAME,
	description = L_NEW_VERSION_NAME
	WHERE budget_version_id = P_BUDGET_VERSION_ID;
	
	UPDATE apps.pa_budget_versions
	SET burdened_cost = raw_cost
	WHERE budget_version_id = P_BUDGET_VERSION_ID
	AND raw_cost <> burdened_cost;
	
	UPDATE apps.pa_budget_lines
	SET burdened_cost = raw_cost
	WHERE budget_version_id = P_BUDGET_VERSION_ID
	AND raw_cost <> burdened_cost
	AND pm_product_code = 'RECO_ESC';
	
	LOG_MSG('Budget Version Updated : '||L_NEW_VERSION_NAME);

EXCEPTION WHEN OTHERS THEN
	ADD_ERROR('PREPARE_BUDGET_FOR_BASELINE : '||SQLERRM);
	G_PROJECT_ERROR := TRUE;
END PREPARE_BUDGET_FOR_BASELINE;

PROCEDURE BASELINE_PROJECT_BUDGET(P_PROJECT_ID IN NUMBER,P_FIN_PLAN_TYPE_ID IN NUMBER,X_SUCCESS OUT VARCHAR2)IS

G_API_VERSION_NUMBER NUMBER := 1.0;
G_COMMIT VARCHAR2(1) := 'F';
G_INIT_MSG_LIST VARCHAR2(1) := 'T';
G_MSG_COUNT NUMBER;
G_MSG_DATA VARCHAR2(2000);
G_RETURN_STATUS VARCHAR2(1);
G_WORKFLOW_STARTED VARCHAR2(1); 

BEGIN
	X_SUCCESS := 'N';
	LOG_MSG('BASELINE_PROJECT_BUDGET STARTED');
	APPS.PA_BUDGET_PUB.BASELINE_BUDGET
									(
									p_api_version_number => G_API_VERSION_NUMBER,
									p_commit => G_COMMIT,
									p_init_msg_list => G_INIT_MSG_LIST,
									p_msg_count => G_MSG_COUNT,
									p_msg_data => G_MSG_DATA,
									p_return_status => G_RETURN_STATUS,
									p_workflow_started => G_WORKFLOW_STARTED,
									p_pm_product_code => 'RECO_ESC',
									p_pa_project_id => P_PROJECT_ID,
									p_pm_project_reference => '',
									p_budget_type_code => '',
									p_mark_as_original => '',
									p_fin_plan_type_id => P_FIN_PLAN_TYPE_ID,
									p_fin_plan_type_name => '',
									p_version_type => 'ALL'
									);
	LOG_MSG('Return Status : '||G_RETURN_STATUS);
	LOG_MSG('Workflow Started : '||G_WORKFLOW_STARTED);
	LOG_MSG('Message Data : '||G_MSG_DATA); 
	LOG_MSG('*** AFTER MESSAGE DATA ***');
	LOG_MSG('Message Count : '||NVL(G_MSG_COUNT,-999));
	
	IF G_RETURN_STATUS <> 'S' THEN
		LOG_API_MESSAGES(G_MSG_COUNT,G_MSG_DATA);
		ADD_ERROR('Baseline Budget API Error : '||G_MSG_DATA);
	ELSE
		LOG_MSG('Budget Baselined Successfully');
		X_SUCCESS := 'Y';
	END IF;        
	
EXCEPTION WHEN OTHERS THEN
	ADD_ERROR('BASELINE_PROJECT_BUDGET : '||SQLERRM);  
	
END BASELINE_PROJECT_BUDGET;

PROCEDURE UPDATE_BASELINE_TASK_STATUS(P_RECO_PROJECT_ID NUMBER,P_STATUS VARCHAR2,P_ERROR_MESSAGE VARCHAR2 DEFAULT NULL) IS
BEGIN
	FOR REC IN(SELECT esc_setup_id,task_number FROM reco_contract_escalation_setup@contractstest WHERE project_id = P_RECO_PROJECT_ID AND status IN ( 'FUNDED','BASELINE_ERROR')) LOOP	
		INSERT_PROCESS_LOG(P_PROJECT_ID => P_RECO_PROJECT_ID,P_TASK_NUMBER => REC.TASK_NUMBER,P_STAGE => 'BASELINE',P_STATUS => P_STATUS,P_ERROR_MESSAGE => P_ERROR_MESSAGE);
		UPDATE_ESC_PROCESSING_STATUS@contractstest(p_project_id => P_RECO_PROJECT_ID,p_esc_setup_id => REC.ESC_SETUP_ID,p_status => P_STATUS,p_error_message => P_ERROR_MESSAGE);
	END LOOP;
EXCEPTION WHEN OTHERS THEN
	ADD_ERROR('UPDATE_BASELINE_TASK_STATUS : '||SQLERRM);
END UPDATE_BASELINE_TASK_STATUS;

PROCEDURE FREEZE_ESCALATION(P_RECO_PROJECT_ID NUMBER) IS
l_user_name VARCHAR2(100);
BEGIN 
	LOG_MSG('Calling UPDATE_ESC_PROCESSING_STATUS to freeze records');   
	SELECT USER_NAME INTO l_user_name FROM fnd_user where user_id=FND_GLOBAL.USER_ID;
	LOG_MSG('Applied By User : ' || l_user_name);
	UPDATE_ESC_PROCESSING_STATUS@contractstest(p_project_id => P_RECO_PROJECT_ID,p_freeze_flag => 'Y',p_applied_by => l_user_name,p_applied_date => SYSDATE,p_error_message => NULL);	
	LOG_MSG('Freeze completed successfully');
