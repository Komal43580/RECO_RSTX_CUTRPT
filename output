SELECT DISTINCT
       p.segment1 project_number,
       p.project_id,
       p.project_status_code,
       p.attribute7,
       rfd.description,
       pp.person_id,
       ppp.full_name
FROM pa_projects p
JOIN pa_project_players pp
  ON pp.project_id = p.project_id
JOIN per_people_f ppp
  ON ppp.person_id = pp.person_id
LEFT JOIN reco_freeze_dates rfd
  ON rfd.value = p.attribute7
WHERE p.project_status_code IN ('ACTIVE','Award','Signed')
  AND pp.project_role_type = 'PROJECT MANAGER'
  AND (pp.end_date_active IS NULL
       OR pp.end_date_active >= TRUNC(SYSDATE))
  AND (ppp.effective_end_date IS NULL
       OR ppp.effective_end_date >= TRUNC(SYSDATE))
  AND p.attribute7 IS NOT NULL
ORDER BY p.segment1;

