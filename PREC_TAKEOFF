-- delete_toff_struct
--
-- DESCRIPTION
-- Deletes a structure along with its panels and parts from takeoff.
-- Will also create a history, and delete any related estimates.
--
-- UPDATES
-- : 02-NOV-2011 - DSM - Created
--
-- PRE-CONDITIONS
-- : The givenStructId is saved in the structure table
-- : There should be no PCFs tied to this structure,
--   validated by GetStructPCFQty
-- : There should be no Material Orders tied to this structure,
--   validated by GetStructMOQty
--
-- POST-CONDITIONS
-- : Deletes the structure, and any related estimates.
-- : A history record is created before deletion.
-- : Return 'DONE' if everything works
-- : Return an error message if something fails and rollback
-- : When completeing and 'DONE', this method may commit
--   depending on the givenShouldCommit value
-- : When completeing and 'DONE', calculated values are synced
function delete_toff_struct ( givenstructid in number,
                              givenshouldcommit in boolean)
return varchar2
is
  vc_temperrormsg varchar2(1024);


  vn_storedjobid number;

begin

  declare
    vn_tmppcfquantity number;
    vn_tmpmoquantity number;
  begin
    vc_temperrormsg :=
      prec_takeoff.getstructpcfqty(givenstructid,vn_tmppcfquantity);
    if vc_temperrormsg != 'DONE'
    then return vc_temperrormsg;
    end if;
    if vn_tmppcfquantity > 0
    then return 'Error 0021 - Cannot delete structure with live PCFs attached';
    end if;
    vc_temperrormsg :=
      prec_takeoff.getstructmoqty(givenstructid,vn_tmpmoquantity);
    if vc_temperrormsg != 'DONE'
    then return vc_temperrormsg;
    end if;
    if vn_tmpmoquantity > 0
    then return 'Error 0022 - Cannot delete structure with live MOs attached';
    end if;
  end;

  select toff_job_id
  into vn_storedjobid
  from reco_toff_structs
  where toff_struct_id = givenstructid;

  vc_temperrormsg := prec_takeoff.write_history_for_struct(givenstructid,false);
  if vc_temperrormsg != 'DONE'
  then
    rollback;
    return vc_temperrormsg;
  end if;

  delete from reco_toff_panels where toff_struct_id = givenstructid;
  delete from reco_toff_parts where toff_struct_id = givenstructid;
  delete from reco_toff_panel_coordinates where toff_struct_id = givenstructid;
  delete from reco_toff_structs where toff_struct_id = givenstructid;


  -- Update job-level stuff

  vc_temperrormsg := prec_takeoff.set_toff_calc_values(vn_storedjobid,null);

  if vc_temperrormsg != 'DONE'
  then rollback;
        return vc_temperrormsg;
  end if;

  if givenshouldcommit
  then commit;
  end if;

  return 'DONE';
end; -- delete_toff_struct

