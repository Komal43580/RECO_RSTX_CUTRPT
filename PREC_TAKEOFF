-- getsteeltons
--
-- modified 5/10/2001 by David Correia
-- Needed the category set id id stop this function from returning double amount
-- of linear feet since the mtl_item_categories table has two entries for steel,
-- category 5 and 26.
-- 1/6/04  conversion changed to 1000001005
function getsteeltons (pi_givenstructid in number)
return number
is
  cursor gettonnage
  is
    select weight_uom, sum(weight * quantity_required ) amt
    from reco_toff_parts p, prec_parts m
    where weight is not null
    and m.part_code = p.part_code
    and m.part_type = 'STEEL'
    and p.toff_struct_id = pi_givenstructid
    group by weight_uom;

  totaltons number := 0;
begin
  for eachton in gettonnage
  loop
      -- CONTINUE HERE this was hard-coded to avoid reco_estimation for CRM-upgrade only
      totaltons := totaltons +
          --reco_estimation.convert_to(eachton.amt,eachton.weight_uom_code,'TO' );
          prec_takeoff.convert_to(eachton.amt,eachton.weight_uom,'TO' );
  end loop;

  return totaltons;
end;

