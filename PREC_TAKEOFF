-- write_history_for_struct
--
-- DESCRIPTION
-- Takes the indicated Structure record in the database and copies it into
-- the reco_toff_struct_hist table. The original record is unchanged
--
-- UPDATES
-- : 02-NOV-2011 - DSM - Created
--
-- PRE-CONDITIONS
-- : givenStructId must exist if provided and be valid in reco_toff_structs table
-- : realistically, you should only call this on commited database-data. It
--   really doesn't make sense to mod stuff on the DB side then send-it-history
-- : you shouldn't really need to use the givenShouldCommit. I mean you can,
--   but what if something after this commit fails in your process ??
--
-- POST-CONDITIONS
-- : Takes the indicated record and copies it into the history table
-- : Doesn't do anything to the struct table
-- : Calculated values don't need adjustment here, just copy to history table
-- : Return 'DONE' if everything works
-- : Return an error message if something fails and rollback
-- : When completeing and 'DONE', this method may commit
--   depending on the givenShouldCommit value
function write_history_for_struct ( givenStructId in number,
                                    givenShouldCommit in boolean)
return varchar2
is
begin

  declare
    vc_Tmp varchar2(1);
  begin
    select 'Y' into vc_Tmp
    from reco_toff_structs
    where toff_struct_id = givenStructId;
  exception
    when others then
      return 'Error 0030 - Invalid parameter given. Contact MIS';
  end;

  begin
	insert into reco_toff_struct_hist
		(	toff_struct_id,
			structure_name,
			revision_number,
            project_number, product_code, 
			unit_of_measure,
			toff_job_id,
			status_code,
			soil_reinf_type,
			total_area,
			prelim_date,
			final_date,
			total_steel_lf,
			total_steel_tons,
			total_steel_qty,
			wall_length,
			num_columns,
			avg_height,
			num_panels,
			num_ties,
			importer_id,
			last_update_date,
			last_updated_by,
			creation_date,
			created_by,
			last_update_login,
      is_corp_std,
      is_mural_wall,
      contents_code,
      engineering_start, engineering_end,
      precast_start, precast_end,
      precast_ship_start, precast_ship_end,
      steel_start, steel_end,
      accessory_start, accessory_end,
      wall_start, wall_end,
      act_engineering_start, act_engineering_end,
      act_precast_start, act_precast_end,
      act_precast_ship_start, act_precast_ship_end,
      act_steel_start, act_steel_end,
      act_accessory_start, act_accessory_end,
      act_wall_start, act_wall_end	)
		(	select	subTbl.TOFF_STRUCT_ID,
							subTbl.STRUCTURE_NAME,
							subTbl.REVISION_NUMBER, subtbl.project_number, subtbl.product_code,
							subTbl.UNIT_OF_MEASURE,
							subTbl.TOFF_JOB_ID,
							subTbl.STATUS_CODE,
							subTbl.SOIL_REINF_TYPE,
							subTbl.TOTAL_AREA,
							subTbl.PRELIM_DATE,
							subTbl.FINAL_DATE,
							subTbl.TOTAL_STEEL_LF,
							subTbl.TOTAL_STEEL_TONS,
							subTbl.TOTAL_STEEL_QTY,
							subTbl.WALL_LENGTH,
							subTbl.NUM_COLUMNS,
							subTbl.AVG_HEIGHT,
							subTbl.NUM_PANELS,
							subTbl.NUM_TIES,
							subTbl.IMPORTER_ID,
							subTbl.LAST_UPDATE_DATE,
							subTbl.LAST_UPDATED_BY,
							subTbl.CREATION_DATE,
							subTbl.CREATED_BY,
							subTbl.LAST_UPDATE_LOGIN,
              subTbl.IS_CORP_STD,
              subTbl.IS_MURAL_WALL,
              subTbl.CONTENTS_CODE,
      engineering_start, engineering_end,
      precast_start, precast_end,
      precast_ship_start, precast_ship_end,
      steel_start, steel_end,
      accessory_start, accessory_end,
      wall_start, wall_end,
      act_engineering_start, act_engineering_end,
      act_precast_start, act_precast_end,
      act_precast_ship_start, act_precast_ship_end,
      act_steel_start, act_steel_end,
      act_accessory_start, act_accessory_end,
      act_wall_start, act_wall_end
			from	reco_toff_structs subTbl
			where		subTbl.toff_struct_id = givenStructId);
exception
  when DUP_VAL_ON_INDEX
  then
    -- This never happens in a good system. However, when something breaks
    -- (e.g. Forms screws up half-way through a transaction), then you may get a
    -- data-corruption thing where a history record exists with the same RevNum
    -- as the current structure. All future updates to that structure will fail
    -- because of the screwed-up data Hist_REV_NUM = Current_REV_NUM
    --
  -- instead, update history record to match
  	update reco_toff_struct_hist
		set	(structure_name,
			revision_number,
			unit_of_measure,
			toff_job_id,
			status_code,
			soil_reinf_type,
			total_area,
			prelim_date,
			final_date,
			total_steel_lf,
			total_steel_tons,
			total_steel_qty,
			wall_length,
			num_columns,
			avg_height,
			num_panels,
			num_ties,
			importer_id,
			last_update_date,
			last_updated_by,
			creation_date,
			created_by,
			last_update_login,
      is_corp_std,
      is_mural_wall,
      contents_code,
      engineering_start, engineering_end,
      precast_start, precast_end,
      precast_ship_start, precast_ship_end,
      steel_start, steel_end,
      accessory_start, accessory_end,
      wall_start, wall_end,
      act_engineering_start, act_engineering_end,
      act_precast_start, act_precast_end,
      act_precast_ship_start, act_precast_ship_end,
      act_steel_start, act_steel_end,
      act_accessory_start, act_accessory_end,
      act_wall_start, act_wall_end	) =
		(	select	subTbl.STRUCTURE_NAME,
							subTbl.REVISION_NUMBER,
							subTbl.UNIT_OF_MEASURE,
							subTbl.TOFF_JOB_ID,
							subTbl.STATUS_CODE,
							subTbl.SOIL_REINF_TYPE,
							subTbl.TOTAL_AREA,
							subTbl.PRELIM_DATE,
							subTbl.FINAL_DATE,
							subTbl.TOTAL_STEEL_LF,
							subTbl.TOTAL_STEEL_TONS,
							subTbl.TOTAL_STEEL_QTY,
							subTbl.WALL_LENGTH,
							subTbl.NUM_COLUMNS,
							subTbl.AVG_HEIGHT,
							subTbl.NUM_PANELS,
							subTbl.NUM_TIES,
							subTbl.IMPORTER_ID,
							subTbl.LAST_UPDATE_DATE,
							subTbl.LAST_UPDATED_BY,
							subTbl.CREATION_DATE,
							subTbl.CREATED_BY,
							subTbl.LAST_UPDATE_LOGIN,
              subTbl.IS_CORP_STD,
              subTbl.IS_MURAL_WALL,
              subTbl.CONTENTS_CODE,
      engineering_start, engineering_end,
      precast_start, precast_end,
      precast_ship_start, precast_ship_end,
      steel_start, steel_end,
      accessory_start, accessory_end,
      wall_start, wall_end,
      act_engineering_start, act_engineering_end,
      act_precast_start, act_precast_end,
      act_precast_ship_start, act_precast_ship_end,
      act_steel_start, act_steel_end,
      act_accessory_start, act_accessory_end,
      act_wall_start, act_wall_end
			from	reco_toff_structs subTbl
			where		subTbl.toff_struct_id = givenStructId)
        where toff_struct_id = givenStructId;

  end;

  if givenShouldCommit = TRUE
  then commit;
  end if;

  return 'DONE';
exception
  when others
  then
    rollback;
    return 'Error 0040 - Unknown Error. Contact MIS:'||sqlerrm;
end; -- write_history_for_struct

