-- takeoff_is_TRLLBskJob
--
-- DESCRIPTION
-- RECo currently groups two different styles of wire-wall under the product
-- code of 'TRL'. Well, actually there's at least three different styles, but
-- for these purposes we look at two-types of TRL-code jobs
-- 1) Single-Stage and Two-Stage jobs
-- 2) L-Basket jobs
--
-- For Single-Stage and Two-Stage jobs, the main panels are A/B/P/Q. There are
-- few (if any) actual L-panels. For these jobs, A/B/P/Q get tiestrips, and are
-- treated at "official" TRL wire panels. The L-Baskets are just tacked on by
-- themselves as one-per-columns.
--
-- But some TRL jobs are made entirely of L-Baskets. In this case, the L-Basket
-- is treated as a regular panel, along with A/B/P/Q (if any). So for this case,
-- The L-Basket gets rods / strips / etc ...
--
-- UPDATES
-- : None
--
-- PRE-CONDITIONS
-- : given pi_ImportId is a valid import id
-- : given pi_ProductCode is a valid product code
-- : this function should only analyze TRL jobs (not OTL / etc), so if you
--   use this function for a non-TRL job then you will get an error
--
-- POST-CONDITIONS
-- : When invalid parameters are passed, some error occurs, then we return an
--   error message.
-- : When valid parameters are passed, but some user-error makes us receive a
--   value of pi_NumColumns = 0, then we can't return a definitive answer. So
--   we just assume the basic / common TRL job style and return 'NO'
-- : When function completes, if indicated TRL import is a "standard" TRL job
--   like Single-Stage or Two-Stage, then return 'NO'
-- : When function completes, if indicated TRL import is a "L-Basket" style
--   TRL job, then return 'YES'
FUNCTION takeoff_is_TRLLBskJob ( pi_ImportId IN NUMBER,
                                 pi_ProductCode IN VARCHAR2,
                                 pi_NumColumns IN NUMBER)
RETURN VARCHAR2
IS
  vn_TempQtyLBaskets number;
  vn_TempTotalPanelQty number;

BEGIN

  IF pi_ProductCode not in ('CT1','CT2','CT3' )
  THEN RETURN 'Error 0024 - Internal error for function call';
  END IF;

  if nvl(pi_NumColumns,0) <= 0
  then return 'NO';
  end if;

  vn_TempQtyLBaskets := 0;

  begin
    SELECT SUM(quantity_required)
    INTO vn_TempQtyLBaskets
    FROM reco_toff_panel_pending
    WHERE toff_struct_pending_id = pi_ImportId
    AND panel_name LIKE 'L%';

    if vn_TempQtyLBaskets is null
    then vn_TempQtyLBaskets := 0;
    end if;
  exception
    when NO_DATA_FOUND then vn_TempQtyLBaskets := 0;
    when others then return 'ERROR';
  end;

  vn_TempTotalPanelQty := 0;

  begin
    SELECT SUM(quantity_required)
    INTO vn_TempTotalPanelQty
    FROM reco_toff_panel_pending
    WHERE toff_struct_pending_id = pi_ImportId;

    if vn_TempTotalPanelQty is null
    then vn_TempTotalPanelQty := 0;
    end if;
  exception
    when NO_DATA_FOUND then vn_TempTotalPanelQty := 0;
    when others then return 'ERROR';
  end;

  if vn_TempQtyLBaskets > 0
  and vn_TempQtyLBaskets > pi_NumColumns
  and vn_TempQtyLBaskets > vn_TempTotalPanelQty * .6
  then return 'YES';
  end if;

  return 'NO';
END; -- takeoff_is_TRLLBskJob

