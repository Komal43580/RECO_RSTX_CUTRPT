-- get_std_panel_areas
--
-- DESCRIPTION
-- Using the Panel Name, RECo assumes standard areas for some panels.
-- Use this method to access standard panelname/area data.
--
-- PRE-CONDITIONS
-- : givenUOM should be valid
-- : givenProdCode is given
-- : commaSeparatedPanNames is a list of panel names that you want to get
--   standard areas for. It should be of format
--   : 'A','B','CII','Q','ZZZZ'
--   This is required for network performance reasons (i.e. no blind queries
--
-- POST-CONDITIONS
-- : If successful, return a nested-table collection that contains panName and
--   stdArea. You can get the qty with outputobject.count method.
-- : It is possible for this method to return a collection with 0 items. It
--   just means the commaSeparatedPanNames given don't have any standard
--   heights, which is okay.
-- : Return null if error
function get_std_panel_areas (givenuom in varchar2,
                              givenprodcode in varchar2,
                              commaseparatedpannames in varchar2)
return coll_stdpanelareas
is
  vo_thepanelsapproved prec_takeoff.coll_stdpanelareas; -- Fetched, so don't initialize

  type dyn_cursor is ref cursor;
  cur_mycursor dyn_cursor;

  vc_jobtype varchar2(1);

  vc_tmpquery varchar2(4000);
begin
  if givenuom is null
  or givenprodcode is null
  or commaseparatedpannames is null
  then return null;
  end if;

  if length(givenuom) = 0
  or length(givenprodcode) = 0
  or length(commaseparatedpannames) = 0
  or givenuom not in ('SF','LF','SM','LM')
  or substr(commaseparatedpannames,1,1) != chr(39)
  then return null;
  end if;

	if givenuom in ('SF','LF') then vc_jobtype := 'E';
	elsif givenuom in ('SM','LM') then vc_jobtype := 'M';
	end if;

  vc_tmpquery :=
    'select distinct dataProdPanLvl.data_value name, '||
    'to_number(dataAreaLvl.data_value) area '||
    'from reco_domain_data dataEMLvl, reco_domain_data dataProdLvl, '||
    'reco_domain_data dataProdPanLvl, reco_domain_data dataAreaLvl '||
    'where dataEMLvl.domain_name = '||chr(39)||'RECO_JOB_TYPE'||chr(39)||' '||
    'and dataProdLvl.domain_name = '||chr(39)||'RECO_PRODUCTS'||chr(39)||' '||
    'and dataProdPanLvl.domain_name = '||chr(39)||'RECO_PRODUCT_PANELS'||chr(39)||' '||
    'and dataAreaLvl.domain_name (+) = '||chr(39)||'RECO_PANEL_AREAS'||chr(39)||' '||
    'and dataEMLvl.data_rownum = dataProdLvl.master_data_rownum '||
    'and dataProdLvl.data_rownum = dataProdPanLvl.master_data_rownum '||
    'and dataProdPanLvl.data_rownum = dataAreaLvl.master_data_rownum (+) '||
    'and dataEMLvl.data_value = '||chr(39)||vc_jobtype||chr(39)||' '||
    'and dataProdLvl.data_value = '||chr(39)||givenprodcode||chr(39)||' '||
    'and dataProdPanLvl.data_value in ('||commaseparatedpannames||') '||
    'order by dataProdPanLvl.data_value, dataAreaLvl.data_value';

  open cur_mycursor for vc_tmpquery;
  fetch cur_mycursor bulk collect into vo_thepanelsapproved;
  close cur_mycursor;

  return vo_thepanelsapproved;
end; -- get_std_panel_areas

