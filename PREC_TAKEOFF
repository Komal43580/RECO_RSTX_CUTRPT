-- part_is_active
--
-- DESCRIPTION
-- This function determines if a given part is "active" in the RECo system.
-- Simply, this determines if the PURCHASING_ENABLED_FLAG is set as 'Y or 'N'.
--
-- This function is overloaded. One version takes an INVENTORY_ITEM_ID as a
-- number, and one version takes the PART_NAME as a string.
--
-- PRE-CONDITIONS
-- : Given parameter should not be null
--
-- POST-CONDITIONS
-- : Return 'YES' if we find the part, and it is active / enabled
-- : Return 'NO' if we find the part, and it is inactive / disabled
-- : If any error occurs, return an error message
function part_is_active ( pi_partname in varchar2 )
  return varchar2
is
  cursor cur_getpartexists (givenpartname varchar2)
  is
    select  active_flag
    from  prec_parts
    where  part_code like givenpartname;

  tmpresult varchar2(50);

begin -- part_is_active

  if pi_partname is null
  then return 'Error - partcode is null';
  end if;

  open cur_getpartexists(pi_partname);
  fetch cur_getpartexists into tmpresult;
  if cur_getpartexists%notfound
  then
    close cur_getpartexists;
    return 'Error - Part name does not exist';
  end if;
  close cur_getpartexists;

  if tmpresult = 'N'
  then
    return 'NO';
  end if;

  return 'YES';
end part_is_active;

