-- StructHasCosts
--
-- Find if a takeoff wall has any PCF/MO cost history
--
-- PRE-CONDITIONS
-- : givenToffStrId is valid
--
-- POST-CONDITIONS
-- : Return 'DONE' if everything works
-- : Return an error if something fails
-- : When completeing and 'DONE', this method sets the value of
--   outCostsExist to 'Y' if costs found or 'N' if no costs found
function StructHasCosts ( givenToffStrId in number,
                          outCostsExist out varchar2)
                          return varchar2
is
  vc_TmpErrMsg varchar2(100);
  vn_TmpPCFQty number;
  vn_TmpMOQty number;
begin
  vc_TmpErrMsg := prec_takeoff.GetStructPCFQty(givenToffStrId,vn_TmpPCFQty);
  if vc_TmpErrMsg != 'DONE'
  then
    outCostsExist := null;
    return vc_TmpErrMsg;
  end if;

  vc_TmpErrMsg := prec_takeoff.GetStructMOQty(givenToffStrId,vn_TmpMOQty);
  if vc_TmpErrMsg != 'DONE'
  then
    outCostsExist := null;
    return vc_TmpErrMsg;
  end if;

  if vn_TmpPCFQty > 0 or vn_TmpMOQty > 0
  then outCostsExist := 'Y';
  else outCostsExist := 'N';
  end if;

  return 'DONE';
end; -- StructHasCosts

