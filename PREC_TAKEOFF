-- import_structure
--
-- This function takes a structure from the import tables, does some validation,
-- then either imports the data and saves it, or clears and inserts the new revision.
-- It is done as a single transaction, so if there are any failures, it returns
-- a simple description of what went wrong.   If it succeeds, it will return 'Imported.'
-- either a salesid/projectid or pi_StructId MUST be passed in.  If no pi_StructId, it
-- creates a new one for the salesid.   The importid must exist as well.
-- Update 08/02/2010 by DSM
-- : Changed parameters to accept user-id and login-id
-- : Changed parameters to accept number-of-columns and wall-length
--   (this saves caller from manually handling set avg_height and such)
-- Update 11/11/2011 by DSM
-- : Converted import to new takeoff system
--
-- PRE-CONDITIONS
-- : All parameters are required to be valid, except ToffJobId and ToffStructid,
--   where only one of those needs to be valid
--
-- POST-CONDITIONS
-- : Return 'DONE' when successful
-- : Return an error message when failure
-- : When successful, if ToffStructId is not provided, the import is added
--   to the indicated ToffJobId as a new wall, and output po_StrIdModified is set
--   to the new structure id that was added
-- : When successful, if ToffStructId is provided, then ToffJobId is ignored and
--   the indicated pi_ToffStructId is overwritten with the new import data,
--   and po_StrIdModified is set to the struct id that was updated
FUNCTION import_structure( pi_UserID IN varchar2, pi_LoginID IN number,
                           pi_NumColumns IN number, pi_WallLength IN number,
                           pi_ToffJobId IN number, pi_ToffStructId IN number,
                           pi_ImportId IN number, pi_JobType IN varchar2,
                           pi_UOM IN varchar2, po_StrIdModified out number )
RETURN varchar2
IS

  rec_ToffJobV reco_toff_jobs_v%ROWTYPE;

  vn_DestinationStructId number;

  vb_IsNewStruct BOOLEAN;
  vb_IsRevision BOOLEAN;

  vn_OriginalRevNum number;

  vc_TempErrorMsg varchar2(1024);

  cursor cur_PendingStructureHdr(pi_GivenPendingStructId in number)
  is select * from reco_toff_struct_pending where toff_struct_pending_id = pi_GivenPendingStructId;

  rec_PendingStructureHdr cur_PendingStructureHdr%rowtype;

  -----------------------------------------------------------------------------
  -- Read reco_toff_jobs_v data into a record using our method parameters
  --
  -- This makes it easy to access job information without having to requery
  -- the job number every 5 seconds.
  --
  -- We need to re-read each time we update ToffJ table, so this code was
  -- wrapped into a function for sanity
  function func_RetrieveJobData(rec_FromJob out reco_toff_jobs_v%ROWTYPE)
  return varchar2
  is
    vn_TempNum number;
    vc_TmpSubErr varchar2(1024);
  begin

    vc_TmpSubErr := 'DONE';

    vn_TempNum := pi_ToffJobId;
    if pi_ToffStructId is not null
    then
      begin
        select subTbl.toff_job_id
        into vn_TempNum
        from reco_toff_structs subTbl
        where subTbl.toff_struct_id = pi_ToffStructId;
      exception
        when no_data_found then vc_TmpSubErr := 'Internal Error 0010 - Import failed';
        when too_many_rows then vc_TmpSubErr := 'Internal Error 0011 - Import failed';
        when others then vc_TmpSubErr := 'Internal Error 0012 - Import failed';
      end;
    end if;

    if vc_TmpSubErr != 'DONE'
    then return vc_TmpSubErr;
    end if;

    begin
      select subTbl.*
      into rec_FromJob
      from reco_toff_jobs_v subTbl
      where subTbl.toff_job_id = vn_TempNum;
    exception
      when no_data_found then vc_TmpSubErr := 'Internal Error 0013 - Import failed';
      when too_many_rows then vc_TmpSubErr := 'Internal Error 0014 - Import failed';
      when others then vc_TmpSubErr := 'Internal Error 0015 - Import failed';
    end;

    return vc_TmpSubErr;
  end; -- func_RetrieveJobData

BEGIN -- import_structure

  ---------------------------------------------------------------
  -- Initialize many output variables
  ---------------------------------------------------------------

  -- Some old boolean from 10 years ago, probably can be replaced by a simple FUNCTION-RETURN value
  did_complete := FALSE;

  -- The warning messages that are generated by this import process
  clear_messages;

  -- Temporary string that holds a return-value from a function or other similar message.
  -- Usually 'DONE' means success, or null means NO ERRORS. Any other string
  -- indicates an ERROR MESSAGE STRING to error out and return to the user
  vc_TempErrorMsg := null;

  -- Importing a new structure can generate a new record, and new primary key
  po_StrIdModified := 0;

  declare
    vc_Found varchar2(1);
  begin
    select 'Y'
    into vc_Found
    from reco_toff_struct_pending
    where toff_struct_pending_id = pi_ImportId;
  exception
    when no_data_found
    then
      rollback;
      return 'Internal Error 0007 - Import failed';
    when too_many_rows
    then
      rollback;
      return 'Internal Error 0008 - Import failed';
    when others
    then
      rollback;
      return 'Internal Error 0009 - Import failed';
  end;

  ---------------------------------------------------------------
  -- Access the pending structure info and destination job info
  ---------------------------------------------------------------

  open cur_PendingStructureHdr(pi_ImportId);
  fetch cur_PendingStructureHdr into rec_PendingStructureHdr;
  close cur_PendingStructureHdr;

  vc_TempErrorMsg := func_RetrieveJobData(rec_ToffJobV);

  if vc_TempErrorMsg != 'DONE'
  then rollback;
        return vc_TempErrorMsg;
  end if;

  ---------------------------------------------------------------
  -- Verify pending Job-Level info against the destination Job
  -- JobNo matches?
  -- Product matches?
  -- Unit System matches?
  ---------------------------------------------------------------

  if rec_toffJobV.project_number
      !=
      nvl(rec_PendingStructureHdr.project_number,rec_toffJobV.project_number)
  then
    rollback;
    vc_TempErrorMsg :=
      'The import wall JobNo '||
      rec_PendingStructureHdr.project_number||
      ' does not match your selected project number !';
    return vc_TempErrorMsg;
  end if;

  if rec_toffJobV.product_code
      !=
      nvl(rec_PendingStructureHdr.product_code,rec_toffJobV.product_code)
  then
    rollback;
    vc_TempErrorMsg :=
      'The import wall Product '||
      rec_PendingStructureHdr.product_code||
      ' does not match your selected project product code !';
    return vc_TempErrorMsg;
  end if;

  declare
    vb_ExactUOMRequired boolean;
  begin
    vb_ExactUOMRequired := true;
    if ProdCodeCanBeLinear(rec_ToffJobV.product_code) = 'T'
    and ProdCodeCanBeSquare(rec_ToffJobV.product_code) = 'T'
    then vb_ExactUOMRequired := false;
    end if;

    vc_TempErrorMsg := prec_takeoff.validate_uom(
      rec_ToffJobV.toff_job_id, pi_ImportId, vb_ExactUOMRequired);

    if vc_TempErrorMsg != 'Valid'
    then
      rollback;
      return vc_TempErrorMsg;
    end if;
  end;

  ---------------------------------------------------------------
  -- Type of Import (New, ReplaceExisting) and destination struct id
  ---------------------------------------------------------------

  vb_IsNewStruct := false;
  vb_IsRevision := false;

  if pi_ToffStructId is not null
  then
    vb_IsNewStruct := false;
    vb_IsRevision := true;
    vn_DestinationStructId := pi_ToffStructId;
  elsif pi_ToffStructId is null
  then
    vb_IsNewStruct := true;
    vb_IsRevision := false;
    select reco_structure_seq.nextval into vn_DestinationStructId from dual;
  end if;

  ---------------------------------------------------------------
  -- Verify pending structure info against destination struct
  -- IS_CORP_STD matches?
  -- IS_MURAL_WALL matches?
  -- CONTENTS_CODE matches?
  ---------------------------------------------------------------

  if vb_IsRevision = true
  then
    declare
      vr_ExistingStructRec reco_toff_structs%rowtype;
    begin
      select *
      into vr_ExistingStructRec
      from reco_toff_structs
      where toff_struct_id = vn_DestinationStructId;

      if nvl(vr_ExistingStructRec.is_corp_std,'N')
            != nvl(rec_PendingStructureHdr.is_corp_std,'N')
      then
        rollback;
        vc_TempErrorMsg := 'Internal Error 0091 - Import Failed.'||
                            ' New Import is a CORP-RLA standard wall, which'||
                            ' does not match the takeoff wall selected.'||
                            ' Please fix the drawing, or correct the checkbox in Takeoff.';
        if nvl(rec_PendingStructureHdr.is_corp_std,'N') = 'N'
        then
          vc_TempErrorMsg := 'Internal Error 0091 - Import Failed.'||
                              ' New Import is a Central Legacy RLA standard wall, which'||
                              ' does not match the takeoff wall selected.'||
                              ' Please fix the drawing, or correct the checkbox in Takeoff.';
        end if;
        return vc_TempErrorMsg;
      end if;

      if nvl(vr_ExistingStructRec.is_mural_wall,'N')
            != nvl(rec_PendingStructureHdr.is_mural_wall,'N')
      then
        rollback;
        vc_TempErrorMsg := 'Internal Error 0092 - Import Failed.'||
                            ' New Import is a mural wall, which'||
                            ' does not match the takeoff wall selected.'||
                            ' Please open Takeoff and mark the wall as Mural.';
        if nvl(rec_PendingStructureHdr.is_mural_wall,'N') = 'N'
        then
          vc_TempErrorMsg := 'Internal Error 0092 - Import Failed.'||
                              ' The takeoff wall was indicated as a mural wall, which'||
                              ' does not match the pending import selected.'||
                              ' Please fix the drawing, or de-select the mural option in Takeoff.';
        end if;
        return vc_TempErrorMsg;
      end if;

      if nvl(vr_ExistingStructRec.contents_code,'STRUCTURE')
            != nvl(rec_PendingStructureHdr.contents_code,'STRUCTURE')
      then
        rollback;
        vc_TempErrorMsg := 'Internal Error 0094 - Import Failed.'||
                            ' New Structure is of type '||
                            chr(39)||nvl(rec_PendingStructureHdr.contents_code,'STRUCTURE')||chr(39)||
                            ', but the wall in Takeoff is listed as '||
                            chr(39)||nvl(vr_ExistingStructRec.contents_code,'STRUCTURE')||chr(39)||
                            '. Please match the Extract with the Takeoff Structure.';
        return vc_TempErrorMsg;
      end if;
    end;
  end if;

  ---------------------------------------------------------------
  -- If making a new structure,
  -- then a lot of the old Takeoff code requires
  -- a record to exist in reco_toff_structs
  ---------------------------------------------------------------

  if vb_IsNewStruct
  then
    vc_TempErrorMsg := null;

    begin
      insert into reco_toff_structs
        ( toff_struct_id, structure_name, project_number, product_code, 
          unit_of_measure, status_code,
          toff_job_id, wall_length, num_columns,
          is_corp_std,
          is_mural_wall,
          contents_code,
          importer_id, last_update_date, last_updated_by,
          creation_date, created_by, last_update_login )
      values
        ( vn_DestinationStructId, rec_PendingStructureHdr.structure_name, rec_pendingstructurehdr.project_number, 
          rec_pendingstructurehdr.product_code,
          rec_PendingStructureHdr.unit_of_measure, 'PRELIM',
          rec_ToffJobV.toff_job_id, pi_WallLength, pi_NumColumns,
          nvl(rec_PendingStructureHdr.is_corp_std,'N'),
          nvl(rec_PendingStructureHdr.is_mural_wall,'N'),
          nvl(rec_PendingStructureHdr.contents_code,'STRUCTURE'),
          pi_UserID, SYSDATE, pi_UserID,
          SYSDATE, pi_UserID, pi_LoginID );
    exception
      when others then vc_TempErrorMsg := 'Internal Error 0019 - Import failed'||sqlerrm;
    end;

    if vc_TempErrorMsg is not null
    then rollback;
          return vc_TempErrorMsg;
    end if;

    vc_TempErrorMsg := prec_takeoff.set_toff_calc_values(null,vn_DestinationStructId);

    if vc_TempErrorMsg != 'DONE'
    then rollback;
          return vc_TempErrorMsg;
    end if;

    -- If there is chance the jobs table has changed, we need to re-read it
    vc_TempErrorMsg := func_RetrieveJobData(rec_ToffJobV);
    if vc_TempErrorMsg != 'DONE'
    then rollback;
          return vc_TempErrorMsg;
    end if;
  end if;

  ---------------------------------------------------------------
  -- When revising a row we should move it to history
  ---------------------------------------------------------------

  if vb_IsRevision
  then
    insert into reco_toff_struct_hist
		(	toff_struct_id, project_Number, product_code, structure_name, revision_number, unit_of_measure,
			toff_job_id, status_code, soil_reinf_type, total_area, prelim_date,
			final_date, total_steel_lf, total_steel_tons, total_steel_qty,
			wall_length, num_columns, avg_height, num_panels, num_ties,
      is_corp_std, is_mural_wall, contents_code,
			importer_id, last_update_date, last_updated_by, creation_date,
			created_by, last_update_login	)
		(	select	subTbl.TOFF_STRUCT_ID,  subtbl.project_Number, subtbl.product_code,
							subTbl.STRUCTURE_NAME,
							subTbl.REVISION_NUMBER,
							subTbl.UNIT_OF_MEASURE,
							subTbl.TOFF_JOB_ID,
							subTbl.STATUS_CODE,
							subTbl.SOIL_REINF_TYPE,
							subTbl.TOTAL_AREA,
							subTbl.PRELIM_DATE,
							subTbl.FINAL_DATE,
							subTbl.TOTAL_STEEL_LF,
							subTbl.TOTAL_STEEL_TONS,
              subTbl.TOTAL_STEEL_QTY,
							subTbl.WALL_LENGTH,
							subTbl.NUM_COLUMNS,
							subTbl.AVG_HEIGHT,
							subTbl.NUM_PANELS,
							subTbl.NUM_TIES,
              subTbl.is_corp_std,
              subTbl.is_mural_wall,
              subTbl.contents_code,
							subTbl.IMPORTER_ID,
							subTbl.LAST_UPDATE_DATE,
							subTbl.LAST_UPDATED_BY,
							subTbl.CREATION_DATE,
							subTbl.CREATED_BY,
							subTbl.LAST_UPDATE_LOGIN
			from	reco_toff_structs subTbl
			where		subTbl.toff_struct_id = vn_DestinationStructId);
  end if;

  ---------------------------------------------------------------
  -- We need to save the "current" revision number before the import does any changes.
  -- A lot of this code will re-gen and raise the revision_number,
  -- so we will need to correct it at the end of the process to what the value should be.
  ---------------------------------------------------------------

  select revision_number
  into vn_OriginalRevNum
  from reco_toff_structs
  where toff_struct_id = vn_DestinationStructId;
  if vb_IsRevision
  then vn_OriginalRevNum := vn_OriginalRevNum + 1;
  end if;

  ---------------------------------------------------------------
  -- update the number of columns for structure and wall_length too
  -- Note: The num_columns is needed for calculate_parts to work properly
  -- Note: The wall_length is needed for avg_height calculations to work
  ---------------------------------------------------------------

  update  reco_toff_structs
  set num_columns = pi_NumColumns,
      wall_length = pi_WallLength
  where toff_struct_id = vn_DestinationStructId;

  ---------------------------------------------------------------
  -- Wipe panels and replace panels
  ---------------------------------------------------------------

  delete from reco_toff_panels where toff_struct_id = vn_DestinationStructId;

  if rec_ToffJobV.product_code not in ( 'TRL','VTL','VTR','OTL','STL','CTT','CT1','CT2','CT3' )
  then
    vc_TempErrorMsg := prec_takeoff.import_panels_normally(
                  pi_ImportId, rec_ToffJobV.product_code,
                  vn_DestinationStructId,'M',
                  pi_LoginID,pi_UserID);
    if vc_TempErrorMsg != 'Imported.'
    then rollback;
          return vc_TempErrorMsg;
    end if;
  end if;

  ---------------------------------------------------------------
  -- now calculate parts
  ---------------------------------------------------------------

  delete from reco_toff_parts where toff_struct_id = vn_DestinationStructId;

  --commit_during_calc := FALSE;
  --vc_TempErrorMsg := prec_takeoff.calculate_parts(
  --                      vn_DestinationStructId,pi_LoginID,pi_UserID);

  --if vc_TempErrorMsg != 'DONE'
  --then rollback;
  --      return vc_TempErrorMsg;
  --end if;

  -- now insert remaining parts from import
  --did_complete := FALSE;
  vc_TempErrorMsg := prec_takeoff.import_reinforcements(
      pi_ImportId, rec_ToffJobV.product_code,
      vn_DestinationStructId, 'M',pi_LoginID,pi_UserID);

  if vc_TempErrorMsg != 'Imported.'
  then rollback;
        return vc_TempErrorMsg;
  end if;

  -- if wire wall, import as parts not panels
  IF rec_ToffJobV.product_code IN( 'TRL','VTR','VTL','OTL','STL','CTT','CT1','CT2','CT3')
  THEN
    prec_takeoff.import_panels_aswire(
      pi_ImportId, rec_ToffJobV.product_code, pi_NumColumns,
      vn_DestinationStructId,'M',
      pi_LoginID,pi_UserID);
  END IF;

  -- if TRL, then sometimes we add one L-Basket per column, sometimes no
  declare

    -- Single Stage TRL and 2-Stage TRL only
    -- Find number of Wire-Panels that are Black (not galvanized)
    -- -> Excludes L-Baskets (if any), since those are not wire-panels in this case
    CURSOR cur_TRLNumBlack (givenImportId number) IS
    SELECT  SUM(quantity_required)
    FROM  reco_toff_panel_pending
    WHERE   toff_struct_pending_id = givenImportId
    AND     panel_name NOT LIKE 'L%'
    AND     panel_finish = 'B';

    -- Single Stage TRL and 2-Stage TRL only
    -- Find number of Wire-Panels total
    -- -> Excludes L-Baskets (if any), since those are not wire-panels in this case
    CURSOR cur_TRLNumTotal (givenImportId number) IS
    SELECT  SUM(quantity_required)
    FROM  reco_toff_panel_pending
    WHERE   toff_panel_pending_id = givenImportId
    AND     panel_name NOT LIKE 'L%';

    tempTRLBlack number;
    tempTRLTotal number;
    tempItemId varchar2(25);
    tempRetNum number;
  begin
    IF rec_ToffJobV.product_code = 'TRL'
    THEN
      vc_TempErrorMsg := takeoff_is_TRLLBskJob(
                pi_ImportId,rec_ToffJobV.product_code,pi_NumColumns);

      -- only add L-Baskets per-column when job is single-stage or two-stage
      IF vc_TempErrorMsg = 'NO'
      THEN

        -- See cursor defn. for additional details
        OPEN cur_TRLNumBlack(pi_ImportId);
        FETCH cur_TRLNumBlack INTO tempTRLBlack;
        IF cur_TRLNumBlack%NOTFOUND
        THEN tempTRLBlack := 0;
        END IF;
        CLOSE cur_TRLNumBlack;

        -- See cursor defn. for additional details
        OPEN cur_TRLNumTotal(pi_ImportId);
        FETCH cur_TRLNumTotal INTO tempTRLTotal;
        IF cur_TRLNumTotal%NOTFOUND
        THEN tempTRLTotal := 0;
        END IF;
        CLOSE cur_TRLNumTotal;

        IF tempTRLBlack = tempTRLTotal
        THEN
          tempItemId:= 'W5LB' ;
        ELSE
          tempItemId:= 'W5LG';
        END IF;

        tempRetNum := insert_struct_parts(
                  vn_DestinationStructId, tempItemId, 0, pi_NumColumns, pi_NumColumns,
                  pi_LoginID,pi_UserID);
      END IF;
    END IF;
  end;

  fold_up_parts(vn_DestinationStructId,pi_LoginID,pi_UserID);

  -- We made a lot of changes, and some calc columns probably aren't set yet.
  -- So let's run the auto complete for the structure, sync with it, and
  -- make sure our revision number stays good

  vc_TempErrorMsg := prec_takeoff.set_toff_calc_values(null,vn_DestinationStructId);

  if vc_TempErrorMsg != 'DONE'
  then rollback;
        return vc_TempErrorMsg;
  end if;

  -- If there is chance the jobs table has changed, we need to re-read it
  vc_TempErrorMsg := func_RetrieveJobData(rec_ToffJobV);
  if vc_TempErrorMsg != 'DONE'
  then rollback;
        return vc_TempErrorMsg;
  end if;

  -------
  -- New Feature MAY-2015
  --
  -- A Job Specific Exception for large Florida Job
  -- This also forms a template for "Splitting Finish" Feature if things go well
  -------

  if nvl(rec_PendingStructureHdr.contents_code,'STRUCTURE') = 'PANELS ONLY'
  then
    update reco_toff_structs
    set num_columns = 0
    where toff_struct_id = vn_DestinationStructId;

    update reco_toff_parts
    set adj_quantity = (calc_quantity * -1), quantity_required = 0
    where toff_struct_id = vn_DestinationStructId;
  end if;

  if nvl(rec_PendingStructureHdr.contents_code,'STRUCTURE') = 'PARTS ONLY'
  then
    update reco_toff_panels
    set quantity_required = 0
    where toff_struct_id = vn_DestinationStructId;
  end if;

  declare
    vc_OutputMssg varchar2(1000);
  begin
    vc_OutputMssg := set_toff_calc_values(null, vn_DestinationStructId);
  end;

  -- If there is chance the jobs table has changed, we need to re-read it
  vc_TempErrorMsg := func_RetrieveJobData(rec_ToffJobV);
  if vc_TempErrorMsg != 'DONE'
  then rollback;
        return vc_TempErrorMsg;
  end if;

  -------
  -- This continues normally
  -------

  -- We have calculated and re-calculated several times,
  -- so the revision number is probably through the roof
  -- so let's set it properly
  update reco_toff_structs
  set revision_number = vn_OriginalRevNum
  where toff_struct_id = vn_DestinationStructId;

  -- Lastly, set the who columns for all the panels and parts and the structure
  -- Be sure to check if this is importing new structure vs Revising an
  -- existing one
  declare
    vd_ThisDate date := SYSDATE;
  begin
    update reco_toff_panels
    set creation_date = vd_ThisDate,
        created_by = pi_UserID,
        last_update_date = vd_ThisDate,
        last_updated_by = pi_UserID,
        last_update_login = pi_LoginId
    where toff_struct_id = vn_DestinationStructId;

    update reco_toff_parts
    set creation_date = vd_ThisDate,
        created_by = pi_UserID,
        last_update_date = vd_ThisDate,
        last_updated_by = pi_UserID,
        last_update_login = pi_LoginId
    where toff_struct_id = vn_DestinationStructId;

    if vb_IsRevision = FALSE
    then
      update reco_toff_structs
      set creation_date = vd_ThisDate,
          created_by = pi_UserID,
          last_update_date = vd_ThisDate,
          last_updated_by = pi_UserID,
          last_update_login = pi_LoginId
      where toff_struct_id = vn_DestinationStructId;
    elsif vb_IsRevision = TRUE
    then
      update reco_toff_structs
      set last_update_date = vd_ThisDate,
          last_updated_by = pi_UserID,
          last_update_login = pi_LoginId
      where toff_struct_id = vn_DestinationStructId;
    end if;
  end;

  -- Commit everything
  --COMMIT;

  po_StrIdModified := vn_DestinationStructId;

  -- Now that EVERYTHING has been processed properly, we can inform
  -- people of a revision.
  -- It all gets handled nicely in one method

  vc_TempErrorMsg := send_wall_change_email(vn_DestinationStructId,TRUE);

  if vc_TempErrorMsg != 'DONE'
  then rollback;
        return vc_TempErrorMsg;
  end if;

  -- set this variable here
  --commit_during_calc := TRUE;

  -- this function is finished, but caller may want to check the
  -- message_count function to see if any warnings occured

  -- call coordinate import procedure
  -- 7/19  determines whether to import, commits, adds warnings as needed
  --
  prec_takeoff.coord_import( vn_DestinationStructId, pi_importid );
  
  --added by komal 12-APR-26 
  
  delete from reco_toff_part_pending
  where toff_struct_pending_id = pi_ImportId;

  delete from reco_toff_panel_pending
  where toff_struct_pending_id = pi_ImportId;

  delete from reco_toff_struct_pending
  where toff_struct_pending_id = pi_ImportId;
  
  COMMIT;
  --

  did_complete := TRUE;
  RETURN 'DONE';
END; -- import_structure

-- imports existing structure coordinates
procedure process_coord_import( errbuf out varchar2, retcode out number, p_struct_pending_id in number, p_takeoff in number ) is

thisstruct  reco_toff_struct_coords%ROWTYPE;
thispanel   reco_toff_panel_coords%ROWTYPE;
finalpanel    reco_toff_panel_coordinates%ROWTYPE;
thisstructid  reco_toff_panel_coordinates.toff_struct_id%TYPE;
matchedpanelid  reco_toff_panel_coordinates.toff_panel_id%TYPE;

cursor getstruct is select * from reco_toff_struct_coords where toff_struct_pending_id = p_struct_pending_id;

cursor getpanels is select * from reco_toff_panel_coords where toff_struct_pending_id = p_struct_pending_id;

-- we take first instance of structure: if they duplicate its on them
cursor lookforstructure( pnum varchar2, prod varchar2, sname varchar2 )  is
   select toff_struct_id from reco_toff_structs ts, prec_project_products pp, prec_projects p
   where p.project_number = pnum
    and  pp.project_id = p.project_id and pp.product_code = prod
    and  ts.toff_job_id = pp.product_code and structure_name = sname
    order by creation_date desc;

-- search for panel type in takeoff, we use exact match
-- 8/7 toff_panel_id is stored in import record now, we do not need to search
 cursor getmatch( pendingid number ) is
   select toff_panel_id from reco_toff_panel_pending
    where toff_panel_pending_id = pendingid;

   cursor getpanel( tsid number, p_x number, p_y number, p_z number ) is
                 select * from reco_toff_panel_coordinates
                       where toff_struct_id = tsid
                         --and toff_panel_id = tpid  just look for coords only
                         and x = p_x and y = p_y and z = p_z;

   isnew  boolean := false;
   lastcoord  varchar2(100);
begin

  open getstruct;
  fetch getstruct into thisstruct;
  if getstruct%NOTFOUND then
     close getstruct;
     errbuf := 'No takeoff found for :'||to_char(p_struct_pending_id);
     retcode := -101;
     return;
  end if;
  close getstruct;

  -- there are no panels for wire walls, so do not import coords
  if thisstruct.product_code in ('TRL', 'VTL', 'VTR', 'OTL', 'CTT', 'CT1', 'CT2', 'CT3') then
     return;
     end if;
  if p_takeoff is null then
     open lookforstructure( thisstruct.project_number,
                         thisstruct.product_code,
                         thisstruct.structure_name );
     fetch lookforstructure into thisstructid;
     if lookforstructure%NOTFOUND then
        close lookforstructure;
        errbuf := 'No imported takeoff found for :'||thisstruct.project_number||','||thisstruct.product_code||','||thisstruct.structure_name;
        retcode := -102;
        return;
     end if;
     close lookforstructure;
  else
     thisstructid := p_takeoff;
  end if;
    prec_takeoff.warning( 'Structure ID:'||to_char(thisstructid) );
  -- update coords to all 'Invalid'
  --   then for each import panel, search for type
  --   look for type + x,y,z, if match, update to Valid
  --   if no match, insert new item as Valid
  --   at end, invalids are those that do not match new coordinate array

  savepoint coordinates;

  update reco_toff_panel_coordinates set panel_status = 'Invalid' where toff_struct_id = thisstructid;

  for thispanel in getpanels loop
      matchedpanelid := null;
      finalpanel := null;
      isnew := false;
      lastcoord := thispanel.panel_name||'-'||to_char(thispanel.x)||','||to_char(thispanel.y)||','||to_char(thispanel.z);
   -- prec_takeoff.warning( lastcoord );

      open getmatch( thispanel.toff_panel_pending_id );
      fetch getmatch into matchedpanelid;
      if getmatch%NOTFOUND then
         matchedpanelid := null;
      end if;
      close getmatch;
   -- prec_takeoff.warning( to_char(matchedpanelid) );

      /* not needed 8/7 open matchtakeoff( thisstructid, thispanel.panel_name,
                                       thispanel.tie_strip_quantity,
                                       thispanel.panel_reinforcements,
                                       thispanel.panel_finish,
                                       thispanel.width,
                                       thispanel.thickness,
                                       thispanel.panel_additions,
                                       thispanel.area_per_piece );
      fetch matchtakeoff into matchedpanelid;
      close matchtakeoff; */

      if matchedpanelid is not null then
         open getpanel( thisstructid, thispanel.x, thispanel.y, thispanel.z );
         fetch getpanel into finalpanel;
         close getpanel;
      end if;
      if finalpanel.panel_coord_id is null then
         -- new panel coord, set up
         finalpanel.toff_struct_id := thisstructid;
         finalpanel.toff_panel_id := matchedpanelid;
         finalpanel.x := thispanel.x;
         finalpanel.y := thispanel.y;
         finalpanel.z := thispanel.z;
         finalpanel.PANEL_ROW := thispanel.panel_row;
         finalpanel.PANEL_COLUMN := thispanel.panel_column;
         finalpanel.LEFTFFHEIGHT := thispanel.leftffheight;
         finalpanel.RIGHTFFHEIGHT := thispanel.rightffheight;
         finalpanel.LINER_TYPE := thispanel.liner_type;
         finalpanel.TOPWIDTH := thispanel.topwidth;
         finalpanel.concretevolume := thispanel.concretevolume;
         finalpanel.created_by := thispanel.created_by;
         finalpanel.creation_date := thispanel.creation_date;
         isnew := true;
      end if;
      finalpanel.panel_status := 'Valid';
      finalpanel.toff_struct_id := thisstructid;
      finalpanel.toff_panel_id := matchedpanelid;
      finalpanel.last_update_date := thispanel.last_update_date;
      finalpanel.last_updated_by := thispanel.last_updated_by;
      finalpanel.last_update_login := thispanel.last_update_login;

      if isnew then
    --prec_takeoff.warning( 'Insert' );

        insert into reco_toff_panel_coordinates values finalpanel;
      else
   -- prec_takeoff.warning( 'Update' );
        update reco_toff_panel_coordinates set row = finalpanel where panel_coord_id = finalpanel.panel_coord_id;
      end if;
   end loop;
   --
   commit;
   retcode := 0;
   errbuf := 'Coordinates Imported.';
exception
  when others then
    errbuf := 'Failed at panel('||lastcoord||') --Loading Error:'||to_char(sqlcode);
    retcode := sqlcode;

    if getstruct%ISOPEN then
       close getstruct;
    end if;
    if getpanels%ISOPEN then
       close getpanels;
    end if;
    if getpanel%ISOPEN then
       close getpanel;
    end if;
    if lookforstructure%ISOPEN then
       close lookforstructure;
    end if;
    if getmatch%ISOPEN then
       close getmatch;
    end if;
    rollback to coordinates;
end;

procedure coord_import( p_struct_id in number, p_import_id in varchar2 ) is
/*
  For structure name, determines most recent version of coordinates
   checks for whether structure is
      coordinate activated (takeoff create > coord start or coords exist)
      import coordinates using above routine
  otherwise, does nothing

  THIS PROCEDURE SHOULD ONLY BE CALLED FROM prec_takeoff DURING IMPORT
*/

cursor checkstruct is  select ts.toff_struct_id, ts.structure_name, p.project_number, ts.creation_date
        from reco_toff_structs ts, prec_project_products pp, prec_projects p
        where toff_struct_id = p_struct_id and pp.product_id = ts.toff_job_id and p.project_id = pp.project_id;

cursor coordsexist is select 'Y' from reco_toff_panel_coordinates where toff_struct_id = p_struct_id;
doesexist varchar2(1) := 'N';

structdata   checkstruct%ROWTYPE;

searchproj varchar2(30);
searchname varchar2(30);

cursor lookforimports is select toff_struct_pending_id from reco_toff_struct_coords
                          where project_number = searchproj
                             and structure_name = searchname
                         order by creation_date desc;

lastimport  number;

cutoffdate date;
xx varchar2(2000);
yy number;
takeoffid number;
begin

  open checkstruct;
  fetch checkstruct into structdata;
  if checkstruct%NOTFOUND then
    -- invalid id
    close checkstruct;
    prec_takeoff.warning('Invalid structure '||to_char(p_struct_id)||' for coordinates import' );
    return;
  end if;
  close checkstruct;
  -- now determine if we should even look at this
  open coordsexist;
  fetch coordsexist into doesexist;
  if coordsexist%notfound then
     doesexist := 'N';
  end if;
  close coordsexist;

  if nvl(doesexist,'N') = 'Y'  then

    -- 1/22/20 change to add import id from takeoff as we should know it
     if p_import_id is null then
        searchproj := structdata.project_number;
        searchname := structdata.structure_name;

        open lookforimports;
        fetch lookforimports into lastimport;
        if lookforimports%notfound then
           close lookforimports;
           prec_takeoff.warning('No coordinates found to import for '||searchproj||','||searchname );
           return;
        end if;
        close lookforimports;
        takeoffid  := p_struct_id;
        else
        lastimport := p_import_id;
        takeoffid := p_struct_id;
        end if;

     process_coord_import( xx, yy, lastimport, takeoffid );
     prec_takeoff.warning( xx );
  end if;

  end;


-- builds wall panel list for pcf
procedure generate_wall_panels( p_pcf in number )  is

  cursor getwalls is select w.* from prec_pcf_walls w, prec_pcf p
                      where p.pcf_id = p_pcf
                         and w.pcf_id = p.pcf_id
                         and exists ( select * from prec_pcf_panels
                                     where pcf_id = w.pcf_id) ;

  cursor getmeasure(pcf number) is select unit_of_measure
                          from prec_pcf p
                         where pcf_id = pcf;
measuretype varchar2(1);
walls   prec_pcf_walls%ROWTYPE;
entry   prec_pcf_wall_panels%ROWTYPE;
mark    prec_pcf_panels%ROWTYPE;
  cursor getreq( pcf number) is select * from prec_pcf_panels
          where pcf_id = pcf order by mark_number;

  cursor matchtakeoff( struct number, pn varchar2, ties number, reins varchar2, fin varchar2,
                       w varchar2, thick varchar2,
                       adds varchar2, a varchar2 ) is
   select toff_panel_id, quantity_required from reco_toff_panels
     where toff_struct_id = struct
      and panel_name = pn
      and tie_strip_quantity = ties
      and nvl(panel_reinforcements,'-') = nvl(reins,'-')
      and nvl(panel_finish,'-') = nvl(fin,'-')
      and ( nvl(width,0) = nvl(w,0) OR
            nvl(width,0) = trunc(nvl(w,0),decode(measuretype,'E',2,'M',3)) OR
            nvl(width,0) = round(nvl(w,0),decode(measuretype,'E',2,'M',3))  )
      and (nvl(thickness,0) in (nvl(thick,0),decode(nvl(thick,0),0,-1,thick)) OR
           nvl(thickness,0) = trunc(nvl(thick,0),2) OR
           nvl(thickness,0) = round(nvl(thick,0),2) )
      and nvl(panel_additions,'-') = nvl(adds,'-')
      and ( nvl(area_per_piece,0) = nvl(a,0)  OR
            trunc(nvl(area_per_piece,0),decode(measuretype,'E',2,'M',3)) = trunc(nvl(a,0),decode(measuretype,'E',2,'M',3)) OR
            round(nvl(area_per_piece,0),decode(measuretype,'E',2,'M',3)) = round(nvl(a,0),decode(measuretype,'E',2,'M',3)) );
myqty number;
mypanelid number;
crnt  varchar2(500);
begin
  -- remove entries for the revision and recreate
  delete from prec_pcf_wall_panels where pcf_id = p_pcf;
  commit;
  for walls in getwalls loop
      open getmeasure( walls.pcf_id);
      fetch getmeasure into measuretype;
      close getmeasure;

      entry := null;
      entry.pcf_id := walls.pcf_id;
      entry.wall_name := walls.wall_name;
      entry.structure_id := walls.structure_id;

      for mark in getreq( walls.pcf_id) loop
          if entry.structure_id is null then
             -- no takeoff match, just present marks as is
             entry.mark_number := mark.mark_number;
             entry.quantity := mark.quantity_required;
          else
             open matchtakeoff( entry.structure_id, mark.panel_name,
              mark.tie_strip_quantity, mark.panel_reinforcements,mark.panel_finish,
              mark.width, mark.thickness, mark.panel_additions,
              mark.area_per_piece );
             fetch matchtakeoff into mypanelid, myqty;
             if matchtakeoff%NOTFOUND then
                -- we are ignoring past mark differences for import
                mypanelid := null;
                myqty := 0;
             end if;
             close matchtakeoff;
             entry.mark_number := mark.mark_number;
             --entry.toff_panel_id := mypanelid;
             entry.quantity := myqty;

          end if;
       if entry.quantity <> 0 then
          crnt := to_char(entry.pcf_id)||'/'||to_char(entry.mark_number)||'/'||entry.wall_name;
          insert into prec_pcf_wall_panels values entry;
       end if;
       end loop;
       commit;
   end loop;
exception
when others then
dbms_output.put_line( crnt );
dbms_output.put_line(sqlerrm);

end;

procedure clear_prodimport(p_pcf in number) is
begin
  delete from reco_toff_pcf_import where pcf_id = p_pcf;
end;

procedure send_structure_to_prod( structureid in number,
                                  pcfid in number )
is
  cursor check4wall
  is
    select  pcfwall.wall_area,
            pcfwall.wall_name
    from  reco_toff_structs toffs,
          prec_pcf_walls pcfwall
    where   pcfwall.pcf_id = pcfid
    and     ( pcfwall.wall_name = toffs.structure_name
              or
              pcfwall.structure_id = toffs.toff_struct_id )
    and     toffs.toff_struct_id = structureid;

  curarea number := 0;
  curname  varchar2(60);
begin
  clear_prodimport( pcfid );
  commit;
  -- changes as part of panel wall breakout
  insert into reco_toff_pcf_import ( quantity, name, tiestrips, reinforcements, width, thickness,
                           additions, finish, area, pcf_id, structure_id )
  select quantity_required, panel_name, tie_strip_quantity, panel_reinforcements,
         width, thickness, panel_additions, panel_finish, area_per_piece,
         pcfid, toff_struct_id
    from reco_toff_panels
   where toff_struct_id = structureid;

  -- now update wall info
  open check4wall;
  fetch check4wall into curarea, curname;
  if check4wall%notfound then
     curarea := -1;
  end if;
  close check4wall;

  if curarea = -1      -- not found
  then
     insert into prec_pcf_walls (pcf_id,wall_name,wall_area, structure_id)
      select pcfid, structure_name, total_area, toff_struct_id
       from reco_toff_structs
      where toff_struct_id = structureid;
  else -- found wall, update area
    update prec_pcf_walls
    set structure_id = structureid,
        wall_area = ( select total_area
                      from reco_toff_structs
                      where toff_struct_id = structureid )
     where pcf_id = pcfid
     and wall_name = curname
     and nvl(structure_id,structureid) = structureid;
  end if;

end;

procedure begin_prod_takeoff( pcfid in number ) is
-- pcf is processed, screen already should have revised

  CURSOR getproj IS
   SELECT *
     FROM prec_pcf v
    WHERE v.pcf_id = pcfid;
    thepcf  prec_pcf%ROWTYPE;
--
pcf  NUMBER;
rev  NUMBER;
pid  NUMBER;
measuretype   VARCHAR2(1);
product  VARCHAR2(3);
CURSOR prods IS
   SELECT COUNT(*), MAX(mark_number) FROM prec_pcf_panels
    WHERE pcf_id = pcf;
isrev NUMBER;
maxmark NUMBER;
CURSOR getnewdata IS
   SELECT SUM(quantity) qty, NAME, tiestrips, reinforcements,
          ROUND(width,3) width,
          ROUND(thickness,2) thickness, NVL(additions,'-') additions, FINISH,
          ROUND(area,3) area
    FROM reco_toff_pcf_import
   WHERE NAME != 'EXECUTE' and pcf_id = pcfid
   GROUP BY NAME, tiestrips, reinforcements, ROUND(width,3),
            ROUND(thickness,2),
            NVL(additions,'-'),FINISH, ROUND(area,3)
   ORDER BY FINISH, reinforcements, NAME, tiestrips;
CURSOR getolddata( pcf number, n VARCHAR2, TIES NUMBER, reins VARCHAR2, w NUMBER,
                   thick NUMBER, adds VARCHAR2, fin VARCHAR2, a NUMBER ) IS
   SELECT quantity_required, mark_number, pc_id, thickness, width, area_per_piece
     FROM prec_pcf_panels
    WHERE pcf_id = pcf
      AND panel_name = n
      AND tie_strip_quantity = TIES
      AND NVL(panel_reinforcements,'-') = NVL(reins,'-')
      AND NVL(panel_finish,'-') = NVL(fin,'-')
      AND ( NVL(width,0) = NVL(w,0) OR
            NVL(width,0) = TRUNC(NVL(w,0),3) OR
            NVL(width,0) = ROUND(NVL(w,0),3)  )
      AND (NVL(thickness,0) IN (NVL(thick,0),DECODE(NVL(thick,0),0,-1,thick)) OR
           NVL(thickness,0) = TRUNC(NVL(thick,0),2) OR
           NVL(thickness,0) = ROUND(NVL(thick,0),2) )
      AND NVL(panel_additions,'-') = NVL(adds,'-')
      AND ( NVL(area_per_piece,0) = NVL(A,0)  OR
            TRUNC(NVL(area_per_piece,0),3) = TRUNC(NVL(A,0),3) OR
            ROUND(NVL(area_per_piece,0),3) = ROUND(NVL(A,0),3) );

CURSOR getdefaults( prod VARCHAR2 ) IS
  SELECT default_additions, default_reinforcements, default_width FROM prec_products
   WHERE product_code = prod;

dfltre       prec_pcf_panels.panel_reinforcements%TYPE;
dfltfi       prec_pcf_panels.panel_finish%TYPE;
dfltad       prec_pcf_panels.panel_additions%TYPE;
dfltwi       prec_pcf_panels.width%TYPE;
dfltth       prec_pcf_panels.thickness%TYPE;


quan  NUMBER;
mark  NUMBER;
pcid  NUMBER;
oldthk NUMBER;
oldwid NUMBER;
oldarea NUMBER;
thk   NUMBER := 0;

description VARCHAR2(80);
BEGIN
  --INSERT INTO prodimport( NAME ) VALUES ( 'EXECUTE' );
  IF pcfid IS NOT NULL
  THEN
     UPDATE prec_pcf SET takeoff_date = TRUNC(SYSDATE)
      WHERE pcf_id = pcfid AND takeoff_date IS NULL ;
     UPDATE prec_pcf SET revision_date = TRUNC(SYSDATE)
      WHERE pcf_id = pcfid;
      commit;

  END IF;
  pcf := pcfid;
  OPEN getproj;
  FETCH getproj INTO thepcf;
  IF thepcf.pcf_id IS NULL THEN
     CLOSE getproj;
     RAISE NO_DATA_FOUND;
  END IF;
  CLOSE getproj;
  pid := thepcf.project_id;
  
  open getdefaults( product );
  fetch getdefaults into dfltad, dfltre, dfltwi;
  CLOSE getdefaults;

  OPEN prods;
  FETCH prods INTO isrev, maxmark;
  CLOSE prods;
  IF isrev = 0 THEN  -- new pcf, need to just dump data in
     mark := 0;
     FOR eachone IN getnewdata LOOP
       mark := mark + 1;
       IF NVL(eachone.thickness,-1) = -1 THEN
          thk := 0;
       ELSE
          thk := eachone.thickness;
       END IF;
  description := '(';
  IF dfltre <> eachone.reinforcements THEN
     description := description||eachone.reinforcements;
  END IF;
  IF dfltwi <> eachone.width THEN
     description := description||LTRIM(TO_CHAR(eachone.width,'90.00'));
  END IF;
  IF dfltad <> eachone.additions THEN
     description := description||eachone.additions;
  END IF;

  IF description = '(' THEN
     description := NULL;
  ELSE
     description := description||')';
  END IF;
  IF NVL(eachone.tiestrips,0) = 0 THEN
     description := eachone.name||description;
  ELSE
     description := eachone.name||LTRIM(TO_CHAR(eachone.tiestrips))||description;
  END IF;

       INSERT INTO prec_pcf_panels ( pc_id, project_id,
              pcf_id, mark_number, quantity_required,
              panel_name, tie_strip_quantity, panel_reinforcements,
              panel_finish, width, thickness, panel_additions, area_per_piece,
              last_update_date, last_updated_by, creation_date, created_by,
              mark_description )  VALUES
              ( prec_pc_id_seq.nextval,
              pid, pcfid, mark, eachone.qty, eachone.name,
              eachone.tiestrips, eachone.reinforcements, eachone.finish,
              eachone.width, thk, eachone.additions, eachone.area,
              NULL,NULL,NULL,NULL,description );
     END LOOP;
  ELSE
     -- check revised marks against recorded ones and update
     FOR eachone IN getnewdata LOOP
       IF NVL(eachone.thickness,-1) = -1 THEN
            thk := 0;
         ELSE
            thk := eachone.thickness;
         END IF;
         OPEN getolddata( pcfid, eachone.name, eachone.tiestrips, eachone.reinforcements,
               eachone.width, thk, eachone.additions,
               eachone.finish, eachone.area );
         FETCH getolddata INTO quan, mark, pcid, oldthk, oldwid, oldarea;
         IF getolddata%NOTFOUND THEN
            quan := 0;
            mark := 0;
            pcid := 0;
         END IF;
         CLOSE getolddata;
         IF pcid != 0 THEN  -- means we found this mark
            dbms_output.put_line( eachone.name||' '||mark );
            IF quan != eachone.qty THEN   -- mark changed quantities
               UPDATE prec_pcf_panels
                  SET quantity_required = eachone.qty
                WHERE pc_id = pcid ;
            END IF;
               IF oldthk != thk THEN
                  UPDATE prec_pcf_panels
                     SET thickness = thk
                   WHERE pc_id = pcid ;
               END IF;
               IF oldwid != eachone.width THEN
                  UPDATE prec_pcf_panels
                     SET width = eachone.width
                   WHERE pc_id = pcid ;
               END IF;
               IF oldarea != eachone.area THEN
                  UPDATE prec_pcf_panels
                     SET area_per_piece = eachone.area
                   WHERE pc_id = pcid;
               END IF;
            -- otherwise, keep going
         ELSE  -- mark not found, append new mark
  description := '(';
  IF dfltre <> eachone.reinforcements THEN
     description := description||eachone.reinforcements;
  END IF;
  IF dfltwi <> eachone.width THEN
     description := description||LTRIM(TO_CHAR(eachone.width,'90.00'));
  END IF;
  IF dfltad <> eachone.additions THEN
     description := description||eachone.additions;
  END IF;

  IF description = '(' THEN
     description := NULL;
  ELSE
     description := description||')';
  END IF;
  IF NVL(eachone.tiestrips,0) = 0 THEN
     description := eachone.name||description;
  ELSE
     description := eachone.name||LTRIM(TO_CHAR(eachone.tiestrips))||description;
  END IF;

            INSERT INTO prec_pcf_panels ( pc_id, project_id,
              pcf_id, mark_number, quantity_required,
              panel_name, tie_strip_quantity, panel_reinforcements,
              panel_finish, width, thickness, panel_additions, area_per_piece,
              last_update_date, last_updated_by, creation_date, created_by,
              mark_description )  VALUES
              ( prec_pc_id_seq.nextval,
              pid, pcf, maxmark+1, eachone.qty, eachone.name,
              eachone.tiestrips, eachone.reinforcements, eachone.finish,
              eachone.width, eachone.thickness, eachone.additions, eachone.area,
              NULL,NULL,NULL,NULL, description );
            maxmark := maxmark + 1;
         END IF;
     END LOOP;
     -- now update old marks that now have no match
     UPDATE prec_pcf_panels
          SET quantity_required = 0
      WHERE pcf_id = pcfid
        AND NOT EXISTS ( SELECT * FROM reco_toff_pcf_import  p
             WHERE NAME = panel_name
               AND NVL(tiestrips,0) = NVL(tie_strip_quantity,0)
               AND NVL(reinforcements,'-') = NVL(panel_reinforcements,'-')
               AND NVL(FINISH,'-') = NVL(panel_finish,'-')
               AND ( NVL(p.width,0) = NVL(prec_pcf_panels.width,0) OR
                     TRUNC(NVL(p.width,0),3) = NVL(prec_pcf_panels.width,0) OR
                     ROUND(NVL(p.width,0),3) = NVL(prec_pcf_panels.width,0) )
               AND ( NVL(p.thickness,-1) = NVL(prec_pcf_panels.thickness,-1) OR
                     TRUNC(NVL(DECODE(p.thickness,0,-1,p.thickness),-1),2) =
                          NVL(prec_pcf_panels.thickness,-1) OR
                     ROUND(NVL(DECODE(p.thickness,0,-1,p.thickness),-1),2) =
                          NVL(prec_pcf_panels.thickness,-1) )
               AND NVL(additions,'-') = NVL(panel_additions,'-')
               AND ( NVL(area_per_piece,0) = NVL(area,0)  OR
                     NVL(area_per_piece,0) = TRUNC(NVL(area,0),3) OR
                     NVL(area_per_piece,0) = ROUND(NVL(area,0),3) ) );
   END IF;

   update prec_pcf set surface_area = (select sum(area_per_piece*quantity_required) from prec_pcf_panels where pcf_id = prec_pcf.pcf_id)
     where pcf_id = pcfid;
     
     clear_prodimport( pcfid );
-- ignoring 0 qty marks
  --reco_toff_coordinates.generate_wall_panels( pcf, rev );

--committed by calling process
exception 
  when others then 
    raise;
end;


END prec_takeoff;
