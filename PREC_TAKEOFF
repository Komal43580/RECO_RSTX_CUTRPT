-- import_reinforcements
--
-- DESCRIPTION
-- This function reviews all the entries in RECO_TOFF_PART_PENDING for this import,
-- and grabs the reinforcements to import them into the job.
--
-- This validates reinforcements that are processed.
--
-- This function may modify the strips or reinforcements, so that the
-- reinforcements that go into the job may not match exactly what was imported
-- from AutoCAD.
-- e.g. very long reinforcing strips may be cut into shorter strips
-- e.g. the geostrap lengths given in import may need to be 'interpreted'
--
-- During this import process here, we may add additional parts / bolts / etc,
-- as may be required by the cutting / interpretation that we perform.
--
-- UPDATES
-- Modified 1/12/2001 by David Correia
-- Added second Splice Plate for steel > 40
-- jra 11/30/01
-- added reduction past 64 feet
-- Bahar on 4/17/2006
-- added additional variables for mesh pins caculation
-- Modified by Scott Mattingly 24-AUG-2010
-- : Added Geostrap handling
-- : Renamed function (formerly know as deal_with_part)
-- : Added loop to function to loop through each strip in the RECO_TOFF_PART_PENDING
--   table. This allows function to work independently, and removes redundancy
-- : Improved documentation
--
-- PRE-CONDITIONS
-- : given pi_ImportId is a valid importid
-- : given pi_ProdCode is a valid product code
-- : pi_GivenJobType is 'E' or 'M'
-- : Realistically, this function expects reinforcements follow a certain
--   format whenplaced in the RECO_TOFF_PART_PENDING table
--   - '50%'  is part_name to reflect reinforcing strips
--   - 'HA%'  is part_name to reflect HA ladders
--   - 'LD%'  is part_name to reflect other type of legacy ladder
--   - 'GEO%' is part_name to reflect geostraps
--
-- POST-CONDITIONS
-- : Function returns 'Imported.' when reinforcements are imported successfully
--   and no errors occur.
-- : Function returns an error message when an error occurs
-- : When function is successful, the reinforcement parts in RECO_TOFF_PART_PENDING
--   are converted and imported into the structure
-- : When function is successful, additional parts other than the reinforcements
--   may also have been imported into the structure
FUNCTION import_reinforcements ( pi_ImportId IN NUMBER,
                                 pi_ProdCode IN VARCHAR2,
                                 pi_StrId IN NUMBER,
                                 pi_GivenJobType in varchar2,
                                 pi_GivenLoginId in number,
                                 pi_GivenUserId in varchar2)
RETURN VARCHAR2
IS

  CURSOR cur_TakeoffReinforcements
  IS
    SELECT  P.part_name,
            P.quantity_required,
            P.attribute1,
            P.attribute2
    FROM  reco_toff_part_pending P
    WHERE   P.toff_struct_pending_id = pi_ImportId
    AND     P.attribute1 is not null
    ORDER BY  P.part_name;
  CURSOR Drawing_parts
  IS
    SELECT  P.part_name,
            P.quantity_required,
            P.attribute1,
            P.attribute2
    FROM  reco_toff_part_pending P
    WHERE   P.toff_struct_pending_id = pi_ImportId
    AND     P.attribute1 is null
    ORDER BY  P.part_name;


  ptlookup varchar2(40);
  ptlookup2 varchar2(40);
  tempnum number;
  tempnum2 number;
  partnum number := NULL;
  nn number;

  pname   reco_toff_part_pending.part_name%TYPE;
  qty     reco_toff_part_pending.QUANTITY_REQUIRED%TYPE;
  attr1   reco_toff_part_pending.attribute1%TYPE;
  attr2   reco_toff_part_pending.attribute2%TYPE;

  ---- additional variables for mesh pins caculation
  nwire number;
  nspace number;
  npinnum number;

  ---- additional variables for geostraps
  vn_Geostrap35TotalLF number := 0;
  vn_Geostrap50TotalLF number := 0;
  vn_Geostrap65TotalLF number := 0;

BEGIN

  ------------------------------------------------------------
  -- Start looping for all reinforcements in RECO_TOFF_PART_PENDING
  ------------------------------------------------------------

  -- import original lengths into extract table for viewing
  insert into reco_toff_parts_extract
  SELECT  pi_StrId, part_name,
            quantity_required,
            attribute1, attribute2, attribute3, attribute4, attribute5, sysdate
    FROM  reco_toff_part_pending P
    WHERE   P.toff_struct_pending_id = pi_ImportId
    AND     P.attribute1 is not null;

  ---------------------------------------------------------------
  -- Finished looping for all reinforcements in RECO_TOFF_PART_PENDING
  ---------------------------------------------------------------
-- 10/2/24  insert parts from direct extract
  for eachpart in Drawing_Parts loop
    pname := eachpart.part_name;
    qty := eachpart.quantity_required;
    attr1 := eachpart.attribute1;
    attr2 := eachpart.attribute2;

    --OPEN cur_InventoryItemId( pname );
    --FETCH cur_InventoryItemId INTO partnum;
    --CLOSE cur_InventoryItemId;

     nn := insert_struct_parts( pi_strid, pname, 0, qty, qty,
                                pi_GivenLoginId,pi_GivenUserId);
    end loop;

  -- Done

  -- Done

  RETURN 'Imported.';

EXCEPTION
  WHEN NO_DATA_FOUND
  THEN RETURN 'Internal Error: NO_DATA_FOUND exception';
  WHEN TOO_MANY_ROWS
  THEN RETURN 'Internal Error: TOO_MANY_ROWS exception';
  WHEN OTHERS
  THEN RETURN 'Internal Error: Unknown exception';
END; -- import_reinforcements

