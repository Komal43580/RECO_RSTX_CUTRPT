-- unit_of_measure
--
-- DESCRIPTION
-- This function analyzes a product code and a E/M code, and determines a proper
-- DEFAULT UOM for the given parameters.
--
-- NOTE: This function acts as a legacy function. This really only gives you A
--       default value for the Product/JobType. For Backwards Compatability
--       reasons, this function does not indicate whether the given product code
--       can support MULTIPLE UOMs, as is the case with sound walls and other
--       obscure product codes.
--
-- To determine if a product CAN be linear or square at all, you should use
-- the related functions ProdCodeCanBeSquare and ProdCodeCanBeLinear
--
-- UPDATES
-- : 05-MAY-2011 - DSM
--   - Comments Added
--   - Corrected for product codes  PEX / VCO / VHC / VPR / VTB
--
-- PRE-CONDITIONS
-- : Product Code should be NOT NULL
-- : JobType should really be 'E' or 'M'
--
-- POST-CONDITIONS
-- : Analyzes the inputs and determines a 'default' UOM for given Prod/JType
FUNCTION unit_of_measure( product IN varchar2, jobtype IN varchar2 ) RETURN varchar2
IS
BEGIN
  IF product IN ('COP','HFC','PAR','PEX','PDB','PWL','TRB','TSP','VCO','VHC','VPR','VTB','CCP','CPB','CTS')
  THEN
     IF jobtype = 'E'
     THEN RETURN 'LF';
     END IF;

     RETURN 'LM';
  END IF;

  IF jobtype = 'E'
  THEN RETURN 'SF';
  END IF;

  RETURN 'SM';
END;

--------------------------------------------------------------------------------
-- ProdCodeCanBeLinear
--
-- DESCRIPTION
-- Determines if a product code can be linear. For example, REW is always run
-- as SF or SM, and will never be linear, so this function returns false value
--
-- Of course, some products can be run as BOTH linear or square, so this will
-- still return true value for that product
--
-- UPDATES
-- : 05-MAY-2011 - DSM
--   - Created
--
-- PRE-CONDITIONS
-- : Given value should not be null
--
-- POST-CONDITIONS
-- : Return 'T' if the indicated product code can be Linear, or run as LF/LM
-- : Return 'F' otherwise
function ProdCodeCanBeLinear (givenProdCode in varchar2) return varchar2
is
begin
  if givenProdCode in
    ( 'COP','HFC','PAR','PDB','PEX','TRB','TSP','VCO','VHC','VPR','VTB',
      'CIS','DBA','DYC','DYR','ENG','EWA','JEG','MOB','MTX','SNA','SNS',
      'SRS','WKD','WRA','ROS','PWL','STC','DUR','SOU' )
  then return 'T';
  end if;

  return 'F';
end;

--------------------------------------------------------------------------------
-- ProdCodeCanBeSquare
--
-- DESCRIPTION
-- Determines if a product code can be linear. For example, REW is always run
-- as SF or SM, and will always be square, so this function returns true value
--
-- Of course, some products can be run as BOTH linear or square, so this will
-- still return true value for that product
--
-- UPDATES
-- : 05-MAY-2011 - DSM
--   - Created
--
-- PRE-CONDITIONS
-- : Given value should not be null
--
-- POST-CONDITIONS
-- : Return 'T' if the indicated product code can be Square, or run as SF/SM
-- : Return 'F' otherwise
function ProdCodeCanBeSquare (givenProdCode in varchar2) return varchar2
is
begin
  if givenProdCode in
    ( 'FAC','FWL','ORE','ORL','OSQ','OTL','OVH','OVL','OVS','PYC','PYR',
      'REM','REW','REX','RLA','RLE','RLM','RLP','RLS','RLT','SLT','SQL',
      'SQM','SQR','TRL','TWL','VHS','VHX','VRL','VRS','VRX','VSQ','VSS',
      'VST','VTL','VTR','CIS','DBA','DYC','DYR','ENG','EWA','JEG','MOB',
      'MTX','SNA','SNS','SRS','WKD','WRA','ROS','PWL','STC','DUR','SOU' )
  then return 'T';
  end if;

  return 'F';
end;

