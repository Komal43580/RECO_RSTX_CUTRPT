-- set_toff_calc_values
--
-- DESCRIPTION
-- Be sure to read the PRE-CONDITIONS and POST-CONDITIONS for more details on
-- how this method works.
--
-- Takeoff tables save a lot of calculated values. This makes queries and
-- reports run much faster, as-well-as making somethings a little more easily
-- programmable in Form Builder. However, form builder still has difficulty with
-- this concept, and it doesn't like it when a child record tries to update
-- calculated values in a master record (multi-record blocks screw things up).
--
-- As a result, this method is formed. It handles the setting of calculated
-- values in the takeoff system, so you can be sure that any given takeoff
-- structure will have its values set properly.
--
-- UPDATES
-- : 02-NOV-2011 - DSM - Created
--
-- PRE-CONDITIONS
-- 1) You should only provide either a givenJobId or a givenStructId.
--    Do not give both.
-- 2) givenJobId must exist if provided and be valid in reco_toff_jobs table
-- 3) givenStructId must exist if provided and be valid in reco_toff_structs table
-- 4) If givenStructId is provided, it is only required to have these
--    values set in the table:
--    + toff_struct_id, structure_name, unit_of_measure,
--      status_code, toff_job_id, wall_length
--    All the other stuff is optional, or will be set properly
-- 5) For either case (givenJob or givenStruct) the toff_job_id should be valid
--    (see TakeoffJobIsValid for details)
-- 6) The caller is responsible for who-columns, not this method.
--    e.g. if caller is changing panels, it should have set whocols for panels
--    e.g. if caller is changing structs, then should have set whocols for structs
--
-- POST-CONDITIONS
-- : When given the StructId only,
--   calculate and apply these values for the struct table.
--      -- REVISION_NUMBER
--      -- SOIL_REINF_TYPE
--      -- TOTAL_AREA (not for wirewalls e.g. 'TRL','VTL','VTR','OTL', manual entry)
--      -- TOTAL_STEEL_LF
--      -- TOTAL_STEEL_TONS
--      -- TOTAL_STEEL_QTY
--      -- AVG_HEIGHT
--      -- NUM_PANELS
--      -- NUM_TIES
-- : Regardless which parameter is given, the Job table has its calculated
--   values updated too.
--      -- NUM_OF_WALLS
--      -- TOTAL_AREA
--      -- TOTAL_STEEL_LF
--      -- TOTAL_STEEL_TONS
--      -- TOTAL_STEEL_QTY
--      -- WALL_LENGTH
--      -- NUM_COLUMNS
--      -- AVG_HEIGHT
--      -- NUM_PANELS
--      -- NUM_TIES
-- : When a structure is involved, this method will --ALWAYS-- increment the
--   revision number by 1. If the revision number is null, it's set to 0
-- : This method does not handle backup or history. Literally we can't do
--   it, because some of the required data may have already been set. So it
--   is the caller's responsibility to track history
-- : This method does not set who columns, as per pre-conditions above
-- : This method does not commit. It is callers responsibility to commit.
-- : Return 'DONE' if everything works
-- : Return an error message if something fails
function set_toff_calc_values ( givenjobid in number,
                                givenstructid in number)
return varchar2
is

  cursor cur_getstrdat (pi_strid in number)
  is
    select  toffs.revision_number,
            toffs.total_area curr_wall_area,
            toffs.wall_length,
            nvl(subqpan.totnumpan,0) panelqtynorm,
            toffs.num_panels panelqtywire,
            nvl(subqpar.totextrats,0) tieqty,
            nvl(subqpan.totpanarea,0) panelarea
            -- Don't get steel  lf  here
            -- Don't get steel tons here
            -- Don't get steel qty  here
    from  reco_toff_structs toffs,
          (
            select  toffpan.toff_struct_id,
                    sum(toffpan.quantity_required) totnumpan,
                    sum(toffpan.quantity_required * toffpan.tie_strip_quantity) totnumtie,
                    sum(toffpan.quantity_required * toffpan.area_per_piece) totpanarea
            from  reco_toff_panels toffpan
            where   toffpan.toff_struct_id = pi_strid
            group by  toffpan.toff_struct_id
          ) subqpan,
          (
            select  toffpar.toff_struct_id, sum(toffpar.quantity_required) totextrats
            from  reco_toff_parts toffpar
            where   part_code like 'TS%'
            and     toffpar.toff_struct_id = pi_strid
            group by  toffpar.toff_struct_id
          ) subqpar
    where   toffs.toff_struct_id = pi_strid
    and     toffs.toff_struct_id = subqpan.toff_struct_id (+)
    and     toffs.toff_struct_id = subqpar.toff_struct_id (+);

  rec_getstrdat cur_getstrdat%rowtype;

  vn_workingjobid number;
  vc_productcode reco_toff_jobs_v.product_code%type;
  vc_jobuom reco_toff_jobs_v.job_uom%type;

  vn_tmptotwallqty number;
  vn_tmptotarea number;
  vn_tmptotsteellf number;
  vn_tmptotsteelton number;
  vn_tmptotsteelqty number;
  vn_tmptotwalllen number;
  vn_tmptotnumcols number;
  vn_tmptotavghgt number;
  vn_tmptotpanqty number;
  vn_tmptottieqty number;

begin

  -- Validate
  if (givenjobid is null and givenstructid is null)
  or (givenjobid is not null and givenstructid is not null)
  then return 'Internal Error 0020 - Method Usage Error';
  end if;

  --if TakeoffJobIsValid = 'NO' then developer error end if;

  -- Basic needs
  if givenjobid is not null
  then
    select givenjobid, product_code, job_uom
    into vn_workingjobid, vc_productcode, vc_jobuom
    from reco_toff_jobs_v toffj
    where toffj.toff_job_id = givenjobid;
  elsif givenstructid is not null
  then
    select toffj.toff_job_id, toffj.product_code, toffj.job_uom
    into vn_workingjobid, vc_productcode, vc_jobuom
    from reco_toff_jobs_v toffj, reco_toff_structs toffs
    where toffj.toff_job_id = toffs.toff_job_id
    and toffs.toff_struct_id = givenstructid;
  end if;

  -- Set structure data
  if givenstructid is not null
  then
    declare
      vn_tmpthiswallrevnum number;
      vn_tmpthiswallarea number;
      vn_tmpthiswallstllf number;
      vn_tmpthiswallstlton number;
      vn_tmpthiswallstlqty number;
      vn_tmpthiswallavghgt number;
      vn_tmpthiswallnumpan number;
      vn_tmpthiswallnumtie number;
    begin
      -- Get and set lots of info first

      open cur_getstrdat(givenstructid);
      fetch cur_getstrdat into rec_getstrdat;
      close cur_getstrdat;

      -- Determine new revision_number
      vn_tmpthiswallrevnum := rec_getstrdat.revision_number + 1;
      if vn_tmpthiswallrevnum is null
      then vn_tmpthiswallrevnum := 0;
      end if;

      -- Determine new Area
      if vc_productcode not in ('TRL','VTL','VTR','OTL','CTT','CT1','CT2','CT3')
      then vn_tmpthiswallarea := rec_getstrdat.panelarea;
      elsif vc_productcode in ('TRL','VTL','VTR','OTL','CTT','CT1','CT2','CT3')
      then vn_tmpthiswallarea := rec_getstrdat.curr_wall_area;
      end if;

      -- Determine new steel
      vn_tmpthiswallstllf := getsteellf(givenstructid);
      vn_tmpthiswallstlton := getsteeltons(givenstructid);
      vn_tmpthiswallstlqty := getsteelqty(givenstructid);

      -- Determine new avg height
      if nvl(rec_getstrdat.wall_length,0) = 0
      or nvl(vn_tmpthiswallarea,0) = 0
      then vn_tmpthiswallavghgt := 0;
      else vn_tmpthiswallavghgt := vn_tmpthiswallarea / rec_getstrdat.wall_length;
      end if;

      -- Determine new panel quantity
      if vc_productcode not in ('TRL','VTL','VTR','OTL','CTT','CT1','CT2','CT3')
      then vn_tmpthiswallnumpan := rec_getstrdat.panelqtynorm;
      elsif vc_productcode in ('TRL','VTL','VTR','OTL','CTT','CT1','CT2','CT3')
      then vn_tmpthiswallnumpan := rec_getstrdat.panelqtywire;
      end if;

      -- Determine new tie quantity
      vn_tmpthiswallnumtie := rec_getstrdat.tieqty;

      -- Update all of our calculated data in structure table

      update reco_toff_structs
      set revision_number = vn_tmpthiswallrevnum,
          total_area = vn_tmpthiswallarea,
          total_steel_lf = vn_tmpthiswallstllf,
          total_steel_tons = vn_tmpthiswallstlton,
          total_steel_qty = vn_tmpthiswallstlqty,
          avg_height = vn_tmpthiswallavghgt,
          num_panels = vn_tmpthiswallnumpan,
          num_ties = vn_tmpthiswallnumtie
      where toff_struct_id = givenstructid;
    end;
  end if;

  -- Run lots of calcs at the job level

  -- The nvl(total_area) is needed because wire walls can have
  -- a missing area until the user enters it on per-wall basis.
  -- Other nvl(value) is added for consistency

  select  count(*) totalwalls,
          sum(nvl(total_area,0)) totalarea,
          sum(nvl(total_steel_lf,0)) totalsteell,
          sum(nvl(total_steel_tons,0)) totalsteelt,
          sum(nvl(total_steel_qty,0)) totalsteelq,
          sum(nvl(wall_length,0)) totalwalll,
          sum(nvl(num_columns,0)) totalnumc,
          sum(nvl(num_panels,0)) numpan,
          sum(nvl(num_ties,0)) numtie
  into  vn_tmptotwallqty, vn_tmptotarea, vn_tmptotsteellf,
        vn_tmptotsteelton, vn_tmptotsteelqty, vn_tmptotwalllen,
        vn_tmptotnumcols, vn_tmptotpanqty, vn_tmptottieqty
  from reco_toff_structs
  where toff_job_id = vn_workingjobid;

  -- Handle case when user deletes last wall, or when there
  -- are otherwise no records in the structure table when
  -- these auto-calcs are run
  if vn_tmptotwallqty = 0
  then
    vn_tmptotarea := 0;
    vn_tmptotsteellf := 0;
    vn_tmptotsteelton := 0;
    vn_tmptotsteelqty := 0;
    vn_tmptotwalllen := 0;
    vn_tmptotnumcols := 0;
    vn_tmptotpanqty := 0;
    vn_tmptottieqty := 0;
  end if;

  if vn_tmptotarea = 0
  or vn_tmptotwalllen = 0
  then vn_tmptotavghgt := 0;
  else vn_tmptotavghgt := vn_tmptotarea / vn_tmptotwalllen;
  end if;

  -- Update all of our calculated data in jobs table

  update prec_project_products
  set num_of_walls = vn_tmptotwallqty,
      total_area = vn_tmptotarea,
      total_steel_lf = vn_tmptotsteellf,
      total_steel_tons = vn_tmptotsteelton,
      total_steel_qty = vn_tmptotsteelqty,
      wall_length = vn_tmptotwalllen,
      num_columns = vn_tmptotnumcols,
      avg_height = vn_tmptotavghgt,
      num_panels = vn_tmptotpanqty,
      num_ties = vn_tmptottieqty
  where product_id = vn_workingjobid;

  -- As described in POST-CONDITIONS, we do not commit

  return 'DONE';

end; -- set_toff_calc_values

