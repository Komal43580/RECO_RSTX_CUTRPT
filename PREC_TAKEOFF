-- import_panels_aswire
--
-- DESCRIPTION
-- imports terratrel panels as parts
--
-- This function grabs panels from the IMPORT_PANELS table, converts them to
-- part numbers / etc , and then inserts them into the RECO_PARTS table.
--
-- This function also handles wire dependent parts, and inserts those too.
--
-- This function should only be run for wire walls. For ordinary walls, you
-- should refer to the function import_panels_normally(). Note that even though
-- these functions may seem similar, they do have several key differences.
--
-- UPDATES
--  added decode to force to B or G
--  changed default MF to now use panel_reinforcements for the TRL type
-- Scott-Mattingly 08-AUG-2010
-- : Improved function name (previously named import_trl)
-- : Improved documentation
-- : Updated connector rod calculations
--
-- PRE-CONDITIONS
-- : parameter pi_ImportId reflects a wire-wall import
-- : parameter pi_ProdCode reflects the product code
-- : parameter pi_NumColumns reflects the number of columns entered by user
-- : pi_GivenJobType is 'E' or 'M'
--
-- POST-CONDITIONS
-- : This function attempts to insert parts required for the wire wall job.
--   Warning messages are sometimes generated if a part cannot be imported.
--   No commit or rollback is executed here.
PROCEDURE import_panels_aswire( pi_ImportId IN NUMBER,
                                pi_ProdCode IN VARCHAR2,
                                pi_NumColumns IN NUMBER,
                                pi_StrId IN NUMBER,
                                pi_GivenJobType in varchar2,
                                pi_GivenLoginId in number,
                                pi_GivenUserId in varchar2)
IS
  CURSOR getpartnos IS
    SELECT panel_reinforcements||
            SUBSTR(panel_name,1,1)||
            DECODE(panel_finish,'G','G','B','B','G') wirename,
            panel_name,
            tie_strip_quantity,
            area_per_piece,
            quantity_required
     FROM reco_toff_panel_pending
    WHERE toff_struct_pending_id = pi_ImportId;

  CURSOR matchpart( partname varchar2 ) IS
     SELECT part_code
     FROM prec_parts
     WHERE part_code LIKE partname;

  CURSOR determineladder IS
     SELECT 'YES'
     FROM reco_toff_part_pending P
     WHERE toff_struct_pending_id = pi_ImportId
     AND part_name LIKE 'LD%';

  -- added HA's  7/24 jra
  CURSOR determinereinf IS
     SELECT 'YES'
     FROM reco_toff_part_pending P
     WHERE toff_struct_pending_id = pi_ImportId
     AND ( part_name LIKE '50%' OR part_name LIKE 'HA%' OR part_name LIKE '%W%W%' );

  tempval number;
  invid   varchar2(25);
  tester  varchar2(3) := NULL;

  totalarea number := 0;
  totalties number := 0;
  totalrods number := 0;
  fcw3rolls number := 0;

  -- There are technically 3 types of TRL jobs
  -- : TRL -  Single Stage  - Middle Panel is 'A'
  -- : TRL -   Two Stage    - Middle Panel is 'Q'
  -- : TRL - L-Basket Stack - Middle Panel is 'L'
  -- The L-Basket wall receives parts differently than the other types, so
  -- we need a special value to track this
  vc_Is_TRL_LBasketWall varchar2(3) := 'NO';

BEGIN

  -- Determine if this is a TRL wall made entirely of L-Baskets
  vc_Is_TRL_LBasketWall := 'NO';

  IF pi_ProdCode = 'TRL'
  THEN
    vc_Is_TRL_LBasketWall :=
                takeoff_is_TRLLBskJob (pi_ImportId,pi_ProdCode,pi_NumColumns);
  END IF;

  -- Loop for each wire "panel" in takeoff
  -- For each panel we see, we will try to import the related wire-panel,
  -- and we will also gather various information in the process
  FOR eachwire IN getpartnos
  LOOP
      -- If this row is a valid wire part, then insert it
      invid := eachwire.wirename ;

      IF invid IS NULL THEN
         warning( 'Part '||eachwire.wirename||' does not match part list.' );
      ELSE
         tempval := insert_struct_parts(pi_StrId, invid, 0,
                      eachwire.quantity_required,eachwire.quantity_required,
                      pi_GivenLoginId,pi_GivenUserId);
      END IF;

      -- Add this wire part's total area to our cummulative total
      totalarea :=
        totalarea + (eachwire.area_per_piece * eachwire.quantity_required);

      -- Add this wire part's tie-strip total to our cummulative total
      totalties :=
        totalties + (eachwire.tie_strip_quantity * eachwire.quantity_required);

      -- Add this wire part's connector-rod total to the cummulative total
      tempval := 0;

      IF pi_ProdCode IN ('TRL','VTL','VTR','CTT','CT1','CT2','CT3')
      THEN
        CASE
          WHEN eachwire.panel_name LIKE 'A%'
          THEN
            tempval := 4;
            IF eachwire.tie_strip_quantity <= 8
            THEN tempval := 2;
            ELSIF eachwire.tie_strip_quantity > 8
            AND eachwire.tie_strip_quantity < 12
            THEN tempval := 3;
            END IF;
          WHEN eachwire.panel_name LIKE 'B%'
          THEN
            tempval := 2;
            IF eachwire.tie_strip_quantity <= 5
            THEN tempval := 1;
            END IF;
          WHEN eachwire.panel_name LIKE 'P%'
          THEN
            tempval := 5;
            IF eachwire.tie_strip_quantity <= 11
            THEN tempval := 3;
            ELSIF eachwire.tie_strip_quantity > 11
            AND eachwire.tie_strip_quantity < 15
            THEN tempval := 4;
            END IF;
          WHEN eachwire.panel_name LIKE 'Q%'
          THEN
            tempval := 3;
            IF eachwire.tie_strip_quantity <= 8
            THEN tempval := 2;
            END IF;
          WHEN eachwire.panel_name LIKE 'L%'
          THEN
            tempval := 0;
            IF vc_Is_TRL_LBasketWall = 'YES'
            THEN tempval := 1;
            END IF;
          ELSE
            tempval := 0;
        END CASE;
      END IF;

      totalrods := totalrods + (tempval*eachwire.quantity_required);

  END LOOP; -- Done loop for each wire part name

  -- calcuate filter cloth rolls
  IF pi_GivenJobType = 'E'
  THEN fcw3rolls := CEIL(totalarea/500.0);
  ELSE fcw3rolls := CEIL(totalarea/46.5);
  END IF;

  -- insert wire part - filter cloth rolls

  invid := 'FCW3';
  tempval := insert_struct_parts( pi_StrId,invid, 0, fcw3rolls, fcw3rolls,
                                  pi_GivenLoginId,pi_GivenUserId);

  -- insert wire part - strut boxes

  IF pi_ProdCode IN ('TRL','OTL')
  THEN
    invid := 'STRUT';
    tempval := insert_struct_parts( pi_StrId, invid, 0, 0, 0,
                                    pi_GivenLoginId,pi_GivenUserId);
    invid := 'STRUTG';
    tempval := insert_struct_parts( pi_StrId, invid, 0, 0, 0,
                                    pi_GivenLoginId,pi_GivenUserId);
  END IF;

  -- if ladders, insert stuff
  OPEN determineladder;
  FETCH determineladder INTO tester;
  IF determineladder%NOTFOUND
  THEN tester := 'NO';
  END IF;
  CLOSE determineladder;

  IF tester = 'YES'
  THEN
    invid := 'AB2B';
    tempval := insert_struct_parts( pi_StrId,invid, 0, totalties, totalties,
                                    pi_GivenLoginId,pi_GivenUserId);
    invid := 'AB2G';
    tempval := insert_struct_parts( pi_StrId,invid, 0, totalties, totalties,
                                    pi_GivenLoginId,pi_GivenUserId);
    invid := 'HB2B';
    tempval := insert_struct_parts( pi_StrId,invid, 0, totalties, totalties,
                                    pi_GivenLoginId,pi_GivenUserId);
    invid := 'HB2G';
    tempval := insert_struct_parts( pi_StrId,invid, 0, totalties, totalties,
                                    pi_GivenLoginId,pi_GivenUserId);
  END IF;

  -- if reinf, insert stuff
  OPEN determinereinf;
  FETCH determinereinf INTO tester;
  IF determinereinf%NOTFOUND
  THEN tester := 'NO';
  END IF;
  CLOSE determinereinf;

  IF tester = 'YES'
  THEN
    invid := 'CLP5';
    tempval := insert_struct_parts( pi_StrId,invid, 0, totalties, totalties,
                                    pi_GivenLoginId,pi_GivenUserId);
    invid := 'CLP8';
    tempval := insert_struct_parts( pi_StrId,invid, 0, totalties, totalties,
                                    pi_GivenLoginId,pi_GivenUserId);
   invid := 'BL14';
    tempval := insert_struct_parts( pi_StrId,invid, 0, totalties, totalties,
                                    pi_GivenLoginId,pi_GivenUserId);
    invid :='ROD10';
    tempval := insert_struct_parts( pi_StrId,invid, 0, totalrods, totalrods,
                                    pi_GivenLoginId,pi_GivenUserId);
    invid := 'ROD11';
    tempval := insert_struct_parts( pi_StrId,invid, 0, totalrods, totalrods,
                                    pi_GivenLoginId,pi_GivenUserId);
  END IF;
END; -- import_panels_aswire

