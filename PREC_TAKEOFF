-- insert_struct_parts
--
-- PRE-CONDITIONS
-- : Given parameters should not be null
function insert_struct_parts(
            p_structure_id in number, p_item in varchar2,
            p_calc_quantity in number, p_adj_quantity in number,
            p_quantity_required in number, pi_givenloginid in number,
            pi_givenuserid in varchar2 )
            return number
is
  vn_partidused number;
begin

  select reco_part_seq.nextval into vn_partidused from dual;

  insert into reco_toff_parts
    ( toff_part_id, toff_struct_id, part_code, calc_quantity,
      adj_quantity, quantity_required, last_update_date, last_updated_by,
      creation_date, created_by, last_update_login )
  values (vn_partidused, p_structure_id, p_item,
          nvl(p_calc_quantity,0), nvl(p_adj_quantity,0), nvl(p_quantity_required,0),
          sysdate, pi_givenuserid, sysdate, pi_givenuserid, pi_givenloginid );

  return vn_partidused;
end; -- insert_struct_parts

