-- added to provide clear warnings for changed panels

procedure clear_messages is
begin
  messages := clr_msg;
  nummsgs := 0;
  msgctr := 0;
end;

function  message_count return number is
begin
  return nummsgs;
end;

function  first_message return varchar2 is
begin
  if nummsgs > 0 then
     msgctr := 0;
     return messages(msgctr);
  end if;
  return '';
end;

function  next_message return varchar2 is
begin
  if msgctr+1 >= nummsgs
  then return '';
  end if;

  msgctr := msgctr + 1;
  return messages(msgctr);
end;

procedure warning( msg_in in varchar2 ) is
begin
  messages(nummsgs) := substr(msg_in,1,80);
  nummsgs := nummsgs + 1;
end;

