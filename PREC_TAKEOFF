-- get_struct_update_dates
--
-- Retrieve a list of LAST_UPDATE_DATEs for given structures ids in csv-format
--
-- PRE-CONDITIONS
-- : pi_GivenStructIds is a comma-delimited list of numbers, preferably
--   toff_struct_ids
--
-- POST-CONDITIONS
-- : When method fails, return and error message
-- : When method succeeds, return 'DONE'
-- : When this method succeeds, then po_OutUpdateDates is set to a corresponding
--   comma delimited list of dates in form DDMMYYYYHH24MISS
-- : The po_OutUpdateDates may not contain all dates, and instead of a date
--   the value DELETED may exist. This means that for the given toff_struct_id,
--   that value does not exist in the reco_toff_structs table
function get_struct_update_dates (pi_givenstructids in varchar2,
                                  po_outupdatedates out varchar2)
return varchar2
is
  vn_stringindex number;
  vc_currentidstring varchar2(10);
begin -- get_struct_update_dates
  if pi_givenstructids is null
  or length(pi_givenstructids) = 0
  then return 'Internal Error 0041 - Invalid Parameters. Contact MIS';
  end if;

  po_outupdatedates := '';

  vn_stringindex := 1;
  vc_currentidstring := '';

  loop
    vc_currentidstring :=
      vc_currentidstring||substr(pi_givenstructids,vn_stringindex,1);

    if vn_stringindex = length(pi_givenstructids)
    then
      if length(vc_currentidstring) = 0
      or substr(vc_currentidstring,length(vc_currentidstring),1) = ','
      then return 'Internal Error 0046 - Invalid Parameters. Contact MIS';
      end if;
      declare
        vd_currentdate date;
      begin
        select last_update_date into vd_currentdate from reco_toff_structs
        where toff_struct_id =
                  to_number(substr(vc_currentidstring,1,length(vc_currentidstring)));
        po_outupdatedates := po_outupdatedates||to_char(vd_currentdate,'DDMMYYYYHH24MISS');
        vc_currentidstring := '';
        exit;
      exception
        when value_error then
          return 'Internal Error 0047 - Number is wrong. Contact MIS.';
        when invalid_number then
          return 'Internal Error 0048 - Number is wrong. Contact MIS.';
        when no_data_found then
          po_outupdatedates := po_outupdatedates||'DELETED';
          vc_currentidstring := '';
          exit;
        when others then
          return 'Internal Error 0049 - Unknown error. Contact MIS.';
      end;
    elsif substr(pi_givenstructids,vn_stringindex,1) = ','
    then
      if length(vc_currentidstring) = 1
      then return 'Internal Error 0045 - Invalid Parameters. Contact MIS';
      end if;
      declare
        vd_currentdate date;
      begin
        select last_update_date into vd_currentdate from reco_toff_structs
        where toff_struct_id =
                  to_number(substr(vc_currentidstring,1,length(vc_currentidstring)-1));
        po_outupdatedates := po_outupdatedates||to_char(vd_currentdate,'DDMMYYYYHH24MISS')||',';
        vc_currentidstring := '';
      exception
        when value_error then
          return 'Internal Error 0042 - Number is wrong. Contact MIS.';
        when invalid_number then
          return 'Internal Error 0043 - Number is wrong. Contact MIS.';
        when no_data_found then
          po_outupdatedates := po_outupdatedates||'DELETED'||',';
          vc_currentidstring := '';
        when others then
          return 'Internal Error 0044 - Unknown error. Contact MIS.';
      end;
    end if;

    vn_stringindex := vn_stringindex+1;
  end loop;

  return 'DONE';
end; -- get_struct_update_dates

