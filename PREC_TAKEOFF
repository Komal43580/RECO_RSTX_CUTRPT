-- fix_saved_wall_uom
--
-- DESCRIPTION
-- Older jobs, and user-error jobs, may give us walls that have a different
-- unit_of_measure than what is needed for the job
-- e.g. a Linear-Meter REW wall in a SquareFoot job
--
-- It's really easy to data-fix a job by just running DML statements.
-- However, this method at least does some checks and validations in an attempt
-- to catch serious issues, so use this method instead if just running an update
-- statement
--
-- PRE-CONDITIONS
-- : Realistically, everything should be saved on the user's end, especially if
--   calling from a form. Make sure everything's saved-and-simple before doing
--   this for best results.
-- : givenToffStrId must be given and valid and exist in the table
-- : RECO_TOFF_JOBS entry and RECO_TOFF_STRUCTS entries all need to be valid
-- : The givenUserId/givenLoginId must be given
-- : If the given wall has PCFs/MOs against it, you should manually fix it and
--   check for any expenditures agains it, and the units of those expenses
-- : If the given wall wall is English/Metric, and that has problems with
--   the rest of job, then you should manually fix, and the area of the
--   panels in that job for E/M
-- : If the JOB is linked to sales/CRM, then if there are budgets against it
--   of a conflicting unit then you should manually fix it, because I'm not
--   sure what to do if your LF wall has LF budget in a Metric job
--
-- POST-CONDITIONS
-- : Updates the structure record to set its unit to match the job's unit
-- : Handles the history too
-- : This runs recalculate for the values out of consistency (and
--   future-proofing the code too) and to increment the revision number
-- : Commits the changes
-- : Returns 'DONE' when successful
-- : Returns and error message when anything fails, and then does a rollback
--   if it fails too
function fix_saved_wall_uom ( giventoffstrid in number,
                              givenuserid in number,
                              givenloginid in number )
return varchar2
is
  vn_tmpjobid number;
  vc_tmpjobuom varchar2(2);
  vc_tmperrmsg varchar2(1024);
begin
  begin
    select toffs.toff_job_id, toffj.job_uom
    into vn_tmpjobid, vc_tmpjobuom
    from reco_toff_structs toffs, reco_toff_jobs_v toffj
    where   toffj.toff_job_id = toffs.toff_job_id
    and     toffs.toff_struct_id = giventoffstrid;
  exception
    when others
    then
      return 'Internal Error 0036 - Invalid Parameters. Contact MIS';
  end;

  if givenuserid is null
  or givenloginid is null
  then return 'Internal Error 0037 - Invalid Parameters. Contact MIS';
  end if;

  vc_tmperrmsg := prec_takeoff.write_history_for_struct(giventoffstrid,false);

  if vc_tmperrmsg != 'DONE'
  then
    rollback;
    return vc_tmperrmsg;
  end if;

  update reco_toff_structs
  set unit_of_measure = vc_tmpjobuom,
      last_updated_by = givenuserid,
      last_update_date = sysdate,
      last_update_login = givenloginid
  where toff_struct_id = giventoffstrid;

  if sql%rowcount != 1
  then
    rollback;
    return 'Internal Error 0038 - Unknown Error. Contact MIS';
  end if;

  -- Calculated Values
  -- Currently, none of the calculated values depend on the individual
  -- structure's UOM, but this is always a good habit plus it raises
  -- the revision number
  vc_tmperrmsg := prec_takeoff.set_toff_calc_values(null,giventoffstrid);

  if vc_tmperrmsg != 'DONE'
  then
    rollback;
    return vc_tmperrmsg;
  end if;

  -- Commit our changes
  commit;

  return 'DONE';
end;

