-- fold_up_parts
procedure fold_up_parts(pi_givenstructid in number,
                        pi_givenloginid in number,
                        pi_givenuserid in varchar2)
is

  cursor getmaxid
  is
    select max(toff_part_id) from reco_toff_parts
    where toff_struct_id = pi_givenstructid;

  cursor getparts
  is
    select  part_code,
            sum(calc_quantity) calc,
            sum(adj_quantity) adj,
            sum(quantity_required) qty
    from  reco_toff_parts
    where   toff_struct_id = pi_givenstructid
    group by  part_code;

  mxid number;
  tmpval number;
begin
  open getmaxid;
  fetch getmaxid into mxid;
  close getmaxid;

  for eachfoldpart in getparts
  loop
      tmpval := insert_struct_parts(pi_givenstructid,
                  eachfoldpart.part_code, ceil(eachfoldpart.calc),
                  eachfoldpart.adj, ceil(eachfoldpart.qty),
                  pi_givenloginid, pi_givenuserid);
  end loop;

  delete from reco_toff_parts
  where toff_struct_id = pi_givenstructid
  and toff_part_id <= mxid;
end; -- fold_up_parts

