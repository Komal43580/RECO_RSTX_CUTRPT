-- validate_uom
--
-- OVERLOADED FUNCTION
-- This function is overloaded. It contains additional error checking and
-- validations.
-- -> Compares the units of a job and an import, instead of simply taking
--    a generic JobType and UOM
-- See the other overloaded function for details.
--
-- DESCRIPTION
-- Most "unit system" stuff boils down into the following setup
-- :   JobType   = E / M
-- : UnitMeasure = LF / SF / LM / SM
--
-- This function attempts to determine if a Takeoff's unit setup is compatable
-- with an indicated import.
--
-- UPDATES
-- : None
--
-- PRE-CONDITIONS
-- : given parameters should not be null
-- : This method can generate warnings, so the caller should have run the
--   clear_messages method at some point before calling this
-- : The pi_ForceExactMatch should be set true or false as desired
--
-- POST-CONDITIONS
-- : Return 'Valid' if import uom matches the takeoff uom
-- : A warning is also generated if method notices that RECO_PROJECTS seems
--   out-of-sync with everything (only a warning, realistically we ignore
--   RECO_PROJECTS almost entirely while in Takeoff)
-- : Return an error only if pi_ForceExactMatch is true and the
--   import uom doesn't match takeoff uom
FUNCTION validate_uom ( pi_ToffJobId IN number,
                        pi_ImportId IN number,
                        pi_ForceExactMatch in boolean)
RETURN varchar2
IS

  cursor cur_FullSalesUnitInfo (givenToffJobId in number)
  is
    select  toffj.job_uom toff_job_uom
    from  reco_toff_jobs_v toffj
    where   toffj.toff_job_id = givenToffJobId;

  rec_FullSalesUnitInfo cur_FullSalesUnitInfo%ROWTYPE;

  rec_PendingStruct reco_toff_struct_pending%ROWTYPE;

  vc_OutputMessage varchar2(1000);

BEGIN -- validate_uom

  vc_OutputMessage := 'Valid';

  IF pi_ToffJobId IS NULL OR pi_ImportId IS NULL
  THEN
    return 'Error: Cannot identify sales item / import item !';
  END IF;

  begin
    select *
    into rec_PendingStruct
    from reco_toff_struct_pending
    where toff_struct_pending_id = pi_ImportId;
  exception
    when NO_DATA_FOUND
    then vc_OutputMessage := 'Internal Error: Unknown toff_struct_pending_id. Contact MIS.';
    when others
    then vc_OutputMessage := 'Internal Error: Unknown error. Contact MIS.';
  end;

  if vc_OutputMessage != 'Valid'
  then return vc_OutputMessage;
  end if;

  open cur_FullSalesUnitInfo(pi_ToffJobId);
  fetch cur_FullSalesUnitInfo into rec_FullSalesUnitInfo;
  close cur_FullSalesUnitInfo;

  if rec_PendingStruct.unit_of_measure != rec_FullSalesUnitInfo.toff_job_uom
  then
    if pi_ForceExactMatch = false
    then warning('Warning: Unit Type '||rec_PendingStruct.unit_of_measure||
                  ' could cause problems for this job.');
    elsif pi_ForceExactMatch = true
    then
      vc_OutputMessage :=
        'The wall'||chr(39)||'s unit system ('||
        rec_PendingStruct.unit_of_measure||
        ') conflicts with the job ('||
        rec_FullSalesUnitInfo.toff_job_uom||
        '). Please check your product code,'||
        ' or contact MIS if you feel this is incorrect.';
      return vc_OutputMessage;
    end if;
  end if;

  RETURN vc_OutputMessage;
END validate_uom;

