-- import_panels_normally
--
-- DESCRIPTION
-- imports and validates panels.
--
-- This function grabs panels from the IMPORT_PANELS table, and then inserts
-- them into the RECO_PANELS table.
-- Also, during the import, this function validates the panels it reads.
--
-- This function should not be run for wire walls. In that case, you should
-- refer to the function import_panels_aswire(). Note that even though these
-- functions may seem similar, they do have several key differences.
--
-- UPDATES
-- grouping added 2/2/01  jra
-- added by David Correia 2/13/2001
-- fixed group by problem by adding sum on quantity required field. the sum will
-- now be placed in the field qty_required
-- Scott-Mattingly 08-AUG-2010
-- : Improved function name (previously named import_panels)
-- : Improved documentation
--
-- PRE-CONDITIONS
-- : parameter pi_ImportId reflects a non-wire-wall import
-- : pi_GivenJobType is 'E' or 'M'
--
-- POST-CONDITIONS
-- : Function returns 'Imported.' when successful. In this case, any warnings
--   are written to package warning system. The panels are inserted into the
--   RECO_PANELS table, but no commit is executed.
-- : Function returns an error message when it fails. Warnings may still be
--   added to the package warning system before the error occurs. In this case,
--   no rollback is executed.
FUNCTION import_panels_normally(pi_ImportId IN number,
                                pi_ProdCode IN varchar2,
                                pi_StructId IN number,
                                pi_GivenJobType in varchar2,
                                pi_GivenLoginId in number,
                                pi_GivenUserId in varchar2)
            RETURN varchar2
IS
  vn_OriginalPanArea number;

  vc_IsListedAsProdPanel varchar2(1);
  vn_TheStdPanelArea number;

  cursor getnewid is select reco_panel_seq.nextval from dual;
  panelid number;
  pendingpanelid number;

CURSOR getnewpanels
IS
  SELECT  toff_panel_pending_id,
          panel_name,
          tie_strip_quantity,
          panel_reinforcements,
          panel_finish,
          panel_additions,
          width,
          thickness,
          area_per_piece,
          quantity_required sum_qty_required
  FROM reco_toff_panel_pending
  WHERE toff_struct_pending_id = pi_ImportId;

BEGIN -- import_panels_normally

  -- Check that JobType/Product exists in the domain data.
  -- If there is a problem, then return error message

  declare
    vc_Temp varchar2(1);
  begin
    select 'Y' into vc_Temp
    from  prec_products
    where  product_code = pi_ProdCode;
  exception
    when NO_DATA_FOUND
    then
      return 'Invalid ProductCode. The product does not exist.';
    when TOO_MANY_ROWS
    then
      return 'Invalid ProductCode/JobType. Duplicate data found. Contact MIS.';
    when others
    then
      return 'Product Code error. Unknown error. Contact MIS.';
  end;

  -------------------------------------------------------------------
  -- Check that all the panel reinforcements are allowable
  -------------------------------------------------------------------

  declare
    cursor cur_BadReinforcements
    is
      select  impan.panel_name pname,
              impan.tie_strip_quantity tsqty,
              impan.panel_reinforcements reinf
      from  reco_toff_panel_pending impan
      where   impan.toff_struct_pending_id = pi_ImportId
      and     impan.panel_reinforcements not in
                ( select reinforcement_type from prec_reinforcements where product_code = pi_prodcode  );

    vn_TotalReinfApproved number;

    vb_FoundBadRec boolean;
    rec_BadReinforcements cur_BadReinforcements%rowtype;
  begin

    select count(*) into vn_TotalReinfApproved
    from  prec_reinforcements
    where   product_code = pi_ProdCode;

    vb_FoundBadRec := true;
    open cur_BadReinforcements;
    fetch cur_BadReinforcements into rec_BadReinforcements;
    if cur_BadReinforcements%NOTFOUND
    then vb_FoundBadRec := false;
    end if;
    close cur_BadReinforcements;

    if vn_TotalReinfApproved > 0
    and vb_FoundBadRec = true
    and pi_ProdCode not in ('TRL','VTL','VTR','OTL','CTT','CT1','CT2','CT3')
    then
      return 'Invalid Reinforcement ('||rec_BadReinforcements.reinf||
              ') for panel '||
              rec_BadReinforcements.pname||'-'||
              rec_BadReinforcements.tsqty||'-'||
              rec_BadReinforcements.reinf||
              '. Either choose a standard reinforcement, '||
              'or contact MIS for assistance';
    end if;
  end;

  -------------------------------------------------------------------
  -- Check that all the panel additions allowable, add warning if not
  -------------------------------------------------------------------

  begin

    if pi_ProdCode in ('REW','SQR','RLA','CTC')
    then
      for rec_BadAdditions
      in
      (
        select  distinct impan.panel_additions addit
        from  reco_toff_panel_pending impan
        where   impan.toff_struct_pending_id = pi_ImportId
        and     impan.panel_additions not in
                  ( select addition_type from prec_additions where product_code = pi_prodcode
                  )
      )
      loop
        warning( 'Warning: Additions '||rec_BadAdditions.addit||' has not been approved for this product.');
      end loop;
    end if;

  end;

  -- Loop for each panel we want to import from the reco_toff_panel_pending table

  FOR eachone IN getnewpanels
  LOOP

    vn_OriginalPanArea := eachone.area_per_piece;

    vc_IsListedAsProdPanel := 'F';
    vn_TheStdPanelArea := null;

    begin
      select  'T',
              case
              when default_area is null then null
              else to_number(default_area)
              end
      into  vc_IsListedAsProdPanel,
            vn_TheStdPanelArea
      from  prec_panel_validation
      where   product_code = pi_ProdCode
      and     panel_name = eachone.panel_name;
    exception
      when NO_DATA_FOUND
      then
        vc_IsListedAsProdPanel := 'F';
        vn_TheStdPanelArea := null;
      when TOO_MANY_ROWS
      then
        return 'Invalid Area definition for panel '||
                eachone.panel_name||'. Contact MIS.';
      when others
      then
        return 'Panel Area error. Unknown error. Contact MIS.';
    end;

    IF vc_IsListedAsProdPanel = 'T'
    THEN

      IF vn_TheStdPanelArea is not null
      AND vn_TheStdPanelArea != vn_OriginalPanArea
      THEN
         warning( 'Invalid default area :'||
                  eachone.panel_name||'-'||TO_CHAR(eachone.area_per_piece)||
                  '/TS:'||TO_CHAR(eachone.tie_strip_quantity)||'/R:'||
                  eachone.panel_reinforcements||'/'||
                  eachone.panel_finish||'/'||eachone.panel_additions||'/'||
                  TO_CHAR(eachone.width)||'/'||TO_CHAR(eachone.thickness)  );
         warning( 'Correcting to '||TO_CHAR(vn_TheStdPanelArea) ) ;
      END IF;


      declare
        vn_MinTSQty number;
        vn_MaxTSQty number;
      begin
        select rts.tiestrips_low, rts.tiestrips_high
        into  vn_MinTSQty, vn_MaxTSQty
        from  prec_product_ranges rts
        where   product_code = pi_ProdCode;

        if eachone.tie_strip_quantity < vn_MinTSQty
        or eachone.tie_strip_quantity > vn_MaxTSQty
        then
          return 'Invalid TSQty for Panel. Panel '||
                  eachone.panel_name||'-'||TO_CHAR(eachone.tie_strip_quantity)||
                  '-'||eachone.panel_reinforcements||' should have TSQty '||
                  'between '||to_char(vn_MinTSQty)||' - '||to_char(vn_MaxTSQty);
        end if;
      exception
        when NO_DATA_FOUND
        then
          null;
        when TOO_MANY_ROWS
        then
          return 'Invalid Tiestrip settings for '||pi_ProdCode||
                  '. Duplicate data found. Contact MIS.';
        when others
        then
          return 'Tiestrip settings error. Unknown error. Contact MIS.';
      end;


      declare
        vn_MinWidth number;
        vn_MaxWidth number;
      begin
        select  rwr.width_low, rwr.width_high
        into  vn_MinWidth, vn_MaxWidth
        from  prec_product_ranges rwr
        where   product_code = pi_ProdCode;
        if eachone.width > 10 then
          -- assume if > 10 then it is in millimeters
          vn_MaxWidth := vn_MaxWidth * 1000 ;
        end if;
        if eachone.width < vn_MinWidth
        or eachone.width > vn_MaxWidth
        then
          return 'Invalid width for panel: '||
                  eachone.panel_name||'-'||TO_CHAR(eachone.tie_strip_quantity)||'-'||
                  eachone.panel_reinforcements||'-'||
                  TO_CHAR(eachone.width)||'. Outside range '||vn_minwidth||'-'||vn_maxwidth;
        end if;
      exception
        when NO_DATA_FOUND
        then
          null;
        when TOO_MANY_ROWS
        then
          return 'Invalid Width settings for '||pi_ProdCode||
                  '. Duplicate data found. Contact MIS.';
        when others
        then
          return 'Width settings error. Unknown error. Contact MIS.';
      end;
    END IF;

    pendingpanelid := eachone.toff_panel_pending_id;

    open getnewid;
    fetch getnewid into panelid;
    close getnewid;

    INSERT INTO reco_toff_panels ( TOFF_PANEL_ID,TOFF_STRUCT_ID,
      PANEL_NAME,TIE_STRIP_QUANTITY,PANEL_REINFORCEMENTS,
      PANEL_FINISH,PANEL_ADDITIONS,WIDTH,THICKNESS,AREA_PER_PIECE,
      QUANTITY_REQUIRED,
      LAST_UPDATE_DATE,LAST_UPDATED_BY,
      CREATION_DATE,CREATED_BY,LAST_UPDATE_LOGIN )
    VALUES ( panelid, pi_StructId, eachone.panel_name,
             eachone.tie_strip_quantity, eachone.panel_reinforcements,
             eachone.panel_finish, eachone.panel_additions, eachone.width,
             eachone.thickness,
             --nvl(vn_TheStdPanelArea,vn_OriginalPanArea), --commented by Komal 22-OCT-25
	         nvl(vn_OriginalPanArea,vn_TheStdPanelArea), --Added by Komal 22-OCT-25
             eachone.sum_qty_required,
             SYSDATE,pi_GivenUserId,SYSDATE,pi_GivenUserId,pi_GivenLoginId );

    -- 8/7 update pending panel to newly created panel id for coordinates
    update reco_toff_panel_pending set toff_panel_id = panelid
     where toff_panel_pending_id = pendingpanelid;

  END LOOP;

  RETURN 'Imported.';
EXCEPTION
  WHEN others THEN
    IF getnewpanels%isopen THEN
       CLOSE getnewpanels;
    END IF;
    RETURN 'Panels - Insert Failure:'||SQLERRM;
END import_panels_normally;

