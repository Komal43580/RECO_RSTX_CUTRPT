-- copy_toff_struct
--
-- DESCRIPTION
-- Copies a structure along with its panels and parts to a takeoff job.
-- Doesn't create history, doesn't affect estimates, and doesn't change costs,
-- but it will affect calculated values in the new job
--
-- UPDATES
-- : 13-JAN-2012 - DSM - Created
--
-- PRE-CONDITIONS
-- : The givenOldStrId is some valid structure in reco_toff_structs
-- : The givenNewJobId is some job in the reco_toff_jobs table
-- : The givenUserId and givenLoginId are for who columns
-- : Do NOT call this method when copying the wall into the same job and there are
--   costs attached. In this case the user should just fix the wall !!
-- : The givenNewStrName is the desired name for the new wall copy.
--   This new name parameter should be used in 1 of 4 ways, and it
--   is the responsibility of the caller to make sure to use it
--   correctly:
--   - IF wall is copied to different job
--   - AND wall has no costs
--   - {
--   -   givenNewStrName can be anything, or null to keep existing name
--   - }
--   - ELSIF wall is copied to different job
--   - AND wall has costs (PCFs/MOs history)
--   - {
--   -   givenNewStrName should be null, keep the same name as old one
--   - }
--   - ELSIF wall is copied to same job
--   - AND wall has no costs
--   - {
--   -   givenNewStrName can be anything, or null to keep existing name
--   - }
--   - ELSIF wall is copied to same job
--   - AND wall has costs (PCFs/MOs history)
--   - {
--   -   Don't allow this case. Caller error (see other pre-conditions)
--   - }
-- : the job units may be different between old job and new job
--
-- POST-CONDITIONS
-- : Copies the structure to the job, with the given name (if any)
--   ( see pre-conditions ).
-- : No history change, no estimate change, no cost change
-- : Return 'DONE' if everything works, and the new copy's
--   toff_struct_id is set into outNewStrId
-- : Return an error message if something fails and rollback
-- : When completeing and 'DONE', this method may commit
--   depending on the givenShouldCommit value
-- : When completeing and 'DONE', this method sets the value of
--   outNewStrId to the copy's structure_id
-- : When completeing and 'DONE', calculated values are synced
function copy_toff_struct ( givenoldstrid in number,
                            givennewjobid in number,
                            givennewstrname in varchar2,
                            givenuserid in number,
                            givenloginid in number,
                            givenshouldcommit in boolean,
                            outnewstrid out number)
return varchar2
is
	vn_tmppcfqty number;
	vn_tmpmoqty number;
  vc_tmphascosts varchar2(1);

  vn_oldjobid number;
  vn_oldstrid number;
  vn_newjobid number;
  vn_newstrid number;
  vc_newstrname reco_toff_structs.structure_name%type;
  vd_updatetime date;

  vc_tmpchar varchar2(1);
  vc_tmperrmsg varchar2(1024);
begin

  -- Validations
  if givenoldstrid is null or givennewjobid is null or givenshouldcommit is null
  then return 'Error 0025 - Internal Error - Invalid parameters';
  end if;

  begin
    select 'Y' into vc_tmpchar from reco_toff_structs
    where toff_struct_id = givenoldstrid;
    select 'Y' into vc_tmpchar from reco_toff_jobs_v
    where toff_job_id = givennewjobid;
  exception
    when others then return 'Error 0026 - Internal Error - Invalid parameters';
  end;

  vn_oldstrid := givenoldstrid;
  vn_newjobid := givennewjobid;

  select toff_job_id into vn_oldjobid from reco_toff_structs
  where toff_struct_id = vn_oldstrid;

  vc_tmperrmsg := prec_takeoff.getstructpcfqty(vn_oldstrid,vn_tmppcfqty);
  if vc_tmperrmsg != 'DONE'
  then return vc_tmperrmsg;
  end if;
  vc_tmperrmsg := prec_takeoff.getstructmoqty(vn_oldstrid,vn_tmpmoqty);
  if vc_tmperrmsg != 'DONE'
  then return vc_tmperrmsg;
  end if;
  vc_tmperrmsg := prec_takeoff.structhascosts(vn_oldstrid,vc_tmphascosts);
  if vc_tmperrmsg != 'DONE'
  then return vc_tmperrmsg;
  end if;

  if vn_oldjobid = vn_newjobid
  and vc_tmphascosts = 'Y'
  then return 'Error 0027 - Cannot copy wall into same project if it has costs';
  end if;

  if vn_oldjobid != vn_newjobid
  and vc_tmphascosts = 'Y'
  and givennewstrname is not null
  then return 'Error 0028 - Cannot change wall name when you copy a '||
              'costed wall to another project';
  end if;

  -- Done validations (and setting 3 vars)
  -- So now do everything else

  select reco_structure_seq.nextval into vn_newstrid from dual;

  vc_newstrname := givennewstrname;
  if vc_newstrname is null
  then
    select substr.structure_name into vc_newstrname
    from reco_toff_structs substr where substr.toff_struct_id = vn_oldstrid;
  end if;

  vd_updatetime := sysdate;

	insert into reco_toff_structs (toff_struct_id,structure_name,
			revision_number,unit_of_measure,toff_job_id,status_code,
			soil_reinf_type,total_area,prelim_date,final_date,
			total_steel_lf,total_steel_tons,total_steel_qty,wall_length,
			num_columns,avg_height,num_panels,num_ties,importer_id,
			last_update_date,last_updated_by,creation_date,created_by,
			last_update_login,
      is_corp_std,is_mural_wall,contents_code)
	(	select	vn_newstrid,
						vc_newstrname,
						revision_number,
						unit_of_measure,
						vn_newjobid,
						status_code,
						soil_reinf_type,
						total_area,
						prelim_date,
						final_date,
						total_steel_lf,
						total_steel_tons,
						total_steel_qty,
						wall_length,
						num_columns,
						avg_height,
						num_panels,
						num_ties,
						importer_id,
						vd_updatetime,
						givenuserid,
						creation_date,
						created_by,
						givenloginid,
            is_corp_std,
            is_mural_wall,
            contents_code
		from	reco_toff_structs
		where		toff_struct_id = vn_oldstrid );

	insert into reco_toff_panels (toff_panel_id,toff_struct_id,
			panel_name,tie_strip_quantity,panel_reinforcements,
			panel_finish,panel_additions,width,thickness,area_per_piece,
			quantity_required,last_update_date,last_updated_by,
			creation_date,created_by,last_update_login)
	(	select	reco_panel_seq.nextval,
						vn_newstrid,
						panel_name,
						tie_strip_quantity,
						panel_reinforcements,
						panel_finish,
						panel_additions,
						width,
						thickness,
						area_per_piece,
						quantity_required,
						vd_updatetime,
						givenuserid,
						creation_date,
						created_by,
						givenloginid
		from	reco_toff_panels
		where		toff_struct_id = vn_oldstrid );

	insert into reco_toff_parts (toff_part_id,toff_struct_id,
			part_code,calc_quantity,adj_quantity,
			quantity_required,last_update_date,last_updated_by,
			creation_date,created_by,last_update_login)
	(	select	reco_part_seq.nextval,
						vn_newstrid,
						part_code,
						calc_quantity,
						adj_quantity,
						quantity_required,
						vd_updatetime,
						givenuserid,
						creation_date,
						created_by,
						givenloginid
		from	reco_toff_parts
		where		toff_struct_id = vn_oldstrid );

  vc_tmperrmsg := prec_takeoff.set_toff_calc_values(vn_newjobid,null);

  if vc_tmperrmsg != 'DONE'
  then rollback;
        return vc_tmperrmsg;
  end if;

  if givenshouldcommit
  then commit;
  end if;

  outnewstrid := vn_newstrid;

  return 'DONE';
end; -- copy_toff_Struct

