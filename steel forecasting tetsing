create or replace PACKAGE BODY      RECO_STEEL_FORECAST_PKG AS

  FUNCTION get_steel_buckets (
    p_project_number IN VARCHAR2,
    p_product_code   IN VARCHAR2,
    p_budget_tons    IN NUMBER,
    p_shipped_tons   IN NUMBER,
    p_as_of_date     IN DATE
  ) RETURN steel_buckets_rec
  IS
    l_rec steel_buckets_rec;

    v_m1_start DATE := TRUNC(p_as_of_date,'MM');
    v_m1_end   DATE := LAST_DAY(v_m1_start);
    v_m2_start DATE := ADD_MONTHS(v_m1_start, 1);
    v_m2_end   DATE := LAST_DAY(v_m2_start);
    v_m3_start DATE := ADD_MONTHS(v_m1_start, 2);
    v_m3_end   DATE := LAST_DAY(v_m3_start);

    v_struct_cnt NUMBER := 0;
    v_prod_cnt   NUMBER := 0;

    v_m1_tons     NUMBER := 0;
    v_m2_tons     NUMBER := 0;
    v_m3_tons     NUMBER := 0;
    v_future_tons NUMBER := 0;

    v_mo_m1_tons     NUMBER := 0;
    v_mo_m2_tons     NUMBER := 0;
    v_mo_m3_tons     NUMBER := 0;
    v_mo_future_tons NUMBER := 0;
    v_mo_total_tons  NUMBER := 0;

    v_total_plan NUMBER := 0;
    v_remaining  NUMBER := 0;

  BEGIN
    l_rec.tons_m1     := 0;
    l_rec.tons_m2     := 0;
    l_rec.tons_m3     := 0;
    l_rec.tons_future := 0;

    v_remaining := GREATEST(p_budget_tons - p_shipped_tons, 0);

    IF v_remaining = 0 THEN
      RETURN l_rec;
    END IF;

    ----------------------------------------------------------------
    -- 1) MATERIAL ORDERS - STEEL ONLY
    ----------------------------------------------------------------
    -- added by Komal 25-APR-2026
    -- reason: calculate pending material order steel at order level.
    -- Delivered steel should reduce pending only for the same order.
    -- This prevents delivered steel from older orders reducing active pending orders.
    BEGIN
      SELECT
          NVL(SUM(CASE
                    WHEN mo.delivery_date BETWEEN v_m1_start AND v_m1_end
                    THEN mo.pending_steel_tons
                    ELSE 0
                  END),0),
          NVL(SUM(CASE
                    WHEN mo.delivery_date BETWEEN v_m2_start AND v_m2_end
                    THEN mo.pending_steel_tons
                    ELSE 0
                  END),0),
          NVL(SUM(CASE
                    WHEN mo.delivery_date BETWEEN v_m3_start AND v_m3_end
                    THEN mo.pending_steel_tons
                    ELSE 0
                  END),0),
          NVL(SUM(CASE
                    WHEN mo.delivery_date > v_m3_end
                    THEN mo.pending_steel_tons
                    ELSE 0
                  END),0)
      INTO v_mo_m1_tons,
           v_mo_m2_tons,
           v_mo_m3_tons,
           v_mo_future_tons
      FROM (
          SELECT ordered.order_id,
                 ordered.delivery_date,
                 GREATEST(
                   ordered.ordered_steel_tons - NVL(shipped.shipped_steel_tons,0),
                   0
                 ) pending_steel_tons
          FROM (
              SELECT o.order_id,
                     o.delivery_date,
                     SUM((op.quantity_required * si.unit_volume) * 1.203 / 2000) ordered_steel_tons
              FROM reco_sales_tracking_v st
              JOIN reco_orders o
                ON o.sales_id = st.sales_id
              JOIN reco_order_parts op
                ON op.order_id = o.order_id
              JOIN apps.mtl_system_items_b_kfv si
                ON si.inventory_item_id = op.part_item_id
               AND si.organization_id   = fnd_global.org_id
              WHERE st.project_number = p_project_number
                AND st.product_code   = p_product_code
                AND NVL(op.quantity_required,0) > 0
                AND o.delivery_date IS NOT NULL
                AND si.attribute3 LIKE 'STEEL%'
                AND UPPER(st.lead_status) <> 'CLOSED'
                AND UPPER(o.status_code) NOT IN ('CANCELLED','CLOSED','DELIVERED','ARCHIVED')
              GROUP BY o.order_id,
                       o.delivery_date
          ) ordered
          LEFT JOIN (
              SELECT o.order_id,
                     SUM((sp.quantity * si.unit_volume) * 1.203 / 2000) shipped_steel_tons
              FROM reco_sales_tracking_v st
              JOIN reco_orders o
                ON o.sales_id = st.sales_id
              JOIN reco_shipment_parts sp
                ON sp.order_id = o.order_id
              JOIN reco_shipment s
                ON s.shipment_id = sp.shipment_id
              JOIN apps.mtl_system_items_b_kfv si
                ON si.inventory_item_id = sp.part_id
               AND si.organization_id   = fnd_global.org_id
              WHERE st.project_number = p_project_number
                AND st.product_code   = p_product_code
                AND s.shipment_status = 'DELIVERED'
                AND sp.orig_subinventory_code = 'RSTX'
                AND si.attribute3 LIKE 'STEEL%'
              GROUP BY o.order_id
          ) shipped
            ON shipped.order_id = ordered.order_id
      ) mo
      WHERE mo.pending_steel_tons > 0;

    EXCEPTION
      WHEN NO_DATA_FOUND THEN
        v_mo_m1_tons     := 0;
        v_mo_m2_tons     := 0;
        v_mo_m3_tons     := 0;
        v_mo_future_tons := 0;
    END;

    v_mo_total_tons := v_mo_m1_tons + v_mo_m2_tons + v_mo_m3_tons + v_mo_future_tons;

    ----------------------------------------------------------------
    -- 2) STRUCTURE FORECAST - EXCLUDE FULLY DELIVERED STRUCTURES
    ----------------------------------------------------------------
    -- added by Komal 24-APR-2026
    -- reason: fully delivered structures must not continue contributing
    -- to pending M1 / M2 / M3 / future forecast buckets in BI.
    SELECT COUNT(*)
      INTO v_struct_cnt
      FROM reco_forecast_structs fs
      JOIN reco_toff_structs ts
        ON ts.toff_struct_id = fs.structure_id
      LEFT JOIN (
        SELECT os.structure_id,
               ROUND(SUM((sp.quantity * si.unit_volume) * 1.203 / 2000), 6) delivered_tons
          FROM reco_order_structures os
          JOIN reco_shipment_parts sp
            ON sp.order_id = os.order_id
          JOIN reco_shipment s
            ON s.shipment_id = sp.shipment_id
          JOIN apps.mtl_system_items_b_kfv si
            ON si.inventory_item_id = sp.part_id
           AND si.organization_id   = fnd_global.org_id
         WHERE s.shipment_status = 'DELIVERED'
           AND sp.orig_subinventory_code = 'RSTX'
           AND si.attribute3 LIKE 'STEEL%'
         GROUP BY os.structure_id
      ) dt
        ON dt.structure_id = fs.structure_id
     WHERE fs.project_number = p_project_number
       AND fs.product_code   = p_product_code
       AND NVL(dt.delivered_tons,0) < NVL(ts.total_steel_tons,0);

    IF v_struct_cnt > 0 THEN

      SELECT NVL(SUM(CASE WHEN fs.forecast_month BETWEEN v_m1_start AND v_m1_end THEN fs.forecast_steel_tons ELSE 0 END),0),
             NVL(SUM(CASE WHEN fs.forecast_month BETWEEN v_m2_start AND v_m2_end THEN fs.forecast_steel_tons ELSE 0 END),0),
             NVL(SUM(CASE WHEN fs.forecast_month BETWEEN v_m3_start AND v_m3_end THEN fs.forecast_steel_tons ELSE 0 END),0),
             NVL(SUM(CASE WHEN fs.forecast_month > v_m3_end THEN fs.forecast_steel_tons ELSE 0 END),0)
        INTO v_m1_tons, v_m2_tons, v_m3_tons, v_future_tons
        FROM reco_forecast_structs fs
        JOIN reco_toff_structs ts
          ON ts.toff_struct_id = fs.structure_id
        LEFT JOIN (
          SELECT os.structure_id,
                 ROUND(SUM((sp.quantity * si.unit_volume) * 1.203 / 2000), 6) delivered_tons
            FROM reco_order_structures os
            JOIN reco_shipment_parts sp
              ON sp.order_id = os.order_id
            JOIN reco_shipment s
              ON s.shipment_id = sp.shipment_id
            JOIN apps.mtl_system_items_b_kfv si
              ON si.inventory_item_id = sp.part_id
             AND si.organization_id   = fnd_global.org_id
           WHERE s.shipment_status = 'DELIVERED'
             AND sp.orig_subinventory_code = 'RSTX'
             AND si.attribute3 LIKE 'STEEL%'
           GROUP BY os.structure_id
        ) dt
          ON dt.structure_id = fs.structure_id
       WHERE fs.project_number = p_project_number
         AND fs.product_code   = p_product_code
         AND NVL(dt.delivered_tons,0) < NVL(ts.total_steel_tons,0);

    ELSE

      ----------------------------------------------------------------
      -- 3) PRODUCT FORECAST
      ----------------------------------------------------------------
      SELECT COUNT(*)
        INTO v_prod_cnt
        FROM reco_forecast_products fp
       WHERE fp.project_number = p_project_number
         AND fp.product_code   = p_product_code;

      IF v_prod_cnt > 0 THEN
        SELECT NVL(SUM(CASE WHEN fp.forecast_month BETWEEN v_m1_start AND v_m1_end THEN fp.forecast_steel_tons ELSE 0 END),0),
               NVL(SUM(CASE WHEN fp.forecast_month BETWEEN v_m2_start AND v_m2_end THEN fp.forecast_steel_tons ELSE 0 END),0),
               NVL(SUM(CASE WHEN fp.forecast_month BETWEEN v_m3_start AND v_m3_end THEN fp.forecast_steel_tons ELSE 0 END),0),
               NVL(SUM(CASE WHEN fp.forecast_month > v_m3_end THEN fp.forecast_steel_tons ELSE 0 END),0)
          INTO v_m1_tons, v_m2_tons, v_m3_tons, v_future_tons
          FROM reco_forecast_products fp
         WHERE fp.project_number = p_project_number
           AND fp.product_code   = p_product_code;
      END IF;
    END IF;

    ----------------------------------------------------------------
    -- 4) PRECEDENCE = FULLY DELIVERED OVERRIDE > MO > FORECAST
    ----------------------------------------------------------------
    -- added by Komal 25-APR-2026
    -- reason: active material orders override forecast only after
    -- same-order delivered steel has been removed from pending.
    IF v_mo_total_tons > 0 THEN
      DECLARE
        v_left NUMBER;
      BEGIN
        v_left := v_remaining;

        l_rec.tons_m1 := LEAST(v_mo_m1_tons, v_left);
        v_left := v_left - l_rec.tons_m1;

        l_rec.tons_m2 := LEAST(v_mo_m2_tons, v_left);
        v_left := v_left - l_rec.tons_m2;

        l_rec.tons_m3 := LEAST(v_mo_m3_tons, v_left);
        v_left := v_left - l_rec.tons_m3;

        l_rec.tons_future := LEAST(v_mo_future_tons, v_left);
      END;

      RETURN l_rec;
    END IF;

    ----------------------------------------------------------------
    -- 5) FINAL ALLOCATION - FORECAST PATH
    ----------------------------------------------------------------
    v_total_plan := v_m1_tons + v_m2_tons + v_m3_tons + v_future_tons;

    IF v_total_plan = 0 THEN
      l_rec.tons_future := v_remaining;
      RETURN l_rec;
    END IF;

    IF v_total_plan <= v_remaining THEN
      l_rec.tons_m1     := v_m1_tons;
      l_rec.tons_m2     := v_m2_tons;
      l_rec.tons_m3     := v_m3_tons;
      l_rec.tons_future := v_future_tons + (v_remaining - v_total_plan);
    ELSE
      DECLARE
        v_left NUMBER;
      BEGIN
        v_left := v_remaining;

        l_rec.tons_m1 := LEAST(v_m1_tons, v_left);
        v_left := v_left - l_rec.tons_m1;

        l_rec.tons_m2 := LEAST(v_m2_tons, v_left);
        v_left := v_left - l_rec.tons_m2;

        l_rec.tons_m3 := LEAST(v_m3_tons, v_left);
        v_left := v_left - l_rec.tons_m3;

        l_rec.tons_future := LEAST(v_future_tons, v_left);
      END;
    END IF;

    RETURN l_rec;

  END get_steel_buckets;

END RECO_STEEL_FORECAST_PKG;
