SELECT
    t.task_id,
    t.task_number,
    t.task_name,
    tsk.value AS product_code,
    st.lead_status
FROM pa_tasks t
JOIN reco_sales_tracking_v st
  ON st.project_id = t.project_id
JOIN reco_task_products tsk
  ON tsk.description = SUBSTR(t.task_number,1,3)
 AND tsk.value       = st.product_code
WHERE st.project_id = (
        SELECT project_id
        FROM pa_projects
        WHERE segment1 = '22604'
      )
  AND st.lead_status NOT IN
      ('Void', 'Lost', 'Closed', 'Pending Closed')
  AND tsk.value = 'RLA'
ORDER BY t.task_number;

