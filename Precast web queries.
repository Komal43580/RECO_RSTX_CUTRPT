WITH current_revision AS
(
    SELECT revision_number
    FROM reco_pcf_current
    WHERE pcf_id = 191252
),
requirements AS
(
    SELECT
        r.mark_number,
        r.quantity_required,
        r.quantity_billed,
        r.area_per_piece
    FROM reco_production_requirements r
    JOIN current_revision c
      ON c.revision_number = r.revision_number
    WHERE r.pcf_id = 191252
),
production AS
(
    SELECT
        mark_number,
        SUM(NVL(quantity_produced, 0)) AS produced_qty,
        SUM(NVL(area_total, 0))        AS produced_area
    FROM reco_production_v
    WHERE pcf_id = 191252
    GROUP BY mark_number
)
SELECT
    r.mark_number,
    r.quantity_required,
    NVL(p.produced_qty, 0) AS produced_qty,
    r.quantity_required - NVL(p.produced_qty, 0) AS missing_qty,
    r.area_per_piece,
    ROUND(
        (r.quantity_required - NVL(p.produced_qty, 0))
        * r.area_per_piece,
        2
    ) AS missing_area
FROM requirements r
LEFT JOIN production p
  ON p.mark_number = r.mark_number
WHERE NVL(p.produced_qty, 0) < r.quantity_required
ORDER BY missing_area DESC, r.mark_number;

