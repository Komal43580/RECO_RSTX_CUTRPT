WITH rev3_at_revision AS
(
    SELECT
        mark_number,
        ROUND(
            (SUM(quantity_produced) - AVG(quantity_required))
            * AVG(area_per_piece),
            2
        ) AS overage_area
    FROM reco_production_rev_v
