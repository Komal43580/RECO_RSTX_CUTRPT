      AND revision_number = 3
      AND creation_date <= DATE '2026-05-19'
      AND billed_date IS NOT NULL
    GROUP BY mark_number
    HAVING AVG(quantity_required) - SUM(quantity_produced) < 0
),
current_overage AS
(
    SELECT
        r.mark_number,
        ROUND(
            GREATEST(
                NVL(p.produced_qty, 0) - r.quantity_required,
                0
            ) * r.area_per_piece,
            2
        ) AS overage_area
    FROM
    (
        SELECT
            mark_number,
            quantity_required,
            area_per_piece
        FROM reco_production_requirements
        WHERE pcf_id = 191252
          AND revision_number = 5
    ) r
    LEFT JOIN
    (
        SELECT
            mark_number,
            SUM(NVL(quantity_produced,0)) produced_qty
        FROM reco_production_v
        WHERE pcf_id = 191252
        GROUP BY mark_number
    ) p
      ON p.mark_number = r.mark_number
)
SELECT
    COALESCE(a.mark_number,c.mark_number) AS mark_number,
    NVL(a.overage_area,0) AS rev3_overage,
    NVL(c.overage_area,0) AS current_overage,
    ROUND(
        NVL(a.overage_area,0)
        - NVL(c.overage_area,0),
        2
    ) AS overage_change
FROM rev3_at_revision a
FULL OUTER JOIN current_overage c
  ON c.mark_number = a.mark_number
