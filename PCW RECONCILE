/* 1. Current production-week view */
SELECT DBMS_METADATA.GET_DDL(
           'VIEW',
           'VW_PCF_PRODUCTION_THIS_WEEK',
           'RECOWEBPROD'
       )
FROM dual;

"
  CREATE OR REPLACE FORCE EDITIONABLE VIEW "RECOWEBPROD"."VW_PCF_PRODUCTION_THIS_WEEK" ("PCF_SEQ", "MON_DATE", "SCHEDULED_QTY", "SUBMITTED_QTY", "WEEK_START_SUBMITTED_QTY", "WEEK_START_SCHEDULED_QTY", "TOTAL_PROD") AS 
  SELECT   a.pc_id              pcf_seq,
           a.mon_date           mon_date,
           sum(a.scheduled_qty) scheduled_qty,
           sum(a.submitted_qty) submitted_qty,
           b.week_start_submitted_qty,
           b.week_start_scheduled_qty,
           b.week_start_submitted_qty + sum(a.submitted_qty) + sum(a.scheduled_qty) + b.week_start_scheduled_qty TOTAL_PROD
  FROM
      (
        select rp.pc_id,
               ln.mon_date,
               decode(ln.submit_flag,
                      'N', nvl(rp.quantity_produced,0),
                       0) scheduled_qty,
               decode(ln.submit_flag,
                      'Y', nvl(rp.quantity_produced,0),
                       0) submitted_qty
        from web_re_lot_numbers ln,
             web_re_production rp
        where ln.lot_id = rp.lot_id
      ) a,
      (
        SELECT  driver.pc_id pc_id,
                driver.mon_date mon_date,
                sum(decode(ln.submit_flag, 'Y', nvl(rp.quantity_produced,0), 0)) week_start_submitted_qty,
                sum(decode(ln.submit_flag, 'N', nvl(rp.quantity_produced,0), 0)) week_start_scheduled_qty
        FROM  web_re_lot_numbers ln,
              web_re_production rp,
              (
                SELECT DISTINCT
                      pc_id,
                      mon_date
                FROM  web_re_production rp,
                      web_re_lot_numbers ln
                where rp.lot_id = ln.lot_id
              ) driver
        WHERE  ln.lot_id = rp.lot_id
        AND    rp.pc_id = driver.pc_id
        AND    ln.mon_date < driver.mon_date
        GROUP BY driver.pc_id, driver.mon_date
        UNION
        SELECT  driver.pc_id,
                driver.mon_date mon_date,
                0 week_start_submitted_qty,
                0 week_start_scheduled_qty
        FROM web_re_lot_numbers ln,
             web_re_production rp,
             (
               SELECT pc_id,
                      min(mon_date) mon_date
               FROM web_re_production rp,
                    web_re_lot_numbers ln
               where rp.lot_id = ln.lot_id
               GROUP BY pc_id
             ) driver
        WHERE  ln.lot_id = rp.lot_id
        AND    rp.pc_id = driver.pc_id
        AND    ln.mon_date = driver.mon_date
        GROUP BY  driver.pc_id,
                  driver.mon_date
      ) b
WHERE  a.pc_id = b.pc_id
AND    a.mon_date = b.mon_date
GROUP BY a.pc_id,
         a.mon_date,
         b.week_start_submitted_qty,
         b.week_start_scheduled_qty"
         
