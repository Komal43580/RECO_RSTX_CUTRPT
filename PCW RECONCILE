                            then nvl(subbtrx.qty_standard,0) + nvl(subbtrx.qty_overage,0) + nvl(subbtrx.qty_paid_over,0)
                            else 0
                            end) qtySunOther,
                        sum(case
                            when subbtrxhdr.monday_date = to_date(:P302_WORKING_WEEKSTARTDATE,'mm/dd/yyyy')
                            then nvl(subbtrx.qty_standard,0)
                            else 0
                            end) qtyReguInWeek,
                        sum(case
                            when subbtrxhdr.monday_date = to_date(:P302_WORKING_WEEKSTARTDATE,'mm/dd/yyyy')
                            then nvl(subbtrx.qty_paid_over,0)
                            else 0
                            end) qtyPdOvInWeek,
                        sum(case
                            when subbtrxhdr.monday_date = to_date(:P302_WORKING_WEEKSTARTDATE,'mm/dd/yyyy')
                            then nvl(subbtrx.qty_overage,0)
                            else 0
                            end) qtyUnPdInWeek,
                        sum(nvl(subbtrx.qty_standard,0)) qtyTotalReguEndWeek,
                        sum(nvl(subbtrx.qty_paid_over,0)) qtyTotalPdOvEndWeek,
                        sum(nvl(subbtrx.qty_overage,0)) qtyTotalUnPdEndWeek
                from  prec_trans_header subbtrxhdr,
                      prec_transactions subbtrx
                where   :STD_PCF_ID = subbtrx.pcf_id
                and     subbtrx.header_id = subbtrxhdr.header_id
                and     subbtrxhdr.transaction_type not in ('S','R','B')
                and     (subbtrxhdr.transaction_type = 'L' or subbtrxhdr.transaction_status != 'P') -- ignore pending addtl, just like everywhere else in controller screens
                and     subbtrxhdr.monday_date <= to_date(:P302_WORKING_WEEKSTARTDATE,'mm/dd/yyyy')
                group by  subbtrx.mark_number
              )) subQMarkTotals
where userpcfs.user_name = :APP_USER
and userpcfs.pcf_id = pcfs.pcf_id
and pcfs.pcf_id = :STD_PCF_ID
and pcfs.pcf_id = marks.pcf_id
and marks.mark_number = subQMarkTotals.mark_number (+)
