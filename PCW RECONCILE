       )
FROM dual;

"
  CREATE OR REPLACE FORCE EDITIONABLE VIEW "RECOWEBPROD"."OLD_PCF_WEEKS_CURR_V" ("PCF_ID", "MON_DATE") AS 
  select  pcfs.pcf_id,
            case
            when lots.lot_date is null
            then null
            when to_char(lots.lot_date,'DY') = 'SUN'
            then trunc(lots.lot_date) - 6
            else
              trunc(lots.lot_date)
                - (to_number(to_char(lots.lot_date,'D')) - 2)
            end mon_date
    from  web_re_projects pcfs,
          web_re_lot_numbers lots
    where   pcfs.pcf_id = lots.pcf_id
    --and     pcfs.job_status = 'OPEN' -- just because job and site are open, does not mean pcf is open
    union
    select  pcfs.pcf_id,
            case
            when lots.submit_date is null
            then null
            when to_char(lots.submit_date,'DY') = 'SUN'
            then trunc(lots.submit_date) - 6
            else
              trunc(lots.submit_date)
                - (to_number(to_char(lots.submit_date,'D')) - 2)
            end mon_date
    from  web_re_projects pcfs,
          web_re_lot_numbers lots
    where   pcfs.pcf_id = lots.pcf_id
    and     lots.submit_date is not null
    --and     pcfs.job_status = 'OPEN'
    union
    select  pcfs.pcf_id,
            case
            when shipheaders.shipment_date is null
            then null
            when to_char(shipheaders.shipment_date,'DY') = 'SUN'
            then trunc(shipheaders.shipment_date) - 6
            else
              trunc(shipheaders.shipment_date)
                - (to_number(to_char(shipheaders.shipment_date,'D')) - 2)
            end mon_date
    from  web_re_projects pcfs,
          web_re_shipment_master shipheaders
    where   pcfs.pcf_id = shipheaders.pcf_id
    --and     pcfs.job_status = 'OPEN'
"

