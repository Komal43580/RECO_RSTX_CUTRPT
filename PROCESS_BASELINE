       NVL(bv.revenue, 0) AS revenue,
       bv.creation_date,
       bv.last_update_date,
       bv.last_updated_by
FROM apps.pa_projects_all p
JOIN apps.pa_budget_versions bv
  ON bv.project_id = p.project_id
WHERE p.segment1 = '20422'
  AND (
         (bv.budget_status_code = 'W' AND bv.current_working_flag = 'Y')
      OR (bv.budget_status_code = 'B' AND bv.current_flag = 'Y')
