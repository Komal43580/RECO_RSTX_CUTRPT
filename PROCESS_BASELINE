-- 23. RERUN VALIDATION - BASELINE LOG COUNT
--------------------------------------------------------------------------------
-- EXPECTED:
--   One BASELINED entry for this lifecycle.

WITH project_map AS (
    SELECT rp.reco_project_id
    FROM apps.pa_projects_all p
    JOIN reco_projects rp
      ON rp.project_id = p.project_id
    WHERE p.segment1 = '20422'
)
SELECT l.process_stage,
       l.process_status,
       COUNT(*) AS log_count,
       MIN(l.creation_date) AS first_log_date,
       MAX(l.creation_date) AS last_log_date
FROM reco.reco_esc_process_log l
JOIN project_map pm
  ON pm.reco_project_id = l.project_id
WHERE l.process_stage = 'BASELINE'
  AND l.process_status = 'BASELINED'
GROUP BY l.process_stage,
         l.process_status;

