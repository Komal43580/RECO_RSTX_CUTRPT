-- 5. BASELINE-ELIGIBLE ESCALATION ROWS
--------------------------------------------------------------------------------
-- EXPECTED:
--   All intended rows have:
--     APPROVAL_STATUS = APPROVED
--     STATUS = FUNDED or BASELINE_ERROR
--     FREEZE_FLAG = N
--     CURRENT_ESCALATION_FLAG = Y

WITH project_map AS (
    SELECT rp.reco_project_id
    FROM apps.pa_projects_all p
    JOIN reco_projects rp
      ON rp.project_id = p.project_id
    WHERE p.segment1 = '20422'
)
SELECT e.esc_setup_id,
       e.project_id AS reco_project_id,
       e.task_number,
       e.task_name,
       e.component,
       e.approval_status,
       e.status,
       e.freeze_flag,
       e.current_escalation_flag,
       e.applied_by,
       e.applied_date,
       e.error_message
FROM reco_contract_escalation_setup@contractstest e
JOIN project_map pm
  ON pm.reco_project_id = e.project_id
WHERE NVL(e.freeze_flag, 'N') = 'N'
  AND e.current_escalation_flag = 'Y'
  AND e.approval_status = 'APPROVED'
  AND e.status IN ('FUNDED', 'BASELINE_ERROR')
ORDER BY e.esc_setup_id;


