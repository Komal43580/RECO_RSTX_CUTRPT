SELECT bv.budget_version_id,
       bv.project_id,
       bv.fin_plan_type_id,
       bv.version_type,
       bv.budget_status_code,
       bv.current_working_flag,
       bv.current_flag,
       bv.version_number,
       bv.version_name,
       bv.description,
       bv.locked_by_person_id,
