-- 12. CHECK RAW COST VS BURDENED COST BEFORE PREPARATION
--------------------------------------------------------------------------------
-- PACKAGE BEHAVIOR:
--   Working budget header BURDENED_COST is set equal to RAW_COST if different.
--   RECO_ESC budget-line BURDENED_COST is set equal to RAW_COST if different.
--
-- EXPECTED:
--   Review rows where RAW_COST <> BURDENED_COST before execution. No row is expected

SELECT 'BUDGET HEADER' AS record_type,
       bv.budget_version_id AS record_id,
       bv.raw_cost,
       bv.burdened_cost,
       bv.raw_cost - bv.burdened_cost AS difference
FROM apps.pa_projects_all p
JOIN apps.pa_budget_versions bv
  ON bv.project_id = p.project_id
WHERE p.segment1 = '20422'
  AND bv.budget_status_code = 'W'
  AND bv.current_working_flag = 'Y'
  AND NVL(bv.raw_cost, 0) <> NVL(bv.burdened_cost, 0)

UNION ALL

SELECT 'RECO_ESC BUDGET LINE',
       bl.budget_line_id,
       bl.raw_cost,
       bl.burdened_cost,
       bl.raw_cost - bl.burdened_cost
FROM apps.pa_projects_all p
JOIN apps.pa_budget_versions bv
  ON bv.project_id = p.project_id
JOIN apps.pa_resource_assignments ra
  ON ra.budget_version_id = bv.budget_version_id
JOIN apps.pa_budget_lines bl
  ON bl.resource_assignment_id = ra.resource_assignment_id
WHERE p.segment1 = '20422'
  AND bv.budget_status_code = 'W'
  AND bv.current_working_flag = 'Y'
  AND bl.pm_product_code = 'RECO_ESC'
  AND NVL(bl.raw_cost, 0) <> NVL(bl.burdened_cost, 0);

