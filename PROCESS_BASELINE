FROM apps.pa_projects_all p
JOIN apps.pa_budget_versions bv
  ON bv.project_id = p.project_id
JOIN apps.pa_resource_assignments ra
  ON ra.budget_version_id = bv.budget_version_id
JOIN apps.pa_tasks t
  ON t.task_id = ra.task_id
LEFT JOIN apps.pa_resource_list_members rlm
  ON rlm.resource_list_member_id = ra.resource_list_member_id
