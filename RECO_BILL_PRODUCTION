PROCEDURE RECO_PASS_PRODUCTION ( bdate IN date,
                                                   edate IN date,
                                                   action IN number,
                                                   billdate IN date DEFAULT TRUNC(SYSDATE) ) IS
--
-- This procedure finds production entered between the two dates that has
-- not been billed and sends it to the interface.
-- It updates the associated lots with a billed flag of 'X' for transfer begins
-- and the date.
-- After the transactions have been posted, billed is set to 'Y'.'
--  It also updates the 'quantity billed' in the requirements table.
--  for negative transactions it sets the appropriate flag
-- JRA
--
-- if -1 is passed in for howmany, it outputs debug messages
-- if -2 is passed, it outputs messages and does NOT commit
--
-- 3/10 added calls to run concurrent printouts
--
begindate date;
enddate date;
howmany number;

-- only difference, this one does not do waco anymore
CURSOR getproduction IS
     SELECT /*+ ORDERED USE_NL( L,P,V,PC,PR,PA,T ) */ l.lot_id,
          l.lot_date,
          TRUNC(l.lot_date+(8-TO_NUMBER(TO_CHAR(TRUNC(l.lot_date),'d')))) end_of_week,
          segment1 project_num,
          t.task_number,
          v.expenditure_type,
          SUM(p.quantity_produced*pr.area_per_piece) qty,
          v.unit_price,
          v.pcf_id
  FROM  reco_lot_numbers l, reco_pcf v, reco_pcf_current pc,
        reco_production p, reco_production_requirements pr,
        pa_projects pa, pa_tasks t
  WHERE   l.billed_flag = 'N'
  AND     l.lot_date <= enddate
  AND     p.lot_id = l.lot_id
  AND     v.pcf_id = l.pcf_id
  AND     pc.pcf_id = v.pcf_id
  AND     pc.revision_number = v.revision_number
  AND     pr.pc_id = p.pc_id
  and     pr.revision_number = pc.revision_number
  AND     v.task_id != 1995
  AND     v.vendor_id not in ( wacovendorid, georgiavendorid, floridavendorid, cavendorid, lbvendorid, wmvendorid )
  AND     pa.project_id = v.project_id
  AND     t.task_id = v.task_id
  GROUP BY l.lot_id, l.lot_date,
            TRUNC(l.lot_date+(8-TO_NUMBER(TO_CHAR(TRUNC(l.lot_date),'d')))),
            segment1, t.task_number, v.expenditure_type, v.unit_price, v.pcf_id;

CURSOR startproduction( pcfid number ) IS
       SELECT SUM(quantity_produced*area_per_piece)
         FROM  reco_production_v
        WHERE lot_date < begindate
          AND pcf_id = pcfid;

CURSOR endproduction( pcfid number ) IS
       SELECT SUM(quantity_produced*area_per_piece)
         FROM  reco_production_v
        WHERE lot_date < enddate
          AND pcf_id = pcfid;

CURSOR pdbilled( pcfid number ) IS
       SELECT SUM(quantity_produced*area_per_piece)
         FROM reco_production_v
        WHERE lot_date BETWEEN begindate AND enddate
          AND billed_flag = 'Y'
          AND pcf_id = pcfid;

-- corrected to give correct overage number
CURSOR startoverage( pcfid number ) IS
     SELECT SUM (( SUM(quantity_produced) - AVG(quantity_required) )
                 * AVG(area_per_piece) )
       FROM reco_production_v
      WHERE pcf_id = pcfid AND lot_date < begindate
        AND billed_date < billdate
      GROUP BY mark_number
     HAVING AVG(quantity_required)-SUM(quantity_produced) < 0;

CURSOR endoverage( pcfid number ) IS
     SELECT SUM (( SUM(quantity_produced) - AVG(quantity_required) )
                 * AVG(area_per_piece) )
       FROM reco_production_v
      WHERE pcf_id = pcfid AND lot_date < enddate
      GROUP BY mark_number
     HAVING AVG(quantity_required)-SUM(quantity_produced) < 0;

CURSOR getbilled IS
         SELECT MAX(end_of_week) eow, MAX(P.lot_date) ldate, SUM(qty) qty,
          P.project_num, P.task_number, P.expenditure_type, P.pcf_id, P.unit_price,
          pp.project_id, pv.revision_number
         FROM reco_prod_billing P, reco_lot_numbers l, pa_projects pp, reco_pcf_v pv
         WHERE l.billed_date = billdate AND l.lot_id = P.lot_id
           AND pp.segment1 = P.project_num AND pv.pcf_id = P.pcf_id
         GROUP BY P.project_num, P.task_number, P.expenditure_type, P.pcf_id, P.unit_price, pp.project_id, pv.revision_number;

CURSOR getemployee (thepid number) IS
 SELECT employee_number
 FROM apps.pa_proj_info_view piv, per_people_f P
 WHERE person_id = manager_person_id
 AND project_id = thepid
 AND P.effective_end_date >= SYSDATE;

CURSOR getvendor (pcfid number ) IS
    SELECT vendor_id FROM reco_pcf_v WHERE pcf_id = pcfid;

CURSOR gnum IS
   SELECT transentry_seq.NEXTVAL FROM dual;

enum  per_people_f.employee_number%TYPE;
calcunits number;
calccost number;
debug BOOLEAN := FALSE;
tinum varchar2(10);
tvalue  number;

sprod number;
eprod number;
sover number;
eover number;
billed number;
junkval number;

isnegative  varchar2(1) := 'N';
adjusteddate date := NULL;
adjustedeow  date := NULL;
expcomment   varchar2(240) := NULL;
vendor  number;
transtype varchar2(30);

dfltempnum   number := get_reco_variable('Default Precast Employee');

BEGIN

  begindate := bdate;
  enddate := edate + .999;
  howmany := action;
  IF howmany < 0 THEN
     debug := TRUE;
     Dbms_Output.Enable( 200000 );
  END IF;
  IF begindate IS NULL THEN
     begindate := TO_DATE('01-01-1901','dd-mm-yyyy');
  END IF;
  howmany := 0;

--
  FOR eachone IN getproduction LOOP
--
     calccost := ROUND(eachone.qty * eachone.unit_price, 2);
     INSERT INTO reco_prod_billing (
          lot_id, end_of_week, lot_date, project_num, task_number,
          expenditure_type, qty, calccost, pcf_id, unit_price )
     VALUES (
          eachone.lot_id, eachone.end_of_week, eachone.lot_date,
          eachone.project_num, eachone.task_number, eachone.expenditure_type,
          eachone.qty, calccost, eachone.pcf_id, eachone.unit_price );
--
     UPDATE reco_lot_numbers set billed_flag = 'X', billed_date = billdate
      WHERE lot_id = eachone.lot_id AND billed_flag != 'X';
     IF debug THEN
        Dbms_Output.Put_Line( 'Lot:'||TO_CHAR(eachone.lot_id) );
     END IF;
     howmany := howmany + 1;
  END LOOP;
--
  IF action = -2 THEN
     Dbms_Output.Put_Line( 'Manual Commit used, check output first.'  );
  ELSE
     COMMIT;
  END IF;
  FOR eachtwo IN getbilled LOOP
-- get enum for each project line
     OPEN getemployee( eachtwo.project_id );
     FETCH getemployee INTO enum;
     CLOSE getemployee;
     IF debug THEN
        Dbms_Output.Put_Line( 'Found Enum was:"'||enum||'"' );
     END IF;
     IF enum IS NULL THEN
        enum := dfltempnum;
     END IF;
     IF debug THEN
        Dbms_Output.Put_Line( 'Used Enum was:"'||enum||'"' );
     END IF;
--
     -- get vendor 8/5
     OPEN getvendor( eachtwo.pcf_id );
     FETCH getvendor INTO vendor;
     CLOSE getvendor;
     --
     OPEN gnum;
     FETCH gnum INTO tvalue;
     CLOSE gnum;
     OPEN startproduction( eachtwo.pcf_id );
     FETCH startproduction INTO sprod;
     CLOSE startproduction;
     OPEN endproduction( eachtwo.pcf_id );
     FETCH endproduction INTO eprod;
     CLOSE endproduction;
     OPEN startoverage( eachtwo.pcf_id );
     FETCH startoverage INTO sover;
     CLOSE startoverage;
     OPEN endoverage( eachtwo.pcf_id );
     FETCH endoverage INTO eover;
     CLOSE endoverage;
     OPEN pdbilled( eachtwo.pcf_id );
     FETCH pdbilled INTO billed;
