     debug := TRUE;
     Dbms_Output.Enable( 200000 );
  END IF;
  IF begindate IS NULL THEN
     begindate := TO_DATE('01-01-1901','dd-mm-yyyy');
  END IF;
  howmany := 0;
--
  FOR eachone IN getproduction LOOP
--
     calccost := ROUND(eachone.qty * eachone.unit_price, 2);
     INSERT INTO reco_lb_prod_billing (
          lot_id, end_of_week, lot_date, project_num, task_number,
          expenditure_type, qty, calccost, pcf_id, unit_price )
     VALUES (
          eachone.lot_id, eachone.end_of_week, eachone.lot_date,
