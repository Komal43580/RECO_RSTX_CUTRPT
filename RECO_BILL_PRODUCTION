              NVL(calcunits,0), calccost, 'P', tinum, enum, isnegative, expcomment,
              'Precast Production', tinum, TO_CHAR(eachtwo.pcf_id), TO_CHAR(eachtwo.revision_number),
                   vendor, transtype, 0 );
    END IF;

     IF debug THEN
       Dbms_Output.Put_Line( 'Project:'||eachtwo.project_num||
                             'Task:'||eachtwo.task_number||
                             'Units:'||TO_CHAR(calcunits)||
                             ' Cost:'||TO_CHAR(calccost)    );
       Dbms_Output.Put_Line( 'Transaction '||tinum||' Value:'||TO_CHAR(calccost) );
     END IF;
     UPDATE reco_lb_prod_billing
       set tnum = tinum
      WHERE project_num = eachtwo.project_num AND task_number = eachtwo.task_number
        AND pcf_id = eachtwo.pcf_id
        AND tnum IS NULL;
     INSERT INTO reco_precast_linkage ( tnum, lot_id )
     SELECT tnum, lot_id FROM reco_lb_prod_billing
      WHERE tnum = tinum;
   END LOOP;

--
  IF action = -2 THEN
     Dbms_Output.Put_Line( 'Manual Commit used, check output first.'  );
  ELSE
     COMMIT;
  END IF;
END;

