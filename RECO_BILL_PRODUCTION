procedure mark_lots_billed( errbuf out varchar2,
                            retcode out number  ) is
-- this procedure marks all lots billed according to the expenditure linked
-- the precast linkage table contains the back link to the original lots
-- the appropriate billing table gets cleared when completed
--
cursor getotherbilled is
select b.tnum
from reco_prod_billing b, pa_expenditure_items_all p
where p.orig_transaction_reference = b.tnum;

cursor getwacobilled is
select b.tnum
from reco_waco_prod_billing b, pa_expenditure_items_all p
where p.orig_transaction_reference = b.tnum;

cursor getgeorgiabilled is
select b.tnum
from reco_georgia_prod_billing b, pa_expenditure_items_all p
where p.orig_transaction_reference = b.tnum;

cursor getfloridabilled is
select b.tnum
from reco_florida_prod_billing b, pa_expenditure_items_all p
where p.orig_transaction_reference = b.tnum;

cursor getcabilled is
select b.tnum
from reco_ca_prod_billing b, pa_expenditure_items_all p
where p.orig_transaction_reference = b.tnum;

cursor getlbbilled is
select b.tnum
from reco_lb_prod_billing b, pa_expenditure_items_all p
where p.orig_transaction_reference = b.tnum;

wacocnt  number :=0;
georgiacnt number :=0;
floridacnt number :=0;
cacnt number :=0;
othercnt number := 0;
lbcnt number := 0;

begin

  for eachother in getotherbilled loop
      update reco_lot_numbers
       set billed_flag = 'Y'
      where lot_id in ( select lot_id from reco_precast_linkage
                         where tnum = eachother.tnum );
      othercnt := othercnt + SQL%ROWCOUNT;
      delete from reco_prod_billing where tnum = eachother.tnum;
  end loop;

  for eachwaco in getwacobilled loop
      update reco_lot_numbers
       set billed_flag = 'Y'
      where lot_id in ( select lot_id from reco_precast_linkage
                         where tnum = eachwaco.tnum );
      wacocnt := wacocnt + SQL%ROWCOUNT;
      delete from reco_waco_prod_billing where tnum = eachwaco.tnum;
  end loop;

  for eachgeorgia in getgeorgiabilled loop
      update reco_lot_numbers
       set billed_flag = 'Y'
      where lot_id in ( select lot_id from reco_precast_linkage
                         where tnum = eachgeorgia.tnum );
      georgiacnt := georgiacnt + SQL%ROWCOUNT;
      delete from reco_georgia_prod_billing where tnum = eachgeorgia.tnum;
  end loop;

  for eachflorida in getfloridabilled loop
      update reco_lot_numbers
       set billed_flag = 'Y'
      where lot_id in ( select lot_id from reco_precast_linkage
                         where tnum = eachflorida.tnum );
      floridacnt := floridacnt + SQL%ROWCOUNT;
      delete from reco_florida_prod_billing where tnum = eachflorida.tnum;
  end loop;

  for eachca in getcabilled loop
      update reco_lot_numbers
       set billed_flag = 'Y'
      where lot_id in ( select lot_id from reco_precast_linkage
                         where tnum = eachca.tnum );
      cacnt := cacnt + SQL%ROWCOUNT;
      delete from reco_ca_prod_billing where tnum = eachca.tnum;
  end loop;

  for eachlb in getlbbilled loop
      update reco_lot_numbers
       set billed_flag = 'Y'
      where lot_id in ( select lot_id from reco_precast_linkage
                         where tnum = eachlb.tnum );
      lbcnt := lbcnt + SQL%ROWCOUNT;
      delete from reco_lb_prod_billing where tnum = eachlb.tnum;
  end loop;

  FND_FILE.PUT_LINE(FND_FILE.Log,'Waco:'||to_char(wacocnt)||', georgia:'||to_char(georgiacnt)||
    ', florida:'||to_char(floridacnt)||', ca:'||to_char(cacnt)||', lb:'||to_char(lbcnt)||', Other:'||to_char(othercnt) );
  retcode := 0;
  commit;
exception
  when others then
        errbuf := sqlerrm;
        FND_FILE.PUT_LINE(FND_FILE.Log,'Unhandled exception in mark_lots_billed: '||errbuf);
        retcode := 1;
        rollback;
end;


BEGIN
  get_reco_organization('0');

  wacovendor := get_reco_variable('WACO PLANT VENDOR ID');
  OPEN determinewaco( wacovendor );
  FETCH determinewaco INTO wacovendorid;
  CLOSE determinewaco;

  georgiavendor := get_reco_variable('GEORGIA PLANT VENDOR ID');
  OPEN determinewaco( georgiavendor );
  FETCH determinewaco INTO georgiavendorid;
  CLOSE determinewaco;

  floridavendor := get_reco_variable('FLORIDA PLANT VENDOR ID');
  OPEN determinewaco( floridavendor );
  FETCH determinewaco INTO floridavendorid;
  CLOSE determinewaco;

  cavendor := get_reco_variable('CA PLANT VENDOR ID');
  OPEN determinewaco( cavendor );
  FETCH determinewaco INTO cavendorid;
  CLOSE determinewaco;

  lbvendor := get_reco_variable('LB PLANT VENDOR ID');
  OPEN determinewaco( lbvendor );
  FETCH determinewaco INTO lbvendorid;
  CLOSE determinewaco;

  wmvendor := get_reco_variable('WM PLANT VENDOR ID');
  OPEN determinewaco( wmvendor );
  FETCH determinewaco INTO wmvendorid;
  CLOSE determinewaco;

END;
