PROCEDURE RECO_SHIP_BILLING (    bdate IN date,
                                                   edate IN date,
                                                   action IN number ) IS
--
-- This procedure finds shipping entered between the two dates that has
-- not been billed and sends it to the interface.
-- It updates the associated shipping entries with a billed flag of 'X'
-- for transfer begins and the date.
-- After the transactions have been posted, billed is set to 'Y'.  (and billed_date is
-- changed to current date )
-- JRA
--
-- if -1 is passed in for howmany, it outputs debug messages
--
begindate  date;
enddate    date;
howmany    number;


CURSOR  getshipping IS
  SELECT /*+ USE_NL( S,T,P,V,PC ) */P.segment1 project_num, T.task_number shipping_task_number, T.project_id,
         s.shipping_expenditure_type, s.ship_comment, s.pcf_id, v.revision_number,
         s.ship_date, s.ship_amount, s.pcf_ship_id, v.shipping_cost, v.expenditure_type,
         'S'||LTRIM(TO_CHAR(s.pcf_ship_id)) interfacenum, v.vendor_id
    FROM reco_pcf_shipping s, pa_tasks T, pa_projects P, reco_pcf v, reco_pcf_current pc
   WHERE T.task_id = s.shipping_task_id
         and p.project_id = t.project_id
         AND ( s.ship_amount != 0 OR t.task_number like '039.03.%' )
         AND v.pcf_id = s.pcf_id
         AND pc.pcf_id = v.pcf_id and pc.revision_number = v.revision_number
         AND billed_flag = 'N'
         AND v.vendor_id not in ( wacovendorid, georgiavendorid, floridavendorid, cavendorid, lbvendorid, wmvendorid )
     AND ship_date <= enddate;

CURSOR getemployee (thepid IN number) IS
 SELECT employee_number
 FROM apps.pa_proj_info_view piv, per_people_f P
 WHERE person_id = manager_person_id
 AND project_id = thepid
 AND P.effective_end_date >= SYSDATE;


enum   per_people_f.employee_number%TYPE;
debug BOOLEAN := FALSE;
isnegative  varchar2(1) := 'N';
junkval number;
adjdate  date;
adjeow   date;
transtype   varchar2(30);

expcomment varchar2(240);
dfltempnum   number := get_reco_variable('Default Precast Employee');

BEGIN

  begindate := bdate;
  enddate := edate;
  howmany := action;
  IF howmany < 0 THEN
     debug := TRUE;
     Dbms_Output.Enable( 200000 );
  END IF;
  IF begindate IS NULL THEN
     begindate := TO_DATE('01-01-1901','dd-mm-yyyy');
  END IF;

  howmany := 0;

  FOR eachone IN getshipping LOOP
     OPEN getemployee(eachone.project_id);
     FETCH getemployee INTO enum;
     CLOSE getemployee;
     IF debug THEN
        Dbms_Output.Put_Line( 'Found Enum was:"'||enum||'"' );
     END IF;
     IF enum IS NULL THEN
        enum := dfltempnum;
     END IF;
     IF debug THEN
        Dbms_Output.Put_Line( 'Used Enum was:"'||enum||'"' );
     END IF;
     IF eachone.ship_amount < 0 THEN
        isnegative := 'Y';
     ELSE
        isnegative := 'N';
     END IF;
     IF debug THEN
        Dbms_Output.Put_Line( 'Trans:'||eachone.interfacenum||';'||
            eachone.project_num||';'||eachone.shipping_task_number||
            '('||TO_CHAR(eachone.ship_amount)||')' );
     END IF;
     --  5/17 determine correct date if previous period
     IF eachone.ship_date BETWEEN begindate AND enddate THEN
        adjdate := eachone.ship_date;
        adjeow  := TRUNC(adjdate+(8-TO_NUMBER(TO_CHAR(TRUNC(adjdate),'d'))));
        expcomment := eachone.ship_comment;
        transtype := 'CURRENT';
     ELSE
        adjdate := begindate + (enddate - begindate)/2;
        adjeow := TRUNC(adjdate+(8-TO_NUMBER(TO_CHAR(TRUNC(adjdate),'d'))));
        expcomment := 'Previous period shipping :'||SUBSTR(eachone.ship_comment,1,150);
        transtype := 'PREVIOUS';
     END IF;
--
-- Ensure WACO passes dollars, but no other vendor type  5/19
--
-- now insert a units line for the precast expenditure  MUST be 0 cost!
     INSERT INTO apps.pa_transaction_interface_all (
          transaction_source, batch_name, expenditure_ending_date,
          expenditure_item_date, project_number, task_number,
          expenditure_type, quantity, denom_raw_cost, transaction_status_code,
          orig_transaction_reference, employee_number, unmatched_negative_txn_flag,
          expenditure_comment, attribute_category, attribute2, attribute3, attribute4,
               attribute5, attribute6, attribute7, org_id, system_linkage )
     VALUES (
          'Production Shipping', eachone.interfacenum||'a', adjeow,
          adjdate, eachone.project_num, eachone.shipping_task_number,
          eachone.expenditure_type, eachone.ship_amount, 0,
