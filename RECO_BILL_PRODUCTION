PROCEDURE  bill_all( errbuf OUT varchar2,
                     retcode OUT number,
                     billing_date IN varchar2 ) IS
vv varchar2(500);
n number := 0;
lastrun varchar2(80) := get_reco_variable('Last Production Run Date');
nn date;
BEGIN
  FND_FILE.PUT_LINE(FND_FILE.Log,'BILL_ALL LastRun:'||lastrun);
  nn := fnd_date.string_to_date( lastrun, 'DD-MON-YYYY' );
  if nn < trunc(sysdate-30) then
     FND_FILE.PUT_LINE(FND_FILE.Log,'Date more than 30 days old, reset to 30 days LastRun:'||lastrun);
     nn := trunc(sysdate-30);
  end if;
  IF nn < trunc(SYSDATE) THEN
     nn := nn + 1;
  END IF;
  lastrun := TO_CHAR( nn, 'DD-MON-YYYY' );
  FND_FILE.PUT_LINE(FND_FILE.Log,'BILL_ALL New LastRun:'||lastrun);

  bill_precast( vv, retcode, lastrun );
  errbuf := vv;
  n := NVL(retcode,0);
  vv := NULL;
  bill_waco( vv, retcode, lastrun );
  errbuf := errbuf || vv;
  retcode := NVL(retcode,0) + n;
  bill_georgia( vv, retcode, lastrun );
  errbuf := errbuf || vv;
  retcode := NVL(retcode,0) + n;
  bill_florida( vv, retcode, lastrun );
  errbuf := errbuf || vv;
  retcode := NVL(retcode,0) + n;
  bill_ca( vv, retcode, lastrun );
  errbuf := errbuf || vv;
  retcode := NVL(retcode,0) + n;
  bill_lb( vv, retcode, lastrun );
  errbuf := errbuf || vv;
  retcode := NVL(retcode,0) + n;
  bill_wm( vv, retcode, lastrun );
  errbuf := errbuf || vv;
  retcode := NVL(retcode,0) + n;

  FND_FILE.PUT_LINE(FND_FILE.Log,'BILL_ALL result messages:'||errbuf);

  IF retcode = 0 THEN
     FND_FILE.PUT_LINE(FND_FILE.Log,'BILL_ALL No errors, New LastRun:'||lastrun);
     UPDATE reco_domain_data set data_value = lastrun
    WHERE domain_name = 'RECO_VARIABLES' AND data_desc = 'Last Production Run Date';
    COMMIT;
  END IF;

END;


PROCEDURE  bill_precast( errbuf OUT varchar2,
                         retcode OUT number,
                         billing_date IN varchar2  ) IS

-- This procedure bills standard outside precaster entries only
-- for the date entered.   It checks to be sure the date has not
-- been processed, in which case it returns a failure code
--
junkval number;
BEGIN
  IF billing_date IS NULL THEN
     errbuf := 'Invalid Date Entered';
     retcode := -1;
     RAISE NO_DATA_FOUND;
  ELSE
     currentbilldate := fnd_date.string_to_date( billing_date, 'DD-MON-YYYY' );

     IF date_billed( billing_date ) THEN
           errbuf := 'Precast Date billed';
           retcode := -1;
           RAISE NO_DATA_FOUND;
     END IF;
  END IF;
  currentbilling.billed_date := billing_date;
  currentbilling.bill_range_low := billing_date;
  currentbilling.bill_range_high := billing_date;
  currentbilling.last_UPDATE_date := SYSDATE;
  currentbilling.creation_date := SYSDATE;
  currentbilling.last_updated_by := apps.fnd_global.user_ID;
  currentbilling.created_by := apps.fnd_global.user_id;
  currentbilling.last_update_login := apps.fnd_global.session_id;

  INSERT INTO reco_pcf_billing VALUES  currentbilling ;

  reco_bill_production.reco_pass_production( billing_date, billing_date, 0, billing_date );

  reco_bill_production.reco_ship_billing( billing_date, billing_date, 0 );

--  Summary report
     IF fnd_request.set_print_options( '\\OPRINT\O_ACC', 'LANDPS', 1, NULL,NULL ) = FALSE THEN
        Dbms_Output.Put_Line( 'Unable to set printing options' );
     END IF;
   junkval := fnd_request.submit_request( 'RECPC', 'PRODTRANSLIST',
            'RECO Production Transfer Import Listing',
            NULL,FALSE  );
   Dbms_Output.Put_Line( 'Import listing:'||TO_CHAR(junkval)  );


  COMMIT;
  retcode := 0;

EXCEPTION
  WHEN OTHERS THEN
     errbuf := errbuf||' '||SQLERRM;
END;


